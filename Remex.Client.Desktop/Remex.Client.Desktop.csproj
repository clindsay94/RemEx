<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Remex.Client\Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.5" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.11">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remex.Client\Remex.Client.csproj" />
    <ProjectReference Include="..\Remex.Host\Remex.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\scripts\**" Link="scripts\%(RecursiveDir)%(FileName)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Mirror the native Linux bridge copy from Remex.Host so that publishing the
    desktop client also includes libremex_linux_bridge.so. The client references
    Remex.Host and runs the same PipeWire capture services, so it needs the .so.
  -->
  <Target Name="CopyNativeLinuxBridge"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <_NativeBridgeSource>$(MSBuildThisFileDirectory)..\Remex.Host.Native.Linux\build\libremex_linux_bridge.so</_NativeBridgeSource>
      <_NativeBridgeDest>$(OutputPath)runtimes\linux-x64\native\</_NativeBridgeDest>
    </PropertyGroup>
    <Warning Condition="!Exists('$(_NativeBridgeSource)')"
             Text="libremex_linux_bridge.so not found at $(_NativeBridgeSource). PipeWire screen capture will be unavailable until you build the native bridge: cmake -S Remex.Host.Native.Linux -B Remex.Host.Native.Linux/build &amp;&amp; cmake --build Remex.Host.Native.Linux/build" />
    <Copy Condition="Exists('$(_NativeBridgeSource)')"
          SourceFiles="$(_NativeBridgeSource)"
          DestinationFolder="$(_NativeBridgeDest)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeLinuxBridgeToPublish"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <_NativeBridgeSource>$(MSBuildThisFileDirectory)..\Remex.Host.Native.Linux\build\libremex_linux_bridge.so</_NativeBridgeSource>
    </PropertyGroup>
    <Warning Condition="!Exists('$(_NativeBridgeSource)')"
             Text="libremex_linux_bridge.so not found at $(_NativeBridgeSource). PipeWire screen capture will be unavailable until you build the native bridge: cmake -S Remex.Host.Native.Linux -B Remex.Host.Native.Linux/build &amp;&amp; cmake --build Remex.Host.Native.Linux/build" />
    <Copy Condition="Exists('$(_NativeBridgeSource)')"
          SourceFiles="$(_NativeBridgeSource)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
