<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia UI -->
    <PackageVersion Include="Avalonia" Version="11.3.11" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.11" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.11" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.11" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.11" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.11" />

    <!-- Material.Avalonia (RemEx-851li) — the design system for the desktop overhaul, RemEx-kb4im.
         Referenced but INERT until RemEx-prkot includes the styles in App.axaml.

         PINNED TO THE 3.14.x LINE ON PURPOSE, AND IT IS NOT THE LATEST. Material.Avalonia 3.15.0
         and everything after it — up to 3.19.0 today — declares a dependency on Avalonia 12.0.0.
         3.14.2 is the newest STABLE release that still targets Avalonia 11.x. It declares Avalonia
         11.1.0, which is a floor rather than a pin, so it resolves against our 11.3.11 without a
         downgrade. Checked against the nuspecs on nuget.org rather than assumed, because the bead
         asked for exactly that.

         So the epic is capped here until Avalonia itself moves to 12, which is a framework major
         upgrade and the operator's call — see the note on RemEx-851li.

         AND THE CAP IS ENFORCED BY NUGET, NOT JUST BY CONVENTION. Measured on 2026-08-20: setting
         these two to 3.15.0 fails `dotnet restore` outright with
           error NU1605: Detected package downgrade: Avalonia from 12.0.0 to 11.3.11.
           Remex.Desktop -> Material.Avalonia 3.15.0 -> Avalonia (>= 12.0.0)
           Remex.Desktop -> Avalonia (>= 11.3.11)
         So a careless bump cannot slip through quietly; it stops the build. An earlier draft of this
         comment said it "silently drags Avalonia 12 into the graph", which was a guess and was wrong
         in the direction that matters — it is loud. MaterialPackagePinTests exists to say WHY that
         NU1605 happens, because the error names a downgrade rather than a deliberate ceiling. -->

    <PackageVersion Include="Material.Avalonia" Version="3.14.2" />
    <PackageVersion Include="Material.Avalonia.Dialogs" Version="3.14.2" />

    <!-- NOT PINNED, AND THAT IS THE FINDING. Material.Avalonia.Dialogs pulls
         Avalonia.Controls.ItemsRepeater transitively and resolves it to 11.0.9, three minors behind
         the 11.3.11 everything else is on. There is no 11.3.x to pin it to: that package's 11 line
         stops at 11.1.5 and the next release is 12.0.0.

         A `PackageVersion` entry alone does NOT fix this — MEASURED. This was written as a pin to
         11.3.11 first, and NuGet ignored it in silence: restore and build both stayed green while
         artifacts/obj/remex.desktop/project.assets.json still resolved 11.0.9. Central package
         management binds versions only for packages a project actually references. A pin nobody
         checks is worse than no pin, because the comment above it reads as a guarantee.

         The documented fixes are CentralPackageTransitivePinningEnabled (a repo-wide behaviour
         change) or an explicit PackageReference to a package remex.desktop does not otherwise use.
         Stated from the NuGet docs, NOT verified here — an attempt to measure it did not produce a
         readable assets file and it was not worth a rabbit hole for a change we are not making.
         Whoever takes RemEx-60x5f should measure it rather than trust this paragraph.

         Left as-is deliberately. It builds clean and the package is inert until RemEx-prkot includes
         the Material styles.

         BE PRECISE ABOUT WHAT IS AND IS NOT GUARANTEED HERE (review). The >= 11.0.9 floor means
         restore resolves and the loader binds our higher 11.3.11 assemblies — so this will not fail
         to load. It does NOT mean a control compiled against 11.0.9 still BEHAVES correctly against
         11.3.11. Avalonia's 11.x compatibility has held for public API; control internals are where
         it has bent before. The residual risk is therefore behavioural and it lands at first use:
         a Material dialog that renders empty or lays out wrong, with no exception and nothing in the
         log. That is the silence class this repo keeps docs/REGRESSION-GUARDS.md for. Whoever wires
         Dialogs up should LOOK at the first Material dialog rather than trust the green build.
         RemEx-60x5f carries the decision. -->

    <!-- A separate package by design — Material.Avalonia does not bundle the icon pack. Same story
         one version later: 3.0.1 and up require Avalonia 12, so 3.0.0 is the newest stable on
         Avalonia 11.x. It declares Avalonia 11.3.0, the closest thing to a real 11.3 target in
         this whole set. RemEx-wyx2c consumes it. -->
    <PackageVersion Include="Material.Icons.Avalonia" Version="3.0.0" />

    <!-- Microsoft Extensions & Standard Libraries -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="10.0.5" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.5" />
    <PackageVersion Include="System.Management" Version="10.0.5" />
    <PackageVersion Include="System.Threading.AccessControl" Version="10.0.5" />

    <!-- Other Libraries -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageVersion Include="MaterialColorUtilities" Version="0.3.0" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <PackageVersion Include="Tmds.DBus.Protocol" Version="0.21.3" />

    <!-- Pinned Multicast DNS (Load-bearing, risk of drift/abandonment) -->
    <PackageVersion Include="Makaretu.Dns.Multicast" Version="0.27.0" />

    <!-- Pinned SkiaSharp (2.88.x line - do not upgrade to 3.x, which has breaking changes).
         2.88.9 matches the floor required by Avalonia.Skia 11.3.11, now that the host's direct
         SkiaSharp use (Linux JPEG encode) and Avalonia live in the same remex.agent project. -->
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />

    <!-- Testing Packages -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- Pinned FluentAssertions (7.0.0 line - v8 has license change) -->
    <PackageVersion Include="FluentAssertions" Version="7.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.5" />
  </ItemGroup>
</Project>
