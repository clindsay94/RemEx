<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RemEx.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Remex.Client\Assets\icon.ico</ApplicationIcon>
    <UserSecretsId>dotnet-Remex.Host-250abb58-e6f9-4331-93e2-4801f7e26382</UserSecretsId>
  </PropertyGroup>

  <!-- The consolidated RemEx.Host is both the Avalonia GUI host and the in-process ASP.NET host. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Replicate the implicit global usings the host code relied on under Microsoft.NET.Sdk.Web,
       now that it lives in a Microsoft.NET.Sdk (desktop) project. Avoids touching ~70 source files. -->
  <ItemGroup>
    <Using Include="System.Net.Http.Json" />
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia GUI -->
    <PackageReference Include="Avalonia.Desktop" />
    <!--Condition removes Avalonia.Diagnostics from Release build output.-->
    <PackageReference Include="Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- Host server deps (absorbed from the former Remex.Host project) -->
    <PackageReference Include="Makaretu.Dns.Multicast" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Management" />
    <PackageReference Include="System.Threading.AccessControl" NoWarn="NU1510" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remex.Client\Remex.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\scripts\**" Link="scripts\%(RecursiveDir)%(FileName)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Copy libremex_linux_bridge.so into runtimes/linux-x64/native/ so
    [DllImport("remex_linux_bridge")] in LinuxPipeWireFrameSource resolves at runtime.
    The .so is produced by Remex.Host.Native.Linux/CMakeLists.txt.
  -->
  <Target Name="CopyNativeLinuxBridge"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <_NativeBridgeSource>$(MSBuildThisFileDirectory)..\Remex.Host.Native.Linux\build\libremex_linux_bridge.so</_NativeBridgeSource>
      <_NativeBridgeDest>$(OutputPath)runtimes\linux-x64\native\</_NativeBridgeDest>
    </PropertyGroup>
    <Warning Condition="!Exists('$(_NativeBridgeSource)')"
             Text="libremex_linux_bridge.so not found at $(_NativeBridgeSource). PipeWire screen capture will be unavailable until you build the native bridge: cmake -S Remex.Host.Native.Linux -B Remex.Host.Native.Linux/build &amp;&amp; cmake --build Remex.Host.Native.Linux/build" />
    <Copy Condition="Exists('$(_NativeBridgeSource)')"
          SourceFiles="$(_NativeBridgeSource)"
          DestinationFolder="$(_NativeBridgeDest)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeLinuxBridgeToPublish"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <_NativeBridgeSource>$(MSBuildThisFileDirectory)..\Remex.Host.Native.Linux\build\libremex_linux_bridge.so</_NativeBridgeSource>
      <_NativeBridgeDest>$(PublishDir)runtimes\linux-x64\native\</_NativeBridgeDest>
    </PropertyGroup>
    <Warning Condition="!Exists('$(_NativeBridgeSource)')"
             Text="libremex_linux_bridge.so not found at $(_NativeBridgeSource). PipeWire screen capture will be unavailable until you build the native bridge: cmake -S Remex.Host.Native.Linux -B Remex.Host.Native.Linux/build &amp;&amp; cmake --build Remex.Host.Native.Linux/build" />
    <Copy Condition="Exists('$(_NativeBridgeSource)')"
          SourceFiles="$(_NativeBridgeSource)"
          DestinationFolder="$(_NativeBridgeDest)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
