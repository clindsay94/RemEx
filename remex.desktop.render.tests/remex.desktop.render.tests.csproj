<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Remex.Desktop.Render.Tests</RootNamespace>
    <AssemblyName>Remex.Desktop.Render.Tests</AssemblyName>

    <!-- Avalonia.Headless.XUnit 12.1.1 depends on xunit.v3.extensibility.core (measured in its
         nuspec) even though this project's own [Fact]/[Theory] tests stay on xunit v2 - Avalonia's
         AvaloniaFactAttribute/AvaloniaTheoryAttribute are xunit v3 test cases now. xunit v3's own
         out-of-process runner launches the test assembly's OWN apphost .exe rather than being
         loaded into vstest's testhost the way xunit v2 is, so without this the run fails with
         "Could not find app host executable" - measured, not assumed. No other test project in
         this repo references Avalonia.Headless.XUnit, so this stays local to this one project. -->
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <!-- Linux has no native Skia binaries bundled with Avalonia.Skia the way Windows does - same
         reason remex.agent.csproj and remex.agent.tests.csproj reference this. Without it the
         headless Skia backend fails to load on CachyOS. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\remex.desktop\remex.desktop.csproj" />
    <ProjectReference Include="..\remex.core\remex.core.csproj" />
    <ProjectReference Include="..\remex.branding\remex.branding.csproj" />
  </ItemGroup>

</Project>
