<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:id="@+id/config_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Configure Widget"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/config_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select items to display (max 4)"
        android:textColor="#B0B0B0"
        android:layout_marginTop="4dp" />

    <ListView
        android:id="@+id/items_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:divider="#2AFFFFFF"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/save_widget_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Widget"
        android:backgroundTint="#6C4CFF"
        android:textColor="#FFFFFF"
        android:layout_marginTop="16dp" />
</LinearLayout>
