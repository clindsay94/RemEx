# RemEx Host — systemd user service
# Installed by: install.sh install
# Manage with:  systemctl --user {start,stop,status,restart} remex-host
#               journalctl --user -u remex-host -f

[Unit]
Description=RemEx Host — remote desktop and telemetry server
Documentation=https://github.com/clindsay94/remex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=REMEX_INSTALL_DIR/Remex.Host
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# The user service inherits the graphical session environment
# (WAYLAND_DISPLAY, DISPLAY, DBUS_SESSION_BUS_ADDRESS, XDG_RUNTIME_DIR, etc.)
# automatically via the systemd --user manager started by PAM/logind.

[Install]
WantedBy=default.target
