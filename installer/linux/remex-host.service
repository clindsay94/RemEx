# RemEx Host — systemd SYSTEM service (headless command agent)
# Installed to /etc/systemd/system/remex-host.service by install.sh (requires root).
# Manage with:  sudo systemctl {start,stop,status,restart} remex-host
#               journalctl -u remex-host -f
#
# Runs the consolidated Remex.Agent binary in headless command-agent mode (--agent) as a SYSTEM
# service, so it answers remote power commands (shutdown / restart / sleep) even while the machine
# is logged out — at the login screen, or mid-reboot. It runs as root so `systemctl poweroff` /
# `reboot` succeed with no active login session (otherwise polkit denies a logged-out request).
#
# It does NOT stream the desktop (that needs a logged-in session). When a user logs in and launches
# the GUI host, the GUI takes over the canonical port via the RemExHostControl pipe and this agent
# yields its web host; the agent reclaims the port when the GUI exits. (Clean SCM-style stop is
# handled by the generic host: SIGTERM here, Windows SCM on Windows.)

[Unit]
Description=RemEx Host — headless remote command agent
Documentation=https://github.com/clindsay94/remex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=REMEX_INSTALL_DIR/Remex.Agent --agent
Restart=on-failure
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
