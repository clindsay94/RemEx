<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Brand Lightning Bolt (⚡) with Electric Orange/Gold Gradient -->
    <path
        android:pathData="M31.5,9.0 V58.5 H45.0 V99.0 L76.5,45.0 H58.5 L76.5,9.0 H31.5 Z"
        android:fillType="nonZero">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31.5"
                android:startY="9.0"
                android:endX="76.5"
                android:endY="99.0"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFD700" /> <!-- Electric Gold -->
                <item android:offset="0.5" android:color="#FFFF8C00" /> <!-- Dark Orange -->
                <item android:offset="1.0" android:color="#FFFF4500" /> <!-- Neon Red-Orange -->
            </gradient>
        </aapt:attr>
    </path>
    
    <!-- Outer Gloss / Drop Shadow effect for Depth -->
    <path
        android:pathData="M31.5,9.0 V58.5 H45.0 V99.0 L76.5,45.0 H58.5 L76.5,9.0 H31.5 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#50FFFFFF" />
</vector>