<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemEx"
        android:extractNativeLibs="false"
        android:localeConfig="@xml/locales_config">

        <!-- Service for backwards compatibility of per-app languages -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RemEx">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget: Remote Control -->
        <receiver
            android:name=".widget.RemoteControlWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_remote_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_control_widget_info" />
        </receiver>

        <activity
            android:name=".widget.RemoteControlConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.RemEx" />

        <!-- Widget: Hardware Info -->
        <receiver
            android:name=".widget.HardwareInfoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_hardware_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hardware_info_widget_info" />
        </receiver>

        <activity
            android:name=".widget.HardwareInfoConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.RemEx" />

        <!-- Widget: App Launcher -->
        <receiver
            android:name=".widget.AppLauncherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_launcher_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/app_launcher_widget_info" />
        </receiver>

        <activity
            android:name=".widget.AppLauncherConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.RemEx" />

        <!-- Foreground service for keeping connection alive -->
        <service
            android:name=".service.RemexConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>