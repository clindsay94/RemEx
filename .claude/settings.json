{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/scripts/beads-context.ps1\"",
            "timeout": 20,
            "type": "command"
          },
          {
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/scripts/check-mcp-health.ps1\" -Hook -Quick",
            "timeout": 20,
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/guard_edit.py\"",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  }
}
