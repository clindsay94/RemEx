{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/guard_edit.py\"",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ]
  }
}
