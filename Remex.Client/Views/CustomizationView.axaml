<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:models="using:Remex.Client.Models"
    xmlns:local="clr-namespace:Remex.Client.Converters" x:Class="Remex.Client.Views.CustomizationView" x:DataType="vm:CustomizationViewModel">

    <UserControl.Styles>
        <Style Selector="Button.accent-picker">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.accent-picker:pointerover">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" Spacing="24">

            <!-- ═══ Header ═══ -->
            <Button Content="{local:Localize Custom_Back}" Command="{Binding NavigateBackCommand}" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" FontWeight="SemiBold" Padding="0" BorderThickness="0" Cursor="Hand"/>
            <StackPanel Spacing="4">
                <TextBlock Text="{local:Localize Custom_Header}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{local:Localize Custom_Subheader}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="3"/>
            </StackPanel>

            <!-- ═══ Section 1: Presets ═══ -->
            <TextBlock Text="{local:Localize Custom_BasePresets}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
            <UniformGrid Columns="5">
                <!-- Dynamic -->
                <Button Classes="theme-tile" Margin="4" Padding="16" Command="{Binding SelectThemeCommand}" CommandParameter="Dynamic" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=Dynamic}">
                    <StackPanel Spacing="8">
                        <Border Height="40" CornerRadius="20" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="#6C4CFF" />
                                    <GradientStop Offset="0.5" Color="#00F3FF" />
                                    <GradientStop Offset="1" Color="#FF00FF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock Text="{local:Localize Custom_PresetDynamic}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <!-- Base Dark Glass -->
                <Button Classes="theme-tile" Margin="4" Padding="16" Command="{Binding SelectThemeCommand}" CommandParameter="BaseDarkGlass" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=BaseDarkGlass}">
                    <StackPanel Spacing="8">
                        <Border Height="40" Background="#1AFFFFFF" CornerRadius="8" BorderBrush="#2AFFFFFF" BorderThickness="1"/>
                        <TextBlock Text="{local:Localize Custom_PresetStandardGlass}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <!-- Cyber-NOC -->
                <Button Classes="theme-tile" Margin="4" Padding="16" Command="{Binding SelectThemeCommand}" CommandParameter="CyberNOC" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=CyberNOC}">
                    <StackPanel Spacing="8">
                        <Border Height="40" Background="#050505" CornerRadius="2" BorderBrush="#00F3FF" BorderThickness="1"/>
                        <TextBlock Text="{local:Localize Custom_PresetCyberNOC}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <!-- Solar-Flare -->
                <Button Classes="theme-tile" Margin="4" Padding="16" Command="{Binding SelectThemeCommand}" CommandParameter="SolarFlare" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=SolarFlare}">
                    <StackPanel Spacing="8">
                        <Border Height="40" Background="#CCFFFFFF" CornerRadius="12" BorderBrush="#FFB800" BorderThickness="1"/>
                        <TextBlock Text="{local:Localize Custom_PresetSolarFlare}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <!-- Monolith -->
                <Button Classes="theme-tile" Margin="4" Padding="16" Command="{Binding SelectThemeCommand}" CommandParameter="Monolith" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=Monolith}">
                    <StackPanel Spacing="8">
                        <Border Height="40" Background="#2C2C2E" CornerRadius="4" BorderBrush="#444" BorderThickness="3"/>
                        <TextBlock Text="{local:Localize Custom_PresetMonolith}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ═══ Section 2: Advanced Overrides ═══ -->
            <Border Classes="glass-card" Padding="24">
                <StackPanel Spacing="20">
                    <TextBlock Text="{local:Localize Custom_AdvancedTuning}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                    <Grid ColumnDefinitions="*,2*" ToolTip.Tip="Customize default border corner roundedness for general dashboard cards and panels">
                        <TextBlock Text="{local:Localize Custom_CornerRadius}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Slider Minimum="0" Maximum="32" Value="{Binding CornerRadius}" Width="200" VerticalAlignment="Center" ToolTip.Tip="Border corner radius in pixels"/>
                                <Grid ColumnDefinitions="*,*" Width="200">
                                    <TextBlock Text="Square" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="Round" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding CornerRadius, StringFormat={}{0:F0}px}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,2*" ToolTip.Tip="Customize border corner roundedness specifically for remote control action keys">
                        <TextBlock Text="{local:Localize Custom_RemoteCardShape}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Slider Minimum="0" Maximum="48" Value="{Binding RemoteCardCornerRadius}" Width="200" VerticalAlignment="Center" ToolTip.Tip="Remote button corner radius in pixels"/>
                            <TextBlock Text="{Binding RemoteCardCornerRadius, StringFormat={}{0:F0}px}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,2*" ToolTip.Tip="Adjust visual opacity blend level of premium glassmorphism background effect">
                        <TextBlock Text="{local:Localize Custom_GlassOpacity}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Slider Minimum="0.01" Maximum="1.0" Value="{Binding GlassOpacity}" Width="200" VerticalAlignment="Center" ToolTip.Tip="Glass frosting opacity percentage"/>
                                <Grid ColumnDefinitions="*,*" Width="200">
                                    <TextBlock Text="Clear" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="Frosted" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding GlassOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,2*" ToolTip.Tip="Adjust background accent neon aura glow intensity around panel edges">
                        <TextBlock Text="{local:Localize Custom_GlowStrength}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <Slider Minimum="0" Maximum="30" Value="{Binding GlowStrength}" Width="200" VerticalAlignment="Center" ToolTip.Tip="Neon glow thickness/spread in pixels"/>
                                <Grid ColumnDefinitions="*,*" Width="200">
                                    <TextBlock Text="None" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Column="1" Text="Intense" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                            <TextBlock Text="{Binding GlowStrength, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource CardBorderBrush}" Opacity="0.3"/>

                    <Grid ColumnDefinitions="*,2*" ToolTip.Tip="Select color palette theme highlights">
                        <TextBlock Text="{local:Localize Custom_AccentColor}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <Button Classes="accent-picker" Background="#6C4CFF" Command="{Binding SetAccentCommand}" CommandParameter="#6C4CFF" ToolTip.Tip="Select Neon Violet accent color theme"/>
                            <Button Classes="accent-picker" Background="#00F3FF" Command="{Binding SetAccentCommand}" CommandParameter="#00F3FF" ToolTip.Tip="Select Cyber Cyan accent color theme"/>
                            <Button Classes="accent-picker" Background="#FF00FF" Command="{Binding SetAccentCommand}" CommandParameter="#FF00FF" ToolTip.Tip="Select Hot Pink/Magenta accent color theme"/>
                            <Button Classes="accent-picker" Background="#FFB800" Command="{Binding SetAccentCommand}" CommandParameter="#FFB800" ToolTip.Tip="Select Solar Gold/Amber accent color theme"/>
                            <Button Classes="accent-picker" Background="#22C55E" Command="{Binding SetAccentCommand}" CommandParameter="#22C55E" ToolTip.Tip="Select Emerald Green accent color theme"/>
                            <Button Classes="accent-picker" Background="#F43F5E" Command="{Binding SetAccentCommand}" CommandParameter="#F43F5E" ToolTip.Tip="Select Crimson Rose accent color theme"/>

                            <!-- Saved custom swatches -->
                            <ItemsControl ItemsSource="{Binding CustomAccentColors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="accent-picker" Background="{Binding}" Command="{Binding $parent[UserControl].DataContext.SetAccentCommand}" CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- + button to open custom hex input -->
                            <Button Width="24" Height="24" CornerRadius="12" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Content="+" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenCustomAccentPickerCommand}" ToolTip.Tip="Add custom colour">
                                <Button.Flyout>
                                    <Flyout IsOpen="{Binding IsCustomAccentPickerOpen}" Placement="Bottom">
                                        <StackPanel Spacing="8" Width="180" Margin="4">
                                            <TextBlock Text="Custom accent colour" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBox Text="{Binding CustomAccentHex}" Watermark="#RRGGBB" FontFamily="Consolas, monospace" FontSize="12" MaxLength="9" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="6" Padding="8,5"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                                <Button Content="Cancel" Command="{Binding CloseCustomAccentPickerCommand}" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" Padding="8,4" FontSize="12" CornerRadius="6"/>
                                                <Button Content="Apply" Command="{Binding ConfirmCustomAccentCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="8,4" FontSize="12" FontWeight="SemiBold" CornerRadius="6"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Section 3: Atmosphere ═══ -->
            <Border Classes="glass-card" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="{local:Localize Custom_Atmosphere}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                    <Grid ColumnDefinitions="*,2*">
                        <TextBlock Text="{local:Localize Custom_BackgroundMode}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding CanvasBackgroundType}" ItemsSource="{Binding AvailableBackgroundTypes}" HorizontalAlignment="Left" Width="200"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,2*" IsVisible="{Binding IsGlassModeSelected}">
                        <TextBlock Text="{local:Localize Custom_AppWindowOpacity}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Slider Minimum="0.1" Maximum="1.0" Value="{Binding AppWindowOpacity}" Width="200" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AppWindowOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,2*">
                        <TextBlock Text="Scheme Variant" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding SchemeVariant}" ItemsSource="{Binding AvailableSchemeVariants}" HorizontalAlignment="Left" Width="200"/>
                    </Grid>

                    <Separator Background="{DynamicResource CardBorderBrush}" Opacity="0.3"/>

                    <!-- Hardware Sync -->
                    <Grid ColumnDefinitions="*,2*">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Hardware Sync" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Sync accent color with physical RGB" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SyncWithHardware}" OnContent="On" OffContent="Off" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="{local:Localize Custom_Reset}" Command="{Binding ResetToDefaultCommand}" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>
