<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:local="clr-namespace:Remex.Client.Converters"
    x:Class="Remex.Client.Views.RemoteView" x:DataType="vm:RemoteViewModel">

    <UserControl.Styles>
        <Style Selector="Button.remote-btn">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource RemoteCardCornerRadius}"/>
            <Setter Property="Padding" Value="20 16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.remote-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
        </Style>
        <Style Selector="Button.remote-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.remote-btn-danger">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemError}" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource SystemError}"/>
            <Setter Property="BorderBrush" Value="#40FF6B6B"/>
        </Style>
        <Style Selector="Button.remote-btn-danger:pointerover">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemError}" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.remote-btn-warn">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemWarning}" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource SystemWarning}"/>
            <Setter Property="BorderBrush" Value="#40FFD93D"/>
        </Style>
        <Style Selector="Button.remote-btn-warn:pointerover">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource SystemWarning}" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="20">

            <!-- ═══ Header ═══ -->
            <StackPanel Spacing="4">
                <TextBlock Text="{local:Localize Remote_Header}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{local:Localize Remote_Subheader}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="3"/>
            </StackPanel>

            <!-- ═══ Wake on LAN ═══ -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="{local:Localize Remote_WolSection}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
                    <TextBlock Text="{local:Localize Remote_WolDescription}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                    <TextBox Text="{Binding WolMacAddress}" Watermark="{local:Localize Remote_WolMacWatermark}"
                             Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                             BorderBrush="{DynamicResource CardBorderBrush}"
                             CornerRadius="8" Padding="10,8" FontSize="12"
                             FontFamily="Consolas, monospace"/>

                    <Grid ColumnDefinitions="*,Auto" Margin="0">
                        <TextBox Grid.Column="0" Text="{Binding WolBroadcastIp}"
                                 Watermark="{local:Localize Remote_WolBroadcastWatermark}"
                                 Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                 BorderBrush="{DynamicResource CardBorderBrush}"
                                 CornerRadius="8" Padding="10,8" FontSize="12"
                                 FontFamily="Consolas, monospace" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding WolPort}" Width="80"
                                 Watermark="{local:Localize Remote_WolPortWatermark}" Background="{DynamicResource GlassBaseDarkBrush}" 
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="8" 
                                 Padding="10,8" FontSize="12" FontFamily="Consolas, monospace"/>
                    </Grid>

                    <Button Classes="remote-btn" Content="{local:Localize Remote_WolSend}"
                            Command="{Binding SendWolCommand}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding WolStatusText}" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding WolStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Border>

            <!-- ═══ Graceful Controls ═══ -->
            <TextBlock Text="{local:Localize Remote_Graceful}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
            <UniformGrid Columns="2" Rows="3" IsEnabled="{Binding Connection.IsConnected}">
                <Button Classes="remote-btn" Content="{local:Localize Remote_Lock}" Command="{Binding LockPcCommand}" Margin="0,0,4,4"/>
                <Button Classes="remote-btn" Content="{local:Localize Remote_SignOut}" Command="{Binding SignOutPcCommand}" Margin="4,0,0,4"/>
                <Button Classes="remote-btn remote-btn-warn" Content="{local:Localize Remote_Shutdown}" Command="{Binding ShutdownPcCommand}" Margin="0,4,4,0"/>
                <Button Classes="remote-btn remote-btn-warn" Content="{local:Localize Remote_Restart}" Command="{Binding RestartPcCommand}" Margin="4,4,0,0"/>
                <Button Classes="remote-btn" Content="{local:Localize Remote_Sleep}" Command="{Binding SleepPcCommand}" Margin="0,8,4,0"/>
                <Button Classes="remote-btn" Content="{local:Localize Remote_Hibernate}" Command="{Binding HibernatePcCommand}" Margin="4,8,0,0"/>
            </UniformGrid>

            <!-- ═══ Forced Controls ═══ -->
            <TextBlock Text="{local:Localize Remote_Forced}" FontSize="11" FontWeight="SemiBold" Foreground="#FF6B6B" LetterSpacing="2"/>
            <UniformGrid Columns="2" Rows="2" IsEnabled="{Binding Connection.IsConnected}">
                <Button Classes="remote-btn remote-btn-danger" Content="{local:Localize Remote_ForceShutdown}" Command="{Binding ForceShutdownPcCommand}" Margin="0,0,4,4"/>
                <Button Classes="remote-btn remote-btn-danger" Content="{local:Localize Remote_ForceRestart}" Command="{Binding ForceRestartCommand}" Margin="4,0,0,4"/>
                <Button Classes="remote-btn remote-btn-danger" Content="{local:Localize Remote_RebootUefi}" Command="{Binding RestartToUefiCommand}" Margin="0,4,4,0"/>
                <Border Margin="4,4,0,0" Background="Transparent"/>
            </UniformGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
