<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:models="using:Remex.Core.Models"
    xmlns:local="clr-namespace:Remex.Client.Converters" x:Class="Remex.Client.Views.FileTransferView" x:DataType="vm:FileTransferViewModel">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.action-btn:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,24">

        <!-- ═══ HEADER ═══ -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{local:Localize FileTransfer_Header}" FontFamily="{StaticResource Bungee_Shade}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource AccentPrimaryBrush}"/>
            <TextBlock Text="{local:Localize FileTransfer_Subheader}" FontFamily="{StaticResource Sixtyfour}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2.0"/>
        </StackPanel>

        <!-- ═══ REMOTE BROWSER ═══ -->
        <Border Grid.Row="1" Classes="glass-card" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <!-- Row 0: Shared folder selector + remove root -->
                <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource GlassBaseDarkBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{local:Localize FileTransfer_SharedFolderLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding RemoteRoots}" SelectedItem="{Binding SelectedRemoteRoot}" MinWidth="220" HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="models:FileSharedRoot">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{local:Localize FileTransfer_ReadOnly}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsWritable}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="2" Content="✕" Classes="icon-btn" Command="{Binding RemoveCurrentRootCommand}" ToolTip.Tip="{local:Localize FileTransfer_RemoveRootTooltip}" Margin="4,0,0,0"/>
                        <Button Grid.Column="3" Content="↺" Classes="icon-btn" Command="{Binding LoadRemoteRootsCommand}" ToolTip.Tip="{local:Localize FileTransfer_ReloadTooltip}" Margin="4,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Row 1: Path breadcrumb + pin + navigation -->
                <Border Grid.Row="1" Padding="12,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource GlassBaseDarkBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{local:Localize FileTransfer_PathLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding RemotePath}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Content="📌" Classes="icon-btn" Command="{Binding PinCurrentFolderCommand}" ToolTip.Tip="{local:Localize FileTransfer_PinFolderTooltip}" Margin="4,0,0,0"/>
                        <Button Grid.Column="3" Content="↑" Classes="icon-btn" Command="{Binding NavigateRemoteUpCommand}" ToolTip.Tip="{local:Localize FileTransfer_UpTooltip}" Margin="4,0,0,0"/>
                        <Button Grid.Column="4" Content="↺" Classes="icon-btn" Command="{Binding BrowseRemoteCommand}" ToolTip.Tip="{local:Localize FileTransfer_RefreshTooltip}" Margin="4,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Row 2: Action bar — normal mode -->
                <Border Grid.Row="2" Padding="12,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource GlassBaseDarkBrush}" IsVisible="{Binding !IsRenaming}">
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="{local:Localize FileTransfer_UploadBtn}" Classes="action-btn" Command="{Binding UploadCommand}" ToolTip.Tip="{local:Localize FileTransfer_UploadTooltip}"/>
                        <Button Content="{local:Localize FileTransfer_DownloadBtn}" Classes="action-btn" Command="{Binding DownloadCommand}" Margin="8,0,0,0" ToolTip.Tip="{local:Localize FileTransfer_DownloadTooltip}"/>
                        <Button Content="{local:Localize FileTransfer_OpenFolderBtn}" Classes="action-btn" Command="{Binding OpenSelectedRemoteCommand}" Margin="8,0,0,0" ToolTip.Tip="{local:Localize FileTransfer_OpenFolderTooltip}"/>
                        <Button Content="{local:Localize FileTransfer_RenameBtn}" Classes="action-btn" Command="{Binding StartRenameCommand}" Margin="8,0,0,0" ToolTip.Tip="{local:Localize FileTransfer_RenameTooltip}"/>
                        <Button Content="{local:Localize FileTransfer_DeleteBtn}" Classes="action-btn" Command="{Binding DeleteRemoteCommand}" Margin="8,0,0,0" Background="{DynamicResource SystemErrorBackgroundBrush}" Foreground="{DynamicResource SystemErrorBrush}" ToolTip.Tip="{local:Localize FileTransfer_DeleteTooltip}"/>
                        <Button Content="{local:Localize FileTransfer_SelectAllBtn}" Classes="action-btn" Command="{Binding SelectAllCommand}" Margin="8,0,0,0" ToolTip.Tip="{local:Localize FileTransfer_SelectAllTooltip}"/>
                        <Button Content="{local:Localize FileTransfer_VerifyHashBtn}" Classes="action-btn" Command="{Binding VerifyHashCommand}" Margin="8,0,0,0" ToolTip.Tip="{local:Localize FileTransfer_VerifyHashTooltip}"/>
                        <Button Content="{local:Localize Btn_Cancel}" Classes="action-btn" Command="{Binding CancelCommand}" Margin="8,0,0,0" Background="{DynamicResource SystemErrorBackgroundBrush}" Foreground="{DynamicResource SystemErrorBrush}" ToolTip.Tip="{local:Localize FileTransfer_CancelTooltip}"/>
                    </WrapPanel>
                </Border>

                <!-- Row 2: Action bar — rename mode -->
                <Border Grid.Row="2" Padding="12,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource GlassBaseDarkBrush}" IsVisible="{Binding IsRenaming}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{local:Localize FileTransfer_RenameInputPlaceholder}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding RenameInputText}" Watermark="{local:Localize FileTransfer_RenameInputPlaceholder}" FontSize="12" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Padding="8,4"/>
                        <Button Grid.Column="2" Content="{local:Localize FileTransfer_RenameConfirmBtn}" Classes="action-btn" Command="{Binding ConfirmRenameCommand}" Margin="8,0,0,0"/>
                        <Button Grid.Column="3" Content="{local:Localize FileTransfer_RenameCancelBtn}" Classes="action-btn" Command="{Binding CancelRenameCommand}" Margin="8,0,0,0" Background="{DynamicResource SystemErrorBackgroundBrush}" Foreground="{DynamicResource SystemErrorBrush}"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="3">
                    <TextBlock Text="{local:Localize FileTransfer_Loading}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}"/>

                    <ListBox x:Name="RemoteFileList" ItemsSource="{Binding RemoteEntries}" SelectedItem="{Binding SelectedRemoteEntry}" SelectionMode="Multiple" Background="Transparent" BorderThickness="0" IsVisible="{Binding !IsLoading}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FileEntry">
                                <Border Background="Transparent" Padding="12,8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding IsDirectory, Converter={x:Static local:BoolToStringConverter.Instance}, ConverterParameter=📁|📄}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={x:Static local:BytesToHumanReadableConverter.Instance}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsDirectory}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ STATUS / PROGRESS ═══ -->
        <Border Grid.Row="2" Classes="glass-card" Padding="16,12" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,Auto,Auto">
                <!-- Progress bar -->
                <ProgressBar Grid.Row="0" Value="{Binding TransferProgress}" Minimum="0" Maximum="100" Height="6" CornerRadius="3" Margin="0,0,0,8" IsVisible="{Binding IsTransferring}"/>
                <!-- Status line -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding TransferProgress, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding IsTransferring}" Margin="8,0,0,0"/>
                </Grid>
                <!-- SHA-256 hash result -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,6,0,0" IsVisible="{Binding HasVerifiedHash}">
                    <TextBlock Grid.Column="0" Text="{local:Localize FileTransfer_HashLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <SelectableTextBlock Grid.Column="1" Text="{Binding VerifiedHash}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
