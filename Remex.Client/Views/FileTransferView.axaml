<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:models="using:Remex.Core.Models"
    xmlns:local="clr-namespace:Remex.Client.Converters"
    x:Class="Remex.Client.Views.FileTransferView"
    x:DataType="vm:FileTransferViewModel">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.action-btn:disabled">
            <Setter Property="Opacity" Value="0.4"/>
        </Style>
        <Style Selector="Button.icon-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.icon-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20,24,24">

        <!-- ═══ HEADER ═══ -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="FILE TRANSFER" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="SECURE · CHUNKED · SHA-256 VERIFIED" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="3"/>
        </StackPanel>

        <!-- ═══ TWO-COLUMN BROWSER ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">

            <!-- ── LOCAL PANEL ── -->
            <Border Grid.Column="0" Classes="glass-card" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <!-- Path bar -->
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource GlassBaseDarkBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="💻" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding LocalPath}" FontSize="11" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button Grid.Column="2" Content="↺" Classes="icon-btn" Command="{Binding RefreshLocalCommand}" ToolTip.Tip="Refresh local" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- File list -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding LocalEntries}" SelectedItem="{Binding SelectedLocalEntry}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FileEntry">
                                <Border Background="Transparent" Padding="12,8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding IsDirectory, Converter={x:Static local:BoolToStringConverter.Instance}, ConverterParameter=📁|📄}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={x:Static local:BytesToHumanReadableConverter.Instance}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsDirectory}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ── MIDDLE CONTROLS ── -->
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" Margin="12,0">
                <Button Content="→" Classes="action-btn" Command="{Binding UploadCommand}" ToolTip.Tip="Upload selected file to remote" FontSize="18"/>
                <Button Content="←" Classes="action-btn" Command="{Binding DownloadCommand}" ToolTip.Tip="Download selected file to local" FontSize="18"/>
                <Button Content="✕" Classes="action-btn" Command="{Binding CancelCommand}" ToolTip.Tip="Cancel transfer"
                        Background="#3A1A1A" Foreground="#FF6B6B"/>
            </StackPanel>

            <!-- ── REMOTE PANEL ── -->
            <Border Grid.Column="2" Classes="glass-card" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <!-- Path bar -->
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Background="{DynamicResource GlassBaseDarkBrush}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="🖥" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding RemotePath}" FontSize="11" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button Grid.Column="2" Content="↺" Classes="icon-btn" Command="{Binding BrowseRemoteCommand}" ToolTip.Tip="Refresh remote" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Loading indicator -->
                    <TextBlock Grid.Row="1" Text="Loading…" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoading}"/>

                    <!-- File list -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding RemoteEntries}" SelectedItem="{Binding SelectedRemoteEntry}" Background="Transparent" BorderThickness="0" IsVisible="{Binding !IsLoading}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FileEntry">
                                <Border Background="Transparent" Padding="12,8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding IsDirectory, Converter={x:Static local:BoolToStringConverter.Instance}, ConverterParameter=📁|📄}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeBytes, Converter={x:Static local:BytesToHumanReadableConverter.Instance}}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsDirectory}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ STATUS / PROGRESS ═══ -->
        <Border Grid.Row="2" Classes="glass-card" Padding="16,12" Margin="0,12,0,0">
            <Grid RowDefinitions="Auto,Auto">
                <!-- Progress bar -->
                <ProgressBar Grid.Row="0" Value="{Binding TransferProgress}" Minimum="0" Maximum="100" Height="6" CornerRadius="3" Margin="0,0,0,8" IsVisible="{Binding IsTransferring}"/>
                <!-- Status line -->
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding TransferProgress, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" IsVisible="{Binding IsTransferring}" Margin="8,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

    </Grid>
</UserControl>
