<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:controls="using:Remex.Client.Controls"
    xmlns:local="clr-namespace:Remex.Client.Converters"
    x:Class="Remex.Client.Views.RemoteDesktopView" x:DataType="vm:RemoteDesktopViewModel"
    Focusable="True">

    <UserControl.Styles>
        <Style Selector="Button.rd-btn">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16 8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.rd-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>
        <Style Selector="Button.rd-btn-start">
            <Setter Property="Background" Value="#1A3A1A"/>
            <Setter Property="Foreground" Value="#6BFF6B"/>
        </Style>
        <Style Selector="Button.rd-btn-start:pointerover">
            <Setter Property="Background" Value="#2A4A2A"/>
        </Style>
        <Style Selector="Button.rd-btn-stop">
            <Setter Property="Background" Value="#3A1A1A"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
        </Style>
        <Style Selector="Button.rd-btn-stop:pointerover">
            <Setter Property="Background" Value="#4A2A2A"/>
        </Style>

        <!-- Animation for the remote cursor crosshair -->
        <Style Selector="Path.cursor-crosshair">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ═══ TOOLBAR ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource GlassBaseDarkBrush}" Padding="16 8" IsVisible="{Binding !IsFullScreen}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Stream controls -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="{local:Localize Btn_Start}" Command="{Binding StartStreamCommand}" Classes="rd-btn rd-btn-start" IsVisible="{Binding !IsStreaming}"/>
                    <Button Content="{local:Localize Btn_Stop}" Command="{Binding StopStreamCommand}" Classes="rd-btn rd-btn-stop" IsVisible="{Binding IsStreaming}"/>
                </StackPanel>

                <!-- Center: Title -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{local:Localize RemoteDesktop_Header}" FontSize="14" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{local:Localize RemoteDesktop_Quality}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <Slider Minimum="10" Maximum="100" Value="{Binding Quality}" Width="80" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Quality, StringFormat={}{0}%}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Width="32" VerticalAlignment="Center"/>

                    <Border Width="1" Height="20" Background="{DynamicResource CardBorderBrush}"/>

                    <TextBlock Text="{local:Localize RemoteDesktop_Scale}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox SelectedIndex="{Binding SelectedScaleIndex}" MinWidth="60" FontSize="11" VerticalAlignment="Center">
                        <ComboBoxItem Content="25%" Tag="0.25"/>
                        <ComboBoxItem Content="50%" Tag="0.5"/>
                        <ComboBoxItem Content="75%" Tag="0.75"/>
                        <ComboBoxItem Content="100%" Tag="1.0"/>
                    </ComboBox>

                    <Border Width="1" Height="20" Background="{DynamicResource CardBorderBrush}"/>

                    <TextBlock Text="{local:Localize RemoteDesktop_Fps}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    <ComboBox SelectedIndex="{Binding SelectedFpsIndex}" MinWidth="55" FontSize="11" VerticalAlignment="Center">
                        <ComboBoxItem Content="5" Tag="5"/>
                        <ComboBoxItem Content="10" Tag="10"/>
                        <ComboBoxItem Content="15" Tag="15"/>
                        <ComboBoxItem Content="20" Tag="20"/>
                        <ComboBoxItem Content="30" Tag="30"/>
                        <ComboBoxItem Content="60" Tag="60"/>
                        <ComboBoxItem Content="120" Tag="120"/>
                        <ComboBoxItem Content="240" Tag="240"/>
                        <ComboBoxItem Content="360" Tag="360"/>
                    </ComboBox>

                    <Button Content="{local:Localize Btn_Apply}" Command="{Binding ApplySettingsCommand}" Classes="rd-btn" Margin="4,0,0,0"/>

                    <Border Width="1" Height="20" Background="{DynamicResource CardBorderBrush}"/>

                    <Button Content="{local:Localize RemoteDesktop_ToggleCursorPad}" Command="{Binding ToggleCursorPadCommand}" Classes="rd-btn"
                            ToolTip.Tip="{local:Localize RemoteDesktop_ToggleCursorPadTip}" FontSize="11" Padding="10 6"/>

                    <Button Content="{Binding CursorPadModeText}" Command="{Binding ToggleCompactCursorPadCommand}" Classes="rd-btn"
                            ToolTip.Tip="{local:Localize RemoteDesktop_SwitchPadModeTip}" FontSize="11" Padding="10 6"/>

                    <Button Content="{local:Localize RemoteDesktop_TogglePen}" Command="{Binding ToggleStylusModeCommand}" Classes="rd-btn"
                            ToolTip.Tip="{local:Localize RemoteDesktop_StylusModeTip}" FontSize="11" Padding="10 6"/>

                    <Button Content="{local:Localize RemoteDesktop_ToggleFullscreen}" Command="{Binding ToggleFullScreenCommand}" Classes="rd-btn"
                            ToolTip.Tip="{local:Localize RemoteDesktop_ToggleFullscreenTip}" FontSize="11" Padding="10 6"/>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- ═══ CONNECTION / AUTH PANEL (collapsible, below toolbar) ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource GlassBaseDarkBrush}" 
                Padding="16,10" IsVisible="{Binding ShowConnectionPanel}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto">
                <TextBlock Text="{local:Localize RemoteDesktop_Host}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" 
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding Connection.HostAddress}" 
                         Background="{DynamicResource CardBackgroundBrush}" 
                         Foreground="{DynamicResource TextPrimaryBrush}" 
                         BorderBrush="{DynamicResource CardBorderBrush}"
                         CornerRadius="6" Padding="8,5" FontSize="11" 
                         FontFamily="Consolas, monospace" Watermark="{local:Localize RemoteDesktop_HostWatermark}"
                         IsEnabled="{Binding !IsStreaming}"/>
                <Button Grid.Column="2" Content="{local:Localize Btn_Save}" Classes="rd-btn" FontSize="11" Padding="10 5" Margin="8,0,0,0" 
                        Command="{Binding SaveConnectionCommand}"/>
            </Grid>
        </Border>

        <!-- ═══ VIEWPORT ═══ -->
        <Border x:Name="ViewportBorder" Grid.Row="2" Background="{DynamicResource GlassBaseDarkBrush}" ClipToBounds="True"
                Gestures.IsHoldingEnabled="True"
                Holding="OnViewportHolding">
            <Panel>
                <!-- Placeholder shown when not streaming -->
                <StackPanel IsVisible="{Binding !IsStreaming}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="D" FontSize="64" HorizontalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Black"/>
                    <TextBlock Text="{local:Localize RemoteDesktop_PlaceholderTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{local:Localize RemoteDesktop_PlaceholderHint}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RemoteDesktopCapabilityText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource SystemErrorBrush}" HorizontalAlignment="Center" 
                               Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="500"/>
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="14,10" Margin="0,8,0,0" MaxWidth="500">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{local:Localize RemoteDesktop_TouchHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{local:Localize RemoteDesktop_StylusHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{local:Localize RemoteDesktop_PenModeHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- TRANSFORM CONTAINER (Shared for Image and Indicators) -->
                <Panel x:Name="TransformContainer" IsVisible="{Binding IsStreaming}" RenderTransformOrigin="0%,0%">
                    <Panel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Panel.RenderTransform>

                    <!-- Screen image -->
                    <Image x:Name="ScreenImage"
                           Source="{Binding CurrentFrame}"
                           Stretch="Uniform"
                           RenderTransformOrigin="0%,0%"
                           Cursor="Cross"/>

                    <!-- Remote Cursor Indicator Crosshair (Stays locked to content) -->
                    <Canvas IsHitTestVisible="False">
                        <Path Data="M -15 0 L 15 0 M 0 -15 L 0 15"
                              Classes="cursor-crosshair"
                              Stroke="{DynamicResource AccentPrimaryBrush}"
                              StrokeThickness="1.5"
                              Opacity="{Binding IsCursorVisible, Converter={StaticResource BoolToDoubleConverter}, ConverterParameter='1.0|0.0'}"
                              Canvas.Left="{Binding CursorIndicatorX}"
                              Canvas.Top="{Binding CursorIndicatorY}"/>
                        
                        <!-- Outer Target Circle -->
                        <Ellipse Width="30" Height="30" 
                                 Stroke="{DynamicResource AccentPrimaryBrush}" 
                                 StrokeThickness="1" 
                                 Opacity="0.4"
                                 IsHitTestVisible="False"
                                 Canvas.Left="{Binding CursorIndicatorX}" 
                                 Canvas.Top="{Binding CursorIndicatorY}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="-15" Y="-15"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Canvas>
                </Panel>

                <!-- Error overlay (shown during streaming when no frames arrive) -->
                <Border IsVisible="{Binding HasStreamError}"
                        Background="{DynamicResource GlassBaseMediumBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        CornerRadius="12" Padding="24,16" MaxWidth="520">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{local:Localize RemoteDesktop_StreamError}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SystemErrorBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Fullscreen floating buttons -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding IsFullScreen}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0">
                    <Button Content="{local:Localize RemoteDesktop_Pad}" Command="{Binding ToggleCompactCursorPadCommand}"
                        Opacity="0.7" CornerRadius="8" Padding="10 6"
                        FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                        ToolTip.Tip="{local:Localize RemoteDesktop_ToggleCompactPadTip}"
                        Background="{DynamicResource GlassBaseMediumBrush}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{local:Localize RemoteDesktop_TogglePen}" Command="{Binding ToggleStylusModeCommand}"
                            Opacity="0.7" CornerRadius="8" Padding="10 6"
                            FontSize="12" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                            ToolTip.Tip="{local:Localize RemoteDesktop_ToggleStylusModeTip}"
                            Background="{DynamicResource GlassBaseMediumBrush}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Button Content="{local:Localize RemoteDesktop_Fullscreen}" Command="{Binding ToggleFullScreenCommand}"
                            Opacity="0.7"
                            Background="{DynamicResource GlassBaseMediumBrush}" Foreground="{DynamicResource TextSecondaryBrush}" CornerRadius="8"
                            Padding="10 6" FontSize="14" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                            ToolTip.Tip="{local:Localize RemoteDesktop_ExitFullscreenTip}"/>
                </StackPanel>

                <!-- Virtual cursor pad (floating, togglable) -->
                <controls:VirtualCursorPad x:Name="CursorPad"
                    IsVisible="{Binding ShowCursorPad}"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="{Binding CursorPadMargin}" Opacity="0.85"
                    RenderTransformOrigin="100%,100%">
                    <controls:VirtualCursorPad.RenderTransform>
                        <ScaleTransform ScaleX="{Binding CursorPadScale}" ScaleY="{Binding CursorPadScale}"/>
                    </controls:VirtualCursorPad.RenderTransform>
                </controls:VirtualCursorPad>

                <!-- Reset zoom hint (shown when zoomed in) -->
                <Button Content="{local:Localize RemoteDesktop_ResetZoom}" Command="{Binding ResetZoomCommand}"
                        IsVisible="{Binding IsViewportZoomed}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,8,0,0" Opacity="0.7"
                        Background="{DynamicResource GlassBaseMediumBrush}" Foreground="{DynamicResource TextSecondaryBrush}" CornerRadius="8"
                        Padding="12 6" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            </Panel>
        </Border>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="3" Background="{DynamicResource GlassBaseDarkBrush}" Padding="16 6" IsVisible="{Binding !IsFullScreen}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Resolution, StringFormat=Resolution: {0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0"/>
                <TextBlock Grid.Column="2" Text="{Binding ActualFps, StringFormat=FPS: {0:F1}}" Foreground="{DynamicResource SystemSuccessBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0"/>
                <TextBlock Grid.Column="3" Text="{Binding Quality, StringFormat=Q: {0}}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0"/>
                <TextBlock Grid.Column="4" Text="{Binding ViewportZoomText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="16,0"
                           IsVisible="{Binding IsViewportZoomed}"/>
                <Border Grid.Column="5" Width="8" Height="8" CornerRadius="4"
                        IsVisible="{Binding IsStreaming}"
                        Background="{DynamicResource SystemSuccessBrush}"
                        VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>
    </Grid>

</UserControl>
