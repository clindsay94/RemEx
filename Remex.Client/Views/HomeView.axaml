<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:conv="using:Remex.Client.Converters"
    xmlns:ctrl="using:Remex.Client.Controls"
    xmlns:local="clr-namespace:Remex.Client.Converters"
    x:Class="Remex.Client.Views.HomeView" x:DataType="vm:HomeViewModel">

    <UserControl.Styles>
        <!-- Quick-action pill buttons -->
        <Style Selector="Button.action-pill">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.action-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
        </Style>
        <Style Selector="Button.action-pill:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.action-pill-accent">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource AccentPrimary}" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.action-pill-danger">
            <Setter Property="Foreground" Value="{DynamicResource SystemError}"/>
            <Setter Property="BorderBrush" Value="#40FF6B6B"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="28">

            <!-- ═══ HERO WELCOME SECTION ═══ -->
            <Border Classes="glass-card" Padding="0" ClipToBounds="True">
                <Grid>
                    <!-- Decorative gradient orb behind text -->
                    <Rectangle Opacity="0.12" Name="HeroGlow">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="80%,30%" RadiusX="0.5" RadiusY="0.7">
                                <GradientStop Offset="0" Color="{DynamicResource AccentPrimary}" />
                                <GradientStop Offset="1" Color="#00000000" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.Styles>
                            <Style Selector="Rectangle#HeroGlow">
                                <Style.Animations>
                                    <Animation Duration="0:0:6" IterationCount="Infinite" PlaybackDirection="Alternate">
                                        <KeyFrame KeyTime="0:0:0">
                                            <Setter Property="Opacity" Value="0.08"/>
                                        </KeyFrame>
                                        <KeyFrame KeyTime="0:0:6">
                                            <Setter Property="Opacity" Value="0.2"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Rectangle.Styles>
                    </Rectangle>

                    <StackPanel Margin="28,24,28,20" Spacing="12">
                        <!-- Brand title with accent glow -->
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom">
                                <TextBlock Text="REM" FontSize="42" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="EX" FontSize="42" FontWeight="Black" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{local:Localize Home_Subtitle}" FontSize="11" FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="4" Opacity="0.7"/>
                        </StackPanel>

                        <!-- Connection status inline -->
                        <Border CornerRadius="12" Padding="16,12" Margin="0,4,0,0"
                                Background="{DynamicResource CardBackgroundBrush}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Status indicator -->
                                    <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center"
                                            Background="{DynamicResource CardBackgroundBrush}">
                                        <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding Connection.IsConnected, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter=#22C55E|#F43F5E}"/>
                                            </Ellipse.Fill>
                                            <!-- Pulse animation for connected state -->
                                            <Ellipse.Styles>
                                                <Style Selector="Ellipse">
                                                    <Style.Animations>
                                                        <Animation Duration="0:0:2" IterationCount="Infinite" PlaybackDirection="Alternate">
                                                            <KeyFrame KeyTime="0:0:0">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </KeyFrame>
                                                            <KeyFrame KeyTime="0:0:1">
                                                                <Setter Property="Opacity" Value="1.0"/>
                                                            </KeyFrame>
                                                            <KeyFrame KeyTime="0:0:2">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </KeyFrame>
                                                        </Animation>
                                                    </Style.Animations>
                                                </Style>
                                            </Ellipse.Styles>
                                        </Ellipse>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Connection.StatusText}" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Connection.LatencyText}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                        <Button Classes="action-pill action-pill-accent" Content="{local:Localize Btn_Connect}"
                                                Command="{Binding Connection.ConnectCommand}"
                                                IsVisible="{Binding !Connection.IsConnecting}" Padding="16,8"
                                                ToolTip.Tip="{local:Localize Home_ConnectTooltip}"/>
                                        <Button Classes="action-pill action-pill-danger" Content="{local:Localize Btn_Cancel}"
                                                Command="{Binding Connection.DisconnectCommand}"
                                                IsVisible="{Binding Connection.IsConnecting}" Padding="16,8"
                                                ToolTip.Tip="{local:Localize Home_CancelTooltip}"/>
                                        <Button Classes="action-pill" Content="{local:Localize Home_QrCodeButton}"
                                                Command="{Binding Connection.GenerateQrCodeCommand}"
                                                Padding="16,8"
                                                ToolTip.Tip="{local:Localize Home_QrCodeTooltip}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- QR Code panel — visible after GenerateQrCode is invoked -->
                                <Border IsVisible="{Binding Connection.ShowQrCode}"
                                        HorizontalAlignment="Center">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="{local:Localize Home_QrCodeScanHint}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <Border Background="White" CornerRadius="4" Padding="8">
                                            <Image Source="{Binding Connection.QrCodeImage}"
                                                   Width="220" Height="220"
                                                   Stretch="Uniform"/>
                                        </Border>
                                        <Button Content="{local:Localize Close}"
                                                Command="{Binding Connection.CloseQrCodeCommand}"
                                                HorizontalAlignment="Center"
                                                Background="Transparent"
                                                Foreground="{DynamicResource TextMutedBrush}"
                                                FontSize="11" Padding="8,4" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ QUICK ACTIONS ROW ═══ -->
            <StackPanel Spacing="6">
                <TextBlock Text="{local:Localize Home_QuickActions}" FontSize="10" FontWeight="Bold" 
                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="3" Margin="4,0,0,0"/>
                <WrapPanel Orientation="Horizontal">
                    <Button Classes="action-pill action-pill-accent" Margin="0,0,8,8"
                            Command="{Binding NavigateToCanvasCommand}"
                            ToolTip.Tip="{local:Localize Home_SensorWorkspaceTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="▦" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Localize Home_SensorWorkspace}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="action-pill" Margin="0,0,8,8"
                            Command="{Binding NavigateToRemoteCommand}"
                            ToolTip.Tip="{local:Localize Home_PcRemoteTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⏻" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Localize Home_PcRemote}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="action-pill" Margin="0,0,8,8"
                            Command="{Binding NavigateToAppLauncherCommand}"
                            ToolTip.Tip="{local:Localize Home_LauncherTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="◈" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Localize Home_Launcher}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="action-pill" Margin="0,0,8,8"
                            Command="{Binding NavigateToTaskManagerCommand}"
                            ToolTip.Tip="{local:Localize Home_TasksTooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="▤" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{local:Localize Home_Tasks}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>

            <!-- ═══ PINNED SENSORS ═══ -->
            <StackPanel Spacing="10" IsVisible="{Binding PinnedSensors.Count}">
                <TextBlock Text="{local:Localize Home_LiveTelemetry}" FontSize="10" FontWeight="Bold" 
                           Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="3" Margin="4,0,0,0"/>

                <ItemsControl ItemsSource="{Binding PinnedSensors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SensorViewModel">
                            <Border Classes="glass-card interactive" Padding="16" Margin="0,0,8,8" MinWidth="160" MaxWidth="220">
                                <Grid>
                                    <!-- Sparkline background -->
                                    <ctrl:SparklineControl History="{Binding History}" 
                                                           GraphType="{Binding ResolvedGraphType}" 
                                                           AccentColor="{Binding Theme.AccentColor, Converter={x:Static conv:HexToColorConverter.Instance}}" 
                                                           TrackBrush="{DynamicResource TextMutedBrush}" 
                                                           CurrentValue="{Binding Value}" 
                                                           MinSeen="{Binding MinSeenValue}" MaxSeen="{Binding MaxSeenValue}" 
                                                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                                           Opacity="0.12" Margin="0,0,0,-8"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" 
                                                   Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                                                   LetterSpacing="0.5"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Value, StringFormat={}{0:F1}}" FontSize="28" FontWeight="Black" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Unit}" FontSize="11" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                                       VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ═══ NO SENSORS HINT ═══ -->
            <Border Classes="glass-card" Padding="20" IsVisible="{Binding !PinnedSensors.Count}" Opacity="0.7">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="▦" FontSize="32" HorizontalAlignment="Center" 
                               Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{local:Localize Home_NoPinnedSensors}" FontSize="14" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{local:Localize Home_NoPinnedSensorsHint}" 
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" 
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
