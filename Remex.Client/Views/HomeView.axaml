<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:conv="using:Remex.Client.Converters"
    xmlns:ctrl="using:Remex.Client.Controls"
    xmlns:local="clr-namespace:Remex.Client.Converters" x:Class="Remex.Client.Views.HomeView" x:DataType="vm:HomeViewModel">

    <UserControl.Styles>
        <!-- Quick-action pill buttons -->
        <Style Selector="Button.action-pill">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.action-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
        </Style>
        <Style Selector="Button.action-pill:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.action-pill-accent">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource AccentPrimary}" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.action-pill-danger">
            <Setter Property="Foreground" Value="{DynamicResource SystemError}"/>
            <Setter Property="BorderBrush" Value="#40FF6B6B"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,32,40,40" Spacing="48">

            <!-- ═══ MASSIVE HUD HERO ═══ -->
            <Grid>
                <!-- Decorative background elements -->
                <TextBlock Text="CLindsay94" FontSize="280" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource AccentPrimaryBrush}" Opacity="0.03" Margin="-40,-80,0,0" IsHitTestVisible="False"/>

                <Grid Margin="0,24,0,0">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <Image Source="avares://Remex.Client/Assets/New-REMEX.png" Height="300" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,4,0,0" ToolTip.Tip="{local:Localize Home_LogoTooltip}"/>
                    </StackPanel>


                </Grid>
            </Grid>

            <WrapPanel Margin="0,24,0,0">

                <!-- ═══ LEFT COLUMN: LIVE TELEMETRY MATRIX ═══ -->
                <StackPanel MinWidth="400" MaxWidth="1200" Spacing="24" Margin="0,0,32,32">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{local:Localize Home_ActiveSensors}" FontSize="12" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="4" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="action-pill" Command="{Binding NavigateToCanvasCommand}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="[ ]" FontSize="14" FontFamily="{StaticResource JetBrainsMono}" VerticalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_OpenWorkspace}" FontSize="11" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox ItemsSource="{Binding PinnedSensors}" Background="Transparent" BorderThickness="0" Padding="0" IsVisible="{Binding PinnedSensors.Count}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="280"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SensorViewModel">
                                <Border Classes="glass-card interactive" Padding="24" Margin="0,0,20,20" Background="Transparent" CornerRadius="4,24,4,24" BorderThickness="1,0,0,0">
                                    <Panel>
                                        <ctrl:SparklineControl History="{Binding History}" GraphType="{Binding ResolvedGraphType}" AccentColor="{Binding Theme.AccentColor, Converter={x:Static conv:HexToColorConverter.Instance}}" Opacity="0.2" VerticalAlignment="Bottom" Height="80" Margin="-24,0,-24,-24"/>

                                        <StackPanel Spacing="16">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <Path Grid.Column="1" Data="{StaticResource IconFlash}" Fill="{Binding Theme.AccentColor, Converter={x:Static conv:HexToColorConverter.Instance}}" Width="14" Height="14" Stretch="Uniform" Opacity="0.8"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Value, StringFormat={}{0:F1}}" FontSize="48" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Unit}" FontSize="16" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- No Sensors HUD state -->
                    <Border Classes="glass-card" Padding="48" IsVisible="{Binding !PinnedSensors.Count}" CornerRadius="4,32,4,32" BorderThickness="1,0,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <TextBlock Text="{local:Localize Home_NoDataFeed}" FontSize="20" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" LetterSpacing="2"/>
                            <TextBlock Text="{local:Localize Home_NoPinnedSensorsHint}" FontSize="13" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"/>
                            <Button Classes="action-pill action-pill-accent" Content="{local:Localize Home_InitializeSensors}" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Black" Command="{Binding NavigateToCanvasCommand}" HorizontalAlignment="Center" Padding="24,12" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ RIGHT COLUMN: COMMAND DIRECTIVES ═══ -->
                <StackPanel Width="340" Spacing="24">
                    <TextBlock Text="{local:Localize Home_Directives}" FontSize="12" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="4"/>

                    <StackPanel Spacing="16">
                        <!-- High Priority Action -->
                        <Button Classes="glass-card interactive" Command="{Binding NavigateToRemoteCommand}" Padding="0" HorizontalAlignment="Stretch" CornerRadius="20,4,20,4">
                            <Grid ColumnDefinitions="Auto,*" Margin="20">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#15FF6B6B" Margin="0,0,16,0">
                                    <Path Data="{StaticResource IconRemote}" Fill="#FF6B6B" Width="20" Height="20" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{local:Localize Home_RemoteControl}" FontSize="13" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{local:Localize Home_RemoteControlDesc}" FontSize="11" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- Standard Actions -->
                        <Button Classes="glass-card interactive" Command="{Binding NavigateToAppLauncherCommand}" Padding="0" HorizontalAlignment="Stretch" CornerRadius="4,20,4,20">
                            <Grid ColumnDefinitions="Auto,*" Margin="20">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#1500F3FF" Margin="0,0,16,0">
                                    <Path Data="{StaticResource IconLauncher}" Fill="#00F3FF" Width="20" Height="20" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{local:Localize Home_AppLauncher}" FontSize="13" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{local:Localize Home_AppLauncherDesc}" FontSize="11" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Classes="glass-card interactive" Command="{Binding NavigateToTaskManagerCommand}" Padding="0" HorizontalAlignment="Stretch" CornerRadius="20,4,20,4">
                            <Grid ColumnDefinitions="Auto,*" Margin="20">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#15FFB800" Margin="0,0,16,0">
                                    <Path Data="{StaticResource IconTasks}" Fill="#FFB800" Width="20" Height="20" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{local:Localize Home_TaskMonitor}" FontSize="13" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{local:Localize Home_TaskMonitorDesc}" FontSize="11" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button Classes="glass-card interactive" Command="{Binding NavigateToFileTransferCommand}" Padding="0" HorizontalAlignment="Stretch" CornerRadius="4,20,4,20">
                            <Grid ColumnDefinitions="Auto,*" Margin="20">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#1534D399" Margin="0,0,16,0">
                                    <Path Data="{StaticResource IconFiles}" Fill="#34D399" Width="20" Height="20" Stretch="Uniform"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{local:Localize Home_FileSystem}" FontSize="13" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{local:Localize Home_FileSystemDesc}" FontSize="11" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>

    <!-- Advanced Status Node Footer -->
    <Border Grid.Row="1" Classes="glass-card" Padding="20" HorizontalAlignment="Center" BoxShadow="0 -8 32 0 #40000000" CornerRadius="20,20,4,4" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" Spacing="24">
            <Grid>
                <!-- Radar Sweep Animation -->
                <Ellipse Width="48" Height="48" Stroke="{Binding Connection.IsConnected, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter=#22C55E|#F43F5E}" StrokeThickness="1" Opacity="0.2"/>
                <Ellipse Width="48" Height="48" Fill="{Binding Connection.IsConnected, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter=#22C55E|#F43F5E}" Opacity="0.1"/>
                <Ellipse Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{Binding Connection.IsConnected, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter=#22C55E|#F43F5E}">
                    <Ellipse.Transitions>
                        <Transitions>
                            <BrushTransition Property="Fill" Duration="0:0:0.4"/>
                        </Transitions>
                    </Ellipse.Transitions>
                </Ellipse>
            </Grid>
            <StackPanel HorizontalAlignment="Center" MinWidth="140">
                <TextBlock Text="{local:Localize Home_LinkStatus}" FontSize="9" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
                <TextBlock Text="{Binding Connection.StatusText}" FontSize="16" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Connection.LatencyText}" FontSize="12" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource AccentPrimaryBrush}" IsVisible="{Binding Connection.IsConnected}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Spacing="8">
                <Button Classes="action-pill action-pill-accent" Content="{local:Localize Home_InitializeLink}" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Black" Command="{Binding Connection.ConnectCommand}" IsVisible="{Binding !Connection.IsConnected}" Padding="20,10"/>
                <Button Classes="action-pill action-pill-danger" Content="{local:Localize Home_TerminateLink}" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Black" Command="{Binding Connection.DisconnectCommand}" IsVisible="{Binding Connection.IsConnected}" Padding="20,10"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Grid>
</UserControl>
