<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Remex.Client.ViewModels"
        xmlns:converters="using:Remex.Client.Converters"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="Remex.Client.Views.AddProgramWindow"
        x:DataType="vm:AddProgramViewModel"
        Title="Add Program"
        Width="400" Height="450"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A24"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Resources>
        <converters:Base64ToImageConverter x:Key="Base64ToImageConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto, *, Auto" Margin="24">

        <TextBlock Grid.Row="0" Text="Add New Program" FontSize="18" FontWeight="Bold" Foreground="#E0E0FF" Margin="0,0,0,24" />

        <StackPanel Grid.Row="1" Spacing="16">

            <TextBlock Text="Executable Path" Foreground="#A0A0FF" FontWeight="SemiBold" FontSize="12" />
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0" Text="{Binding TargetPath}" Watermark="C:\Path\To\App.exe" IsReadOnly="True" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" Classes="glass-button" />
            </Grid>

            <TextBlock Text="Display Name" Foreground="#A0A0FF" FontWeight="SemiBold" FontSize="12" />
            <TextBox Text="{Binding DisplayName}" Watermark="My App" />

            <TextBlock Text="Accent Color (Hex)" Foreground="#A0A0FF" FontWeight="SemiBold" FontSize="12" />
            <Grid ColumnDefinitions="*, Auto">
                <TextBox Grid.Column="0" Text="{Binding HexColor}" Watermark="#RRGGBB" Margin="0,0,8,0" />
                <Border Grid.Column="1" Width="32" Height="32" CornerRadius="4">
                    <Border.Background>
                        <SolidColorBrush Color="{Binding ValidatedColor}" />
                    </Border.Background>
                </Border>
            </Grid>

            <TextBlock Text="Icon Preview" Foreground="#A0A0FF" FontWeight="SemiBold" FontSize="12" />
            <Border Width="64" Height="64" Classes="glass-card" HorizontalAlignment="Left">
                <Image Source="{Binding IconBase64, Converter={StaticResource Base64ToImageConverter}}"
                       Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*, *" Margin="0,24,0,0">
            <Button Grid.Column="0" Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Stretch" Margin="0,0,8,0" Classes="glass-button" />
            <Button Grid.Column="1" Content="Save" Command="{Binding SaveCommand}" HorizontalAlignment="Stretch" Margin="8,0,0,0" Classes="glass-button" Background="#4A3AFF" Foreground="White" />
        </Grid>
    </Grid>
</Window>
