<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:models="using:Remex.Client.Models"
    xmlns:local="clr-namespace:Remex.Client.Converters" mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="400" x:Class="Remex.Client.Views.CommandPaletteWindow" x:DataType="vm:CommandPaletteViewModel" Title="{local:Localize CommandPalette_Title}" Width="540" MaxHeight="480" SizeToContent="Height" SystemDecorations="None" Background="{DynamicResource GlassBaseDarkBrush}" WindowStartupLocation="CenterOwner" CanResize="False" Topmost="True" ShowInTaskbar="False" TransparencyLevelHint="AcrylicBlur">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding DismissCommand}" />
    </Window.KeyBindings>

    <Border CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="0,0,0,8">

        <StackPanel>

            <!-- Search Box -->
            <Grid ColumnDefinitions="Auto, *" Margin="16,16,16,8">
                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchText}" Watermark="{local:Localize CommandPalette_SearchWatermark}" FontSize="15" Background="Transparent" BorderThickness="0" Padding="0" CaretBrush="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>

            <!-- Divider -->
            <Rectangle Height="1" Fill="{DynamicResource CardBorderBrush}" Margin="12,0" />

            <!-- Results -->
            <ListBox ItemsSource="{Binding FilteredResults}" x:Name="ResultsList" MaxHeight="360" Background="Transparent" BorderThickness="0" Margin="8,4,8,0" SelectionMode="Single">

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CommandPaletteEntry}">
                        <Grid ColumnDefinitions="*, Auto" Margin="4,2">
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="#22FFFFFF" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                    </Style>
                </ListBox.Styles>

            </ListBox>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyStateText" IsVisible="{Binding IsEmpty}" Text="{local:Localize CommandPalette_NoCommands}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,12,0,4" />

        </StackPanel>
    </Border>
</Window>
