<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Remex.Client.ViewModels"
             xmlns:local="clr-namespace:Remex.Client.Converters"
             x:Class="Remex.Client.Views.DiagnosticLogsView"
             x:DataType="vm:DiagnosticLogsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.log-btn">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.log-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="40" MaxWidth="1100" HorizontalAlignment="Stretch">
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="LOGS &amp; DIAGNOSTICS" FontFamily="{StaticResource Bungee_Shade}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,24"/>

        <!-- Main Card -->
        <Border Grid.Row="1" Classes="glass-card" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TabControl Theme="{StaticResource TabControlTheme}">
                <!-- Tab 1: Live App Logs -->
                <TabItem Header="Live Application Logs">
                    <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
                        <!-- Toolbar -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,16">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Verbosity Filter:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding VerbosityLevels}" SelectedItem="{Binding SelectedVerbosity}" Width="150" CornerRadius="8" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10">
                                <Button Classes="log-btn" Content="Refresh" Command="{Binding RefreshLogsCommand}"/>
                                <Button Classes="log-btn" Content="Clear Logs" Command="{Binding ClearLogsCommand}" Foreground="{DynamicResource SystemErrorBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Terminal Output -->
                        <Border Grid.Row="1" Background="#121214" CornerRadius="12" Padding="16" BorderBrush="#26262B" BorderThickness="1" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBox Text="{Binding LogText}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Background="Transparent"
                                         Foreground="#E4E4E7"
                                         BorderThickness="0"
                                         Margin="0"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: Service Logs -->
                <TabItem Header="Background Service Logs">
                    <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
                        <!-- Toolbar -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <TextBlock Grid.Column="0" Text="Latest event logs query from Windows Event Viewer or Linux systemd journal." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="log-btn" Content="Query Service Logs" Command="{Binding FetchServiceLogsCommand}"/>
                        </Grid>

                        <!-- Terminal Output -->
                        <Border Grid.Row="1" Background="#121214" CornerRadius="12" Padding="16" BorderBrush="#26262B" BorderThickness="1" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBox Text="{Binding ServiceLogsText}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Background="Transparent"
                                         Foreground="#4ADE80"
                                         BorderThickness="0"
                                         Margin="0"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
