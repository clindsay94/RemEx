<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:converters="using:Remex.Client.Converters"
    x:Class="Remex.Client.Views.AppLauncherView" x:DataType="vm:AppLauncherViewModel">

    <UserControl.Resources>
        <converters:Base64ToImageConverter x:Key="Base64ToImageConverter" />
    </UserControl.Resources>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" Spacing="24">

            <!-- ═══ Header ═══ -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Spacing="4" Grid.Column="0">
                    <TextBlock Text="◈  APP LAUNCHER" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="REMOTE APPLICATION CONTROL" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="3"/>
                </StackPanel>

                <Button Content="+ Add Program" Grid.Column="1" VerticalAlignment="Center"
                        Classes="glass-button" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" Padding="12,8"
                        Command="{Binding OpenAddProgramDialogCommand}" />
            </Grid>

            <!-- ═══ Android Add Panel ═══ -->
            <Border Classes="glass-card" Padding="20" IsVisible="{Binding IsAndroidAddPanelOpen}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="ADD NEW APPLICATION" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
                    <TextBox Text="{Binding AndroidNewAppName}" Watermark="Display Name (e.g. Chrome)" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <TextBox Text="{Binding AndroidNewAppPath}" Watermark="Target Path (e.g. C:\Program Files\...)" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding OpenAddProgramDialogCommand}" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Button Content="Submit" Command="{Binding SubmitAndroidNewAppCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Apps Grid ═══ -->
            <ItemsControl ItemsSource="{Binding Launchers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="160" ItemHeight="160" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="glass-card" Margin="8" Padding="16" Cursor="Hand">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding HexColor}" Opacity="0.1" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding HexColor}" Opacity="0.3" />
                            </Border.BorderBrush>


                            <Button Background="Transparent" Padding="0"
                                    Command="{Binding $parent[UserControl].((vm:AppLauncherViewModel)DataContext).LaunchAppCommand}"
                                    CommandParameter="{Binding}">
                                <Grid RowDefinitions="*, Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <!-- Remove Button -->
                                    <Button Content="✕" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="Transparent" Foreground="#666" Padding="4" ZIndex="1"
                                            Command="{Binding $parent[UserControl].((vm:AppLauncherViewModel)DataContext).RemoveAppCommand}" CommandParameter="{Binding}" />

                                    <Image Grid.Row="0" Source="{Binding IconBase64, Converter={StaticResource Base64ToImageConverter}}"
                                           Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No applications configured." IsVisible="{Binding !Launchers.Count}"
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,40,0,0" FontStyle="Italic"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
