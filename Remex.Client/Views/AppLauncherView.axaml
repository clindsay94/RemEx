<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:converters="using:Remex.Client.Converters"
    xmlns:local="clr-namespace:Remex.Client.Converters" x:Class="Remex.Client.Views.AppLauncherView" x:DataType="vm:AppLauncherViewModel">

    <UserControl.Resources>
        <converters:Base64ToImageConverter x:Key="Base64ToImageConverter" />
    </UserControl.Resources>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" Spacing="24">

            <!-- ═══ Header ═══ -->
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Spacing="4" Grid.Column="0">
                    <TextBlock Text="{local:Localize AppLauncher_Header}" FontFamily="{StaticResource Bungee_Shade}" FontSize="28" FontWeight="Black" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                    <TextBlock Text="{local:Localize AppLauncher_Subheader}" FontFamily="{StaticResource Sixtyfour}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="3"/>
                </StackPanel>

                <Button Content="{local:Localize AppLauncher_AddProgram}" Grid.Column="1" VerticalAlignment="Center" Classes="glass-button" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" Padding="12,8" Command="{Binding OpenAddProgramDialogCommand}" />
            </Grid>

            <!-- ═══ Android Add Panel ═══ -->
            <Border Classes="glass-card" Padding="20" IsVisible="{Binding IsAndroidAddPanelOpen}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="{local:Localize AppLauncher_AddNewApp}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
                    <TextBox Text="{Binding AndroidNewAppName}" Watermark="{local:Localize AppLauncher_DisplayNameWatermark}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <TextBox Text="{Binding AndroidNewAppPath}" Watermark="{local:Localize AppLauncher_TargetPathWatermark}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{local:Localize Btn_Cancel}" Command="{Binding OpenAddProgramDialogCommand}" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}"/>
                        <Button Content="{local:Localize Btn_Submit}" Command="{Binding SubmitAndroidNewAppCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Search ═══ -->
            <TextBox Watermark="{local:Localize AppLauncher_SearchWatermark}" Text="{Binding SearchText}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="16" Padding="16,10" FontSize="13"/>

            <!-- ═══ Apps Grid ═══ -->
            <ItemsControl ItemsSource="{Binding FilteredApps}" x:Name="LauncherGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="160" ItemHeight="160" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="glass-card" Margin="8" Padding="0" ClipToBounds="True">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding HexColor}" Opacity="0.1" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding HexColor}" Opacity="0.3" />
                            </Border.BorderBrush>

                            <Grid RowDefinitions="*, Auto">
                                <!-- Main Launch Button (Top Area) -->
                                <Button Grid.Row="0" Background="Transparent" Padding="12" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Command="{Binding $parent[UserControl].((vm:AppLauncherViewModel)DataContext).LaunchAppCommand}" CommandParameter="{Binding}" IsEnabled="{Binding $parent[UserControl].((vm:AppLauncherViewModel)DataContext).Connection.IsConnected}">
                                    <Grid RowDefinitions="*, Auto" HorizontalAlignment="Center">
                                        <Image Grid.Row="0" Source="{Binding IconBase64, Converter={StaticResource Base64ToImageConverter}}" Width="56" Height="56" HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="1" Text="{Binding DisplayName}" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                    </Grid>
                                </Button>

                                <!-- Action Toolbar (Bottom Area) -->
                                <Border Grid.Row="1" Background="{DynamicResource GlassOverlayBrush}" Padding="4,2">
                                    <Grid ColumnDefinitions="*, *, *">
                                        <Button Grid.Column="0" Content="←" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" Padding="0" FontSize="16" HorizontalAlignment="Stretch" ToolTip.Tip="{local:Localize AppLauncher_MoveLeft}" Command="{Binding $parent[UserControl].((vm:AppLauncherViewModel)DataContext).MoveLeftCommand}" CommandParameter="{Binding}" />

                                        <Button Grid.Column="1" Content="→" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" Padding="0" FontSize="16" HorizontalAlignment="Stretch" ToolTip.Tip="{local:Localize AppLauncher_MoveRight}" Command="{Binding $parent[UserControl].((vm:AppLauncherViewModel)DataContext).MoveRightCommand}" CommandParameter="{Binding}" />

                                        <Button Grid.Column="2" Content="✕" Background="Transparent" Foreground="{DynamicResource SystemErrorBrush}" Padding="0" FontSize="16" HorizontalAlignment="Stretch" ToolTip.Tip="{local:Localize AppLauncher_Remove}" Command="{Binding $parent[UserControl].((vm:AppLauncherViewModel)DataContext).RemoveAppCommand}" CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{local:Localize AppLauncher_NoApps}" IsVisible="{Binding !Launchers.Count}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,40,0,0" FontStyle="Italic"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
