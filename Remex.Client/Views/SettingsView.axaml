<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Client.ViewModels"
    xmlns:conv="using:Remex.Client.Converters"
    xmlns:local="clr-namespace:Remex.Client.Converters"
    xmlns:coreModels="using:Remex.Core.Models" x:Class="Remex.Client.Views.SettingsView" x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.settings-back">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.settings-back:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>
        <Style Selector="Button.settings-back:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32" Spacing="24" MaxWidth="500">

            <!-- ═══ Header ═══ -->
            <Button Classes="settings-back" Content="{local:Localize Settings_Back}" Command="{Binding NavigateBackCommand}" HorizontalAlignment="Left"/>

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{local:Localize Settings_Header}" FontSize="24" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SavedStatus}" FontSize="12" Foreground="{DynamicResource SystemSuccessBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Content="{local:Localize Settings_SaveChanges}" Command="{Binding SaveCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="Bold"/>
                </StackPanel>
            </Grid>

            <!-- ═══ Service Section ═══ -->
            <Border Classes="glass-card" Padding="20" IsVisible="{Binding IsServiceSectionVisible}">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding ServiceSectionHeader}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>

                    <!-- Status row -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" AutomationProperties.Name="{Binding ServiceStatusText}">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding IsServiceRunning, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter=#4ADE80|#FF6B6B}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding ServiceStatusText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ServiceAccountDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding IsServiceInstalled}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{local:Localize Settings_Refresh}" Command="{Binding RefreshServiceCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="10,6" CornerRadius="6" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsServiceBusy}">
                        <!-- Not installed → Install + Configure Login -->
                        <Button Content="{local:Localize Settings_ConfigureLogin}" Command="{Binding ConfigureLoginCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8" CornerRadius="6" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding ShowInstallButton}"/>
                        <Button Content="{local:Localize Settings_Install}" Command="{Binding InstallServiceCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="12,8" CornerRadius="6" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding ShowInstallButton}"/>

                        <!-- Installed → Start / Stop / Configure / Uninstall -->
                        <Button Content="{local:Localize Btn_Start}" Command="{Binding StartServiceCommand}" Background="{DynamicResource SystemSuccessBrush}" Foreground="#1A1A1A" Padding="12,8" CornerRadius="6" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding ShowStartStopButtons}" IsEnabled="{Binding !IsServiceRunning}"/>
                        <Button Content="{local:Localize Btn_Stop}" Command="{Binding StopServiceCommand}" Background="{DynamicResource SystemWarningBrush}" Foreground="#1A1A1A" Padding="12,8" CornerRadius="6" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding ShowStartStopButtons}" IsEnabled="{Binding IsServiceRunning}"/>
                        <Button Content="{local:Localize Settings_ConfigureLogin}" Command="{Binding ConfigureLoginCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8" CornerRadius="6" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding ShowStartStopButtons}"/>
                        <Button Content="{local:Localize Settings_Uninstall}" Command="{Binding UninstallServiceCommand}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource SystemErrorBrush}" Padding="12,8" CornerRadius="6" FontSize="12" FontWeight="SemiBold" IsVisible="{Binding ShowStartStopButtons}"/>
                    </StackPanel>
                    <!-- Credential configuration panel -->
                    <Border IsVisible="{Binding IsCredentialPanelOpen}" Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{local:Localize Settings_ServiceLogin}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{local:Localize Settings_Username}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding ServiceUsername}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="8" Padding="8 6" FontSize="13" FontFamily="Consolas, monospace" Watermark="{local:Localize Settings_UsernameWatermark}"/>
                                <TextBlock Text="{local:Localize Settings_UsernameHint}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="{local:Localize Settings_Password}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox PasswordChar="●" Text="{Binding ServicePassword}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="8" Padding="8 6" FontSize="13" Watermark="{local:Localize Settings_PasswordWatermark}"/>
                            </StackPanel>

                            <Button Content="{local:Localize Btn_Apply}" Command="{Binding ApplyLoginCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="16,8" CornerRadius="6" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left" IsVisible="{Binding IsServiceInstalled}"/>
                        </StackPanel>
                    </Border>

                    <!-- Service log -->
                    <Border IsVisible="{Binding ServiceLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" MaxHeight="200">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ServiceLog}" FontSize="11" FontFamily="Consolas, monospace" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="NoWrap"/>
                        </ScrollViewer>
                    </Border>

                    <TextBlock Text="{local:Localize Settings_ServiceDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <!-- ═══ General Section ═══ -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{local:Localize Settings_General}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{local:Localize Settings_Language}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableLanguages}" SelectedValue="{Binding Language}" SelectedValueBinding="{Binding Code}" MinWidth="150" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Connection Section ═══ -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="{local:Localize Settings_Connection}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>

                    <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding HostRuntimeText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding HostCapabilityText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{local:Localize Settings_HostAddress}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding HostAddress}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="8" Padding="12 8" FontSize="13" FontFamily="Consolas, monospace" Watermark="ws://host:port/ws" ToolTip.Tip="{local:Localize Settings_HostAddressTooltip}"/>
                        <Button Grid.Column="1" Content="{local:Localize Btn_Discover}" Command="{Binding DiscoverHostCommand}" IsEnabled="{Binding !IsDiscovering}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8" CornerRadius="8" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="{local:Localize Settings_DiscoverTooltip}"/>
                    </Grid>
                    <ComboBox IsVisible="{Binding DiscoveredHosts.Count}" ItemsSource="{Binding DiscoveredHosts}" SelectedItem="{Binding HostAddress}" HorizontalAlignment="Stretch" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="8" Padding="12,4" FontSize="12" FontFamily="Consolas, monospace" ToolTip.Tip="Select a discovered host"/>

                    <!-- Recent connection history picker -->
                    <ComboBox IsVisible="{Binding ConnectionHistory.Count}" ItemsSource="{Binding ConnectionHistory}" HorizontalAlignment="Stretch" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="8" Padding="12,4" FontSize="12" FontFamily="Consolas, monospace" ToolTip.Tip="Select from recent connections" SelectionChanged="OnConnectionHistorySelected">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="coreModels:ConnectionProfile">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding HostAddress}" FontSize="12"/>
                                    <TextBlock Text="{Binding LastConnected, StringFormat='Connected: {0:g}'}" FontSize="10" Opacity="0.7"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Content="{local:Localize Settings_SaveReconnect}" Command="{Binding SaveAndReconnectCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip.Tip="{local:Localize Settings_SaveReconnectTooltip}"/>

                    <TextBlock Text="{local:Localize Settings_AutoSaveHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ═══ Remote Desktop Section ═══ -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{local:Localize Settings_RemoteDesktop}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>

                    <!-- Stream Quality -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{local:Localize RemoteDesktop_Quality}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding StreamQuality, StringFormat={}{0}%}"/>
                        </Grid>
                        <Slider Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding StreamQuality}" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Text="Low" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="High" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Stream FPS -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{local:Localize RemoteDesktop_Fps}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{local:Localize Settings_StreamFpsDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedStreamFpsIndex}" MinWidth="70" VerticalAlignment="Center">
                            <ComboBoxItem Content="5"/>
                            <ComboBoxItem Content="10"/>
                            <ComboBoxItem Content="15"/>
                            <ComboBoxItem Content="20"/>
                            <ComboBoxItem Content="30"/>
                            <ComboBoxItem Content="60"/>
                            <ComboBoxItem Content="120"/>
                            <ComboBoxItem Content="240"/>
                            <ComboBoxItem Content="360"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Layout Section ═══ -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{local:Localize Settings_Layout}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>

                    <!-- Snap toggle -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{local:Localize Settings_SnapToGrid}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{local:Localize Settings_SnapToGridDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsSnapToGridEnabled}" OnContent="" OffContent="" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Settings_SnapToGridTooltip}"/>
                    </Grid>

                    <!-- Grid size slider -->
                    <StackPanel Spacing="4" IsEnabled="{Binding IsSnapToGridEnabled}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{local:Localize Settings_GridSize}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} px">
                                        <Binding Path="GridSize"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </Grid>
                        <Slider Minimum="10" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding GridSize}" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Text="Small" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="Large" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Pinned Sensors Section ═══ -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{local:Localize Settings_PinnedSensors}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2" VerticalAlignment="Center"/>
                        <TextBlock Text="ℹ" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Settings_HwInfoTooltip}"/>
                    </StackPanel>
                    <TextBlock Text="{local:Localize Settings_PinnedSensorsDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <TextBlock Text="{local:Localize Settings_OpenSensorWorkspaceHint}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" IsVisible="{Binding !AvailableSensors.Count}"/>

                    <ScrollViewer MaxHeight="350" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailableSensors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SensorPinItem">
                                    <CheckBox IsChecked="{Binding IsPinned}" Margin="0,2" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding SensorName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Border Background="#1E1E3A" CornerRadius="3" Padding="4,1" VerticalAlignment="Center" IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#6C6CAA"/>
                                            </Border>
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ═══ Help Section ═══ -->
            <Border Classes="glass-card" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="{local:Localize Settings_Help}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
                    <Button Content="{local:Localize Settings_ReplayTutorial}" Command="{Binding ReplayTutorialCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="12,8" CornerRadius="8" FontSize="13" FontWeight="SemiBold" Cursor="Hand" ToolTip.Tip="{local:Localize Settings_ReplayTutorialTooltip}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
