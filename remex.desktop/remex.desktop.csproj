<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Remex.Desktop</RootNamespace>
    <AssemblyName>Remex.Desktop</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- This assembly owns the About page, so it is the one that carries the build id (RemEx-2ckhm). -->
    <RemexStampBuildId>true</RemexStampBuildId>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Themes\**" />
    <!-- Bundle the changelog so the About page's "What's New" can read the latest release notes at runtime. -->
    <AvaloniaResource Include="..\docs\CHANGELOG.md" Link="Assets\CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Material.Avalonia (RemEx-851li). Versionless: ManagePackageVersionsCentrally is true, so a
         Version attribute here is NU1008 and a restore error. Measured, not assumed — adding
         Version="3.14.2" to the line below fails restore with "The following PackageReference items
         cannot define a value for Version". Versions, and the reason they are not the latest, are in
         Directory.Packages.props. Nothing includes these styles yet — that is RemEx-prkot — so the
         app looks exactly as it did. -->
    <PackageReference Include="Material.Avalonia" />
    <PackageReference Include="Material.Avalonia.Dialogs" />
    <PackageReference Include="Material.Icons.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MaterialColorUtilities" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Remex.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\remex.core\remex.core.csproj" />
    <ProjectReference Include="..\remex.branding\remex.branding.csproj" />
  </ItemGroup>
</Project>
