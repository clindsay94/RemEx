<ContentControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:converters="using:Remex.Desktop.Converters" x:DataType="vm:ShellViewModel" x:Class="Remex.Desktop.Controls.DashboardBackgroundControl">

    <ContentControl.Template>
        <ControlTemplate>
            <Grid x:DataType="vm:ShellViewModel">
                <Grid IsHitTestVisible="False" Classes.palette-transition-suppressed="{Binding SuppressPaletteTransitions}">
                    <!-- ═══ PALETTE CROSSFADE (RemEx-zgtn1). This is the largest surface in the app —
                         every mode below fills the whole window — and it used to be the one place a
                         palette change SNAPPED instead of crossfading; the ten pre-existing
                         BrushTransition spots (App.axaml) only ever covered chrome (Card, Button,
                         Ellipse). Classes="palette-bg" opts a Rectangle into the Fill transition
                         defined below; suppression follows the same Classes.palette-transition-
                         suppressed flag as MainWindow.axaml, bound once here rather than per-rectangle
                         since every one of them is a descendant of this Grid.
                         Rectangles bound through a nested SolidColorBrush's own Color (Acrylic's tint,
                         the Aurora gradients) are deliberately NOT tagged: ThemeService swaps the
                         COLOR in place there, never the brush instance, so Fill itself never raises a
                         change and a BrushTransition on it would never fire. Only a Rectangle whose
                         Fill is DIRECTLY "{DynamicResource ...Brush}" gets a new brush object on every
                         apply and is worth tagging. -->
                    <Grid.Styles>
                        <Style Selector="Rectangle.palette-bg">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Fill" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <!-- The gradient base needs BOTH a Fill and an Opacity transition, and it needs
                             both to be SUPPRESSIBLE. Carrying them in the Rectangle's own
                             <Rectangle.Transitions> would make them a LocalValue, which outranks the
                             StyleTrigger a class setter resolves at — so the suppressor below could
                             never reach them, and a reduced-motion user would get an unturnoffable
                             400ms ease on the largest surface in the app (review MEDIUM, round 2).
                             Both live on this class instead, which is what makes them switchable. -->
                        <Style Selector="Rectangle.palette-bg-gradient-base">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:1"/>
                                    <BrushTransition Property="Fill" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                                </Transitions>
                            </Setter>
                        </Style>
                        <!-- Declared after the styles above. BOTH selectors in each pair carry an
                             activator, so both resolve at BindingPriority.StyleTrigger and the tie
                             breaks on declaration order — which is the one case where "later wins" is
                             the real rule. It is NOT a general specificity rule: a style with no
                             activator loses to either of these wherever it sits. (RemEx-zrlze shipped
                             a P0 from confusing the two.)

                             The suppressed gradient base keeps its Opacity transition and drops only
                             the Fill one: the 8-second opacity breathing is decorative motion the
                             palette change does not drive, and killing it here would stop the
                             background animating for reasons that have nothing to do with this bead. -->
                        <Style Selector="Grid.palette-transition-suppressed Rectangle.palette-bg">
                            <Setter Property="Transitions" Value="{x:Null}"/>
                        </Style>
                        <Style Selector="Grid.palette-transition-suppressed Rectangle.palette-bg-gradient-base">
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:1"/>
                                </Transitions>
                            </Setter>
                        </Style>
                    </Grid.Styles>
                    <!-- ═══ Custom Gradient Mode ═══ -->
                    <!-- Static base — always visible when gradient mode is active, and a full-window
                         surface, so it has to crossfade with everything else rather than hard-cutting
                         underneath the layer above it.

                         TWO WRONG ANSWERS PRECEDED THIS ONE, both silent. The first left it untagged,
                         reasoning that a Fill transition "would fight the Opacity transition it
                         already owns for the same property collection" — a Transitions collection
                         holds transitions for different properties without conflict, so that was
                         simply not true. The second added the Fill transition to a local
                         <Rectangle.Transitions>, which does fire, but as a LocalValue it outranks the
                         suppression class and could never be turned off — handing a reduced-motion
                         user a 400ms ease on the largest surface in the app with no setting to stop
                         it, which is worse than the snap it replaced.

                         Both transitions come off the .palette-bg-gradient-base class above, where
                         the suppressor can reach them. -->
                    <Rectangle Classes="palette-bg-gradient-base" IsVisible="{Binding EffectiveBackgroundType, Converter={x:Static converters:StringMatchConverter.IsGradient}}" Fill="{DynamicResource BackgroundGradientBrush}" Opacity="0.8"/>
                    <!-- Animated opacity pulse — suppressed when reduced motion is on. The animation
                         itself is also class-gated on .window-visible (perf audit P0-2), so a
                         tray-hidden or minimized window stops ticking it; the static Opacity equals
                         the first keyframe so a restore resumes without a jump, the same pairing the
                         Aurora layers below keep. -->
                    <Rectangle Classes="palette-bg" Fill="{DynamicResource BackgroundGradientBrush}" x:Name="GradientAnimated" Opacity="0.7" Classes.window-visible="{Binding IsWindowVisible}">
                        <Rectangle.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="EffectiveBackgroundType" Converter="{x:Static converters:StringMatchConverter.IsGradient}"/>
                                <Binding Path="IsReducedMotion" Converter="{x:Static BoolConverters.Not}"/>
                            </MultiBinding>
                        </Rectangle.IsVisible>
                        <Rectangle.Styles>
                            <Style Selector="Rectangle#GradientAnimated.window-visible">
                                <Style.Animations>
                                    <Animation Duration="0:0:10" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                                        <KeyFrame KeyTime="0:0:0">
                                            <Setter Property="Opacity" Value="0.7"/>
                                        </KeyFrame>
                                        <KeyFrame KeyTime="0:0:10">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Rectangle.Styles>
                    </Rectangle>

                    <!-- ═══ Aurora Mode — the animated mesh (RemEx-ddynd) ═══
                         Three radial blobs, each two DynamicResource stops: an Aurora tone at
                         Offset 0 (tone 30 of its ramp on a dark surface, tone 90 on a light one —
                         ThemeService picks the set with the same ResolveIsLight answer the palette
                         uses) and the Surface base (GlassBaseDark, the same brush as the base
                         rectangle) at Offset 1, so the glow fades to nothing against it.

                         REDUCED MOTION FREEZES, IT DOES NOT HIDE. Each layer's static Opacity IS
                         its first keyframe; the animation lives on a class bound to the inverse of
                         IsReducedMotion, so removing the class stops the animation and the property
                         falls back to that static value. AuroraMeshTests pins the pairing.
                         The same selector ALSO requires .window-visible (ShellViewModel.IsWindowVisible,
                         perf audit P0-2): an AND on top of the reduced-motion gate, never a
                         replacement, so a tray-hidden or minimized window freezes at the same
                         first keyframe instead of animating for the life of the process.

                         RADII ARE PERCENTAGES, NEVER BARE NUMBERS (RemEx-4kv0g.5 audit, 2026-09-15).
                         RadialGradientBrush.RadiusX/RadiusY are RelativeScalars: "98%" is 98% of the
                         rectangle, but a bare "0.98" is 0.98 DEVICE PIXELS. The mesh shipped as
                         RadiusX="0.98" etc., so every blob was a one-pixel circle and the whole layer
                         painted its Offset-1 stop - the base colour - which is why Aurora read as a
                         flat black or white sheet for months. AuroraMeshTests requires the unit. -->
                    <Panel IsVisible="{Binding EffectiveBackgroundType, Converter={x:Static converters:StringMatchConverter.IsAurora}}">
                        <Rectangle Classes="palette-bg" Fill="{DynamicResource GlassBaseDarkBrush}" />

                        <Rectangle Name="AuroraLayer1" Opacity="0.55" Classes.aurora-animated="{Binding !IsReducedMotion}" Classes.window-visible="{Binding IsWindowVisible}">
                            <Rectangle.Fill>
                                <RadialGradientBrush Center="25%,35%" RadiusX="98%" RadiusY="113%">
                                    <GradientStop Offset="0" Color="{DynamicResource AuroraPrimary}" />
                                    <GradientStop Offset="1" Color="{DynamicResource GlassBaseDark}" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Styles>
                                <Style Selector="Rectangle#AuroraLayer1.aurora-animated.window-visible">
                                    <Style.Animations>
                                        <Animation Duration="0:0:8" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                                            <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="0.55"/></KeyFrame>
                                            <KeyFrame KeyTime="0:0:4"><Setter Property="Opacity" Value="0.90"/></KeyFrame>
                                            <KeyFrame KeyTime="0:0:8"><Setter Property="Opacity" Value="0.60"/></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Rectangle.Styles>
                        </Rectangle>

                        <Rectangle Name="AuroraLayer2" Opacity="0.42" Classes.aurora-animated="{Binding !IsReducedMotion}" Classes.window-visible="{Binding IsWindowVisible}">
                            <Rectangle.Fill>
                                <RadialGradientBrush Center="72%,65%" RadiusX="105%" RadiusY="90%">
                                    <GradientStop Offset="0" Color="{DynamicResource AuroraSecondary}" />
                                    <GradientStop Offset="1" Color="{DynamicResource GlassBaseDark}" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Styles>
                                <Style Selector="Rectangle#AuroraLayer2.aurora-animated.window-visible">
                                    <Style.Animations>
                                        <Animation Duration="0:0:12" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                                            <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="0.42"/></KeyFrame>
                                            <KeyFrame KeyTime="0:0:6"><Setter Property="Opacity" Value="0.80"/></KeyFrame>
                                            <KeyFrame KeyTime="0:0:12"><Setter Property="Opacity" Value="0.35"/></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Rectangle.Styles>
                        </Rectangle>

                        <Rectangle Name="AuroraLayer3" Opacity="0.30" Classes.aurora-animated="{Binding !IsReducedMotion}" Classes.window-visible="{Binding IsWindowVisible}">
                            <Rectangle.Fill>
                                <RadialGradientBrush Center="50%,8%" RadiusX="83%" RadiusY="68%">
                                    <GradientStop Offset="0" Color="{DynamicResource AuroraTertiary}" />
                                    <GradientStop Offset="1" Color="{DynamicResource GlassBaseDark}" />
                                </RadialGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Styles>
                                <Style Selector="Rectangle#AuroraLayer3.aurora-animated.window-visible">
                                    <Style.Animations>
                                        <Animation Duration="0:0:15" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                                            <KeyFrame KeyTime="0:0:0"><Setter Property="Opacity" Value="0.30"/></KeyFrame>
                                            <KeyFrame KeyTime="0:0:15"><Setter Property="Opacity" Value="0.65"/></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Rectangle.Styles>
                        </Rectangle>
                    </Panel>

                    <!-- ═══ Wallpaper Mode — the real desktop wallpaper or a picked image (RemEx-ddynd) ═══
                         The bitmap is decoded once per path change (ShellViewModel) and blurred by an
                         Effect on the Image — nothing here animates, so the blur is not re-rendered per
                         frame. The surface veil sits over it at the WINDOW opacity, the same knob Glass
                         mode uses for "how much shows through", so text keeps its contrast — with a
                         Light-mode floor (VeilOpacityConverter.LightFloor, RemEx-4kv0g.5.1) so a light
                         palette gets a light ground rather than dark ink on a dark wallpaper. -->
                    <Panel IsVisible="{Binding EffectiveBackgroundType, Converter={x:Static converters:StringMatchConverter.IsWallpaper}}">
                        <Image Source="{Binding WallpaperBitmap}" Stretch="UniformToFill"
                               Effect="{Binding WallpaperBlurRadius, Converter={x:Static converters:BlurRadiusToEffectConverter.Instance}}" />
                        <Rectangle Classes="palette-bg" Fill="{DynamicResource GlassBaseDarkBrush}">
                            <Rectangle.Opacity>
                                <MultiBinding Converter="{x:Static converters:VeilOpacityConverter.Instance}" ConverterParameter="1.0">
                                    <Binding Path="Customization.AppWindowOpacity"/>
                                    <Binding Path="$self.ActualThemeVariant"/>
                                </MultiBinding>
                            </Rectangle.Opacity>
                        </Rectangle>
                    </Panel>

                    <!-- ═══ TINTS OVER OS BACKDROPS COMPENSATE FOR AN OPAQUE BRUSH (RemEx-c437b).
                         These panels sit over a TRANSPARENT window whose real surface is the OS
                         backdrop (Acrylic / bare desktop). They were authored when GlassBaseDark
                         was #A00A0A10 — alpha 0xA0, 63% — so a bare Fill already let the backdrop
                         through. ThemeService now overrides GlassBaseDark with the HCT-solved
                         Surface at full alpha (26 files consume it; its opacity is not this
                         control's to change), which silently turned these tints into opaque sheets:
                         Acrylic went 63%→100% and the backdrop vanished. Each Rectangle therefore
                         carries the old EFFECTIVE opacity as a ceiling. Acrylic (RemEx-mmrgc) scales
                         that ceiling by Customization.GlassOpacity, so Card Opacity's "Clear" leaves
                         the backdrop nearly bare and "Frosted" reproduces the old fixed value — Glass's
                         tint stays a fixed literal below. Solid mode is the one mode whose sheet is
                         opaque on purpose. For Wallpaper and Acrylic the scaling lives in
                         VeilOpacityConverter, which also takes the rectangle's ActualThemeVariant: when
                         the palette resolves LIGHT the veil is raised to VeilOpacityConverter.LightFloor
                         (RemEx-4kv0g.5.1), because the light Surface at 0.25 cannot lift a dark
                         backdrop and the light palette's dark ink landed on a dark ground. Dark keeps
                         the measured ceilings untouched. Mica stays on MultiplyConverter with no floor —
                         DWM paints Mica light or dark to match the theme, so see its panel below. -->

                    <!-- ═══ Glass / Acrylic Mode (Material 3 Style) ═══ -->
                    <Panel IsVisible="{Binding EffectiveBackgroundType, Converter={x:Static converters:StringMatchConverter.IsAcrylic}}">
                        <!-- Veil scales with Card Opacity: GlassOpacity × 0.25 ceiling (RemEx-mmrgc).
                             Clear (0.01) ≈ no veil, Frosted (1.0) reproduces today's fixed 0.25.
                             Light mode floors the result (see the block comment above). -->
                        <Rectangle Classes="palette-bg" Fill="{DynamicResource GlassBaseDarkBrush}">
                            <Rectangle.Opacity>
                                <MultiBinding Converter="{x:Static converters:VeilOpacityConverter.Instance}" ConverterParameter="0.25">
                                    <Binding Path="Customization.GlassOpacity"/>
                                    <Binding Path="$self.ActualThemeVariant"/>
                                </MultiBinding>
                            </Rectangle.Opacity>
                        </Rectangle>
                        <Rectangle Opacity="{Binding Customization.GlassOpacity}">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{DynamicResource AccentPrimary}" Opacity="0.15" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Panel>

                    <!-- ═══ Mica Mode (Windows 11 22H2+, RemEx-rq0xl) ═══
                         Mica itself supplies the colour: MainWindow requests a Transparent window and
                         MicaBackdrop.cs calls DwmSetWindowAttribute(DWMWA_SYSTEMBACKDROP_TYPE) so DWM
                         paints the wallpaper-derived backdrop directly (see
                         docs/REGRESSION-GUARDS.md, "Mica is requested as Transparent + our own DWM
                         call" — the TransparencyLevelHint=Mica hint paints Avalonia's own flat layer
                         instead and never reaches DWM at all). This panel therefore carries only the
                         same GlassOpacity-derived veil Acrylic uses to keep ink legible — no accent
                         tint (Mica is not re-tinted) and no wallpaper Image (DWM already paints it). -->
                    <Panel IsVisible="{Binding EffectiveBackgroundType, Converter={x:Static converters:StringMatchConverter.IsMica}}">
                        <!-- Mica is EXEMPT from the Light-mode floor the Wallpaper and Acrylic veils carry
                             (RemEx-4kv0g.5.1). MicaBackdrop.TryApply sets DWMWA_USE_IMMERSIVE_DARK_MODE from
                             the theme, so DWM already paints a LIGHT Mica under a light palette — the ink is
                             legible without a floor, and light Mica is such a faint wash (confirmed on
                             26200, RemEx-kir7r) that a 0.55 veil would erase the only Mica there is. -->
                        <Rectangle Classes="palette-bg" Fill="{DynamicResource GlassBaseDarkBrush}" Opacity="{Binding Customization.GlassOpacity, Converter={x:Static converters:MultiplyConverter.Instance}, ConverterParameter=0.25, FallbackValue=0.0, TargetNullValue=0.0}" />
                    </Panel>

                    <!-- ═══ Glass Mode — Frosted / see-through overlay ═══ -->
                    <!-- The window itself is transparent; this panel adds only a subtle frosted tint
                 so UI elements remain readable when the desktop shows behind the window. -->
                    <Panel IsVisible="{Binding EffectiveBackgroundType, Converter={x:Static converters:StringMatchConverter.IsGlass}}">
                        <!-- 0.25 × the old 0.63 brush alpha ≈ 0.16 -->
                        <Rectangle Classes="palette-bg" Fill="{DynamicResource GlassBaseDarkBrush}" Opacity="0.16" />
                        <!-- Very light accent tint to tint the frost toward the theme color -->
                        <Rectangle Classes="palette-bg" Fill="{DynamicResource AccentPrimaryBrush}" Opacity="0.08" />
                    </Panel>

                    <!-- ═══ Solid Mode — Surface base + accent tint from color picker ═══ -->
                    <Panel IsVisible="{Binding EffectiveBackgroundType, Converter={x:Static converters:StringMatchConverter.IsSolid}}">
                        <Rectangle Classes="palette-bg" Fill="{DynamicResource GlassBaseDarkBrush}" />
                        <!-- Accent tint driven by Glass Opacity slider so color picker affects the result -->
                        <Rectangle Classes="palette-bg" Opacity="{Binding Customization.GlassOpacity}" Fill="{DynamicResource AccentPrimaryBrush}" />
                    </Panel>
                </Grid>

                <!-- Main Content -->
                <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>
        </ControlTemplate>
    </ContentControl.Template>
</ContentControl>
