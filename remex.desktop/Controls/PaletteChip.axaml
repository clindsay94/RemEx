<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Remex.Desktop.Controls"
    x:Class="Remex.Desktop.Controls.PaletteChip">

    <!-- ═══ PaletteChip (spec 2026-09-13 personalize-tabs §3, RemEx-9ql7v; fix round 1,
         RemEx-4kv0g.4.1) ═══ All three chip rows (scheme variants, built-in presets, saved palettes)
         painted their own colours as three dots plus a caption; this replaces that with the
         palette's own three accents AS the fill, geometry C: primary the left 62% at full height,
         secondary the top half of the right 38%, tertiary the bottom half.

         FILL AND LABEL ONLY - NO RING OF ITS OWN. The chip used to draw its own selection border on
         top of the host Button's ".tile.selected" ring (App.axaml:576-612), which stacked into two
         concentric rings at different radii on preset tiles (review-1-report.md MEDIUM #1). The
         button's ring is the only one now; this control is just the fixed ChipWidth x ChipHeight box,
         clipped to CornerRadius, holding the three fill regions and the label.

         The label sits on the primary field and gets its ink from Remex.Core.Theming.ChipInk against
         Primary's own colour (PaletteChip.axaml.cs, OnPropertyChanged) - black or white, whichever the
         palette engine would already call "on-primary" for that tone. Primary is not always a solid
         brush (a caller could hand this control anything IBrush), so LabelBrush can be null - and a
         DynamicResourceExtension stored in TargetNullValue is never evaluated (it's an IBinding, not a
         value; review-1-report.md MEDIUM #2), so the fallback is a real Style instead: the plain
         "TextBlock#PART_Label" style below sets the default Foreground, and the "TextBlock#PART_Label.
         inked" style overrides it with LabelBrush once PaletteChip.axaml.cs has a real colour to hand
         it, toggling the "inked" class alongside LabelBrush in the same OnPropertyChanged branch so
         the two never go out of sync. -->

    <Grid Width="{x:Static controls:PaletteChip.ChipWidth}" Height="{x:Static controls:PaletteChip.ChipHeight}">
        <Border Name="PART_OuterBorder"
                ClipToBounds="True"
                CornerRadius="{Binding $parent[controls:PaletteChip].CornerRadius}">
            <Grid ColumnDefinitions="62*,38*" RowDefinitions="*,*">
                <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                        Background="{Binding $parent[controls:PaletteChip].Primary}"/>
                <Border Grid.Column="1" Grid.Row="0"
                        Background="{Binding $parent[controls:PaletteChip].Secondary}"/>
                <Border Grid.Column="1" Grid.Row="1"
                        Background="{Binding $parent[controls:PaletteChip].Tertiary}"/>

                <TextBlock Name="PART_Label"
                           Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                           Text="{Binding $parent[controls:PaletteChip].Label}"
                           Theme="{StaticResource Body2TextBlock}"
                           FontWeight="Bold"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="TextBlock#PART_Label">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock#PART_Label.inked">
            <Setter Property="Foreground" Value="{Binding $parent[controls:PaletteChip].LabelBrush}"/>
        </Style>
    </UserControl.Styles>
</UserControl>
