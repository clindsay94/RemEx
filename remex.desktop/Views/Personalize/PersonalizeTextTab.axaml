<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
    x:Class="Remex.Desktop.Views.Personalize.PersonalizeTextTab" x:DataType="vm:CustomizationViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">

            <!-- ═══ Text (RemEx-jt6w5) ═══ Readability first: per-section size and bold, the
                 legibility halo, and the sensor-title backdrop. Every value applies live
                 (ApplyAndSave → ThemeService → TypographyService) and persists with the rest of
                 Personalize; the sheet is made of these roles, so it previews itself. -->
            <material:Card Padding="20">
                <StackPanel Spacing="16">
                    <!-- ColumnDefinitions="Auto,*,Auto,Auto": label, slider (fills remaining width), value
                         label, Bold switch (no On/Off content — the sheet is too narrow for it; the
                         accessible name below carries the label a sighted user gets from the content). -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{local:Localize Custom_TextHeadersTip}">
                        <TextBlock Text="{local:Localize Custom_TextHeaders}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Column="1" Value="{Binding HeadersScale}" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextHeaders}"/>
                        <TextBlock Grid.Column="2" Text="{Binding HeadersSizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="48" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{local:Localize Custom_TextSizeLabelTip}"/>
                        <ToggleSwitch Grid.Column="3" IsChecked="{Binding HeadersBold}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextHeadersBold}"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{local:Localize Custom_TextBodyTip}">
                        <TextBlock Text="{local:Localize Custom_TextBody}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Column="1" Value="{Binding BodyScale}" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextBody}"/>
                        <TextBlock Grid.Column="2" Text="{Binding BodySizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="48" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{local:Localize Custom_TextSizeLabelTip}"/>
                        <ToggleSwitch Grid.Column="3" IsChecked="{Binding BodyBold}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextBodyBold}"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{local:Localize Custom_TextSmallTip}">
                        <TextBlock Text="{local:Localize Custom_TextSmall}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Column="1" Value="{Binding SmallScale}" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextSmall}"/>
                        <TextBlock Grid.Column="2" Text="{Binding SmallSizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="48" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{local:Localize Custom_TextSizeLabelTip}"/>
                        <ToggleSwitch Grid.Column="3" IsChecked="{Binding SmallBold}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextSmallBold}"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{local:Localize Custom_TextSensorTip}">
                        <TextBlock Text="{local:Localize Custom_TextSensor}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Slider Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Column="1" Value="{Binding SensorScale}" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextSensor}"/>
                        <TextBlock Grid.Column="2" Text="{Binding SensorSizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="48" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{local:Localize Custom_TextSizeLabelTip}"/>
                        <ToggleSwitch Grid.Column="3" IsChecked="{Binding SensorBold}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextSensorBold}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{local:Localize Custom_TextSensorBackdropTip}">
                        <TextBlock Text="{local:Localize Custom_TextSensorBackdrop}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding SensorTitleBackdrop}" OnContent="{local:Localize Common_On}" OffContent="{local:Localize Common_Off}" HorizontalAlignment="Right" AutomationProperties.Name="{local:Localize Custom_TextSensorBackdrop}"/>
                    </Grid>

                    <Separator Background="{DynamicResource CardBorderBrush}" Opacity="0.3"/>

                    <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_TextShadowTip}">
                        <TextBlock Text="{local:Localize Custom_TextShadow}" VerticalAlignment="Center"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding TextShadowEnabled}" OnContent="{local:Localize Common_On}" OffContent="{local:Localize Common_Off}" HorizontalAlignment="Left" AutomationProperties.Name="{local:Localize Custom_TextShadow}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,2*" IsEnabled="{Binding TextShadowEnabled}">
                        <TextBlock Text="{local:Localize Custom_TextShadowStrength}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="10" Value="{Binding TextShadowStrength}" Width="160" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextShadowStrength}"/>
                            <TextBlock Text="{Binding TextShadowStrength, StringFormat={}{0:F0}}" VerticalAlignment="Center" MinWidth="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>

                    <Button Classes="tertiary" Content="{local:Localize Custom_TextReset}" Command="{Binding ResetTextToDefaultsCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{local:Localize Custom_TextReset}"/>

                    <!-- ═══ Fonts ═══ Lifted verbatim out of the retired Advanced-tuning
                         disclosure (spec §2): page-title font and content font are typography, so
                         they join the rest of this tab under a new sub-heading rather than staying
                         behind a disclosure. -->
                    <TextBlock Text="{local:Localize Custom_SectionFonts}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                    <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_PageTitleFontTip}">
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedPageTitleFont}" HorizontalAlignment="Left" Width="200" MaxDropDownHeight="340" AutomationProperties.Name="{local:Localize Custom_PageTitleFont}" assists:ComboBoxAssist.Label="{local:Localize Custom_PageTitleFont}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_ContentFontTip}">
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedBodyFont}" HorizontalAlignment="Left" Width="200" MaxDropDownHeight="340" AutomationProperties.Name="{local:Localize Custom_ContentFont}" assists:ComboBoxAssist.Label="{local:Localize Custom_ContentFont}"/>
                    </Grid>

                    <!-- Shown only when a chosen font can't be loaded on this machine; the app falls back safely. -->
                    <!-- Warning colours come from the theme, not literals: the amber pair below was
                         mixed for a dark glass background and washes out on SolarFlare, whose surface
                         is near-white. Both keys exist in all four themes (RemEx-fy0a). -->
                    <Border Background="{DynamicResource SystemWarningBackgroundBrush}" BorderBrush="{DynamicResource SystemWarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" IsVisible="{Binding HasFontWarning}">
                        <TextBlock Text="{Binding FontWarning}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </material:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
