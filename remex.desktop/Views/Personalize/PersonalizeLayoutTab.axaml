<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
    x:Class="Remex.Desktop.Views.Personalize.PersonalizeLayoutTab" x:DataType="vm:CustomizationViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16">

            <!-- ═══ UI scale ═══ Governs the whole shell's density. Snap to grid, grid size and the
                 pinned-sensors list moved off this tab in RemEx-172ba (Sensors page / per-card pins). -->
            <material:Card Padding="20">
                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_UiScaleTip}">
                    <TextBlock Text="{local:Localize Custom_UiScale}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                        <Slider Minimum="0.85" Maximum="1.3" SmallChange="0.05" LargeChange="0.1" Value="{Binding UiScale}" Width="168" VerticalAlignment="Center" TickFrequency="0.05" TickPlacement="BottomRight" IsSnapToTickEnabled="True" AutomationProperties.Name="{local:Localize Custom_UiScale}"/>
                        <TextBlock Text="{Binding UiScale, StringFormat={}{0:P0}}" VerticalAlignment="Center" MinWidth="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </material:Card>

            <!-- ═══ Behaviour ═══ -->
            <material:Card Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="{local:Localize Custom_SectionBehaviour}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                    <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_WelcomeSplashTooltip}">
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ComboBox SelectedItem="{Binding SplashStyle}" ItemsSource="{Binding AvailableSplashStyles}" HorizontalAlignment="Left" Width="160" AutomationProperties.Name="{local:Localize Custom_SplashScreen}" assists:ComboBoxAssist.Label="{local:Localize Custom_SplashScreen}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:CompileBindings="False">
                                        <TextBlock Text="{Binding Converter={x:Static local:SplashStyleLabelConverter.Instance}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Classes="tertiary compact" Content="{local:Localize Custom_Preview}" Command="{Binding PreviewSplashCommand}" AutomationProperties.Name="{local:Localize Custom_Preview}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="{DynamicResource CardBorderBrush}" Opacity="0.3"/>

                    <!-- Reduced Motion -->
                    <Grid ColumnDefinitions="*,2*">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{local:Localize Custom_ReducedMotionTitle}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{local:Localize Custom_ReducedMotionDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch AutomationProperties.Name="{local:Localize Custom_ReducedMotionTitle}" Grid.Column="1" IsChecked="{Binding IsReducedMotion}" HorizontalAlignment="Left"/>
                    </Grid>
                </StackPanel>
            </material:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>
