<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:models="using:Remex.Desktop.Models"
    xmlns:local="clr-namespace:Remex.Desktop.Converters" mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="400" x:Class="Remex.Desktop.Views.CommandPaletteWindow" x:DataType="vm:CommandPaletteViewModel" Title="{local:Localize CommandPalette_Title}" Width="540" MaxHeight="480" SizeToContent="Height" WindowDecorations="None" Background="{DynamicResource GlassBaseDarkBrush}" WindowStartupLocation="CenterOwner" CanResize="False" Topmost="True" ShowInTaskbar="False" TransparencyLevelHint="AcrylicBlur">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding DismissCommand}" />
    </Window.KeyBindings>

    <Border CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="0,0,0,8">

        <StackPanel>

            <!-- Search Box -->
            <Grid ColumnDefinitions="Auto, *" Margin="16,16,16,8">
                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="{local:Localize CommandPalette_SearchWatermark}" FontSize="15" Background="Transparent" BorderThickness="0" Padding="0" CaretBrush="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>

            <!-- Divider -->
            <Rectangle Height="1" Fill="{DynamicResource CardBorderBrush}" Margin="12,0" />

            <!-- Results -->
            <ListBox ItemsSource="{Binding FilteredResults}" x:Name="ResultsList" MaxHeight="360" Background="Transparent" BorderThickness="0" Margin="8,4,8,0" SelectionMode="Single">

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CommandPaletteEntry}">
                        <Grid ColumnDefinitions="*, Auto" Margin="4,2">
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                <!-- Foreground and Opacity come from the styles below, NOT from here
                                     (RemEx-o9gd). A local value beats a style setter in Avalonia, so
                                     setting them inline would make the selected-state rules silently
                                     inert - which is exactly the failure this change fixes. -->
                                <TextBlock Classes="palette-label" Text="{Binding Label}" FontSize="13" />
                                <TextBlock Classes="palette-category" Text="{Binding Category}" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                    <!-- /template/ IS REQUIRED HERE, not fragile decoration (RemEx-f51fa). The
                         tempting tidy-up — set Background on the ListBoxItem and let the template
                         binding carry it — silently loses both fills: Fluent 12.1.1's ListBoxItem
                         ControlTheme set :pointerover and :selected Backgrounds directly on
                         PART_ContentPresenter (ControlTheme style + activator, frame 5), which
                         outranked the TemplateBinding (frame 6) a control-level value would ride in
                         on. Only another presenter-level setter with an activator (app style,
                         frame 3) beat it — which is exactly what these are. The app now applies
                         Material 3.19.0 instead, whose ListBoxItem template has no ContentPresenter
                         at all — re-verify the /template/ ContentPresenter selectors below still
                         match anything under Material before relying on this file again, or the
                         o9gd text recolours further down would sit on an unpainted fill. -->
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                    </Style>

                    <!-- ═══ Row text, and it has to follow the fill (RemEx-o9gd) ═══
                         The selected row is filled with the accent, and both labels used to keep
                         their normal-background colours regardless. Measured against each theme's
                         own accent that is 4.88 / 1.31 / 3.65 / 10.29 for the label and
                         1.99 / 1.37 / 1.12 / 5.97 for the category — CyberNOC's 1.31 is worse than
                         the 1.38 headline RemEx-iegl was raised to fix, and the row a user is
                         actually pointing at is the one that goes unreadable.

                         AccentForegroundBrush is the per-theme token that exists for exactly this
                         surface, and AccentForegroundContrastTests already pins it at AA or better
                         against every theme's accent. -->
                    <Style Selector="ListBoxItem TextBlock.palette-label">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem TextBlock.palette-category">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Opacity" Value="0.7" />
                    </Style>

                    <Style Selector="ListBoxItem:selected TextBlock.palette-label">
                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected TextBlock.palette-category">
                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />

                        <!-- FULL OPACITY ON THE SELECTED ROW, and this is measured rather than
                             tidy-minded. The 0.7 that dims this label on a normal background
                             composites toward the accent when the row is filled, and that costs
                             enough to fail AA on two themes even with the correct colour. The token
                             is only guaranteed at full strength, so the dimming is dropped exactly
                             where the guarantee is needed. -->
                        <Setter Property="Opacity" Value="1.0" />
                    </Style>
                </ListBox.Styles>

            </ListBox>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyStateText" IsVisible="{Binding IsEmpty}" Text="{local:Localize CommandPalette_NoCommands}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,12,0,4" />

        </StackPanel>
    </Border>
</Window>
