<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:models="using:Remex.Desktop.Models"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    xmlns:mi="using:Material.Icons.Avalonia" mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="400" x:Class="Remex.Desktop.Views.CommandPaletteWindow" x:DataType="vm:CommandPaletteViewModel" Title="{local:Localize CommandPalette_Title}" Width="540" MaxHeight="480" SizeToContent="Height" WindowDecorations="None" Background="{DynamicResource GlassBaseDarkBrush}" WindowStartupLocation="CenterOwner" CanResize="False" Topmost="True" ShowInTaskbar="False" TransparencyLevelHint="AcrylicBlur">

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding DismissCommand}" />
    </Window.KeyBindings>

    <Border x:Name="PaletteSurface" CornerRadius="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="0,0,0,8" Opacity="0" RenderTransformOrigin="50%,0%" RenderTransform="scale(0.98)">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
            </Transitions>
        </Border.Transitions>

        <StackPanel>

            <!-- Search Box -->
            <Grid ColumnDefinitions="Auto, *" Margin="16,16,16,8">
                <mi:MaterialIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchText}" PlaceholderText="{local:Localize CommandPalette_SearchWatermark}" FontSize="15" CaretBrush="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Grid>

            <!-- Divider -->
            <Rectangle Height="1" Fill="{DynamicResource CardBorderBrush}" Margin="12,0" />

            <!-- Results -->
            <ListBox ItemsSource="{Binding FilteredResults}" x:Name="ResultsList" MaxHeight="360" Background="Transparent" BorderThickness="0" Margin="8,4,8,0" SelectionMode="Single">

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:CommandPaletteEntry}">
                        <Grid ColumnDefinitions="*, Auto" Margin="4,2">
                            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                                <!-- Foreground and Opacity come from the styles below, NOT from here
                                     (RemEx-o9gd). A local value beats a style setter in Avalonia, so
                                     setting them inline would make the selected-state rules silently
                                     inert - which is exactly the failure this change fixes. -->
                                <TextBlock Classes="palette-label" Text="{Binding Label}" Theme="{StaticResource Subtitle2TextBlock}" />
                                <TextBlock Classes="palette-category" Text="{Binding Category}" Theme="{StaticResource CaptionTextBlock}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Padding" Value="10,6" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                    <!-- BOTH FILLS GO ON THE CONTROL (RemEx-f51fa, corrected by RemEx-3ule6). These
                         two selectors used to read `/template/ ContentPresenter`, which was right
                         for Fluent 12.1.1: Fluent set its OWN :pointerover and :selected Backgrounds
                         on PART_ContentPresenter, so only a part-level app style outranked them.
                         RemEx-prkot then handed every template to Material 3.19.0 (App.axaml), whose
                         ListBoxItem has NO ContentPresenter part at all — it is
                         Border#PART_RootBorder > Panel#PART_RootPanel > { Border#PART_BehaviourEffect,
                         RippleEffect#PART_Ripple, Border#PART_HoverEffect }, with the content inside
                         the ripple. Both selectors matched nothing, the fills vanished, and the o9gd
                         text recolours below kept firing over Material's own faint scrim — an
                         accent-tinted label on a nearly-unpainted row, which is the
                         unreadable-selected-row bug o9gd was raised to fix.

                         A CONTROL-LEVEL Background IS ENOUGH UNDER MATERIAL, and that is the whole
                         difference from the Fluent era. Material template-binds Background to
                         PART_RootBorder — the outermost, bottom-most Border, drawn beneath the
                         content and already carrying the CornerRadius — and sets no competing
                         Background on any part, so there is nothing to outrank and no part name to
                         go stale. This is how the shipped nav rail paints its selection
                         (ShellView.axaml, ListBoxItem.nav-item:selected), what
                         docs/REGRESSION-GUARDS.md records about PART_RootBorder, and the invariant
                         FocusVisibleStyleGuardTests pins for ListBoxItem under Material
                         (RemEx-kgs7g — same control, same theme, same root cause). Reaching into
                         the template for a plain fill would render identically; it just buys a part
                         name that the next Material bump can rename out from under us.

                         AND NOT PART_HoverEffect, which is the tempting target because it IS what
                         Material varies for these states: it is the LAST child of the panel, so it
                         paints OVER the content, and an opaque accent there covers the label rather
                         than backing it.

                         :selected is declared after :pointerover on purpose — same priority, so the
                         later one wins and a hovered selected row keeps the accent. -->
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                    </Style>

                    <!-- AND MATERIAL'S OWN SELECTED VEIL GOES WHERE THE GUARANTEE IS MEASURED
                         (RemEx-3ule6). /template/ IS required here, unlike the fills above: Opacity
                         on the control would fade the whole row, and it is specifically Material's
                         :selected state layer — MaterialBodyBrush at 0.12 on PART_HoverEffect —
                         that must stop compositing over the accent. AccentForegroundBrush is pinned
                         at AA against each theme's RAW accent by AccentForegroundContrastTests, and
                         a body-coloured scrim over that fill measures something else. The accent IS
                         the selection indicator on this row, so the veil is redundant as well as
                         inaccurate.

                         SCOPED TO :not(:pointerover) DELIBERATELY (review). Zeroing it
                         unconditionally made the selected row pixel-identical hovered and unhovered
                         — the one row in the list that stopped answering the pointer. Under the
                         pointer Material's veil comes back, which is what shipped before this bead;
                         the keyboard path (arrow onto a row, read it, press Enter) is the one the AA
                         measurement describes, and it is now the one that renders it. Unselected
                         rows keep Material's 0.05 hover veil on top of CardBackgroundHoverBrush,
                         which carries no contrast guarantee to void. -->
                    <Style Selector="ListBoxItem:selected:not(:pointerover) /template/ Border#PART_HoverEffect">
                        <Setter Property="Opacity" Value="0" />
                    </Style>

                    <!-- ═══ Row text, and it has to follow the fill (RemEx-o9gd) ═══
                         The selected row is filled with the accent, and both labels used to keep
                         their normal-background colours regardless. Measured against each theme's
                         own accent that is 4.88 / 1.31 / 3.65 / 10.29 for the label and
                         1.99 / 1.37 / 1.12 / 5.97 for the category — CyberNOC's 1.31 is worse than
                         the 1.38 headline RemEx-iegl was raised to fix, and the row a user is
                         actually pointing at is the one that goes unreadable.

                         AccentForegroundBrush is the per-theme token that exists for exactly this
                         surface, and AccentForegroundContrastTests already pins it at AA or better
                         against every theme's accent. -->
                    <Style Selector="ListBoxItem TextBlock.palette-label">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem TextBlock.palette-category">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Opacity" Value="0.7" />
                    </Style>

                    <Style Selector="ListBoxItem:selected TextBlock.palette-label">
                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected TextBlock.palette-category">
                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />

                        <!-- FULL OPACITY ON THE SELECTED ROW, and this is measured rather than
                             tidy-minded. The 0.7 that dims this label on a normal background
                             composites toward the accent when the row is filled, and that costs
                             enough to fail AA on two themes even with the correct colour. The token
                             is only guaranteed at full strength, so the dimming is dropped exactly
                             where the guarantee is needed. -->
                        <Setter Property="Opacity" Value="1.0" />
                    </Style>
                </ListBox.Styles>

            </ListBox>

            <!-- Empty state -->
            <TextBlock x:Name="EmptyStateText" IsVisible="{Binding IsEmpty}" Text="{local:Localize CommandPalette_NoCommands}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Theme="{StaticResource CaptionTextBlock}" Margin="0,12,0,4" />

        </StackPanel>
    </Border>
</Window>
