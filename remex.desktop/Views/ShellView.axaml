<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    xmlns:ctrl="using:Remex.Desktop.Controls"
    xmlns:views="using:Remex.Desktop.Views" x:Class="Remex.Desktop.Views.ShellView" x:DataType="vm:ShellViewModel">

    <UserControl.Styles>
        <!-- ═══ Sidebar nav item base ═══ -->
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.nav-item:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.nav-item-active">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource AccentPrimary}" Opacity="0.15"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>
        <!-- Nav rail icon fill follows button state -->
        <Style Selector="Button.nav-item Path">
            <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Fill" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item:pointerover Path">
            <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.nav-item-active Path">
            <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>

        <!-- ═══ Settings overlay panel ═══ -->
        <Style Selector="Border.settings-overlay">
            <Setter Property="RenderTransform" Value="translateX(420px)"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.settings-overlay.open">
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- ═══ Gear FAB ═══ -->
        <Style Selector="Button.gear-fab">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gear-fab:pointerover">
            <Setter Property="RenderTransform" Value="rotate(180deg) scale(1.1)"/>
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="Button.gear-fab:pressed">
            <Setter Property="RenderTransform" Value="rotate(180deg) scale(0.95)"/>
        </Style>
    </UserControl.Styles>

    <ctrl:DashboardBackgroundControl>
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- ═══ TITLE BAR DRAG REGION ═══ -->
            <Border Grid.Row="0" Height="32" Background="Transparent" IsHitTestVisible="False"/>

            <!-- ═══ MAIN LAYOUT: Sidebar + Content ═══ -->
            <SplitView Grid.Row="1" IsPaneOpen="{Binding IsDrawerOpen}" DisplayMode="CompactOverlay" OpenPaneLength="{Binding OpenPaneLength}" CompactPaneLength="{Binding CompactPaneLength}" PaneBackground="Transparent" IsVisible="{Binding !IsShellChromeHidden}">

                <SplitView.Pane>
                    <Border IsVisible="{Binding IsDesktop}">
                        <Border Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <!-- ═══ Top: Brand / Header ═══ -->
                                <StackPanel Grid.Row="0" Margin="0,16,0,8">
                                    <Button Classes="nav-item" Width="48" Height="48" CornerRadius="{DynamicResource CornerRadiusLarge}" Command="{Binding ToggleDrawerCommand}" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0">
                                        <Path Data="{StaticResource IconLauncher}" Fill="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Text="REMEX" FontSize="11" FontWeight="Black" LetterSpacing="4" HorizontalAlignment="Center" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="4,12,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                    
                                    <!-- Command Palette Hint -->
                                    <Button Command="{Binding OpenCommandPaletteCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,8,0,0" IsVisible="{Binding IsDrawerOpen}" ToolTip.Tip="{conv:Localize Shell_OpenCommandPaletteTooltip}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Opacity="0.5">
                                            <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ctrl+Shift+P" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- ═══ Navigation Items ═══ -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="4" Margin="0,8">
                                        <!-- Home Dashboard -->
                                        <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}" Command="{Binding NavigateToHomeCommand}" ToolTip.Tip="{conv:Localize Nav_Home}">
                                            <Grid ColumnDefinitions="48,*">
                                                <Path Grid.Column="0" Data="{StaticResource IconHome}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Home}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Live Sensors -->
                                        <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}" Command="{Binding NavigateToCanvasCommand}" ToolTip.Tip="{conv:Localize Nav_Sensors}">
                                            <Grid ColumnDefinitions="48,*">
                                                <Path Grid.Column="0" Data="{StaticResource IconSensors}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Sensors}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Remote Control -->
                                        <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}" Command="{Binding NavigateToRemoteCommand}" ToolTip.Tip="{conv:Localize Nav_Remote}">
                                            <Grid ColumnDefinitions="48,*">
                                                <Path Grid.Column="0" Data="{StaticResource IconRemote}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Remote}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- App Launcher -->
                                        <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}" Command="{Binding NavigateToAppLauncherCommand}" ToolTip.Tip="{conv:Localize Nav_Launcher}">
                                            <Grid ColumnDefinitions="48,*">
                                                <Path Grid.Column="0" Data="{StaticResource IconLauncher}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Launcher}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Task Manager -->
                                        <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}" Command="{Binding NavigateToTaskManagerCommand}" ToolTip.Tip="{conv:Localize Nav_Tasks}">
                                            <Grid ColumnDefinitions="48,*">
                                                <Path Grid.Column="0" Data="{StaticResource IconTasks}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Tasks}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- File Explorer -->
                                        <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=7}" Command="{Binding NavigateToFileTransferCommand}" ToolTip.Tip="{conv:Localize Nav_Files}">
                                            <Grid ColumnDefinitions="48,*">
                                                <Path Grid.Column="0" Data="{StaticResource IconFiles}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Files}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- About -->
                                        <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=6}" Command="{Binding NavigateToAboutCommand}" ToolTip.Tip="{conv:Localize Shell_About}">
                                            <Grid ColumnDefinitions="48,*">
                                                <Path Grid.Column="0" Data="{StaticResource IconAbout}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Shell_About}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Logs & Diagnostics -->
                                        <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=8}" Command="{Binding NavigateToDiagnosticLogsCommand}" ToolTip.Tip="{conv:Localize Shell_LogsDiagnostics}">
                                            <Grid ColumnDefinitions="48,*">
                                                <Path Grid.Column="0" Data="{StaticResource IconLogs}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Shell_LogsDiagnostics}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <Separator Height="1" Background="{DynamicResource CardBorderBrush}" Margin="16,12" Opacity="0.3"/>

                                        <!-- Settings -->
                                        <Button Classes="nav-item" Command="{Binding NavigateToSettingsCommand}" ToolTip.Tip="{conv:Localize Nav_Settings}">
                                            <Grid ColumnDefinitions="48,*">
                                                <Path Grid.Column="0" Data="{StaticResource IconSettings}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Settings}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- ═══ Bottom: Connection Status ═══ -->
                                <Border Grid.Row="2" Margin="12,4,12,16" Padding="4" CornerRadius="{DynamicResource CornerRadiusMedium}" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="48,*">
                                        <Ellipse Grid.Column="0" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding Connection.IsConnected, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter=#22C55E|#F43F5E}"/>
                                            </Ellipse.Fill>
                                            <Ellipse.Transitions>
                                                <Transitions>
                                                    <BrushTransition Property="Fill" Duration="0:0:0.4"/>
                                                </Transitions>
                                            </Ellipse.Transitions>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0" IsVisible="{Binding IsDrawerOpen}">
                                            <TextBlock Text="{Binding Connection.StatusText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Connection.LatencyText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding Connection.IsConnected}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Border>
                </SplitView.Pane>

                <!-- ═══ PAGE CONTENT ═══ -->
                <SplitView.Content>
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- ═══ CONNECTION BANNER ═══ -->
                        <Border Grid.Row="0" IsVisible="{Binding ShowConnectionBanner}" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Border.Transitions>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <Path Grid.Column="0" Data="{StaticResource IconWarning}" Fill="{DynamicResource SystemWarningBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionBannerMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Content="{conv:Localize Btn_Connect}" Command="{Binding Connection.ConnectCommand}" Background="{DynamicResource SystemSuccessBrush}" Foreground="White" Padding="10,5" CornerRadius="6" FontSize="11" FontWeight="SemiBold" Margin="12,0,6,0" Cursor="Hand"/>
                                <Button Grid.Column="3" Content="{conv:Localize Shell_OpenSettings}" Command="{Binding NavigateToSettingsCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="10,5" CornerRadius="6" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button Grid.Column="4" Command="{Binding DismissConnectionBannerCommand}" Background="Transparent" Padding="6,4" CornerRadius="6" Cursor="Hand" BorderThickness="0">
                                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ═══ LAYOUT LOAD WARNING BANNER ═══ -->
                        <Border Grid.Row="1" IsVisible="{Binding ShowLayoutLoadWarning}" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource SystemWarningBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Border.Transitions>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Path Grid.Column="0" Data="{StaticResource IconWarning}" Fill="{DynamicResource SystemWarningBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding LayoutLoadWarningMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Command="{Binding DismissLayoutLoadWarningCommand}" Background="Transparent" Padding="6,4" CornerRadius="6" Cursor="Hand" BorderThickness="0">
                                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <TransitioningContentControl Grid.Row="2" Content="{Binding CurrentView}" Name="PageHost">
                            <TransitioningContentControl.DataTemplates>
                                <DataTemplate DataType="vm:HomeViewModel">
                                    <views:HomeView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:CanvasDashboardViewModel">
                                    <views:CanvasView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:RemoteViewModel">
                                    <views:RemoteView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:AppLauncherViewModel">
                                    <views:AppLauncherView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:TaskManagerViewModel">
                                    <views:TaskManagerView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:RemoteDesktopViewModel">
                                    <views:RemoteDesktopView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:AboutViewModel">
                                    <views:AboutView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:FaqViewModel">
                                    <views:FaqView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:ConnectionViewModel">
                                    <views:ConnectionView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:FileTransferViewModel">
                                    <views:FileTransferView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:SettingsViewModel">
                                    <views:SettingsView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiagnosticLogsViewModel">
                                    <views:DiagnosticLogsView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:CustomizationViewModel">
                                    <views:CustomizationView />
                                </DataTemplate>
                            </TransitioningContentControl.DataTemplates>
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.3"/>
                            </TransitioningContentControl.PageTransition>
                        </TransitioningContentControl>
                    </Grid>
                </SplitView.Content>
            </SplitView>

            <!-- ═══ FULLSCREEN REMOTE DESKTOP (bypasses sidebar) ═══ -->
            <TransitioningContentControl Content="{Binding CurrentView}" IsVisible="{Binding IsShellChromeHidden}">
                <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="vm:RemoteDesktopViewModel">
                        <views:RemoteDesktopView />
                    </DataTemplate>
                </TransitioningContentControl.DataTemplates>
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.2"/>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <!-- ═══ SETTINGS OVERLAY BACKDROP ═══ -->
            <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsSettingsPanelOpen}" Background="{DynamicResource GlassOverlayBrush}" PointerPressed="OnSettingsBackdropPressed" IsHitTestVisible="{Binding IsSettingsPanelOpen}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </Border.Transitions>
            </Border>

            <!-- ═══ SETTINGS SLIDE-IN PANEL (Right side) ═══ -->
            <Border Grid.Row="0" Grid.RowSpan="3" x:Name="SettingsPanel" Classes="settings-overlay" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="400" MaxWidth="420" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" BoxShadow="-8 0 40 0 #40000000">
                <Grid RowDefinitions="Auto,*">
                    <!-- Panel header -->
                    <Border Grid.Row="0" Padding="20,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{conv:Localize Shell_SettingsTitle}" FontSize="20" FontWeight="Black" />
                                <TextBlock Text="{conv:Localize Shell_SettingsSubtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1"/>
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseSettingsPanelCommand}" Background="Transparent" Padding="8" CornerRadius="8" BorderThickness="0" VerticalAlignment="Top" Cursor="Hand">
                                <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextMutedBrush}" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Quick-access content: connection status + nav links -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20" Spacing="16">

                            <!-- ═══ CONNECTION STATUS ═══ -->
                            <Border Classes="glass-card" Padding="16">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="{conv:Localize Settings_Connection}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" VerticalAlignment="Center" AutomationProperties.Name="{Binding Connection.StatusText}">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding Connection.IsConnected, Converter={x:Static conv:BoolToColorConverter.Instance}, ConverterParameter=#22C55E|#F43F5E}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Connection.StatusText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Content="{conv:Localize Btn_Connect}" Command="{Binding Connection.ConnectCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="12,8" CornerRadius="8" FontSize="13" FontWeight="Bold" HorizontalAlignment="Stretch" IsVisible="{Binding !Connection.IsConnected}" Cursor="Hand"/>
                                    <Button Content="{conv:Localize Btn_Disconnect}" Command="{Binding Connection.DisconnectCommand}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource SystemErrorBrush}" Padding="12,8" CornerRadius="8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Stretch" IsVisible="{Binding Connection.IsConnected}" BorderBrush="{DynamicResource SystemErrorBrush}" BorderThickness="1" Cursor="Hand"/>
                                </StackPanel>
                            </Border>

                            <!-- ═══ NAVIGATION LINKS ═══ -->
                            <Border Classes="glass-card" Padding="8">
                                <StackPanel Spacing="4">
                                    <Button Content="{conv:Localize Shell_OpenSettings}" Command="{Binding NavigateToSettingsCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="14,10" CornerRadius="8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" BorderThickness="0"/>
                                    <Button Content="{conv:Localize Custom_Header}" Command="{Binding NavigateToCustomizationCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="14,10" CornerRadius="8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" BorderThickness="0"/>
                                    <Button Content="{conv:Localize Shell_About}" Command="{Binding NavigateToAboutCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="14,10" CornerRadius="8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Cursor="Hand" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>


            <!-- ═══ FLOATING GEAR FAB (Bottom-Right) ═══ -->
            <Button Grid.Row="1" Classes="gear-fab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Command="{Binding ToggleSettingsPanelCommand}" ToolTip.Tip="{conv:Localize Shell_SettingsTitle}">
                <Path Data="{StaticResource IconGear}" Fill="White" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsShellChromeHidden"/>
                        <Binding Path="IsDesktop"/>
                    </MultiBinding>
                </Button.IsVisible>
            </Button>

            <Button Grid.Row="1" Classes="gear-fab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,90" Command="{Binding ToggleSettingsPanelCommand}" ToolTip.Tip="{conv:Localize Shell_SettingsTitle}">
                <Path Data="{StaticResource IconGear}" Fill="White" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsShellChromeHidden"/>
                        <Binding Path="IsAndroid"/>
                    </MultiBinding>
                </Button.IsVisible>
            </Button>

            <!-- ═══ WELCOME SPLASH — BOOT SEQUENCE ═══ -->
            <ctrl:BootSequenceControl x:Name="BootSplash" Grid.RowSpan="2" IsVisible="{Binding ShowWelcomeSplash}" AccentColor="{DynamicResource AccentPrimary}" SplashStyle="{Binding Customization.SplashStyle}" ZIndex="999"/>

            <!-- ═══ TUTORIAL OVERLAY (first-run or replay) ═══ -->
            <Border Grid.RowSpan="2" IsVisible="{Binding ShowTutorialOverlay}" Background="{DynamicResource OverlayBackdropBrush}" ZIndex="998">
                <Grid>
                    <Border Width="520" MaxWidth="540" Padding="32,28" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="16">
                            <!-- Header with Skip -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{conv:Localize Tutorial_Header}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="3" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{conv:Localize Tutorial_Skip}" Command="{Binding TutorialSkipCommand}" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Padding="8,4" CornerRadius="6" Cursor="Hand" BorderThickness="0" ToolTip.Tip="{conv:Localize Tutorial_SkipTooltip}"/>
                            </Grid>

                            <!-- Page 0: Welcome -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=0}">
                                <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P0_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P0_Body}"/>
                            </StackPanel>

                            <!-- Page 1: How It Works -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=1}">
                                <TextBlock Text="🔗" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P1_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P1_Body1}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P1_Body2}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Text="{conv:Localize Tutorial_P1_Diagram}"/>
                                </Border>
                            </StackPanel>

                            <!-- Page 2: Service Setup (Windows) -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=2}">
                                <TextBlock Text="⚙️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P2_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P2_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P2_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P2_Note}"/>
                            </StackPanel>

                            <!-- Page 3: Service Setup (Linux) -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=3}">
                                <TextBlock Text="🐧" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P3_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P3_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P3_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P3_Body2}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P3_Link}"/>
                            </StackPanel>

                            <!-- Page 4: HWInfo Setup -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=4}">
                                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P4_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P4_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P4_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FFAA44" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P4_Warning}"/>
                            </StackPanel>

                            <!-- Page 5: Sensors Overview -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=5}">
                                <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P5_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P5_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P5_HWInfo}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P5_BuiltIn}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P5_Body2}"/>
                            </StackPanel>

                            <!-- Page 6: App Launcher -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=6}">
                                <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P6_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P6_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P6_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P6_Note}"/>
                            </StackPanel>

                            <!-- Page 7: Network & Discovery -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=7}">
                                <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P7_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P7_Body1}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P7_Body2}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P7_IpSteps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P7_Body3}"/>
                            </StackPanel>

                            <!-- Page 8: QR Code Pairing -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=8}">
                                <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P8_QR_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P8_QR_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P8_QR_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P8_QR_Body2}"/>
                            </StackPanel>

                            <!-- Page 9: File Transfer -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=9}">
                                <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P9_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P9_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P9_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P9_Body2}"/>
                            </StackPanel>

                            <!-- Page 10: Glossary Command Palette -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=10}">
                                <TextBlock Text="⌨️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_CommandPalette_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_CommandPalette_Body}"/>
                            </StackPanel>

                            <!-- Page 11: Glossary App Launcher -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=11}">
                                <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_AppLauncher_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_AppLauncher_Body}"/>
                            </StackPanel>

                            <!-- Page 12: Glossary Task Manager -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=12}">
                                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_TaskManager_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_TaskManager_Body}"/>
                            </StackPanel>

                            <!-- Page 13: Glossary Sensor Canvas -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=13}">
                                <TextBlock Text="🌡️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_SensorCanvas_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_SensorCanvas_Body}"/>
                            </StackPanel>

                            <!-- Page 14: Glossary File Transfer -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=14}">
                                <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_FileTransfer_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_FileTransfer_Body}"/>
                            </StackPanel>
                            
                            <!-- Page 15: Glossary Remote Desktop -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=15}">
                                <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_RemoteDesktop_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_RemoteDesktop_Body}"/>
                            </StackPanel>

                            <!-- Page 16: Glossary Quick Settings -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=16}">
                                <TextBlock Text="⚙️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_QuickSettings_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_QuickSettings_Body}"/>
                            </StackPanel>
                            
                            <!-- Page 17: Glossary Customization -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=17}">
                                <TextBlock Text="🎨" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_Customization_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_Customization_Body}"/>
                            </StackPanel>

                            <!-- Page 18: You're All Set -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=18}">
                                <TextBlock Text="🎉" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P10_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P10_Body1}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P10_Body2}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P10_Replay}"/>
                            </StackPanel>

                            <!-- Page indicator dots -->
                            <ItemsControl ItemsSource="{Binding TutorialPageDots}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}" Opacity="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Don't Show Again checkbox -->
                            <CheckBox IsChecked="{Binding DontShowTutorialAgain}" Content="{conv:Localize Tutorial_DontShowAgain}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>

                            <!-- Navigation buttons -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Content="{conv:Localize Tutorial_Back}" Command="{Binding TutorialPreviousCommand}" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntNotEqualConverter.Instance}, ConverterParameter=0}" Background="#2A2A4A" Foreground="#C0C0FF" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                                <Button Grid.Column="2" Content="{conv:Localize Tutorial_Next}" Command="{Binding TutorialNextCommand}" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntNotEqualConverter.Instance}, ConverterParameter=18}" Background="#4A3AFF" Foreground="White" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                                <Button Grid.Column="2" Content="{conv:Localize Tutorial_Finish}" Command="{Binding TutorialFinishCommand}" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=18}" Background="#4ADE80" Foreground="#1A1A1A" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══ BOTTOM NAV BAR (ANDROID M3) ═══ -->
            <Border Grid.Row="2" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="IsAndroid"/>
                        <Binding Path="!IsShellChromeHidden"/>
                    </MultiBinding>
                </Border.IsVisible>
                <UniformGrid Columns="5" Height="80" Margin="0,4,0,12">
                    <!-- Home -->
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}" Command="{Binding NavigateToHomeCommand}" VerticalAlignment="Stretch" Margin="4,0" Padding="0">
                        <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Panel>
                                <Border Classes="nav-pill" />
                                <PathIcon Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" Width="24" Height="24" HorizontalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="{conv:Localize Nav_Home}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Sensors -->
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}" Command="{Binding NavigateToCanvasCommand}" VerticalAlignment="Stretch" Margin="4,0" Padding="0">
                        <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Panel>
                                <Border Classes="nav-pill" />
                                <PathIcon Data="M19.03 7.39l1.42-1.42c-4.3-4.29-11.41-4.29-15.71 0l1.42 1.42c3.52-3.51 9.34-3.51 12.87 0zM12 17c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z" Width="24" Height="24" HorizontalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="{conv:Localize Nav_Sensors}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Remote -->
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}" Command="{Binding NavigateToRemoteCommand}" VerticalAlignment="Stretch" Margin="4,0" Padding="0">
                        <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Panel>
                                <Border Classes="nav-pill" />
                                <PathIcon Data="M15 1H9v2h6V1zm-4 13h2V8h-2v6zm8.03-6.61l1.42-1.42c-.43-.51-.9-.99-1.41-1.41l-1.42 1.42C16.07 4.74 14.12 4 12 4c-4.97 0-9 4.03-9 9s4.02 9 9 9 9-4.03 9-9c0-2.12-.74-4.07-1.97-5.61zM12 20c-3.87 0-7-3.13-7-7s3.13-7 7-7 7 3.13 7 7-3.13 7-7 7z" Width="24" Height="24" HorizontalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="{conv:Localize Nav_Remote}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Launcher -->
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}" Command="{Binding NavigateToAppLauncherCommand}" VerticalAlignment="Stretch" Margin="4,0" Padding="0">
                        <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Panel>
                                <Border Classes="nav-pill" />
                                <PathIcon Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z" Width="24" Height="24" HorizontalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="{conv:Localize Nav_Launch}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Tasks -->
                    <Button Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}" Command="{Binding NavigateToTaskManagerCommand}" VerticalAlignment="Stretch" Margin="4,0" Padding="0">
                        <StackPanel Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Panel>
                                <Border Classes="nav-pill" />
                                <PathIcon Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 14h-3v3h-2v-3H8v-2h3v-3h2v3h3v2zm-3-7V3.5L18.5 9H13z" Width="24" Height="24" HorizontalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="{conv:Localize Nav_Tasks}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </ctrl:DashboardBackgroundControl>
</UserControl>
