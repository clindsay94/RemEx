<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    xmlns:ctrl="using:Remex.Desktop.Controls"
    xmlns:splash="using:Remex.Desktop.Controls.Splash"
    xmlns:views="using:Remex.Desktop.Views" x:Class="Remex.Desktop.Views.ShellView" x:DataType="vm:ShellViewModel">

    <UserControl.Styles>
        <!-- ═══ Sidebar nav item base ═══ -->
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.nav-item:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.nav-item-active">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource AccentPrimary}" Opacity="0.22"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>
        <!-- Nav rail icon colour follows button state. MaterialIcon paints with Foreground,
             not Fill, so these selectors must name the property the control actually reads -
             a leftover Fill setter here would compile and simply never apply. -->
        <Style Selector="Button.nav-item mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item:pointerover mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.nav-item-active mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>

        <!-- ═══ Settings overlay panel ═══ -->
        <Style Selector="Border.settings-overlay">
            <!-- Must clear the panel's full width. It is Width=440 with MaxWidth=460, so the old
                 420px left up to 40px of it still inside the viewport - invisible only because
                 Opacity is 0, which means it was still hit-testable and still being composited.
                 460 matches the widest the panel can be (RemEx-vm0j). -->
            <Setter Property="RenderTransform" Value="translateX(460px)"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.settings-overlay.open">
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>

        <!-- ═══ Gear FAB ═══ -->
        <Style Selector="Button.gear-fab">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gear-fab:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1)"/>
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="Button.gear-fab:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>
    </UserControl.Styles>

    <ctrl:DashboardBackgroundControl>
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- ═══ TITLE BAR DRAG REGION ═══ -->
            <Border Grid.Row="0" Height="32" Background="Transparent" IsHitTestVisible="False"/>

            <!-- ═══ MAIN LAYOUT: Sidebar + Content ═══ -->
            <SplitView Grid.Row="1" IsPaneOpen="{Binding IsDrawerOpen}" DisplayMode="CompactOverlay" OpenPaneLength="{Binding OpenPaneLength}" CompactPaneLength="{Binding CompactPaneLength}" PaneBackground="Transparent" IsVisible="{Binding !IsShellChromeHidden}">

                <SplitView.Pane>
                    <!-- Wrapper retained as a plain container; its IsDesktop gate was always true (RemEx-f167). -->
                    <Border>
                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                            <!-- Bold gradient rail: theme-accent bleeds from the top over a semi-opaque glass base -->
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="{DynamicResource AccentPrimary}"/>
                                    <GradientStop Offset="0.14" Color="{DynamicResource AccentPrimary}"/>
                                    <GradientStop Offset="1" Color="Transparent"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Background="{DynamicResource GlassBaseDarkBrush}" Opacity="0.9">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <!-- ═══ Top: Brand / Header ═══ -->
                                <StackPanel Grid.Row="0" Margin="0,16,0,8">
                                    <Button Classes="nav-item" Width="48" Height="48" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                            Command="{Binding ToggleDrawerCommand}" HorizontalAlignment="Center" Padding="0"
                                            ToolTip.Tip="{conv:Localize Shell_ToggleDrawerTooltip}" AutomationProperties.Name="{conv:Localize Shell_ToggleDrawerTooltip}">
                                        <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True">
                                            <ctrl:BrandMark/>
                                        </Border>
                                    </Button>
                                    <TextBlock Text="RemEx" FontFamily="{StaticResource Orbitron}" FontSize="14" FontWeight="Bold"
                                               LetterSpacing="3" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentPrimaryBrush}" Margin="4,12,0,0"
                                               IsVisible="{Binding IsDrawerOpen}"/>
                                    
                                    <!-- Command Palette Hint -->
                                    <Button Command="{Binding OpenCommandPaletteCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,8,0,0" IsVisible="{Binding IsDrawerOpen}" ToolTip.Tip="{conv:Localize Shell_OpenCommandPaletteTooltip}" AutomationProperties.Name="{conv:Localize Shell_OpenCommandPaletteTooltip}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Opacity="0.5">
                                            <mi:MaterialIcon Kind="Magnify" Foreground="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ctrl+K" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- ═══ Navigation Items ═══ -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Spacing="4" Margin="0,8">
                                        <!-- Home Dashboard -->
                                        <Button AutomationProperties.Name="{conv:Localize Nav_Home}" Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}" Command="{Binding NavigateToHomeCommand}" ToolTip.Tip="{conv:Localize Nav_Home}">
                                            <Grid ColumnDefinitions="64,*">
                                                <mi:MaterialIcon Grid.Column="0" Kind="Home" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Home}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Live Sensors -->
                                        <Button AutomationProperties.Name="{conv:Localize Nav_Sensors}" Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}" Command="{Binding NavigateToCanvasCommand}" ToolTip.Tip="{conv:Localize Nav_Sensors}">
                                            <Grid ColumnDefinitions="64,*">
                                                <mi:MaterialIcon Grid.Column="0" Kind="ChartLineVariant" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Sensors}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Commands (remote power/control commands) -->
                                        <Button AutomationProperties.Name="{conv:Localize Nav_Commands}" Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2}" Command="{Binding NavigateToRemoteCommand}" ToolTip.Tip="{conv:Localize Nav_Commands}">
                                            <Grid ColumnDefinitions="64,*">
                                                <mi:MaterialIcon Grid.Column="0" Kind="RemoteTv" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Commands}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- App Launcher -->
                                        <Button AutomationProperties.Name="{conv:Localize Nav_Launcher}" Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3}" Command="{Binding NavigateToAppLauncherCommand}" ToolTip.Tip="{conv:Localize Nav_Launcher}">
                                            <Grid ColumnDefinitions="64,*">
                                                <mi:MaterialIcon Grid.Column="0" Kind="Apps" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Launcher}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Processes (running programs / task manager) -->
                                        <Button AutomationProperties.Name="{conv:Localize Nav_Processes}" Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4}" Command="{Binding NavigateToTaskManagerCommand}" ToolTip.Tip="{conv:Localize Nav_Processes}">
                                            <Grid ColumnDefinitions="64,*">
                                                <mi:MaterialIcon Grid.Column="0" Kind="MonitorDashboard" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Processes}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- File Explorer -->
                                        <Button AutomationProperties.Name="{conv:Localize Nav_Files}" Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=7}" Command="{Binding NavigateToFileTransferCommand}" ToolTip.Tip="{conv:Localize Nav_Files}">
                                            <Grid ColumnDefinitions="64,*">
                                                <mi:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Files}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- Logs & Diagnostics -->
                                        <Button AutomationProperties.Name="{conv:Localize Shell_LogsDiagnostics}" Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=8}" Command="{Binding NavigateToDiagnosticLogsCommand}" ToolTip.Tip="{conv:Localize Shell_LogsDiagnostics}">
                                            <Grid ColumnDefinitions="64,*">
                                                <mi:MaterialIcon Grid.Column="0" Kind="FileDocument" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Shell_LogsDiagnostics}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <Separator Height="1" Background="{DynamicResource CardBorderBrush}" Margin="16,12" Opacity="0.3"/>

                                        <!-- ═══ Settings family ═══ -->
                                        <!-- Settings -->
                                        <Button AutomationProperties.Name="{conv:Localize Nav_Settings}" Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=9}" Command="{Binding NavigateToSettingsCommand}" ToolTip.Tip="{conv:Localize Nav_Settings}">
                                            <Grid ColumnDefinitions="64,*">
                                                <mi:MaterialIcon Grid.Column="0" Kind="Tune" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Settings}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                        <!-- About (moved into settings cluster) -->
                                        <Button AutomationProperties.Name="{conv:Localize Shell_About}" Classes="nav-item" Classes.nav-item-active="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=6}" Command="{Binding NavigateToAboutCommand}" ToolTip.Tip="{conv:Localize Shell_About}">
                                            <Grid ColumnDefinitions="64,*">
                                                <mi:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{conv:Localize Shell_About}" VerticalAlignment="Center" Margin="8,0,0,0" IsVisible="{Binding IsDrawerOpen}"/>
                                            </Grid>
                                        </Button>

                                    </StackPanel>
                                </ScrollViewer>

                                <!-- ═══ Bottom: Connection Status ═══ -->
                                <Border Grid.Row="2" Margin="12,4,12,16" Padding="4" CornerRadius="{DynamicResource CornerRadiusMedium}" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="64,*">
                                        <Ellipse AutomationProperties.Name="{Binding Presence.PresenceAccessibleName}" Grid.Column="0" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="status-dot" Classes.connected="{Binding Presence.IsPhoneAttached}">
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0" IsVisible="{Binding IsDrawerOpen}">
                                            <!-- PHONE PRESENCE IS THE HEADLINE, the loopback link is the detail
                                                 below it (RemEx-0z7w / RemEx-porg). Connection.IsConnected is the
                                                 UI's own socket to its embedded host and is up essentially always,
                                                 so leading with it told a user with no phone paired that they were
                                                 "Connected" — the one fact this panel exists to convey, absent.
                                                 The dot to the left is bound to phone presence for the same reason. -->
                                            <TextBlock Text="{Binding Presence.PresenceText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Connection.StatusText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Connection.LatencyText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding Connection.IsConnected}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            </Border>
                        </Border>
                    </Border>
                </SplitView.Pane>

                <!-- ═══ PAGE CONTENT ═══ -->
                <SplitView.Content>
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- ═══ CONNECTION BANNER ═══ -->
                        <Border Grid.Row="0" IsVisible="{Binding ShowConnectionBanner}" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Border.Transitions>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <mi:MaterialIcon Grid.Column="0" Kind="AlertOutline" Foreground="{DynamicResource SystemWarningBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionBannerMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Content="{conv:Localize Btn_Connect}" Command="{Binding Connection.ConnectCommand}" Background="{DynamicResource SystemSuccessBrush}" Foreground="{DynamicResource SuccessForegroundBrush}" Padding="10,5" CornerRadius="6" FontSize="11" FontWeight="SemiBold" Margin="12,0,6,0" Cursor="Hand"/>
                                <Button Grid.Column="3" Content="{conv:Localize Shell_OpenSettings}" Command="{Binding NavigateToSettingsCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentForegroundBrush}" Padding="10,5" CornerRadius="6" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button AutomationProperties.Name="{conv:Localize A11y_Dismiss}" Grid.Column="4" Command="{Binding DismissConnectionBannerCommand}" Background="Transparent" Padding="6,4" CornerRadius="6" Cursor="Hand" BorderThickness="0">
                                    <mi:MaterialIcon Kind="Close" Foreground="{DynamicResource TextMutedBrush}" Width="10" Height="10"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ═══ LAYOUT LOAD WARNING BANNER ═══ -->
                        <Border Grid.Row="1" IsVisible="{Binding ShowLayoutLoadWarning}" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource SystemWarningBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Border.Transitions>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Grid.Column="0" Kind="AlertOutline" Foreground="{DynamicResource SystemWarningBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding LayoutLoadWarningMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button AutomationProperties.Name="{conv:Localize A11y_Dismiss}" Grid.Column="2" Command="{Binding DismissLayoutLoadWarningCommand}" Background="Transparent" Padding="6,4" CornerRadius="6" Cursor="Hand" BorderThickness="0">
                                    <mi:MaterialIcon Kind="Close" Foreground="{DynamicResource TextMutedBrush}" Width="10" Height="10"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content is NOT bound here. ShellView.axaml.cs feeds this host one page at a time so a
                             second navigation cannot interrupt the first (RemEx-lma2o). -->
                        <TransitioningContentControl Grid.Row="2" Name="PageHost">
                            <TransitioningContentControl.DataTemplates>
                                <DataTemplate DataType="vm:HomeViewModel">
                                    <views:HomeView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:CanvasDashboardViewModel">
                                    <views:CanvasView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:RemoteViewModel">
                                    <views:RemoteView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:AppLauncherViewModel">
                                    <views:AppLauncherView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:TaskManagerViewModel">
                                    <views:TaskManagerView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:RemoteDesktopViewModel">
                                    <views:RemoteDesktopView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:AboutViewModel">
                                    <views:AboutView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:FileTransferViewModel">
                                    <views:FileTransferView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:SettingsViewModel">
                                    <views:SettingsView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiagnosticLogsViewModel">
                                    <views:DiagnosticLogsView />
                                </DataTemplate>
                            </TransitioningContentControl.DataTemplates>
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.14"/>
                            </TransitioningContentControl.PageTransition>
                        </TransitioningContentControl>
                    </Grid>
                </SplitView.Content>
            </SplitView>

            <!-- ═══ FULLSCREEN REMOTE DESKTOP (bypasses sidebar) ═══ -->
            <TransitioningContentControl Content="{Binding CurrentView}" IsVisible="{Binding IsShellChromeHidden}" Name="ImmersiveHost">
                <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="vm:RemoteDesktopViewModel">
                        <views:RemoteDesktopView />
                    </DataTemplate>
                </TransitioningContentControl.DataTemplates>
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.14"/>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <!-- ═══ SETTINGS OVERLAY BACKDROP ═══ -->
            <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding IsSettingsPanelOpen}" Background="{DynamicResource GlassOverlayBrush}" PointerPressed="OnSettingsBackdropPressed" IsHitTestVisible="{Binding IsSettingsPanelOpen}">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </Border.Transitions>
            </Border>

            <!-- ═══ SETTINGS SLIDE-IN PANEL (Right side) ═══ -->
            <Border Grid.Row="0" Grid.RowSpan="3" x:Name="SettingsPanel" Classes="settings-overlay" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="440" MaxWidth="460" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" BoxShadow="-8 0 40 0 #40000000">
                <Grid RowDefinitions="Auto,*">
                    <!-- Panel header -->
                    <Border Grid.Row="0" Padding="20,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{conv:Localize Personalize_Title}" FontSize="20" FontWeight="Black" />
                                <TextBlock Text="{conv:Localize Personalize_Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1"/>
                            </StackPanel>
                            <Button AutomationProperties.Name="{conv:Localize A11y_Close}" Grid.Column="1" Command="{Binding CloseSettingsPanelCommand}" Background="Transparent" Padding="8" CornerRadius="8" BorderThickness="0" VerticalAlignment="Top" Cursor="Hand">
                                <mi:MaterialIcon Kind="Close" Foreground="{DynamicResource TextMutedBrush}" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Live personalization content: language + all visual customization -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20" Spacing="16">

                            <!-- ═══ LANGUAGE (binds the shared SettingsViewModel) ═══ -->
                            <Border Classes="glass-card" Padding="16" DataContext="{Binding SettingsVm}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{conv:Localize Settings_Language}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedValue="{Binding Language}" SelectedValueBinding="{Binding Code}" HorizontalAlignment="Stretch" CornerRadius="8">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- ═══ ALL VISUAL CUSTOMIZATION (live-applied via CustomizationViewModel) ═══ -->
                            <views:PersonalizationPanelView DataContext="{Binding CustomizationVm}"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>


            <!-- ═══ FLOATING GEAR FAB (Bottom-Right) ═══ -->
            <Button AutomationProperties.Name="{conv:Localize Personalize_FabTooltip}" Grid.Row="1" Classes="gear-fab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Command="{Binding ToggleSettingsPanelCommand}" ToolTip.Tip="{conv:Localize Personalize_FabTooltip}" IsVisible="{Binding !IsShellChromeHidden}">
                <mi:MaterialIcon Kind="Palette" Foreground="{DynamicResource AccentForegroundBrush}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>


            <!-- ═══ WELCOME SPLASH — BOOT SEQUENCE ═══ -->
            <splash:SkiaSplashControl x:Name="BootSplash" Grid.RowSpan="2" IsVisible="{Binding ShowWelcomeSplash}" SplashStyle="{Binding Customization.SplashStyle}" ZIndex="999"/>

            <!-- ═══ TUTORIAL OVERLAY (first-run or replay) ═══ -->
            <Border Grid.RowSpan="2" IsVisible="{Binding ShowTutorialOverlay}" Background="{DynamicResource OverlayBackdropBrush}" ZIndex="998">
                <Grid>
                    <Border Width="520" MaxWidth="540" Padding="32,28" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="16">
                            <!-- Header with Skip -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{conv:Localize Tutorial_Header}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="3" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{conv:Localize Tutorial_Skip}" Command="{Binding TutorialSkipCommand}" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Padding="8,4" CornerRadius="6" Cursor="Hand" BorderThickness="0" ToolTip.Tip="{conv:Localize Tutorial_SkipTooltip}"/>
                            </Grid>

                            <!-- Page 0: Welcome -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=0}">
                                <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P0_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P0_Body}"/>
                            </StackPanel>

                            <!-- Page 1: How It Works -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=1}">
                                <TextBlock Text="🔗" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P1_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P1_Body1}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P1_Body2}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Text="{conv:Localize Tutorial_P1_Diagram}"/>
                                </Border>
                            </StackPanel>

                            <!-- Page 2: HWInfo Setup -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=2}">
                                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P4_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P4_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P4_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemWarningBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P4_Warning}"/>
                            </StackPanel>

                            <!-- Page 3: Sensors Overview -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=3}">
                                <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P5_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P5_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P5_HWInfo}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P5_BuiltIn}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P5_Body2}"/>
                            </StackPanel>

                            <!-- Page 4: App Launcher -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=4}">
                                <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P6_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P6_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P6_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P6_Note}"/>
                            </StackPanel>

                            <!-- Page 5: Network & Discovery -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=5}">
                                <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P7_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P7_Body1}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P7_Body2}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P7_IpSteps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P7_Body3}"/>
                            </StackPanel>

                            <!-- Page 6: QR Code Pairing -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=6}">
                                <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P8_QR_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P8_QR_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P8_QR_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P8_QR_Body2}"/>
                            </StackPanel>

                            <!-- Page 7: File Transfer -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=7}">
                                <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P9_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P9_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P9_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P9_Body2}"/>
                            </StackPanel>

                            <!-- Page 8: Glossary Command Palette -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=8}">
                                <TextBlock Text="⌨️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_CommandPalette_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_CommandPalette_Body}"/>
                            </StackPanel>

                            <!-- Page 9: Glossary App Launcher -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=9}">
                                <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_AppLauncher_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_AppLauncher_Body}"/>
                            </StackPanel>

                            <!-- Page 10: Glossary Task Manager -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=10}">
                                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_TaskManager_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_TaskManager_Body}"/>
                            </StackPanel>

                            <!-- Page 11: Glossary Sensor Canvas -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=11}">
                                <TextBlock Text="🌡️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_SensorCanvas_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_SensorCanvas_Body}"/>
                            </StackPanel>

                            <!-- Page 12: Glossary File Transfer -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=12}">
                                <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_FileTransfer_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_FileTransfer_Body}"/>
                            </StackPanel>

                            <!-- Page 13: Glossary Remote Desktop -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=13}">
                                <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_RemoteDesktop_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_RemoteDesktop_Body}"/>
                            </StackPanel>

                            <!-- Page 14: Glossary Quick Settings -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=14}">
                                <TextBlock Text="⚙️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_QuickSettings_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_QuickSettings_Body}"/>
                            </StackPanel>

                            <!-- Page 15: Glossary Customization -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=15}">
                                <TextBlock Text="🎨" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_Customization_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_Customization_Body}"/>
                            </StackPanel>

                            <!-- Page 16: You're All Set -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=16}">
                                <TextBlock Text="🎉" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P10_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P10_Body1}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P10_Body2}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P10_Replay}"/>
                            </StackPanel>

                            <!-- Page indicator dots -->
                            <ItemsControl ItemsSource="{Binding TutorialPageDots}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}" Opacity="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Don't Show Again checkbox -->
                            <CheckBox IsChecked="{Binding DontShowTutorialAgain}" Content="{conv:Localize Tutorial_DontShowAgain}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>

                            <!-- Navigation buttons -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Content="{conv:Localize Tutorial_Back}" Command="{Binding TutorialPreviousCommand}" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntNotEqualConverter.Instance}, ConverterParameter=0}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                                <Button Grid.Column="2" Content="{conv:Localize Tutorial_Next}" Command="{Binding TutorialNextCommand}" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntNotEqualConverter.Instance}, ConverterParameter=16}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentForegroundBrush}" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                                <Button Grid.Column="2" Content="{conv:Localize Tutorial_Finish}" Command="{Binding TutorialFinishCommand}" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=16}" Background="{DynamicResource SystemSuccessBrush}" Foreground="{DynamicResource SuccessForegroundBrush}" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </ctrl:DashboardBackgroundControl>
</UserControl>
