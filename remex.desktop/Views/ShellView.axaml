<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    xmlns:ctrl="using:Remex.Desktop.Controls"
    xmlns:splash="using:Remex.Desktop.Controls.Splash"
    xmlns:views="using:Remex.Desktop.Views" x:Class="Remex.Desktop.Views.ShellView" x:DataType="vm:ShellViewModel">

    <UserControl.Styles>
        <!-- ═══ Drawer-toggle brand button base (RemEx-zi3ua) ═══
             This class used to also style the nine nav DESTINATIONS. They are ListBoxItems now
             (below) and get their own selectors from Material's ListBoxItem control theme plus the
             ListBoxItem.nav-item block further down. What is left here is only the round brand-mark
             toggle button at the top of the drawer (Width=48/CornerRadius=Large override) - the
             ButtonVocabularyTests exception for "nav-item" stays live for exactly this one Button. -->
        <Style Selector="Button.nav-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.nav-item:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- ═══ Nav destination list items (RemEx-zi3ua) ═══
             The rail used to hand-roll active state as a bool Classes.nav-item-active flipped by a
             converter binding on nine Buttons, duplicated again for each Path/MaterialIcon's colour.
             ListBoxItem's own :selected pseudo-class is the same state Avalonia already tracks once
             IsSelected is bound to ActiveNavIndex - no hand-toggled class, no risk of the class and
             the "real" state disagreeing.

             Ripple and the hover/press state layer are NOT set here - they come from Material's
             ListBoxItem control theme itself. Verified against the actual template source
             (Material.Styles 3.19.0's Resources/Themes/ListBoxItem.axaml on GitHub, not just the
             type's presence in the DLL, per the RemEx-vryje/RemEx-04ftl lesson that a resource
             existing proves it was declared, not that any template consumes it): the default
             ControlTheme for ListBoxItem wraps content in a ripple:RippleEffect named PART_Ripple,
             which fires from the pointer position on press with no extra wiring, plus a
             PART_HoverEffect overlay that already answers :pointerover/:selected. This block only
             adds what that shared theme cannot know - this app's accent colour for the selected fill
             and the per-state icon recolour below. -->
        <Style Selector="ListBoxItem.nav-item">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem.nav-item:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- :selected IS the active destination - Avalonia's own pseudo-class, driven by
             IsSelected, not a hand-rolled bool class. The accent tint here composes with Material's
             own :selected state layer (ListBoxItem.axaml's PART_HoverEffect, Opacity 0.12) rather
             than replacing it, matching how a selected Material list item is meant to read: fill AND
             state layer together, so the active destination stays unambiguous against all four
             themes rather than relying on either alone. -->
        <Style Selector="ListBoxItem.nav-item:selected">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource AccentPrimary}" Opacity="0.22"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>
        <!-- Nav rail icon colour follows item state. MaterialIcon paints with Foreground,
             not Fill, so these selectors must name the property the control actually reads -
             a leftover Fill setter here would compile and simply never apply. -->
        <Style Selector="ListBoxItem.nav-item mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem.nav-item:pointerover mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBoxItem.nav-item:selected mi|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>

        <!-- The "Settings family" divider inside NavList (RemEx-zi3ua HIGH fix). It carries
             Focusable="False"/IsHitTestVisible="False" in the XAML, not Classes="nav-item" — that
             already keeps it out of selection and ripple; this style only strips the base Material
             ListBoxItem theme's own 8px default Padding so the thin Separator inside sits exactly
             where the old sibling Separator did. -->
        <Style Selector="ListBoxItem.nav-divider">
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- ═══ Settings side sheet (RemEx-zrlze) ═══
             The hand-rolled translateX slide + separate scrim Border this replaced are gone -
             material:SideSheet (declared as a Grid sibling further down, in the same full-bleed
             position the old backdrop+panel pair occupied) supplies the slide, and the two style
             blocks below supply a working, correctly-weighted scrim and the panel's own surface.

             SideSheet's own template (Material.Styles 3.19.0's Controls/SideSheet.axaml, read from
             source rather than assumed off the DLL, per the RemEx-vryje/RemEx-04ftl lesson) disables
             PART_Scrim outright for anything not carrying its :mobile pseudo-class:
             `^:not(:mobile) /template/ Border#PART_Scrim { IsEnabled False; IsVisible False }`.
             Nothing in SideSheet.axaml.cs ever applies :mobile - the class carries a
             "// TODO: mobile variant" comment and UpdatePseudoClasses only ever sets :open/:closed
             and :left/:right - so that selector matches unconditionally and the built-in scrim never
             appears on desktop as shipped.

             REVIEW ROUND 1, HIGH: an UNCONDITIONED override here (`material|SideSheet /template/
             Border#PART_Scrim`, no pseudo-class) does NOT beat it. A selector carrying a
             pseudo-class is an ACTIVATED style and resolves at BindingPriority.StyleTrigger (1); an
             unconditioned Style setter resolves at BindingPriority.Style (3) - lower ordinal wins,
             and priority is compared BEFORE application order, so the theme's IsVisible=False won
             regardless of which style was attached later. (The PART_LeftDrawerBorder precedent below
             does not transfer: that override and the ControlTheme setter it beats are BOTH
             unconditioned, so THAT case really is decided by application order.) Repeating
             `:not(:mobile)` here gives this override the same activator, so it resolves at the same
             StyleTrigger tier the theme's own selector does, and application order (this Style is
             attached after the ControlTheme resolves) decides it correctly.

             The :open override below match the old backdrop's opacity WEIGHT, not just visibility:
             GlassOverlayBrush is #33000000 (alpha 0.20 - FallbackPalette.axaml:110), but the base
             ControlTheme's own `^:open` sets the scrim's render Opacity to 0.32, which would
             multiply out to ~6.5% black - visibly lighter than the flat 20% the old backdrop painted.
             Forcing render Opacity back to 1 while open leaves GlassOverlayBrush's own alpha as the
             only factor, matching the old weight exactly. PART_Scrim's own opacity TRANSITION and its
             click-to-dismiss handler (PART_Scrim_Pressed -> SideSheetOpened = false, propagating back
             through the TwoWay binding) are untouched by either style and still do the rest. -->
        <Style Selector="material|SideSheet:not(:mobile) /template/ Border#PART_Scrim">
            <Setter Property="IsEnabled" Value="True"/>
            <Setter Property="IsVisible" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource GlassOverlayBrush}"/>
        </Style>
        <Style Selector="material|SideSheet:not(:mobile):open /template/ Border#PART_Scrim">
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <!-- The actual 440px sliding panel, as opposed to the scrim covering the remainder.
             Background/BorderBrush have to land here rather than as attributes on the SideSheet
             element itself - those template-bind to PART_RootBorder, which wraps BOTH this panel
             AND the scrim's remainder, so setting them on the control would paint/border the entire
             shell rather than the panel (review round 1, MEDIUM). BoxShadow restores the old panel
             Border's `BoxShadow="-8 0 40 0 #40000000"`, dropped in round 1 with no replacement -
             NavigationDrawer gets its own depth from ShadowAssist on PART_LeftDrawerBorder, so this
             panel needs the equivalent named explicitly since nothing supplies it by default
             (review round 1, LOW).

             Background and BoxShadow are UNCONDITIONED on purpose - neither is set anywhere else in
             SideSheet's own template or ControlTheme, so BindingPriority.Style is uncontested for
             them. BorderBrush is NOT: the base theme sets it from an ACTIVATED selector,
             `^:not(:mobile) /template/ Border#PART_SideSheet { BorderBrush = MaterialDividerBrush }`,
             at BindingPriority.StyleTrigger - the exact HIGH-1 scrim trap, on a different property
             (review round 2, MEDIUM). An unconditioned BorderBrush setter here would compile, match,
             and still lose, leaving the panel's left-edge divider painted Material's default instead
             of this app's own CardBorderBrush - invisible in a text diff, wrong on screen the moment
             a theme switch (e.g. SolarFlare) makes the two brushes visibly different. Splitting the
             BorderBrush setter into its own :not(:mobile) block is what actually wins it.

             GENERAL RULE for every future Material.Avalonia 3.19.0 template-part override: before
             overriding ANY property a theme sets, check whether the theme's own setter for that
             property comes from a selector carrying a pseudo-class (`^:open`, `^:not(:mobile)`,
             etc.) - if it does, the override needs the SAME activator, or it loses regardless of
             attach order. A property the theme never touches needs no activator at all. -->
        <Style Selector="material|SideSheet /template/ Border#PART_SideSheet">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="BoxShadow" Value="-8 0 40 0 #40000000"/>
        </Style>
        <Style Selector="material|SideSheet:not(:mobile) /template/ Border#PART_SideSheet">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        </Style>

        <!-- ═══ Gear FAB ═══ -->
        <Style Selector="Button.gear-fab">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.gear-fab:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.1)"/>
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="Button.gear-fab:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>

        <!-- ═══ Drawer surface ═══
             The SplitView this replaced carried PaneBackground="Transparent", and the drawer content
             brings its own accent gradient over GlassBaseDarkBrush at 0.9 opacity. Material's control
             theme paints PART_LeftDrawerBorder with MaterialCardBackgroundBrush, which would sit
             behind that glass as opaque paper and stop the drawer compositing onto the window
             backdrop — most visibly under SolarFlare, the one light theme, where the paper is nearly
             white. Transparent restores what the SplitView did.

             This override wins, and the two facts it depends on were read out of Material.Avalonia
             3.19.0's own NavigationDrawer.axaml rather than assumed, because both fail SILENTLY:
             PART_LeftDrawerBorder really is a Border (a wrong type here matches nothing), and its
             Background arrives from a Style setter inside the ControlTheme, not an inline attribute
             on the ControlTemplate. That second one is the load-bearing part — an inline attribute
             would be a LocalValue and would beat any Style, which is the ShadowAssist trap App.axaml
             already documents. An app-level Style outranks a ControlTheme setter, so this applies.
             Not yet confirmed on screen across the four themes: see RemEx-j2gfa. -->
        <Style Selector="material|NavigationDrawer /template/ Border#PART_LeftDrawerBorder">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <ctrl:DashboardBackgroundControl>
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- ═══ TITLE BAR DRAG REGION ═══ -->
            <Border Grid.Row="0" Height="32" Background="Transparent" IsHitTestVisible="False"/>

            <!-- ═══ DRAWER TOGGLE ═══
                 An overlay drawer leaves nothing on screen when it is shut, so the toggle cannot live
                 inside it the way the brand mark did on the old compact rail — it would disappear with
                 the drawer and strand every nav destination behind something nothing can open. It sits
                 in the title bar strip for now; RemEx-a3prn turns that strip into a ColorZone app bar
                 and this is the button it adopts. It carves a hit-testable hole in the drag region
                 above, which is why that Border stays IsHitTestVisible="False" and this does not. -->
            <Button Grid.Row="0" Name="DrawerToggle" Classes="icon-button compact"
                    Command="{Binding ToggleDrawerCommand}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0"
                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                    IsVisible="{Binding !IsShellChromeHidden}"
                    ToolTip.Tip="{conv:Localize Shell_ToggleDrawerTooltip}"
                    AutomationProperties.Name="{conv:Localize Shell_ToggleDrawerTooltip}">
                <mi:MaterialIcon Kind="Menu" Width="18" Height="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>

            <!-- ═══ MAIN LAYOUT: Overlay drawer + Content ═══
                 LeftDrawerOpened is TwoWay on purpose. The control theme's scrim assigns
                 LeftDrawerOpened = false directly on the control when it is clicked, and the property is
                 registered without a default binding mode — one-way would swallow that, sliding the
                 drawer shut while IsDrawerOpen stayed true.
                 LeftDrawerExpandThresholdWidth is bound rather than omitted: a null threshold means
                 "permanently expanded" inside NavigationDrawer, not "overlay". See
                 ShellViewModel.NeverExpandThresholdWidth. -->
            <material:NavigationDrawer Grid.Row="1" Name="ShellDrawer"
                                       LeftDrawerOpened="{Binding IsDrawerOpen, Mode=TwoWay}"
                                       LeftDrawerWidth="{Binding OpenPaneLength}"
                                       LeftDrawerExpandThresholdWidth="{Binding DrawerExpandThresholdWidth}"
                                       IsVisible="{Binding !IsShellChromeHidden}">

                <material:NavigationDrawer.LeftDrawerContent>
                    <!-- Every label, the brand text and the status panel below used to carry
                         IsVisible="{Binding IsDrawerOpen}" so they vanished in the 64px compact rail.
                         An overlay drawer has no compact state — it is either over the content or off
                         screen — so those gates went with it (RemEx-q3mle). They were not merely
                         redundant: IsDrawerOpen flips at the START of the 300ms close animation, so
                         the labels blinked out while the panel was still sliding away. -->
                    <!-- Wrapper retained as a plain container; its IsDesktop gate was always true (RemEx-f167). -->
                    <Border>
                        <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
                            <!-- Bold gradient rail: theme-accent bleeds from the top over a semi-opaque glass base -->
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="{DynamicResource AccentPrimary}"/>
                                    <GradientStop Offset="0.14" Color="{DynamicResource AccentPrimary}"/>
                                    <GradientStop Offset="1" Color="Transparent"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Background="{DynamicResource GlassBaseDarkBrush}" Opacity="0.9">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <!-- ═══ Top: Brand / Header ═══ -->
                                <StackPanel Grid.Row="0" Margin="0,16,0,8">
                                    <Button Classes="nav-item" Width="48" Height="48" CornerRadius="{DynamicResource CornerRadiusLarge}"
                                            Command="{Binding ToggleDrawerCommand}" HorizontalAlignment="Center" Padding="0"
                                            ToolTip.Tip="{conv:Localize Shell_ToggleDrawerTooltip}" AutomationProperties.Name="{conv:Localize Shell_ToggleDrawerTooltip}">
                                        <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True">
                                            <ctrl:BrandMark/>
                                        </Border>
                                    </Button>
                                    <TextBlock Text="RemEx" FontFamily="{StaticResource Orbitron}" FontSize="14" FontWeight="Bold"
                                               LetterSpacing="3" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentPrimaryBrush}" Margin="4,12,0,0"
                                              />
                                    
                                    <!-- Command Palette Hint -->
                                    <Button Command="{Binding OpenCommandPaletteCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,8,0,0" ToolTip.Tip="{conv:Localize Shell_OpenCommandPaletteTooltip}" AutomationProperties.Name="{conv:Localize Shell_OpenCommandPaletteTooltip}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Opacity="0.5">
                                            <mi:MaterialIcon Kind="Magnify" Foreground="{DynamicResource TextSecondaryBrush}" Width="11" Height="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ctrl+K" FontSize="10" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- ═══ Navigation Items (RemEx-zi3ua) ═══
                                     ONE ListBox, not two. It was briefly two - split at the
                                     "Settings family" divider so a plain Separator would not be
                                     auto-wrapped into its own selectable/rippling ListBoxItem - but
                                     that also cut arrow-key travel into two scopes: Down on the last
                                     item of list one did nothing, so Settings/About were arrow-
                                     unreachable. The real fix keeps the divider IN the list, as its
                                     own ListBoxItem with Focusable="False" and
                                     IsHitTestVisible="False": ItemsControl.GetNextControl (what
                                     ListBox.OnKeyDown's MoveSelection calls on every arrow press) is
                                     a loop that skips any candidate failing result.Focusable and
                                     keeps walking, so the divider is never returned as a stop -
                                     confirmed against Avalonia 12.1.1's own source
                                     (src/Avalonia.Controls/ItemsControl.cs), not assumed.
                                     IsHitTestVisible="False" keeps a pointer click off it too.

                                     Navigation is driven by Tapped and Enter/Space
                                     (OnNavItemTapped/OnNavItemKeyDown in ShellView.axaml.cs), NOT by
                                     ListBox.SelectionChanged. Avalonia moves SELECTION on arrow keys
                                     too (same MoveSelection call above) - confirmed on the headless
                                     platform that every arrow press raises SelectionChanged - so a
                                     SelectionChanged handler cannot tell an arrow-key highlight move
                                     from an actual activation. Driving navigation off it closed the
                                     drawer out from under a user who had only pressed Down once,
                                     which does not meet "arrow keys move through destinations" on
                                     either reading. Tapped and Enter/Space are what Avalonia itself
                                     reserves for "commit" (ListBoxItem.OnKeyDown only escalates Space
                                     and Enter into a selection update - see
                                     ItemSelectionEventTriggers.ShouldTriggerSelection in the same
                                     source), so arrow keys now move ONLY the highlight - the same
                                     IsSelected binding below, since Avalonia updates it locally via
                                     SetCurrentValue without disturbing the Mode=OneWay binding - and
                                     committing is a separate, explicit step.

                                     IsSelected stays explicitly Mode=OneWay from ActiveNavIndex:
                                     ObjectConverters.Equal has no ConvertBack, and IsSelected's own
                                     default binding mode is TwoWay, so an unguarded binding would try
                                     to push a click's boolean back through an equality converter that
                                     cannot invert it into an index. -->
                                <ListBox Grid.Row="1" Name="NavList" SelectionMode="Single" Margin="0,8">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>

                                    <!-- Home Dashboard -->
                                    <ListBoxItem Tag="0" AutomationProperties.Name="{conv:Localize Nav_Home}" Classes="nav-item" IsSelected="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0, Mode=OneWay}" ToolTip.Tip="{conv:Localize Nav_Home}" Tapped="OnNavItemTapped" KeyDown="OnNavItemKeyDown">
                                        <Grid ColumnDefinitions="64,*">
                                            <mi:MaterialIcon Grid.Column="0" Kind="Home" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Home}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <!-- Live Sensors -->
                                    <ListBoxItem Tag="1" AutomationProperties.Name="{conv:Localize Nav_Sensors}" Classes="nav-item" IsSelected="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1, Mode=OneWay}" ToolTip.Tip="{conv:Localize Nav_Sensors}" Tapped="OnNavItemTapped" KeyDown="OnNavItemKeyDown">
                                        <Grid ColumnDefinitions="64,*">
                                            <!-- THE ALERT COUNT REACHES A SCREEN (RemEx-rjnbo). ShellViewModel has
                                                 incremented AlertBadgeCount on every sensor alert, exposed HasAlerts,
                                                 kept twenty AlertNotifications and offered a DismissAlerts command
                                                 since it was written - and NO view bound any of it. The pipeline ran
                                                 correctly into a number nobody could see. Sensors is where the alerts
                                                 come from, so it is where the count belongs.

                                                 IsBadgeVisible is bound rather than left to Material, which renders a
                                                 badge reading "0" quite happily - a notification that there is nothing
                                                 to notify. Placement and colour come from App.axaml so no call site
                                                 can put one somewhere else. -->
                                            <material:Badged Grid.Column="0"
                                                             BadgeContent="{Binding AlertBadgeCount}"
                                                             IsBadgeVisible="{Binding HasAlerts}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <mi:MaterialIcon Kind="ChartLineVariant" Width="22" Height="22"/>
                                            </material:Badged>
                                            <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Sensors}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <!-- Commands (remote power/control commands) -->
                                    <ListBoxItem Tag="2" AutomationProperties.Name="{conv:Localize Nav_Commands}" Classes="nav-item" IsSelected="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=2, Mode=OneWay}" ToolTip.Tip="{conv:Localize Nav_Commands}" Tapped="OnNavItemTapped" KeyDown="OnNavItemKeyDown">
                                        <Grid ColumnDefinitions="64,*">
                                            <mi:MaterialIcon Grid.Column="0" Kind="RemoteTv" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Commands}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <!-- App Launcher -->
                                    <ListBoxItem Tag="3" AutomationProperties.Name="{conv:Localize Nav_Launcher}" Classes="nav-item" IsSelected="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=3, Mode=OneWay}" ToolTip.Tip="{conv:Localize Nav_Launcher}" Tapped="OnNavItemTapped" KeyDown="OnNavItemKeyDown">
                                        <Grid ColumnDefinitions="64,*">
                                            <mi:MaterialIcon Grid.Column="0" Kind="Apps" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Launcher}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <!-- Processes (running programs / task manager) -->
                                    <ListBoxItem Tag="4" AutomationProperties.Name="{conv:Localize Nav_Processes}" Classes="nav-item" IsSelected="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=4, Mode=OneWay}" ToolTip.Tip="{conv:Localize Nav_Processes}" Tapped="OnNavItemTapped" KeyDown="OnNavItemKeyDown">
                                        <Grid ColumnDefinitions="64,*">
                                            <mi:MaterialIcon Grid.Column="0" Kind="MonitorDashboard" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Processes}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <!-- File Explorer -->
                                    <ListBoxItem Tag="7" AutomationProperties.Name="{conv:Localize Nav_Files}" Classes="nav-item" IsSelected="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=7, Mode=OneWay}" ToolTip.Tip="{conv:Localize Nav_Files}" Tapped="OnNavItemTapped" KeyDown="OnNavItemKeyDown">
                                        <Grid ColumnDefinitions="64,*">
                                            <mi:MaterialIcon Grid.Column="0" Kind="FolderOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Files}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <!-- Logs & Diagnostics -->
                                    <ListBoxItem Tag="8" AutomationProperties.Name="{conv:Localize Shell_LogsDiagnostics}" Classes="nav-item" IsSelected="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=8, Mode=OneWay}" ToolTip.Tip="{conv:Localize Shell_LogsDiagnostics}" Tapped="OnNavItemTapped" KeyDown="OnNavItemKeyDown">
                                        <Grid ColumnDefinitions="64,*">
                                            <mi:MaterialIcon Grid.Column="0" Kind="FileDocument" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{conv:Localize Shell_LogsDiagnostics}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <!-- ═══ Settings family divider ═══ Not selectable, not
                                         focusable, not a nav destination - see the comment above
                                         this ListBox for why Focusable="False" is what keeps arrow
                                         travel from stopping here. Focusable/IsHitTestVisible keep
                                         it out of keyboard and pointer traversal, but Avalonia still
                                         builds an automation peer for every ListBoxItem regardless -
                                         without AccessibilityView="Raw" a screen reader announces a
                                         10-item list with one unnamed, unreachable entry, which the
                                         old sibling Separator (not a list item at all) never did. -->
                                    <ListBoxItem Focusable="False" IsHitTestVisible="False" Classes="nav-divider" AutomationProperties.AccessibilityView="Raw">
                                        <Separator Height="1" Background="{DynamicResource CardBorderBrush}" Margin="16,12" Opacity="0.3"/>
                                    </ListBoxItem>

                                    <!-- Settings -->
                                    <ListBoxItem Tag="9" AutomationProperties.Name="{conv:Localize Nav_Settings}" Classes="nav-item" IsSelected="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=9, Mode=OneWay}" ToolTip.Tip="{conv:Localize Nav_Settings}" Tapped="OnNavItemTapped" KeyDown="OnNavItemKeyDown">
                                        <Grid ColumnDefinitions="64,*">
                                            <mi:MaterialIcon Grid.Column="0" Kind="Tune" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{conv:Localize Nav_Settings}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </ListBoxItem>

                                    <!-- About (moved into settings cluster) -->
                                    <ListBoxItem Tag="6" AutomationProperties.Name="{conv:Localize Shell_About}" Classes="nav-item" IsSelected="{Binding ActiveNavIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=6, Mode=OneWay}" ToolTip.Tip="{conv:Localize Shell_About}" Tapped="OnNavItemTapped" KeyDown="OnNavItemKeyDown">
                                        <Grid ColumnDefinitions="64,*">
                                            <mi:MaterialIcon Grid.Column="0" Kind="InformationOutline" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{conv:Localize Shell_About}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </ListBoxItem>
                                </ListBox>

                                <!-- ═══ Bottom: Connection Status ═══ -->
                                <Border Grid.Row="2" Margin="12,4,12,16" Padding="4" CornerRadius="{DynamicResource CornerRadiusMedium}" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="64,*">
                                        <Ellipse AutomationProperties.Name="{Binding Presence.PresenceAccessibleName}" Grid.Column="0" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="status-dot" Classes.connected="{Binding Presence.IsPhoneAttached}">
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                                            <!-- PHONE PRESENCE IS THE HEADLINE, the loopback link is the detail
                                                 below it (RemEx-0z7w / RemEx-porg). Connection.IsConnected is the
                                                 UI's own socket to its embedded host and is up essentially always,
                                                 so leading with it told a user with no phone paired that they were
                                                 "Connected" — the one fact this panel exists to convey, absent.
                                                 The dot to the left is bound to phone presence for the same reason. -->
                                            <TextBlock Text="{Binding Presence.PresenceText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Connection.StatusText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Connection.LatencyText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding Connection.IsConnected}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            </Border>
                        </Border>
                    </Border>
                </material:NavigationDrawer.LeftDrawerContent>

                <!-- ═══ PAGE CONTENT ═══ -->
                <material:NavigationDrawer.Content>
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- ═══ CONNECTION BANNER ═══ -->
                        <Border Grid.Row="0" IsVisible="{Binding ShowConnectionBanner}" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Border.Transitions>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <mi:MaterialIcon Grid.Column="0" Kind="AlertOutline" Foreground="{DynamicResource SystemWarningBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ConnectionBannerMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button Grid.Column="2" Content="{conv:Localize Btn_Connect}" Command="{Binding Connection.ConnectCommand}" Background="{DynamicResource SystemSuccessBrush}" Foreground="{DynamicResource SuccessForegroundBrush}" Padding="10,5" CornerRadius="6" FontSize="11" FontWeight="SemiBold" Margin="12,0,6,0" Cursor="Hand"/>
                                <Button Grid.Column="3" Content="{conv:Localize Shell_OpenSettings}" Command="{Binding NavigateToSettingsCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentForegroundBrush}" Padding="10,5" CornerRadius="6" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"/>
                                <Button AutomationProperties.Name="{conv:Localize A11y_Dismiss}" Grid.Column="4" Command="{Binding DismissConnectionBannerCommand}" Background="Transparent" Padding="6,4" CornerRadius="6" Cursor="Hand" BorderThickness="0">
                                    <mi:MaterialIcon Kind="Close" Foreground="{DynamicResource TextMutedBrush}" Width="10" Height="10"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- ═══ LAYOUT LOAD WARNING BANNER ═══ -->
                        <Border Grid.Row="1" IsVisible="{Binding ShowLayoutLoadWarning}" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource SystemWarningBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                                </Transitions>
                            </Border.Transitions>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <mi:MaterialIcon Grid.Column="0" Kind="AlertOutline" Foreground="{DynamicResource SystemWarningBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding LayoutLoadWarningMessage}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button AutomationProperties.Name="{conv:Localize A11y_Dismiss}" Grid.Column="2" Command="{Binding DismissLayoutLoadWarningCommand}" Background="Transparent" Padding="6,4" CornerRadius="6" Cursor="Hand" BorderThickness="0">
                                    <mi:MaterialIcon Kind="Close" Foreground="{DynamicResource TextMutedBrush}" Width="10" Height="10"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Content is NOT bound here. ShellView.axaml.cs feeds this host one page at a time so a
                             second navigation cannot interrupt the first (RemEx-lma2o). -->
                        <TransitioningContentControl Grid.Row="2" Name="PageHost">
                            <TransitioningContentControl.DataTemplates>
                                <DataTemplate DataType="vm:HomeViewModel">
                                    <views:HomeView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:CanvasDashboardViewModel">
                                    <views:CanvasView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:RemoteViewModel">
                                    <views:RemoteView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:AppLauncherViewModel">
                                    <views:AppLauncherView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:TaskManagerViewModel">
                                    <views:TaskManagerView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:RemoteDesktopViewModel">
                                    <views:RemoteDesktopView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:AboutViewModel">
                                    <views:AboutView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:FileTransferViewModel">
                                    <views:FileTransferView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:SettingsViewModel">
                                    <views:SettingsView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:DiagnosticLogsViewModel">
                                    <views:DiagnosticLogsView />
                                </DataTemplate>
                            </TransitioningContentControl.DataTemplates>
                            <TransitioningContentControl.PageTransition>
                                <CrossFade Duration="0:0:0.14"/>
                            </TransitioningContentControl.PageTransition>
                        </TransitioningContentControl>
                    </Grid>
                </material:NavigationDrawer.Content>
            </material:NavigationDrawer>

            <!-- ═══ FULLSCREEN REMOTE DESKTOP (bypasses sidebar) ═══ -->
            <TransitioningContentControl Content="{Binding CurrentView}" IsVisible="{Binding IsShellChromeHidden}" Name="ImmersiveHost">
                <TransitioningContentControl.DataTemplates>
                    <DataTemplate DataType="vm:RemoteDesktopViewModel">
                        <views:RemoteDesktopView />
                    </DataTemplate>
                </TransitioningContentControl.DataTemplates>
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.14"/>
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>

            <!-- ═══ SETTINGS SIDE SHEET (RemEx-zrlze) ═══
                 A material:SideSheet SIBLING here, occupying the exact Grid.RowSpan="3" full-bleed
                 cell the old backdrop+panel Border pair did - NOT wrapping DashboardBackgroundControl
                 as its Content. Review round 1 tried the latter (SideSheet as the shell's outermost
                 element); Material's desktop SideSheet is a STANDARD/push variant - PART_SideSheet
                 docks Right at SideSheetWidth and PART_ContentPanel takes the DockPanel's remainder
                 via LastChildFill - so wrapping real content in it reflowed the entire shell (title
                 bar, drawer, page host, FAB, snackbar) sideways by 440px on open, which is not what
                 "slides identically or better" asked for.

                 Left as a stretched sibling with nothing assigned to SideSheet's own Content, the
                 SAME internal DockPanel reproduces the old two-Border geometry for free instead:
                 PART_SideSheet (docked, opaque - styled below) IS the old slide-in panel, and
                 PART_ContentPanel's remainder-plus-scrim IS the old full-bleed backdrop, since there
                 is nothing else in that remainder for it to push. Nothing outside this control's own
                 bounds ever reflows.

                 IsHitTestVisible is bound to IsSettingsPanelOpen, matching the old backdrop's own
                 binding: this control now occupies the WHOLE shell area at all times (closed panel
                 sits off-screen via Margin, not by shrinking the control's Bounds), so without this
                 the always-present PART_RootBorder/PART_ContentPanel would swallow every pointer
                 event over the shell even while closed - Avalonia hit-tests a transparent Background
                 the same as an opaque one (the same trap the SnackbarHost comment below already
                 documents for this exact file). IsHitTestVisible=False blocks the whole subtree, so
                 this has to flip true the instant the sheet opens, before the slide animation starts -
                 same instant-flag-plus-animated-visual split the old backdrop already used.

                 SideSheetPadding is forced to 0 so this view keeps full control of the header's and
                 content's own padding (20,16 / 20 below) instead of fighting an inherited 16px inset
                 around both - see the header Border's own padding for where that value landed.

                 SideSheetOpened is TwoWay for the same reason ShellDrawer's LeftDrawerOpened is
                 (comment further up): the built-in scrim click assigns SideSheetOpened = false
                 directly on the control, and the property's own default binding mode IS already
                 TwoWay, but this stays explicit so the reason doesn't have to be rediscovered.

                 SideSheetCanClose="False" hides SideSheet's own PART_CloseButton - this view supplies
                 its own close button inside SideSheetHeader instead, wired to
                 CloseSettingsPanelCommand rather than the template's bare "set SideSheetOpened
                 false", so the header keeps the exact markup (title/subtitle stack, accessible close
                 button) the old panel had.

                 Background/BorderBrush are deliberately NOT set here - the template routes both to
                 PART_RootBorder, which wraps the WHOLE control including the scrim's remainder area,
                 so setting them on the control itself would paint (and border) the entire shell, not
                 the 440px panel. They're set on PART_SideSheet specifically instead, in
                 UserControl.Styles below. -->
            <material:SideSheet Grid.Row="0" Grid.RowSpan="3" Name="SettingsSideSheet"
                                 SideSheetOpened="{Binding IsSettingsPanelOpen, Mode=TwoWay}"
                                 SideSheetDirection="Right"
                                 SideSheetWidth="440"
                                 SideSheetPadding="0"
                                 SideSheetCanClose="False"
                                 IsHitTestVisible="{Binding IsSettingsPanelOpen}">
                <material:SideSheet.SideSheetHeader>
                    <Border Name="SettingsSheetHeader" Padding="20,16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{conv:Localize Personalize_Title}" FontSize="20" FontWeight="Black" />
                                <TextBlock Text="{conv:Localize Personalize_Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1"/>
                            </StackPanel>
                            <Button AutomationProperties.Name="{conv:Localize A11y_Close}" Grid.Column="1" Command="{Binding CloseSettingsPanelCommand}" Background="Transparent" Padding="8" CornerRadius="8" BorderThickness="0" VerticalAlignment="Top" Cursor="Hand">
                                <mi:MaterialIcon Kind="Close" Foreground="{DynamicResource TextMutedBrush}" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                    </Border>
                </material:SideSheet.SideSheetHeader>

                <!-- Live personalization content: language + all visual customization.
                     MaxHeight is a REAL constraint, not decoration (review round 1, HIGH): the
                     template presents SideSheetContent through PART_SideContentPresenter, a child of
                     StackPanel#PART_SideSheetPanel - and a vertical StackPanel measures every child
                     with infinite available height, so without an explicit bound this ScrollViewer
                     sizes itself to its full content instead of scrolling, and everything below the
                     fold (PersonalizationPanelView alone is taller than a 1080p viewport) becomes
                     unreachable - PART_RootBorder is ClipToBounds="False", so it does not even get
                     clipped, it runs off the window. SubtractHeightConverter turns two live Bounds
                     readings (this sheet's own full height, minus the header's actual rendered
                     height) into the one number that is actually available, so a translated
                     Subtitle that wraps to two lines still gets the header height it really needs
                     instead of a guessed constant.

                     ConverterParameter="5" cancels PART_SideContentPresenter's own
                     Margin="0,5,0,0" (set by SideSheet's ControlTheme, unconditioned, so it applies
                     regardless of pseudo-class) - without it MaxHeight overshoots the truly available
                     space by exactly that margin, and on a maximised window the last 5px of the
                     viewport sit past the window edge, unclipped (review round 2, LOW). -->
                <material:SideSheet.SideSheetContent>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.MaxHeight>
                            <MultiBinding Converter="{x:Static conv:SubtractHeightConverter.Instance}" ConverterParameter="5">
                                <Binding ElementName="SettingsSideSheet" Path="Bounds.Height"/>
                                <Binding ElementName="SettingsSheetHeader" Path="Bounds.Height"/>
                            </MultiBinding>
                        </ScrollViewer.MaxHeight>
                        <StackPanel Margin="20" Spacing="16">

                            <!-- ═══ LANGUAGE (binds the shared SettingsViewModel) ═══ -->
                            <material:Card Padding="16" DataContext="{Binding SettingsVm}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="{conv:Localize Settings_Language}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                                    <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedValue="{Binding Language}" SelectedValueBinding="{Binding Code}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </material:Card>

                            <!-- ═══ ALL VISUAL CUSTOMIZATION (live-applied via CustomizationViewModel) ═══ -->
                            <views:PersonalizationPanelView DataContext="{Binding CustomizationVm}"/>

                        </StackPanel>
                    </ScrollViewer>
                </material:SideSheet.SideSheetContent>
            </material:SideSheet>

            <!-- ═══ FLOATING GEAR FAB (Bottom-Right) ═══ -->
            <Button AutomationProperties.Name="{conv:Localize Personalize_FabTooltip}" Grid.Row="1" Classes="gear-fab" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20" Command="{Binding ToggleSettingsPanelCommand}" ToolTip.Tip="{conv:Localize Personalize_FabTooltip}" IsVisible="{Binding !IsShellChromeHidden}">
                <mi:MaterialIcon Kind="Palette" Foreground="{DynamicResource AccentForegroundBrush}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <!-- ═══ SNACKBAR HOST (RemEx-uedna) ═══
                 Replaces the WindowNotificationManager / NotificationCard toast. Declared after the
                 FAB so it paints on top of it should the two ever overlap, but the real fix is the
                 bottom margin: 20 (FAB's own margin) + 52 (FAB height) + 16 (gap) = 88, which clears
                 the FAB's footprint entirely rather than relying on z-order alone - the acceptance
                 criterion is "above the FAB", not merely "not visually identical to it".
                 HorizontalAlignment/VerticalAlignment (not the Snackbar* ones) are set to Right/Bottom
                 so the control sizes to its own content instead of stretching over the row - a
                 stretched ContentControl with a Background (the control theme sets Transparent, and
                 Avalonia hit-tests a transparent brush same as an opaque one) would swallow every
                 click over the content area whenever no toast is showing. SnackbarMaxCounts=3 matches
                 the old WindowNotificationManager's MaxItems so multiple toasts still stack instead of
                 replacing each other outright.

                 HostName is a plain literal, not an x:Static against ShellView.ShellSnackbarHostName -
                 XamlIl cannot resolve a static member of the very class its own code-behind partial is
                 compiling (AVLN2000, measured). Same convention this file already uses for x:Name /
                 FindControl pairs (PageHost, SettingsPanel, ImmersiveHost, BootSplash): the string must
                 match SnackbarToastSink's ShellSnackbarHostName below, and ShellSnackbarHostTests pins
                 both ends. -->
            <material:SnackbarHost Grid.Row="1" HostName="ShellSnackbar"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,20,88"
                                   SnackbarHorizontalAlignment="Right" SnackbarVerticalAlignment="Bottom"
                                   SnackbarMaxCounts="3"/>

            <!-- ═══ WELCOME SPLASH — BOOT SEQUENCE ═══ -->
            <splash:SkiaSplashControl x:Name="BootSplash" Grid.RowSpan="2" IsVisible="{Binding ShowWelcomeSplash}" SplashStyle="{Binding Customization.SplashStyle}" ZIndex="999"/>

            <!-- ═══ TUTORIAL OVERLAY (first-run or replay) ═══ -->
            <Border Grid.RowSpan="2" IsVisible="{Binding ShowTutorialOverlay}" Background="{DynamicResource OverlayBackdropBrush}" ZIndex="998">
                <Grid>
                    <Border Width="520" MaxWidth="540" Padding="32,28" Background="{DynamicResource GlassBaseDarkBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="16">
                            <!-- Header with Skip -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{conv:Localize Tutorial_Header}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="3" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="{conv:Localize Tutorial_Skip}" Command="{Binding TutorialSkipCommand}" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Padding="8,4" CornerRadius="6" Cursor="Hand" BorderThickness="0" ToolTip.Tip="{conv:Localize Tutorial_SkipTooltip}"/>
                            </Grid>

                            <!-- Page 0: Welcome -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=0}">
                                <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P0_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P0_Body}"/>
                            </StackPanel>

                            <!-- Page 1: How It Works -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=1}">
                                <TextBlock Text="🔗" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P1_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P1_Body1}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P1_Body2}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Text="{conv:Localize Tutorial_P1_Diagram}"/>
                                </Border>
                            </StackPanel>

                            <!-- Page 2: HWInfo Setup -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=2}">
                                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P4_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P4_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P4_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemWarningBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P4_Warning}"/>
                            </StackPanel>

                            <!-- Page 3: Sensors Overview -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=3}">
                                <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P5_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P5_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P5_HWInfo}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P5_BuiltIn}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P5_Body2}"/>
                            </StackPanel>

                            <!-- Page 4: App Launcher -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=4}">
                                <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P6_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P6_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P6_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P6_Note}"/>
                            </StackPanel>

                            <!-- Page 5: Network & Discovery -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=5}">
                                <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P7_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P7_Body1}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P7_Body2}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P7_IpSteps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P7_Body3}"/>
                            </StackPanel>

                            <!-- Page 6: QR Code Pairing -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=6}">
                                <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P8_QR_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P8_QR_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P8_QR_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P8_QR_Body2}"/>
                            </StackPanel>

                            <!-- Page 7: File Transfer -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=7}">
                                <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P9_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P9_Body1}"/>
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Text="{conv:Localize Tutorial_P9_Steps}"/>
                                </Border>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P9_Body2}"/>
                            </StackPanel>

                            <!-- Page 8: Glossary Command Palette -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=8}">
                                <TextBlock Text="⌨️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_CommandPalette_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_CommandPalette_Body}"/>
                            </StackPanel>

                            <!-- Page 9: Glossary App Launcher -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=9}">
                                <TextBlock Text="🚀" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_AppLauncher_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_AppLauncher_Body}"/>
                            </StackPanel>

                            <!-- Page 10: Glossary Task Manager -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=10}">
                                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_TaskManager_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_TaskManager_Body}"/>
                            </StackPanel>

                            <!-- Page 11: Glossary Sensor Canvas -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=11}">
                                <TextBlock Text="🌡️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_SensorCanvas_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_SensorCanvas_Body}"/>
                            </StackPanel>

                            <!-- Page 12: Glossary File Transfer -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=12}">
                                <TextBlock Text="📁" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_FileTransfer_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_FileTransfer_Body}"/>
                            </StackPanel>

                            <!-- Page 13: Glossary Remote Desktop -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=13}">
                                <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_RemoteDesktop_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_RemoteDesktop_Body}"/>
                            </StackPanel>

                            <!-- Page 14: Glossary Quick Settings -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=14}">
                                <TextBlock Text="⚙️" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_QuickSettings_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_QuickSettings_Body}"/>
                            </StackPanel>

                            <!-- Page 15: Glossary Customization -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=15}">
                                <TextBlock Text="🎨" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_Glossary_Customization_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_Glossary_Customization_Body}"/>
                            </StackPanel>

                            <!-- Page 16: You're All Set -->
                            <StackPanel Spacing="12" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=16}">
                                <TextBlock Text="🎉" FontSize="48" HorizontalAlignment="Center"/>
                                <TextBlock Text="{conv:Localize Tutorial_P10_Title}" FontSize="22" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P10_Body1}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Text="{conv:Localize Tutorial_P10_Body2}"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" FontStyle="Italic" TextAlignment="Center" Text="{conv:Localize Tutorial_P10_Replay}"/>
                            </StackPanel>

                            <!-- Page indicator dots -->
                            <ItemsControl ItemsSource="{Binding TutorialPageDots}" HorizontalAlignment="Center" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentPrimaryBrush}" Opacity="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Don't Show Again checkbox -->
                            <CheckBox IsChecked="{Binding DontShowTutorialAgain}" Content="{conv:Localize Tutorial_DontShowAgain}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,8,0,0" HorizontalAlignment="Center"/>

                            <!-- Navigation buttons -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0" Content="{conv:Localize Tutorial_Back}" Command="{Binding TutorialPreviousCommand}" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntNotEqualConverter.Instance}, ConverterParameter=0}" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                                <Button Grid.Column="2" Content="{conv:Localize Tutorial_Next}" Command="{Binding TutorialNextCommand}" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntNotEqualConverter.Instance}, ConverterParameter=16}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentForegroundBrush}" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                                <Button Grid.Column="2" Content="{conv:Localize Tutorial_Finish}" Command="{Binding TutorialFinishCommand}" IsVisible="{Binding TutorialPageIndex, Converter={x:Static conv:IntEqualConverter.Instance}, ConverterParameter=16}" Background="{DynamicResource SystemSuccessBrush}" Foreground="{DynamicResource SuccessForegroundBrush}" Padding="16,8" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </ctrl:DashboardBackgroundControl>
</UserControl>
