<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Remex.Desktop.ViewModels"
             xmlns:local="clr-namespace:Remex.Desktop.Converters"
             xmlns:logging="using:Remex.Core.Logging"
             x:Class="Remex.Desktop.Views.DiagnosticLogsView"
             x:DataType="vm:DiagnosticLogsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.log-btn">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.log-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>
        <!-- Compact rows for the virtualized log list -->
        <Style Selector="ListBox.log-list ListBoxItem">
            <Setter Property="Padding" Value="8,1"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="40" HorizontalAlignment="Stretch">
        <!-- Header -->
        <TextBlock Grid.Row="0" Classes="page-title" Text="{local:Localize Logs_Header}" Margin="0,0,0,24"/>

        <!-- Main Card -->
        <Border Grid.Row="1" Classes="glass-card" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TabControl>
                <!-- Tab 1: Live App Logs -->
                <TabItem Header="{local:Localize Logs_LiveTab}">
                    <Grid RowDefinitions="Auto,Auto,*" Margin="0,16,0,0">
                        <!-- Filter toolbar (live, non-destructive) -->
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,8">
                                <TextBlock Text="{local:Localize Logs_VerbosityFilter}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding SelectedDisplayLevel}" Width="140" CornerRadius="8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,8">
                                <TextBlock Text="{local:Localize Logs_Preset}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" Width="185" CornerRadius="8" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBox Text="{Binding SearchText}" Watermark="{local:Localize Logs_SearchWatermark}" Width="220" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,16,8"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="{local:Localize Logs_CaptureLevel}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding CaptureLevelOptions}" SelectedItem="{Binding SelectedCaptureLevel}" Width="120" CornerRadius="8" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Logs_CaptureLevelTip}"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Export + actions bar -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" Margin="0,0,0,12">
                            <TextBlock Grid.Column="0" Text="{local:Localize Logs_ExportAs}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}" Width="90" CornerRadius="8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding ExportScopes}" SelectedItem="{Binding SelectedExportScope}" Width="195" CornerRadius="8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding EntryCountText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button Grid.Column="4" Classes="log-btn" Content="{local:Localize Logs_Export}" Command="{Binding ExportLogsCommand}" Margin="0,0,10,0"/>
                            <Button Grid.Column="5" Classes="log-btn" Content="{local:Localize Logs_Refresh}" Command="{Binding RefreshLogsCommand}" Margin="0,0,10,0"/>
                            <Button Grid.Column="6" Classes="log-btn" Content="{local:Localize Logs_Clear}" Command="{Binding ClearLogsCommand}" Foreground="{DynamicResource SystemErrorBrush}"/>
                        </Grid>

                        <!-- Colored, virtualized log list -->
                        <Border Grid.Row="2" Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="12" Padding="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" MinHeight="360" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ListBox Classes="log-list" ItemsSource="{Binding VisibleEntries}" Background="Transparent" BorderThickness="0" SelectionMode="Multiple" FontFamily="Consolas" FontSize="12">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="logging:LogEntry">
                                        <StackPanel Spacing="1" Margin="0,1">
                                            <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                                <TextBlock Grid.Column="0" Text="{Binding TimeStamp, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding Level, Converter={x:Static local:LogLevelToBrushConverter.Instance}}" FontWeight="Bold" Width="76" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{DynamicResource TextMutedBrush}" Width="170" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{Binding Level, Converter={x:Static local:LogLevelToBrushConverter.Instance}}" TextWrapping="Wrap"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Exception}" IsVisible="{Binding Exception, Converter={x:Static ObjectConverters.IsNotNull}}" Foreground="{DynamicResource SystemErrorBrush}" FontSize="11" TextWrapping="Wrap" Margin="84,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 2: System Event Logs (key names still say Service for history) -->
                <TabItem Header="{local:Localize Logs_ServiceTab}">
                    <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
                        <!-- Toolbar -->
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <TextBlock Grid.Column="0" Text="{local:Localize Logs_ServiceDesc}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="log-btn" Content="{local:Localize Logs_QueryService}" Command="{Binding FetchServiceLogsCommand}"/>
                        </Grid>

                        <!-- Terminal Output -->
                        <Border Grid.Row="1" Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" MinHeight="400" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBox Text="{Binding ServiceLogsText}"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Background="Transparent"
                                         Foreground="{DynamicResource SystemSuccessBrush}"
                                         BorderThickness="0"
                                         Margin="0"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
