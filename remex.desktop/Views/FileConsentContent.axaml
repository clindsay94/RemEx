<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Remex.Desktop.ViewModels"
             xmlns:local="clr-namespace:Remex.Desktop.Converters"
             mc:Ignorable="d" d:DesignWidth="392"
             x:Class="Remex.Desktop.Views.FileConsentContent"
             x:DataType="vm:FileConsentDialogViewModel"
             Width="392">

    <!-- The message, detail card and "remember" checkbox that FileConsentDialog.axaml carried
         directly. Title/message are inside this control rather than the dialog builder's own
         ContentHeader/SupportingText because the Remember checkbox has to sit under them either
         way, and one bound control keeps that whole block, bindings included, unchanged from before
         (RemEx-2m7fr pinned the CheckBox binding at FileConsentDialogViewModel.cs:40,59-65). -->
    <StackPanel Spacing="14" Margin="24,24,24,0">

        <StackPanel Spacing="6">
            <TextBlock Text="{Binding Title}"
                       Theme="{StaticResource Headline6TextBlock}"/>
            <TextBlock Text="{Binding Message}"
                       Theme="{StaticResource Body2TextBlock}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       MaxWidth="440"/>
        </StackPanel>

        <Border IsVisible="{Binding HasDetail}"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <TextBlock Text="{Binding Detail}"
                       Theme="{StaticResource Body2TextBlock}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <CheckBox IsChecked="{Binding Remember}"
                  Content="{local:Localize FileConsent_Remember}"
                  Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
</UserControl>
