<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Remex.Desktop.Converters"
        x:Class="Remex.Desktop.Views.RestorePromptWindow"
        x:CompileBindings="False"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <Grid RowDefinitions="Auto,Auto,Auto" Margin="24,40,24,24">

        <!-- Dialog title -->
        <TextBlock Grid.Row="0"
                   Text="{local:Localize Restore_PromptTitle}"
                   Theme="{StaticResource Headline6TextBlock}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- Descriptive message, includes the snapshot date (set in code-behind) -->
        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Theme="{StaticResource Body2TextBlock}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,28"/>

        <!-- Buttons: Skip (left) | Restore (right) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="SkipBtn"
                    Classes="tertiary"
                    Content="{local:Localize Restore_Skip}"
                    Click="OnSkipClicked"/>
            <Button x:Name="RestoreBtn"
                    Classes="primary"
                    Content="{local:Localize Restore_Accept}"
                    Click="OnRestoreClicked"/>
        </StackPanel>

    </Grid>
</Window>
