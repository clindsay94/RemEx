<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    xmlns:controls="clr-namespace:Remex.Desktop.Controls" xmlns:views="using:Remex.Desktop.Views" x:Class="Remex.Desktop.Views.AboutView" x:DataType="vm:AboutViewModel">

    <UserControl.Styles>
        <Style Selector="Button.about-back">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.about-back:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>
        <Style Selector="Button.about-back:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.github-btn">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16 10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="page-content" Margin="32" Spacing="24">

            <!-- Back Button -->
            <Button Classes="about-back" Content="{local:Localize Settings_Back}" Command="{Binding NavigateBackCommand}" HorizontalAlignment="Left"/>

            <!-- Header -->
            <TextBlock Classes="page-title" Text="{local:Localize About_Header}" HorizontalAlignment="Center"/>

            <!-- ═══ RESPONSIVE TWO-COLUMN CONTENT ═══ -->
            <WrapPanel x:Name="AboutCards" HorizontalAlignment="Stretch">

                <!-- LEFT COLUMN -->
                <StackPanel Width="{Binding #AboutCards.Bounds.Width, Converter={x:Static local:ResponsiveColumnWidthConverter.Instance}}" Spacing="24" Margin="0,0,24,16">

                    <!-- App Logo and Name -->
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <Border Width="100" Height="100" CornerRadius="50" ClipToBounds="True" HorizontalAlignment="Center">
                            <controls:BrandMark/>
                        </Border>

                        <TextBlock Classes="page-subtitle" Text="{local:Localize About_Tagline}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Keyboard Shortcuts Button -->
                    <Button Classes="about-back" Content="{local:Localize About_KeyboardShortcuts}" Command="{Binding ToggleShortcutsCommand}" HorizontalAlignment="Center" Margin="0,-8,0,0">
                        <Button.Flyout>
                            <Flyout Placement="Bottom" IsOpen="{Binding IsShowShortcutsOpen, Mode=TwoWay}">
                                <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{local:Localize About_KeyboardShortcuts}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,8"/>

                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Ctrl + K" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{local:Localize About_CommandPalette}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Ctrl + Z" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{local:Localize About_UndoLayout}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Ctrl + Y" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,16,8"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{local:Localize About_RedoLayout}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,0,8"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Esc" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{local:Localize About_CloseOverlays}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Version Info Card -->
                    <material:Card Padding="20" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                        <StackPanel Spacing="16">
                            <!-- This RemEx app's own version (remex.agent is one process — there is no separate desktop client) -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <mi:MaterialIcon Kind="Laptop" Foreground="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="{local:Localize About_DesktopClient}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ClientVersion}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,0,0,0"/>
                                <!-- Build id: which BUILD, as opposed to which release (RemEx-2ckhm).
                                     Monospaced and selectable on purpose — the entire use case is
                                     reading it off a screen and typing it into a message, and the
                                     digit/letter pairs a proportional face blurs are exactly the ones
                                     that get transcribed wrong. Hidden rather than shown as "unknown"
                                     when the assembly carries no stamp. -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="30,0,0,0"
                                            IsVisible="{Binding HasClientBuildId}">
                                    <TextBlock Text="{local:Localize About_BuildId}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <SelectableTextBlock Text="{Binding ClientBuildId}"
                                                         FontSize="12"
                                                         FontFamily="Consolas, Menlo, monospace"
                                                         Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.5"/>

                            <!-- Embedded host connection status / version ("Your PC") -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <mi:MaterialIcon Kind="Monitor" Foreground="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="{local:Localize About_PCHost}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HostVersion}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,0,0,0"/>
                                <!-- The host's build id in its COMPARABLE form: sha, and a bare '+'
                                     for a dirty build — never the remote dirty suffix, which a
                                     different tool hashed and which would invite a false mismatch
                                     against the row above (RemEx-d9guj). Same monospace/selectable
                                     treatment and the same hidden-when-absent rule as the local row,
                                     so an older host shows nothing here rather than "unknown". -->
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="30,0,0,0"
                                            IsVisible="{Binding HasHostBuildId}">
                                    <TextBlock Text="{local:Localize About_BuildId}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <SelectableTextBlock Text="{Binding HostBuildId}"
                                                         FontSize="12"
                                                         FontFamily="Consolas, Menlo, monospace"
                                                         Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.5"/>

                            <!-- This PC's certificate fingerprint (RemEx-n8xk).
                                 The phone shows the same value in the same grouping when it warns that this
                                 PC's certificate changed, and tells the user to check it here — so this is
                                 monospaced (the groups must line up against a phone screen) and selectable
                                 (so it can be pasted into a support thread). -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <mi:MaterialIcon Kind="LinkVariant" Foreground="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="{local:Localize About_HostFingerprint}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <SelectableTextBlock Text="{Binding HostFingerprint}" FontFamily="{StaticResource JetBrainsMono}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="30,0,0,0"/>
                                <TextBlock Text="{local:Localize About_HostFingerprint_Hint}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="30,0,0,0"/>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.5"/>

                            <!-- Software Update -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <mi:MaterialIcon Kind="Sync" Foreground="{DynamicResource AccentPrimaryBrush}" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Text="{local:Localize About_Update_Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UpdateStatusText}" IsVisible="{Binding HasUpdateStatus}"
                                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="30,0,0,0"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="30,4,0,0">
                                    <Button Classes="action-btn"
                                            Content="{local:Localize About_Update_CheckButton}"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            IsEnabled="{Binding !IsCheckingForUpdate}"/>
                                    <Button Classes="github-btn"
                                            Content="{local:Localize About_Update_DownloadButton}"
                                            Command="{Binding DownloadUpdateCommand}"
                                            IsVisible="{Binding IsUpdateAvailable}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </material:Card>

                </StackPanel>

                <!-- RIGHT COLUMN -->
                <StackPanel Width="{Binding #AboutCards.Bounds.Width, Converter={x:Static local:ResponsiveColumnWidthConverter.Instance}}" Spacing="24" Margin="0,0,0,16">

                    <!-- What's New Section -->
                    <material:Card Padding="20" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{local:Localize About_WhatsNew}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding WhatsNewItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="4" Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Version}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </material:Card>

                    <!-- GitHub Section -->
                    <material:Card Padding="20" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12">
                        <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                            <TextBlock Text="{local:Localize About_GitHubStar}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <TextBlock Text="{local:Localize About_GitHubDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center"/>

                            <Button Classes="github-btn" Content="{local:Localize About_ViewGitHub}" Command="{Binding OpenGitHubCommand}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </material:Card>

                </StackPanel>

            </WrapPanel>

            <!-- FAQ (merged from the former standalone FAQ page) -->
            <StackPanel Spacing="12" MaxWidth="900" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                <TextBlock Text="{local:Localize Nav_Faq}" FontSize="18" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                <ItemsControl ItemsSource="{Binding FaqItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander Margin="0,0,0,8" Padding="4" Header="{Binding Question}">
                                <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Text="{local:Localize About_MadeWith}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,32"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
