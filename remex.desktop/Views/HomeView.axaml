<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    xmlns:ctrl="using:Remex.Desktop.Controls"
    xmlns:services="using:Remex.Desktop.Services"
    xmlns:local="clr-namespace:Remex.Desktop.Converters" x:Class="Remex.Desktop.Views.HomeView" x:DataType="vm:HomeViewModel">

    <UserControl.Styles>
        <!-- System status row dot. CLASS BINDINGS rather than a bound brush name, because a
             DynamicResource cannot be resolved from a string a binding produced - it would silently
             render nothing. All three brushes exist in every one of the four themes. -->
        <Style Selector="Ellipse.state-dot">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="{DynamicResource SystemSuccessBrush}"/>
        </Style>
        <Style Selector="Ellipse.state-dot.attention">
            <Setter Property="Fill" Value="{DynamicResource SystemWarningBrush}"/>
        </Style>
        <Style Selector="Ellipse.state-dot.problem">
            <Setter Property="Fill" Value="{DynamicResource SystemErrorBrush}"/>
        </Style>

        <!-- Quick-action pill buttons -->
        <Style Selector="Button.action-pill">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.action-pill:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
        </Style>
        <Style Selector="Button.action-pill:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.action-pill-accent">
            <Setter Property="Background">
                <Setter.Value>
                    <SolidColorBrush Color="{DynamicResource AccentPrimary}" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.action-pill-danger">
            <!-- Foreground: SystemErrorBrush rather than the raw SystemError Color. This is a
                 readability change, NOT a bug fix — DynamicResourceExpression converts a Color to a
                 Brush via ColorToBrushConverter when the target property is IBrush, so the old form
                 resolved correctly too. Naming the brush just matches every sibling style here.
                 BorderBrush: deliberate theme alignment, replacing a hardcoded #40FF6B6B with the
                 theme's own error tint so the danger pill follows the palette the way the accent
                 pill above it already does (RemEx-fy0a). -->
            <Setter Property="Foreground" Value="{DynamicResource SystemErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorBackgroundBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0" Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="40,32,40,40" Spacing="48">

            <!-- ═══ WELCOME HERO ═══ -->
            <Grid>
                <!-- Decorative background watermark -->
                <TextBlock Text="REMEX" FontSize="280" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource AccentPrimaryBrush}" Opacity="0.03" Margin="-40,-80,0,0" IsHitTestVisible="False"/>

                <StackPanel Spacing="16" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Border Width="128" Height="128" CornerRadius="30" ClipToBounds="True" HorizontalAlignment="Center" ToolTip.Tip="{local:Localize Home_LogoTooltip}">
                        <ctrl:BrandMark Width="128" Height="128"/>
                    </Border>

                    <TextBlock Classes="page-title" Text="{local:Localize Home_WelcomeTitle}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{local:Localize Home_WelcomeIntro}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="640" TextWrapping="Wrap" LineHeight="21"/>

                    <!-- Command palette launcher -->
                    <Button AutomationProperties.Name="{local:Localize Shell_OpenCommandPaletteTooltip}" Command="{Binding Shell.OpenCommandPaletteCommand}" Classes="action-pill" HorizontalAlignment="Center" MinWidth="380" Padding="18,12" Margin="0,8,0,0" ToolTip.Tip="{local:Localize Shell_OpenCommandPaletteTooltip}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <mi:MaterialIcon Grid.Column="0" Kind="Magnify" Foreground="{DynamicResource TextMutedBrush}" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{local:Localize Home_SearchPrompt}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Border Grid.Column="2" Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="6" Padding="8,3" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + K" FontSize="11" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Keyboard shortcuts strip -->
                    <WrapPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4" VerticalAlignment="Center">
                            <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="5" Padding="6,2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <TextBlock Text="Ctrl + 1–7" FontSize="10" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="{local:Localize Home_ScNav}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4" VerticalAlignment="Center">
                            <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="5" Padding="6,2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <TextBlock Text="Ctrl + ," FontSize="10" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="{local:Localize Home_ScSettings}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,4" VerticalAlignment="Center">
                            <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="5" Padding="6,2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <TextBlock Text="Esc" FontSize="10" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="{local:Localize Home_ScClose}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- ═══ SYSTEM STATUS (RemEx-id37) ═══ -->
            <Border Classes="glass-card" Padding="24" CornerRadius="4,20,4,20" BorderThickness="1,0,0,0"
                    IsVisible="{Binding SystemStatus.IsRendered}">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="card-title"
                                   Text="{local:Localize SystemStatus_Title}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Classes="action-pill" Padding="12,6" FontSize="12"
                                Command="{Binding SystemStatus.RefreshCommand}"
                                IsEnabled="{Binding !SystemStatus.IsChecking}"
                                AutomationProperties.Name="{local:Localize SystemStatus_Recheck}"
                                ToolTip.Tip="{local:Localize SystemStatus_Recheck}"
                                Content="{local:Localize SystemStatus_Recheck}"/>
                    </Grid>

                    <!-- COLLAPSED WHEN READY: one line, no rows. A card that is always open teaches
                         people to stop reading it. -->
                    <TextBlock Text="{local:Localize SystemStatus_AllReady}" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding SystemStatus.IsFullyReady}"/>

                    <!-- THE HOST IS NOT THERE. Review found IsUnavailable computed and rendered
                         nowhere, so the card simply vanished - on the one surface a user opens to
                         find out that the host is down. -->
                    <TextBlock Text="{local:Localize SystemStatus_Unavailable}" FontSize="13"
                               Foreground="{DynamicResource SystemWarningBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding SystemStatus.IsUnavailable}"/>

                    <!-- DataContext set HERE so each row can reach the card's FixCommand. Review
                         found the first version casting $parent[ItemsControl].DataContext to
                         SystemStatusViewModel - but the ItemsControl inherited HomeViewModel, so the
                         cast failed, Command bound to null, and the Fix button did NOTHING with no
                         error anywhere. Avalonia binding failures are silent. -->
                    <ItemsControl DataContext="{Binding SystemStatus}"
                                  ItemsSource="{Binding Rows}"
                                  IsVisible="{Binding !IsFullyReady}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SystemStatusRowViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                                    <Ellipse Grid.Column="0" Classes="state-dot"
                                             Classes.attention="{Binding IsAttention}"
                                             Classes.problem="{Binding IsProblem}"
                                             VerticalAlignment="Top" Margin="0,5,12,0"/>

                                    <StackPanel Grid.Column="1" Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <!-- The SENTENCE, never ReadinessCheck.Detail: Detail is
                                             developer-facing English built for logs, sometimes from an
                                             exception message, and the view model has no path to it. -->
                                        <TextBlock Text="{Binding Sentence}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" MaxWidth="620"
                                                   HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Top">
                                        <Button Classes="action-pill" Padding="12,6" FontSize="12"
                                                IsVisible="{Binding ShowsFix}"
                                                IsEnabled="{Binding !$parent[ItemsControl].((vm:SystemStatusViewModel)DataContext).IsChecking}"
                                                Command="{Binding $parent[ItemsControl].((vm:SystemStatusViewModel)DataContext).FixCommand}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{local:Localize SystemStatus_Fix}"
                                                Content="{local:Localize SystemStatus_Fix}"/>
                                        <!-- Same $parent[ItemsControl] cast as the Fix button above,
                                             and for the same reason: the ItemsControl inherits
                                             HomeViewModel, so reaching the card's command needs the
                                             explicit cast. Avalonia binding failures are silent, so
                                             getting this wrong gives a button that does nothing with
                                             no error anywhere. (RemEx-tb0a) -->
                                        <Button Classes="action-pill" Padding="12,6" FontSize="12"
                                                IsVisible="{Binding ShowsExplain}"
                                                Command="{Binding $parent[ItemsControl].((vm:SystemStatusViewModel)DataContext).ExplainCommand}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{local:Localize SystemStatus_Explain}"
                                                Content="{local:Localize SystemStatus_Explain}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ═══ ALWAYS-ON STATS STRIP (live CPU · memory · uptime) ═══ -->
            <Border Classes="glass-card" Padding="6,4" HorizontalAlignment="Center" CornerRadius="18">
                <StackPanel Orientation="Horizontal">
                    <!-- CPU -->
                    <StackPanel Width="190" Spacing="7" Margin="22,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{local:Localize Home_StatCpu}" FontSize="10" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Black" LetterSpacing="3" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding CpuText}" FontSize="21" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuPercent}" Height="4" MinHeight="4" CornerRadius="2" Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource GlassBaseDarkBrush}"/>
                    </StackPanel>

                    <Rectangle Width="1" Fill="{DynamicResource CardBorderBrush}" Margin="0,14" VerticalAlignment="Stretch"/>

                    <!-- MEMORY -->
                    <StackPanel Width="190" Spacing="7" Margin="22,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{local:Localize Home_StatMemory}" FontSize="10" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Black" LetterSpacing="3" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding RamText}" FontSize="21" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding RamPercent}" Height="4" MinHeight="4" CornerRadius="2" Foreground="{DynamicResource AccentPrimaryBrush}" Background="{DynamicResource GlassBaseDarkBrush}"/>
                    </StackPanel>

                    <Rectangle Width="1" Fill="{DynamicResource CardBorderBrush}" Margin="0,14" VerticalAlignment="Stretch"/>

                    <!-- UPTIME -->
                    <StackPanel Width="190" Spacing="7" Margin="22,14" VerticalAlignment="Center">
                        <TextBlock Text="{local:Localize Home_StatUptime}" FontSize="10" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Black" LetterSpacing="3" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding UptimeText}" FontSize="18" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <WrapPanel Margin="0,24,0,0" HorizontalAlignment="Center">

                <!-- ═══ LEFT COLUMN: LIVE TELEMETRY MATRIX ═══ -->
                <StackPanel MinWidth="400" MaxWidth="1400" Spacing="24" Margin="0,0,32,32">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{local:Localize Home_ActiveSensors}" FontSize="12" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="4" VerticalAlignment="Center"/>
                        <Button AutomationProperties.Name="{local:Localize Home_OpenWorkspace}" Grid.Column="1" Classes="action-pill" Command="{Binding NavigateToCanvasCommand}" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="[ ]" FontSize="14" FontFamily="{StaticResource JetBrainsMono}" VerticalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_OpenWorkspace}" FontSize="11" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox ItemsSource="{Binding PinnedSensors}" Background="Transparent" BorderThickness="0" Padding="0" IsVisible="{Binding PinnedSensors.Count}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <!-- The gap between cards is set HERE rather than on the card itself, and the
                                     corner radius is repeated here, so that the focus ring below lands on the
                                     card's own outline. Left on the card, the 20px margin sat inside the ring
                                     and the ring drew square-cornered, flush with the card on two sides and
                                     20px clear of it on the other two - visible, but reading as a stray box
                                     rather than as focus. -->
                                <Setter Property="Margin" Value="0,0,20,20"/>
                                <Setter Property="CornerRadius" Value="4,24,4,24"/>
                                <!-- The Border is not decoration: it is what makes the keyboard focus ring
                                     visible on these cards. App.axaml rings a focused ListBoxItem by setting
                                     BorderBrush and BorderThickness ON THE CONTROL, which only renders if the
                                     item's template binds them. Fluent's stock template does; this one
                                     replaces it, so without this Border the pinned sensors would be the one
                                     list in the app you can tab into and see nothing (RemEx-kgs7g).

                                     While UNFOCUSED the thickness is 0 and this costs no layout. While focused
                                     it costs 2px a side, and the WrapPanel slot is a fixed 280 wide, so the
                                     card narrows by 4px as focus arrives. Whether that twitch is noticeable is
                                     a visual question, recorded on the bead. -->
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{TemplateBinding CornerRadius}">
                                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemWidth="280"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SensorViewModel">
                                <!-- Margin moved onto the ListBoxItem so the focus ring hugs this card. -->
                                <Border Classes="glass-card interactive" Padding="24" Background="Transparent" CornerRadius="4,24,4,24" BorderThickness="1,0,0,0">
                                    <Panel>
                                        <ctrl:SparklineControl History="{Binding History}" GraphType="{Binding ResolvedGraphType}" AccentColor="{Binding Theme.AccentColor, Converter={x:Static conv:HexToColorConverter.Instance}}" Opacity="0.2" VerticalAlignment="Bottom" Height="80" Margin="-24,0,-24,-24"/>

                                        <StackPanel Spacing="16">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                <mi:MaterialIcon Grid.Column="1" Kind="Flash" Foreground="{Binding Theme.AccentColor, Converter={x:Static conv:HexToColorConverter.Instance}}" Width="14" Height="14" Opacity="0.8"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Bottom" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding Value, StringFormat={}{0:F1}}" FontSize="48" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Unit}" FontSize="16" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Panel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- No Sensors HUD state -->
                    <Border Classes="glass-card" Padding="48" IsVisible="{Binding !PinnedSensors.Count}" CornerRadius="4,32,4,32" BorderThickness="1,0,0,0">
                        <StackPanel Spacing="16" HorizontalAlignment="Center">
                            <TextBlock Text="{local:Localize Home_NoDataFeed}" FontSize="20" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" LetterSpacing="2"/>
                            <TextBlock Text="{local:Localize Home_NoPinnedSensorsHint}" FontSize="13" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"/>
                            <Button Classes="action-pill action-pill-accent" Content="{local:Localize Home_InitializeSensors}" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Black" Command="{Binding NavigateToCanvasCommand}" HorizontalAlignment="Center" Padding="24,12" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ═══ RIGHT COLUMN: QUICK LAUNCH ═══ -->
                <StackPanel Width="340" Spacing="16">
                    <TextBlock Text="{local:Localize Home_Directives}" FontSize="12" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="4"/>
                    <UniformGrid Columns="2">
                        <Button AutomationProperties.Name="{local:Localize Home_QsSensors}" Classes="glass-card interactive" Command="{Binding NavigateToCanvasCommand}" Padding="0" Margin="4" HorizontalAlignment="Stretch" CornerRadius="16">
                            <StackPanel Spacing="8" Margin="12,18" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="ChartLineVariant" Foreground="{DynamicResource AccentPrimaryBrush}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_QsSensors}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{local:Localize Home_QsCommands}" Classes="glass-card interactive" Command="{Binding NavigateToRemoteCommand}" Padding="0" Margin="4" HorizontalAlignment="Stretch" CornerRadius="16">
                            <StackPanel Spacing="8" Margin="12,18" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="Monitor" Foreground="{DynamicResource AccentPrimaryBrush}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_QsCommands}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{local:Localize Home_QsApps}" Classes="glass-card interactive" Command="{Binding NavigateToAppLauncherCommand}" Padding="0" Margin="4" HorizontalAlignment="Stretch" CornerRadius="16">
                            <StackPanel Spacing="8" Margin="12,18" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="Apps" Foreground="{DynamicResource AccentPrimaryBrush}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_QsApps}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{local:Localize Home_QsProcesses}" Classes="glass-card interactive" Command="{Binding NavigateToTaskManagerCommand}" Padding="0" Margin="4" HorizontalAlignment="Stretch" CornerRadius="16">
                            <StackPanel Spacing="8" Margin="12,18" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="FormatListBulleted" Foreground="{DynamicResource AccentPrimaryBrush}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_QsProcesses}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{local:Localize Home_QsFiles}" Classes="glass-card interactive" Command="{Binding NavigateToFileTransferCommand}" Padding="0" Margin="4" HorizontalAlignment="Stretch" CornerRadius="16">
                            <StackPanel Spacing="8" Margin="12,18" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="FolderOutline" Foreground="{DynamicResource AccentPrimaryBrush}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_QsFiles}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{local:Localize Home_QsLogs}" Classes="glass-card interactive" Command="{Binding NavigateToDiagnosticLogsCommand}" Padding="0" Margin="4" HorizontalAlignment="Stretch" CornerRadius="16">
                            <StackPanel Spacing="8" Margin="12,18" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="FileDocument" Foreground="{DynamicResource AccentPrimaryBrush}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_QsLogs}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{local:Localize Home_QsPersonalize}" Classes="glass-card interactive" Command="{Binding NavigateToCustomizationCommand}" Padding="0" Margin="4" HorizontalAlignment="Stretch" CornerRadius="16">
                            <StackPanel Spacing="8" Margin="12,18" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="Palette" Foreground="{DynamicResource AccentPrimaryBrush}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_QsPersonalize}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button AutomationProperties.Name="{local:Localize Home_QsAbout}" Classes="glass-card interactive" Command="{Binding NavigateToAboutCommand}" Padding="0" Margin="4" HorizontalAlignment="Stretch" CornerRadius="16">
                            <StackPanel Spacing="8" Margin="12,18" HorizontalAlignment="Center">
                                <mi:MaterialIcon Kind="InformationOutline" Foreground="{DynamicResource AccentPrimaryBrush}" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{local:Localize Home_QsAbout}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </WrapPanel>

            <!-- ═══ RECENT ACTIVITY ═══ -->
            <StackPanel MaxWidth="780" HorizontalAlignment="Center" Spacing="16">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{local:Localize Home_RecentActivity}" FontSize="12" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="4" VerticalAlignment="Center"/>
                    <Button AutomationProperties.Name="{local:Localize Home_ClearActivity}" Grid.Column="1" Classes="action-pill" Command="{Binding ClearActivityCommand}" Padding="14,7" IsVisible="{Binding HasRecentActivity}">
                        <TextBlock Text="{local:Localize Home_ClearActivity}" FontSize="11" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Bold"/>
                    </Button>
                </Grid>

                <!-- Populated feed -->
                <Border Classes="glass-card" Padding="8" CornerRadius="4,20,4,20" BorderThickness="1,0,0,0" IsVisible="{Binding HasRecentActivity}">
                    <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentActivity}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:ActivityEntry">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,9">
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource GlassBaseDarkBrush}" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding Glyph}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeLabel}" FontSize="11" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- Empty state -->
                <Border Classes="glass-card" Padding="32" CornerRadius="4,20,4,20" BorderThickness="1,0,0,0" IsVisible="{Binding !HasRecentActivity}">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="🗒" FontSize="26" HorizontalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="{local:Localize Home_NoRecentActivity}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ═══ Links: GitHub + Google Play ═══ -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button AutomationProperties.Name="{local:Localize Home_GitHubCardDesc}" Classes="glass-card interactive" Command="{Binding OpenGitHubCommand}" Padding="0" Margin="8" CornerRadius="16" ToolTip.Tip="{local:Localize Home_GitHubCardDesc}">
                    <Grid ColumnDefinitions="Auto,*" Margin="20" Width="270">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource CardBackgroundHoverBrush}" Margin="0,0,14,0">
                            <TextBlock Text="🐙" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{local:Localize Home_GitHubCard}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{local:Localize Home_GitHubCardDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Home_PlayStoreCardDesc}" Classes="glass-card interactive" Command="{Binding OpenPlayStoreCommand}" Padding="0" Margin="8" CornerRadius="16" ToolTip.Tip="{local:Localize Home_PlayStoreCardDesc}">
                    <Grid ColumnDefinitions="Auto,*" Margin="20" Width="270">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource SystemSuccessBackgroundBrush}" Margin="0,0,14,0">
                            <TextBlock Text="▶" FontSize="20" Foreground="{DynamicResource SystemSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{local:Localize Home_PlayStoreCard}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{local:Localize Home_PlayStoreCardDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Home_HwInfoCardDesc}" Classes="glass-card interactive" Command="{Binding OpenHwInfoCommand}" Padding="0" Margin="8" CornerRadius="16" ToolTip.Tip="{local:Localize Home_HwInfoCardDesc}">
                    <Grid ColumnDefinitions="Auto,*" Margin="20" Width="270">
                        <Border Width="44" Height="44" CornerRadius="22" Background="{DynamicResource SystemWarningBackgroundBrush}" Margin="0,0,14,0">
                            <TextBlock Text="🌡️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="{local:Localize Home_HwInfoCard}" FontSize="13" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{local:Localize Home_HwInfoCardDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Button>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>

    <!-- Advanced Status Node Footer -->
    <Border Grid.Row="1" Classes="glass-card" Padding="20" HorizontalAlignment="Center" BoxShadow="0 -8 32 0 #40000000" CornerRadius="20,20,4,4" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" Spacing="24">
            <Grid>
                <!-- Radar Sweep Animation -->
                <!-- All three of these (ring, halo, dot) follow PHONE presence, not the loopback link
                     (RemEx-7zzw). Binding only some of them would make the halo disagree with the
                     dot inside it. -->
                <Ellipse Width="48" Height="48" Classes="status-ring" Classes.connected="{Binding Presence.IsPhoneAttached}" StrokeThickness="1" Opacity="0.2"/>
                <Ellipse Width="48" Height="48" Classes="status-dot" Classes.connected="{Binding Presence.IsPhoneAttached}" Opacity="0.1"/>
                <Ellipse AutomationProperties.Name="{Binding Presence.PresenceAccessibleName}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="status-dot" Classes.connected="{Binding Presence.IsPhoneAttached}">
                </Ellipse>
            </Grid>
            <StackPanel HorizontalAlignment="Center" MinWidth="140">
                <!-- The label had to move with the line it labels (review). "LINK_STATUS" now sits over the
                     host-link detail; the phone line gets its own heading, because a label reading
                     LINK_STATUS above "No phone connected" is the same contradiction one level down. -->
                <TextBlock Text="{local:Localize Home_PhoneStatus}" FontSize="9" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
                <!-- The dot beside this follows PHONE presence, so this line must too (RemEx-7zzw). Binding
                     the dot alone put a red radar next to the word "Connected" — the contradiction moved
                     from between screens into one StackPanel, which is the more confusing of the two. -->
                <TextBlock Text="{Binding Presence.PresenceText}" FontSize="16" FontWeight="Black" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{local:Localize Home_LinkStatus}" FontSize="8" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Connection.StatusText}" FontSize="10" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Connection.LatencyText}" FontSize="12" FontFamily="{StaticResource JetBrainsMono}" Foreground="{DynamicResource AccentPrimaryBrush}" IsVisible="{Binding Connection.IsConnected}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Spacing="8">
                <Button Classes="action-pill action-pill-accent" Content="{local:Localize Home_InitializeLink}" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Black" Command="{Binding Connection.ConnectCommand}" IsVisible="{Binding !Connection.IsConnected}" Padding="20,10"/>
                <Button Classes="action-pill action-pill-danger" Content="{local:Localize Home_TerminateLink}" FontFamily="{StaticResource JetBrainsMono}" FontWeight="Black" Command="{Binding Connection.DisconnectCommand}" IsVisible="{Binding Connection.IsConnected}" Padding="20,10"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Grid>
</UserControl>
