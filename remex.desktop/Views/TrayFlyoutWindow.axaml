<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    xmlns:ctrl="using:Remex.Desktop.Controls"
    xmlns:svc="using:Remex.Desktop.Services"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    x:Class="Remex.Desktop.Views.TrayFlyoutWindow"
    x:DataType="vm:TrayFlyoutViewModel"
    Title="{local:Localize TrayFlyout_Title}"
    Width="528" Height="400"
    MinWidth="320" MinHeight="382"
    MaxWidth="944" MaxHeight="800">

    <!-- SizeToContent, CanResize, Focusable and ShowInTaskbar are deliberately absent: the
         code-behind's ApplyMode and constructor own them, and a value here would fight it.
         The Min/Max above duplicate TrayFlyoutGeometryValidator's constants, and Width duplicates
         TrayFlyoutGeometry.DefaultWidth (528, fix round 2 - wide enough for two 212px card columns;
         see that constant's XML doc), because Avalonia needs literals in XAML - change one, change
         the other. -->

    <Window.Styles>
        <!-- (RemEx-rjnbo.1) The presence badge now shows a device count, so a fixed 10x10 only
             fits the dot state (HasOnlineDevices false): at two-plus online devices the same size
             clips the "2"+ digits App.axaml's BadgeContent renders. Classes.dot on the element
             below gates this style so the count state is left unsized, like the nav count badges
             (ShellView.axaml:806/848/865). -->
        <Style Selector="material|Badged.dot">
            <Setter Property="BadgeWidth" Value="10"/>
            <Setter Property="BadgeHeight" Value="10"/>
        </Style>
    </Window.Styles>


    <Panel>

    <!-- Elevation2Shadow (blur 34, OffsetY 9 - ThemeService.cs:528), not Elevation3: this window
         is transparent with no decorations, so the shadow extent has to fit inside Margin below or
         it gets clipped by the window bounds into a hard band (RemEx-la0rk round 3). Margin 44 clears
         blur+OffsetY=43. Elevation3's 48/12 would need Margin ~=60, which eats too much of the
         320x382 MinWidth/MinHeight floor from TrayFlyoutGeometryValidator (382, not the old 240 -
         Flyout D2 .2, RemEx-4kv0g.18.6, closes RemEx-4kv0g.18.4 - see that constant's derivation
         comment) for the toolbar row below. -->
    <Border Background="{DynamicResource FlyoutGlassBrush}" CornerRadius="{DynamicResource CornerRadiusExtraLarge}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="12" BoxShadow="{DynamicResource Elevation2Shadow}">
        <!-- Row 1 (the cards ScrollViewer) starts Auto and the tiles row (2) is always Auto — the
             cards row is the only one whose Height changes, flipped to "*" by ApplyMode in the
             code-behind when the window is pinned, so a resized-taller pinned window hands the
             extra space to the cards instead of stretching the fixed-height tile buttons
             (RemEx-4kv0g.18.2). x:Name is how the code-behind reaches RowDefinitions[1]. -->
        <Grid x:Name="ContentGrid" RowDefinitions="Auto,Auto,Auto" Margin="16">

            <!-- Status strip. Doubles as the drag handle in pinned mode: this window has no system
                 title bar, so without PointerPressed here a pinned window could not be moved.
                 The material:Badged below is the presence indicator, and (RemEx-rjnbo.1) now also
                 carries the online-paired-device count as its content instead of rendering as a bare
                 dot - Classes="presence"/Classes.connected keep the same red/green vocabulary and
                 BottomRight placement App.axaml declares for both. Unlike the Files/Diagnostics
                 badges, this one is never fully hidden: it doubles as the presence dot, so at zero
                 online devices BadgeDisplayContent drops back to a plain dot rather than the whole
                 badge disappearing. The 10x10 size is now conditional (fix, MEDIUM, RemEx-rjnbo.1):
                 a fixed 10x10 badge clips the digits BadgeContent draws once a device count shows,
                 so Classes.dot below applies the fixed size only in the dot state via the
                 material|Badged.dot style in Window.Styles - the count state is left unsized, same
                 shape as the nav count badges (ShellView.axaml:806/848/865). The drawer-footer twin
                 in ShellView.axaml:928 has no count to show and keeps its own literal 10x10. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  PointerPressed="OnHeaderPressed"
                  Background="Transparent"
                  AutomationProperties.Name="{local:Localize A11y_TrayFlyout_Header}">

                <material:Badged Grid.Column="0" Classes="presence"
                                  Classes.connected="{Binding Presence.IsPhoneAttached}"
                                  Classes.dot="{Binding !HasOnlineDevices}"
                                  BadgeContent="{Binding OnlineDeviceCount}"
                                  BadgeDisplayContent="{Binding HasOnlineDevices}"
                                  Margin="0,0,12,0" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Presence.PresenceAccessibleName}">
                    <mi:MaterialIcon Kind="Cellphone" Width="18" Height="18"
                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                </material:Badged>

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Presence.PresenceText}"
                               Theme="{StaticResource Subtitle2TextBlock}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Connection.StatusText}"
                               Theme="{StaticResource OverlineTextBlock}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <Button Grid.Column="2" Classes="tertiary icon-button compact" Click="OnOpenMainApp"
                        AutomationProperties.Name="{local:Localize Palette_Settings}">
                    <mi:MaterialIcon Kind="Cog" Width="14" Height="14"/>
                </Button>

                <!-- ONE-WAY ON PURPOSE. A two-way IsChecked binding writes IsPinned before the Click
                     handler runs, so OnTogglePin would read the already-flipped value and flip it
                     straight back - the pin button would appear dead. The handler is the only writer;
                     this binding just reflects the result. -->
                <ToggleButton Grid.Column="3" Classes="tertiary icon-button compact"
                              IsChecked="{Binding IsPinned, Mode=OneWay}"
                              Click="OnTogglePin"
                              ToolTip.Tip="{Binding PinTooltip}"
                              AutomationProperties.Name="{local:Localize A11y_TrayFlyout_Pin}">
                    <mi:MaterialIcon Kind="Pin" Width="14" Height="14"/>
                </ToggleButton>

                <Button Grid.Column="4" Classes="tertiary icon-button compact" Click="OnCloseFlyout"
                        AutomationProperties.Name="{local:Localize A11y_Close}">
                    <mi:MaterialIcon Kind="Close" Width="14" Height="14"/>
                </Button>
            </Grid>

            <!-- Sensor cards, directly under the status line rather than along the bottom edge
                 (RemEx-or8f8, same placement rule the old strip used). RemEx-4kv0g.18.2 replaces
                 the name/value/44x16-sparkline strip with the canvas's own SensorCardContent
                 (RemEx-4kv0g.18.1) in a scrolling WrapPanel: canvas-size (200x150) cards, the same
                 family palette (spec B), as many columns as the popup's width holds. It collapses
                 entirely when nothing is pinned, for the same reason the strip did - a command
                 center with no telemetry should just be shorter, not show a paragraph explaining
                 its own emptiness. The double bang is Avalonia's coercion-to-bool; the negated
                 single-bang form was already used in this file, so the positive case is written as
                 its double rather than relying on an implicit int-to-bool that may not exist.

                 MaxHeight IS A HARD REQUIREMENT IN TRANSIENT MODE ONLY, NOT A NICETY
                 (docs/REGRESSION-GUARDS.md). In transient mode the window's own
                 SizeToContent="Height" has no natural bound on this row, so without an explicit cap
                 a long pin list grows the popup past the screen and nothing throws.
                 TrayFlyoutGeometry.CardsMaxHeight is that constant, set below as the XAML default -
                 see its derivation comment. In pinned mode this row's RowDefinition switches to
                 star-sized AND CardsScrollViewer.MaxHeight is overridden to
                 double.PositiveInfinity (ApplyMode, TrayFlyoutWindow.axaml.cs, fix round 2) so the
                 cards row takes every bit of height the resize leaves free above the fixed-height
                 tiles row - CardsMaxHeight does not apply while pinned at all. -->
            <ScrollViewer x:Name="CardsScrollViewer" Grid.Row="1"
                          Margin="0,12,0,0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          MaxHeight="{x:Static svc:TrayFlyoutGeometry.CardsMaxHeight}"
                          IsVisible="{Binding !!FlyoutSensors.Count}">
                <ItemsControl ItemsSource="{Binding FlyoutSensors}" Margin="6,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SensorViewModel">
                            <!-- Padding reproduces DraggableCard's content inset (Themes/Shared/DraggableCard.axaml:57
                                 - same converter, same expression shape) so the flyout card's title/sparkline/plates
                                 sit inset from the rounded corners the way the canvas card's ContentPresenter Margin
                                 does, instead of edge-to-edge (fix round 3, whole-branch review). DraggableCard binds
                                 against its TemplatedParent because CornerRadius lives on the templated control; this
                                 Border isn't templated, so $self reaches the same property directly. -->
                            <Border Classes="flyout-card" Width="200" Height="150" Margin="6"
                                    Padding="{Binding $self.CornerRadius, Converter={x:Static conv:CornerRadiusToMarginConverter.Instance}}"
                                    Classes.family-primary="{Binding IsPrimaryFamily}"
                                    Classes.family-secondary="{Binding IsSecondaryFamily}"
                                    Classes.family-tertiary="{Binding IsTertiaryFamily}"
                                    Classes.family-neutral="{Binding IsNeutralFamily}"
                                    Classes.family-custom="{Binding IsCustomTheme}">
                                <ctrl:SensorCardContent Sensor="{Binding}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Toolbar row (Flyout D2 .1, RemEx-4kv0g.18.5). ONE ItemsControl over
                 TrayFlyoutViewModel.ToolbarItems - a closed TrayToolbarItem hierarchy (TrayTile /
                 TrayToolbarDivider / TrayShortcut) rendered through three DataTemplates keyed by
                 x:DataType below, so there are no `if`s in this XAML and no second list to keep in
                 sync with the first. WrapPanel, not UniformGrid: the six tiles are icon-only
                 buttons now, not the old 66px content tiles TrayTileColumnsConverter's column math
                 was sized for - that converter and its column grid are gone (RemEx-4kv0g.18.5,
                 TrayFlyoutGeometry.ToolbarRowHeight). A wrapping row only spills to a second line
                 once app shortcuts push the row past the window's width.

                 Classes="tertiary icon-button" ON PURPOSE, NOT A NEW PER-VIEW STYLE
                 (docs/BUTTON-VOCABULARY.md, ButtonVocabularyTests): the header buttons three rows
                 up (Cog/Pin/Close) already wear this exact combination, just with ".compact" for
                 their smaller 28px size - this row omits ".compact" for the 32px default instead,
                 no bespoke class or inline Width/Height/CornerRadius/Padding needed. Width/Height
                 are NOT set inline for the same reason: the class already owns them.

                 MaxHeight IS A HARD REQUIREMENT, NOT A NICETY (Flyout D2 .2, RemEx-4kv0g.18.6,
                 docs/REGRESSION-GUARDS.md) - the same rule CardsScrollViewer's own MaxHeight above
                 follows, for the same reason: a WrapPanel has no bound of its own, so enough app
                 shortcuts would otherwise grow this row (and the transient popup around it) past
                 the screen with nothing to stop it. TrayFlyoutGeometry.ToolbarMaxHeight caps it at
                 two rows; a third row's worth of shortcuts is clipped, not scrollable - there is no
                 scroll affordance on this row the way the cards row above has one. -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding ToolbarItems}" Margin="0,16,0,0"
                          MaxHeight="{x:Static svc:TrayFlyoutGeometry.ToolbarMaxHeight}"
                          ClipToBounds="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="vm:TrayTile">
                        <!-- The tooltip hangs on the PANEL, not on the Button. DisabledTooltip is
                             non-null only when IsEnabled is false, and Avalonia excludes disabled
                             controls from hit testing with no ShowOnDisabled equivalent - so on the
                             Button the one string that explains why a tile is dead could never
                             open. The panel stays enabled, so the pointer still reaches it. When
                             DisabledTooltip is null (the enabled case), the Panel's own ToolTip.Tip
                             resolves to nothing and the Button's ToolTip.Tip="{Binding Label}"
                             below is what actually shows on hover. -->
                        <Panel ToolTip.Tip="{Binding DisabledTooltip}">
                            <!-- Ordinary tile -->
                            <Button Margin="4" Classes="tertiary icon-button"
                                    IsVisible="{Binding !HasSubmenu}"
                                    Command="{Binding Command}"
                                    IsEnabled="{Binding IsEnabled}"
                                    ToolTip.Tip="{Binding Label}"
                                    AutomationProperties.Name="{Binding Label}"
                                    Click="OnTileClicked">
                                <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20"
                                                  Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </Button>

                            <!-- Submenu tile (Power). A second Button rather than a conditional
                                 Flyout, because Button.Flyout cannot be set per-item from one
                                 DataTemplate. Placement="Top" matters: the window usually sits at
                                 the bottom-right of the screen, where a downward flyout would open
                                 off-screen. -->
                            <Button Margin="4" Classes="tertiary icon-button"
                                    IsVisible="{Binding HasSubmenu}"
                                    ToolTip.Tip="{Binding Label}"
                                    AutomationProperties.Name="{Binding Label}">
                                <mi:MaterialIcon Kind="{Binding Icon}" Width="20" Height="20"
                                                  Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                <Button.Flyout>
                                    <MenuFlyout Placement="Top">
                                        <MenuItem Header="{local:Localize Confirm_Restart_Btn}"
                                                  Command="{Binding $parent[Window].((vm:TrayFlyoutViewModel)DataContext).InvokePowerCommand}"
                                                  CommandParameter="{x:Static vm:TrayPowerAction.Restart}"/>
                                        <MenuItem Header="{local:Localize Confirm_Shutdown_Btn}"
                                                  Command="{Binding $parent[Window].((vm:TrayFlyoutViewModel)DataContext).InvokePowerCommand}"
                                                  CommandParameter="{x:Static vm:TrayPowerAction.Shutdown}"/>
                                        <MenuItem Header="{local:Localize Confirm_SignOut_Btn}"
                                                  Command="{Binding $parent[Window].((vm:TrayFlyoutViewModel)DataContext).InvokePowerCommand}"
                                                  CommandParameter="{x:Static vm:TrayPowerAction.SignOut}"/>
                                        <MenuItem Header="{local:Localize Tray_Power_Hibernate}"
                                                  Command="{Binding $parent[Window].((vm:TrayFlyoutViewModel)DataContext).InvokePowerCommand}"
                                                  CommandParameter="{x:Static vm:TrayPowerAction.Hibernate}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Panel>
                    </DataTemplate>

                    <DataTemplate x:DataType="vm:TrayToolbarDivider">
                        <Border Width="1" Height="24" Margin="8,0" VerticalAlignment="Center"
                                Background="{DynamicResource TextMutedBrush}"/>
                    </DataTemplate>

                    <DataTemplate x:DataType="vm:TrayShortcut">
                        <Button Margin="4" Classes="tertiary icon-button"
                                Command="{Binding LaunchCommand}"
                                ToolTip.Tip="{Binding DisplayName}"
                                AutomationProperties.Name="{Binding DisplayName}"
                                Click="OnTileClicked">
                            <Image Width="20" Height="20"
                                   Source="{Binding IconBase64, Converter={x:Static conv:Base64ToImageConverter.Instance}}"
                                   RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>

        </Grid>
    </Border>

    <!-- Resize border, by hand. WindowDecorations="None" means Windows draws no frame, so
         CanResize="True" alone gives nothing to grab (RemEx-2j58q). These eight hit areas sit in
         the 12px band between the window edge and the card, which otherwise holds only the drop
         shadow. The Grid itself has no Background and the centre cell is empty, so everything over
         the card hit-tests straight through to the tiles. Only present when pinned - a transient
         popup is not resizable and should not show resize cursors. -->
    <Grid IsVisible="{Binding IsPinned}"
          RowDefinitions="12,*,12" ColumnDefinitions="12,*,12">
        <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Cursor="TopLeftCorner"
                Tag="NorthWest" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Cursor="TopSide"
                Tag="North" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Cursor="TopRightCorner"
                Tag="NorthEast" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Cursor="LeftSide"
                Tag="West" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="RightSide"
                Tag="East" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Cursor="BottomLeftCorner"
                Tag="SouthWest" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Cursor="BottomSide"
                Tag="South" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="BottomRightCorner"
                Tag="SouthEast" PointerPressed="OnResizePressed"/>
    </Grid>

    </Panel>
</Window>
