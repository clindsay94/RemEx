<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    xmlns:ctrl="using:Remex.Desktop.Controls"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    x:Class="Remex.Desktop.Views.TrayFlyoutWindow"
    x:DataType="vm:TrayFlyoutViewModel"
    Title="{local:Localize TrayFlyout_Title}"
    Width="420" Height="400"
    MinWidth="320" MinHeight="240"
    MaxWidth="900" MaxHeight="800">

    <!-- SizeToContent, CanResize, Focusable and ShowInTaskbar are deliberately absent: the
         code-behind's ApplyMode and constructor own them, and a value here would fight it.
         The Min/Max above duplicate TrayFlyoutGeometryValidator's constants because Avalonia
         needs literals in XAML - change one, change the other. -->

    <Window.Resources>
        <!-- Shared by both tile buttons below so the plain tile and the submenu tile cannot
             drift apart visually. -->
        <DataTemplate x:Key="TrayTileFace" x:DataType="vm:TrayTile">
            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                <mi:MaterialIcon Kind="{Binding Icon}"
                                 Foreground="{DynamicResource AccentPrimaryBrush}"
                                 Width="18" Height="18"
                                 HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Label}"
                           FontSize="10" FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Window.Styles>



        <Style Selector="Button.tray-chip, ToggleButton.tray-chip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.tray-chip:pointerover, ToggleButton.tray-chip:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>

        <!-- The chip glyphs are drawn icons, not font characters. The obvious alternative is a
             Segoe MDL2 Assets codepoint, but that font ships with Windows only and nothing here
             sets the family, so the glyph would be a fallback box on Linux and probably on Windows
             too. The icon's Foreground follows the button's own so the pointerover style still
             lands. MaterialIcon has no Fill at all — a Fill setter here would compile and do
             nothing (RemEx-wyx2c). -->
        <Style Selector="Button.tray-chip mi|MaterialIcon, ToggleButton.tray-chip mi|MaterialIcon">
            <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
        </Style>

        <!-- BACKGROUND IS SET HERE, NOT JUST FOREGROUND, AND IT IS THE WHOLE FIX (RemEx-xpfls).
             The pin glyph vanished the moment the flyout was pinned, leaving a plain filled square,
             so there was no way to tell which mode the window was in — and the two modes differ in
             whether the window can be resized and whether its geometry persists. Connor reported the
             resize behaviour backwards because of it.

             It is a priority collision, not a missing colour. Avalonia's frame order (lower wins) puts
             an app style WITH an activator at StyleTrigger, a ControlTheme style with an activator at
             StyleTriggerTheme, and a plain app style at Style. So on :checked, under Fluent (the
             theme applied when this was diagnosed) —
               Foreground: ours (StyleTrigger) beat Fluent's ToggleButtonForegroundChecked. Accent.
               Background: Fluent's ToggleButtonBackgroundChecked (StyleTriggerTheme) beat the plain
                           Background="Transparent" in the base .tray-chip style above (Style).
             Fluent's checked background was itself accent-derived, so the result was an accent glyph
             on an accent fill. The glyph's own colour was never the problem: it comes from the
             selector above, ToggleButton derives from Button, and $parent[Button] resolves
             correctly.

             Pinning the background at the same activator priority as the theme's own ControlTheme
             style is what stops the theme (Fluent then, Material 3.19.0 now) supplying it.
             CardBackgroundHoverBrush reads as "this chip is active" and exists in all four PC themes,
             so the accent glyph keeps its contrast on SolarFlare too. -->
        <Style Selector="ToggleButton.tray-chip:checked">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>

        <!-- Hover while already pinned must not fall back to the theme's own accent fill either. -->
        <Style Selector="ToggleButton.tray-chip:checked:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <Panel>

    <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="{DynamicResource CornerRadiusExtraLarge}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="12" BoxShadow="0 8 28 0 #60000000">
        <Grid RowDefinitions="Auto,Auto,*" Margin="16">

            <!-- Status strip. Doubles as the drag handle in pinned mode: this window has no system
                 title bar, so without PointerPressed here a pinned window could not be moved. -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                  PointerPressed="OnHeaderPressed"
                  Background="Transparent"
                  AutomationProperties.Name="{local:Localize A11y_TrayFlyout_Header}">

                <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         Classes="status-dot"
                         Classes.connected="{Binding Presence.IsPhoneAttached}"
                         AutomationProperties.Name="{Binding Presence.PresenceAccessibleName}"/>

                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Presence.PresenceText}"
                               FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Connection.StatusText}"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <Button Grid.Column="2" Classes="tray-chip" Click="OnOpenMainApp"
                        AutomationProperties.Name="{local:Localize Palette_Settings}">
                    <mi:MaterialIcon Kind="Cog" Width="14" Height="14"/>
                </Button>

                <!-- ONE-WAY ON PURPOSE. A two-way IsChecked binding writes IsPinned before the Click
                     handler runs, so OnTogglePin would read the already-flipped value and flip it
                     straight back - the pin button would appear dead. The handler is the only writer;
                     this binding just reflects the result. -->
                <ToggleButton Grid.Column="3" Classes="tray-chip"
                              IsChecked="{Binding IsPinned, Mode=OneWay}"
                              Click="OnTogglePin"
                              AutomationProperties.Name="{local:Localize A11y_TrayFlyout_Pin}">
                    <mi:MaterialIcon Kind="Pin" Width="14" Height="14"/>
                </ToggleButton>

                <Button Grid.Column="4" Classes="tray-chip" Click="OnCloseFlyout"
                        Content="&#x2715;"
                        AutomationProperties.Name="{local:Localize A11y_Close}"/>
            </Grid>

            <!-- Sensor strip, directly under the status line rather than along the bottom edge
                 (RemEx-or8f8). At the bottom its horizontal scrollbar sat on top of a 16px-tall
                 strip and covered the values it was there to scroll. Scrollbar is Hidden rather
                 than Auto for the same reason - the wheel still scrolls it, nothing steals height.
                 It collapses entirely when nothing is pinned: a command center with no telemetry
                 should just be shorter, not show a paragraph explaining its own emptiness. The
                 double bang is Avalonia's coercion-to-bool; the negated single-bang form was
                 already used in this file, so the positive case is written as its double rather
                 than relying on an implicit int-to-bool that may not exist. -->
            <ScrollViewer Grid.Row="1"
                          Margin="0,12,0,0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          IsVisible="{Binding !!PinnedSensors.Count}">
                <ItemsControl ItemsSource="{Binding PinnedSensors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SensorViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="9" FontWeight="Black" LetterSpacing="1"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource JetBrainsMono}"
                                           Foreground="{DynamicResource TextPrimaryBrush}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static conv:SensorValueConverter.Instance}">
                                            <Binding Path="Value"/>
                                            <Binding Path="Unit"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ctrl:SparklineControl History="{Binding History}"
                                                       GraphType="{Binding ResolvedGraphType}"
                                                       AccentColor="{Binding Theme.AccentColor,
                                                                     Converter={x:Static conv:HexToColorConverter.Instance}}"
                                                       Width="44" Height="16"
                                                       Opacity="0.7" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Action grid. Columns are driven by the window's own width so that resizing reveals
                 more of the grid per row instead of only stretching the tiles. -->
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Tiles}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding $parent[Window].Bounds.Width,
                                               Converter={x:Static conv:TrayTileColumnsConverter.Instance}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrayTile">
                        <!-- The tooltip hangs on the PANEL, not on the Button. DisabledTooltip is
                             non-null only when IsEnabled is false, and Avalonia excludes disabled
                             controls from hit testing with no ShowOnDisabled equivalent - so on the
                             Button the one string that explains why a tile is dead could never
                             open. The panel stays enabled, so the pointer still reaches it. -->
                        <Panel ToolTip.Tip="{Binding DisabledTooltip}">
                            <!-- Ordinary tile -->
                            <Button Height="66" Margin="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="tile"
                                    IsVisible="{Binding !HasSubmenu}"
                                    Command="{Binding Command}"
                                    IsEnabled="{Binding IsEnabled}"
                                    AutomationProperties.Name="{Binding Label}"
                                    ContentTemplate="{StaticResource TrayTileFace}"
                                    Content="{Binding}"
                                    Click="OnTileClicked"/>

                            <!-- Submenu tile. A second Button rather than a conditional Flyout,
                                 because Button.Flyout cannot be set per-item from one DataTemplate.
                                 Placement="Top" matters: the window usually sits at the bottom-right
                                 of the screen, where a downward flyout would open off-screen. -->
                            <Button Height="66" Margin="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="tile"
                                    IsVisible="{Binding HasSubmenu}"
                                    AutomationProperties.Name="{Binding Label}"
                                    ContentTemplate="{StaticResource TrayTileFace}"
                                    Content="{Binding}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Top">
                                        <MenuItem Header="{local:Localize Confirm_Restart_Btn}"
                                                  Command="{Binding $parent[Window].((vm:TrayFlyoutViewModel)DataContext).InvokePowerCommand}"
                                                  CommandParameter="{x:Static vm:TrayPowerAction.Restart}"/>
                                        <MenuItem Header="{local:Localize Confirm_Shutdown_Btn}"
                                                  Command="{Binding $parent[Window].((vm:TrayFlyoutViewModel)DataContext).InvokePowerCommand}"
                                                  CommandParameter="{x:Static vm:TrayPowerAction.Shutdown}"/>
                                        <MenuItem Header="{local:Localize Confirm_SignOut_Btn}"
                                                  Command="{Binding $parent[Window].((vm:TrayFlyoutViewModel)DataContext).InvokePowerCommand}"
                                                  CommandParameter="{x:Static vm:TrayPowerAction.SignOut}"/>
                                        <MenuItem Header="{local:Localize Tray_Power_Hibernate}"
                                                  Command="{Binding $parent[Window].((vm:TrayFlyoutViewModel)DataContext).InvokePowerCommand}"
                                                  CommandParameter="{x:Static vm:TrayPowerAction.Hibernate}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>
    </Border>

    <!-- Resize border, by hand. WindowDecorations="None" means Windows draws no frame, so
         CanResize="True" alone gives nothing to grab (RemEx-2j58q). These eight hit areas sit in
         the 12px band between the window edge and the card, which otherwise holds only the drop
         shadow. The Grid itself has no Background and the centre cell is empty, so everything over
         the card hit-tests straight through to the tiles. Only present when pinned - a transient
         popup is not resizable and should not show resize cursors. -->
    <Grid IsVisible="{Binding IsPinned}"
          RowDefinitions="12,*,12" ColumnDefinitions="12,*,12">
        <Border Grid.Row="0" Grid.Column="0" Background="Transparent" Cursor="TopLeftCorner"
                Tag="NorthWest" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="0" Grid.Column="1" Background="Transparent" Cursor="TopSide"
                Tag="North" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="0" Grid.Column="2" Background="Transparent" Cursor="TopRightCorner"
                Tag="NorthEast" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="1" Grid.Column="0" Background="Transparent" Cursor="LeftSide"
                Tag="West" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="1" Grid.Column="2" Background="Transparent" Cursor="RightSide"
                Tag="East" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="2" Grid.Column="0" Background="Transparent" Cursor="BottomLeftCorner"
                Tag="SouthWest" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="2" Grid.Column="1" Background="Transparent" Cursor="BottomSide"
                Tag="South" PointerPressed="OnResizePressed"/>
        <Border Grid.Row="2" Grid.Column="2" Background="Transparent" Cursor="BottomRightCorner"
                Tag="SouthEast" PointerPressed="OnResizePressed"/>
    </Grid>

    </Panel>
</Window>
