<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    xmlns:svc="using:Remex.Desktop.Services"
    xmlns:ctrl="using:Remex.Desktop.Controls"
    xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles" x:Class="Remex.Desktop.Views.CanvasView" x:DataType="vm:CanvasDashboardViewModel">

    <UserControl.Styles>
        <!-- Snapshot status line: success by default, error colour when the last attempt failed (RemEx-40x8). -->
        <Style Selector="TextBlock.snapshot-status">
            <Setter Property="Foreground" Value="{DynamicResource SystemSuccessBrush}"/>
        </Style>
        <Style Selector="TextBlock.snapshot-status.failed">
            <Setter Property="Foreground" Value="{DynamicResource SystemErrorBrush}"/>
        </Style>
        <Style Selector="ctrl|DraggableCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource AccentPrimary}" BlurRadius="16" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ═══ Alert bell (RemEx-8wpvr.4) ═══ Kind/Foreground scoped to the header bell button by
             its "alert-bell" class; ".tripped" (bound to IsAlertTripped) swaps outline-and-unit-
             colour for ring-and-error. Foreground here (not on the Button) so the icon repaints even
             though MaterialIcon does not template-bind Foreground from an ancestor Setter. -->
        <Style Selector="Button.alert-bell mi|MaterialIcon" x:DataType="vm:CanvasCardViewModel">
            <Setter Property="Kind" Value="BellOutline"/>
        </Style>
        <!-- Spec B (RemEx-4kv0g.3.2): the bell's resting colour now follows the card's family via the
             "card-icon" class on the glyph below; the family AND family-custom rules for it both live
             in SensorCardFamilies.axaml (".family-{F} mi|MaterialIcon.card-icon" /
             ".family-custom Button.alert-bell mi|MaterialIcon"), not here — every per-theme colour
             binding in this view moved there. -->
        <Style Selector="Button.alert-bell.tripped mi|MaterialIcon" x:DataType="vm:CanvasCardViewModel">
            <Setter Property="Kind" Value="BellRing"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemErrorBrush}"/>
        </Style>

        <!-- ═══ Sensor alert pulse (RemEx-8wpvr.4, replaces the old fixed-opacity flash) ═══
             Opus review (RemEx-8wpvr.4) found the previous version of this block inert: Style.
             Animations applies keyframes to the styled control (DraggableCard), not to the
             DropShadowEffect instance created by an Effect setter, and Avalonia has no property-path
             animation into a nested object (TranslateTransform.Y works only because Transform is
             special-cased) - so the glow never actually moved. The fix animates Border.Opacity on
             PART_AlertGlow, a real control-owned property declared in DraggableCard's ControlTemplate
             (Themes/Shared/DraggableCard.axaml), instead.
             Split into three selectors rather than one style carrying both a Setter and a
             Style.Animations for Opacity: Style.Animations runs for as long as its selector matches
             and writes straight to the property every frame, so if ".reduced-motion" also matched
             this same style and merely tried to override the Opacity Setter, the animation would keep
             winning the tug-of-war and repaint the "steady" glow every frame anyway. ":not()" instead
             makes the two states mutually exclusive selectors, so only one of them is ever active.
             The border stays a plain Setter on the base ".alert-active" style since it does not
             animate either way. -->
        <Style Selector="ctrl|DraggableCard.alert-active">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ctrl|DraggableCard.alert-active /template/ Border#PART_AlertGlow">
            <Setter Property="Opacity" Value="0.6"/>
        </Style>
        <Style Selector="ctrl|DraggableCard.alert-active:not(.reduced-motion) /template/ Border#PART_AlertGlow">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.35"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.85"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="ctrl|DraggableCard.alert-active.reduced-motion /template/ Border#PART_AlertGlow">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <!-- ═══ DraggableCard chrome + elevation ramp ═══ -->
        <!-- Moved to a ControlTheme at Themes/Shared/DraggableCard.axaml, merged from App.axaml (RemEx-9iz00.3). -->

        <!-- ═══ Toolbar buttons ═══ -->

        <!-- ═══ Staging drawer buttons ═══ -->

        <!-- ═══ Action buttons inside cards ═══ -->

        <!-- Staging drawer ListBoxes: both the active-sensors and new-sensors lists reset item chrome
             the same way, so the shared class replaces two identical local blocks (RemEx-evw7y). -->
        <Style Selector="ListBox.staging ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ═══ Latency bar ═══ -->
        <Style Selector="Border.lat-bar">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="1 0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="MinHeight" Value="2"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent" RowDefinitions="Auto,*">

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource GlassBaseDarkBrush}" Padding="12 8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <!-- Background="Transparent" stays: this "button" is a non-interactive title label
                     (IsHitTestVisible="False"), not a real secondary surface — a documented exception,
                     not drift (RemEx-cgrv3). -->
                <Button AutomationProperties.Name="{local:Localize Canvas_Header}" Classes="secondary" IsHitTestVisible="False" Background="Transparent">
                    <TextBlock Text="{local:Localize Canvas_Header}" Theme="{StaticResource Headline5TextBlock}" FontFamily="{DynamicResource PageTitleFontFamily}" FontWeight="Black" LetterSpacing="2" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{local:Localize Canvas_Header}" Theme="{StaticResource CaptionTextBlock}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding LayoutStatus}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource SystemSuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button AutomationProperties.Name="{local:Localize Canvas_UndoTooltip}" Grid.Column="3" Classes="secondary" Command="{Binding UndoCommand}" ToolTip.Tip="{local:Localize Canvas_UndoTooltip}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Undo" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <!-- Label was gated on the shell SplitView's IsPaneOpen. That ancestor stopped
                             existing when the shell moved to an overlay drawer (RemEx-q3mle), and the
                             binding would have failed silently to FallbackValue=False — leaving a bare
                             arrow with no word next to it, permanently. The gate is not re-pointed
                             because an overlay drawer has no compact state for it to mean anything:
                             it floats above this toolbar instead of narrowing it. -->
                        <TextBlock Text="{local:Localize Canvas_Undo}" Theme="{StaticResource CaptionTextBlock}"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_RedoTooltip}" Grid.Column="4" Classes="secondary" Command="{Binding RedoCommand}" ToolTip.Tip="{local:Localize Canvas_RedoTooltip}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <mi:MaterialIcon Kind="Redo" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Redo}" Theme="{StaticResource CaptionTextBlock}"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_Save}" Grid.Column="5" Classes="secondary" Command="{Binding SaveLayoutCommand}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="ContentSave" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Save}" Theme="{StaticResource CaptionTextBlock}"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_Sync}" Grid.Column="6" Classes="secondary" Command="{Binding SyncLayoutCommand}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Sync" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Sync}" Theme="{StaticResource CaptionTextBlock}"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize A11y_SensorLibrary}" x:Name="SensorsButton" Grid.Column="7" Classes="secondary" Command="{Binding ToggleStagingDrawerCommand}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Download" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Theme="{StaticResource CaptionTextBlock}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{x:Static local:LocalizedFormatConverter.Instance}">
                                    <Binding Path="[Canvas_Sensors]" Source="{x:Static svc:LocalizationService.Instance}"/>
                                    <Binding Path="StagedCards.Count"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_ResetView}" Grid.Column="8" Classes="secondary" Command="{Binding ResetViewCommand}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Restore" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_ResetView}" Theme="{StaticResource CaptionTextBlock}"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_ToggleMinimapTooltip}" Grid.Column="9" Classes="secondary" Command="{Binding ToggleMinimapCommand}" ToolTip.Tip="{local:Localize Canvas_ToggleMinimapTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Map" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Map}" Theme="{StaticResource CaptionTextBlock}"/>
                    </StackPanel>
                </Button>
                <!-- P8-I: Snapshot export -->
                <Button AutomationProperties.Name="{local:Localize Canvas_ExportPngTooltip}" Grid.Column="10" Classes="secondary" Click="OnExportSnapshot" ToolTip.Tip="{local:Localize Canvas_ExportPngTooltip}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Export" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Export}" Theme="{StaticResource CaptionTextBlock}"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="11" Orientation="Vertical" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{local:Localize Canvas_CopySnapshotTooltip}" Classes="secondary" Click="OnCopySnapshot" ToolTip.Tip="{local:Localize Canvas_CopySnapshotTooltip}" Padding="8,4">
                        <TextBlock Text="{local:Localize Canvas_Copy}" Theme="{StaticResource CaptionTextBlock}"/>
                    </Button>
                    <TextBlock Text="{Binding SnapshotStatus}" Theme="{StaticResource OverlineTextBlock}" Classes="snapshot-status" Classes.failed="{Binding !SnapshotSucceeded}" HorizontalAlignment="Center" IsVisible="{Binding HasSnapshotStatus}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Main content ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <!-- ═══ CANVAS ═══ -->
            <Grid Grid.Column="0">
                <ctrl:ZoomableCanvas x:Name="MainCanvas" Background="Transparent">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="4000" Height="4000" Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="vm:CanvasCardViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding PositionX}"/>
                                <Setter Property="Canvas.Top" Value="{Binding PositionY}"/>
                                <Setter Property="ZIndex" Value="{Binding ZIndex}"/>
                            </Style>
                        </ItemsControl.Styles>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CanvasCardViewModel">
                                <ctrl:DraggableCard Width="{Binding Width}" Height="{Binding Height}"
                                    Classes.family-primary="{Binding Sensor.IsPrimaryFamily}"
                                    Classes.family-secondary="{Binding Sensor.IsSecondaryFamily}"
                                    Classes.family-tertiary="{Binding Sensor.IsTertiaryFamily}"
                                    Classes.family-neutral="{Binding Sensor.IsNeutralFamily}"
                                    Classes.family-custom="{Binding Sensor.IsCustomTheme}">
                                    <ctrl:DraggableCard.ContextMenu>
                                        <ContextMenu IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsSensor}}">
                                            <MenuItem Header="{local:Localize Canvas_GraphType}">
                                                <MenuItem.Icon>
                                                    <mi:MaterialIcon Kind="ChartBoxOutline" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                                <MenuItem Header="{local:Localize Canvas_GraphSmart}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Auto">
                                                    <MenuItem.Icon>
                                                        <mi:MaterialIcon Kind="AutoAwesome" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{local:Localize Canvas_GraphBar}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Bar">
                                                    <MenuItem.Icon>
                                                        <mi:MaterialIcon Kind="ChartBar" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{local:Localize Canvas_GraphLine}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Line">
                                                    <MenuItem.Icon>
                                                        <mi:MaterialIcon Kind="ChartLine" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{local:Localize Canvas_GraphGauge}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Gauge">
                                                    <MenuItem.Icon>
                                                        <mi:MaterialIcon Kind="Gauge" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{local:Localize Canvas_GraphRing}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Ring">
                                                    <MenuItem.Icon>
                                                        <mi:MaterialIcon Kind="ChartDonut" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{local:Localize Canvas_GraphLed}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="LedMeter">
                                                    <MenuItem.Icon>
                                                        <mi:MaterialIcon Kind="DotsGrid" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{local:Localize Canvas_GraphGlow}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="GlowArea">
                                                    <MenuItem.Icon>
                                                        <mi:MaterialIcon Kind="ShimmerOutline" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="{local:Localize Canvas_GraphDual}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="DualMetric">
                                                    <MenuItem.Icon>
                                                        <mi:MaterialIcon Kind="ChartMultiline" Width="16" Height="16"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuItem>
                                            <MenuItem Header="{local:Localize Canvas_SecondMetric}" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).ChooseSecondMetricCommand}" CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <mi:MaterialIcon Kind="ChartTimelineVariant" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{local:Localize Canvas_ColorPreset}">
                                                <MenuItem.Icon>
                                                    <mi:MaterialIcon Kind="PaletteOutline" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                                <MenuItem Header="{local:Localize Canvas_Preset_FollowTheme}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Default"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_MagentaCyan}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Magenta &amp; Cyan"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_SmokeGold}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Smoke &amp; Gold"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_EmeraldNight}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Emerald Night"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_Sunset}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Sunset"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_Arctic}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Arctic"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_NeonPurple}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Neon Purple"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_Monochrome}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Monochrome"/>
                                            </MenuItem>
                                            <MenuItem Header="{local:Localize Canvas_Rename}" Command="{Binding Sensor.BeginRenameCommand}">
                                                <MenuItem.Icon>
                                                    <mi:MaterialIcon Kind="RenameBox" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="{local:Localize Canvas_ShowValueOverlay}" ToggleType="CheckBox" IsChecked="{Binding Sensor.ShowValueOverlay, Mode=TwoWay}">
                                                <MenuItem.Icon>
                                                    <mi:MaterialIcon Kind="Numeric" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{local:Localize Canvas_TogglePinToHome}" Command="{Binding TogglePinToHomeCommand}">
                                                <MenuItem.Icon>
                                                    <mi:MaterialIcon Kind="Pin" Width="16" Height="16" IsVisible="{Binding IsPinnedToHome}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{local:Localize Canvas_SetAlert}" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).SetAlertCommand}" CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <mi:MaterialIcon Kind="BellAlertOutline" Width="16" Height="16"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                        </ContextMenu>
                                    </ctrl:DraggableCard.ContextMenu>

                                    <Grid>
                                        <!-- ═══ CONNECTION ═══ -->
                                        <StackPanel IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsConnection}}">
                                            <TextBlock Text="{local:Localize Canvas_Connection}" Theme="{StaticResource CaptionTextBlock}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <!-- Phone presence, not the loopback link (RemEx-7zzw). -->
                                                <Ellipse Width="10" Height="10" AutomationProperties.Name="{Binding Presence.PresenceAccessibleName}" Classes="status-dot" Classes.connected="{Binding Presence.IsPhoneAttached}">
                                                </Ellipse>
                                                <TextBlock Text="{Binding Presence.PresenceText}" Theme="{StaticResource Body1TextBlock}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <!-- Demoted, not dropped (review). I first replaced this line, reasoning that
                                                 HostRuntimeText carried the host detail — it does not: that lives on
                                                 SettingsViewModel and this card is a CanvasCardViewModel. Canvas would
                                                 have had no host-link indication at all. -->
                                            <TextBlock Text="{Binding Connection.StatusText}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBox Text="{Binding Connection.HostAddress}" Margin="0,12,0,0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontFamily="Consolas, monospace" PlaceholderText="wss://host:port/ws" Classes="outline" UseFloatingPlaceholder="True" assists:TextFieldAssist.Label="{conv:Localize Conn_HostAddress}" AutomationProperties.Name="{conv:Localize Conn_HostAddress}" IsEnabled="{Binding !Connection.IsConnected}"/>
                                        </StackPanel>

                                        <!-- ═══ ACTIONS ═══ -->
                                        <StackPanel IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsActions}}" Spacing="8">
                                            <TextBlock Text="{local:Localize Canvas_Actions}" Theme="{StaticResource CaptionTextBlock}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Button Classes="primary" Content="{local:Localize Dashboard_Connect}" Command="{Binding Connection.ConnectCommand}" IsVisible="{Binding !Connection.IsConnecting}"/>
                                            <!-- Connecting is the one action here with no end the user can see, so it is the one that
                                                 needs a busy indicator rather than just a button that changed
                                                 its label (RemEx-rcgmc). Indeterminate because a connection
                                                 attempt has no percentage - a determinate bar here would be
                                                 inventing progress. -->
                                            <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding Connection.IsConnecting}">
                                                <ProgressBar Grid.Column="0" Classes="circular" IsIndeterminate="True"
                                                             Margin="0,0,10,0" VerticalAlignment="Center"
                                                             AutomationProperties.Name="{local:Localize Status_Connecting}"/>
                                                <Button Grid.Column="1" Classes="primary danger" Content="{local:Localize Canvas_CancelConnect}" Command="{Binding Connection.DisconnectCommand}"/>
                                            </Grid>
                                            <!-- Background stays (deliberately lighter than a resting .secondary
                                                 card against the canvas backdrop); Foreground was a duplicate of
                                                 the class default and is removed (RemEx-cgrv3). -->
                                            <Button Classes="secondary" Content="{local:Localize Canvas_Ping}" Command="{Binding Connection.SendPingCommand}" Background="{DynamicResource CardBackgroundHoverBrush}"/>
                                            <Button Classes="secondary" Content="{local:Localize Canvas_LockPC}" Command="{Binding Connection.LockCommand}"/>
                                            <Button Classes="secondary" Content="{local:Localize Canvas_RebootUefi}" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).RestartToUefiCommand}"/>
                                            <Button Classes="primary danger" Content="{local:Localize Canvas_Disconnect}" Command="{Binding Connection.DisconnectCommand}" IsVisible="{Binding Connection.IsConnected}"/>
                                        </StackPanel>

                                        <!-- ═══ LATENCY ═══ -->
                                        <StackPanel IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsLatency}}">
                                            <TextBlock Text="{local:Localize Canvas_Latency}" Theme="{StaticResource CaptionTextBlock}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Connection.LatencyText}" Theme="{StaticResource Headline5TextBlock}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{local:Localize Canvas_Avg}" Theme="{StaticResource OverlineTextBlock}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Theme="{StaticResource CaptionTextBlock}" FontWeight="SemiBold" Text="{Binding Connection.AverageLatency, StringFormat={}{0:F1} ms}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{local:Localize Canvas_Max}" Theme="{StaticResource OverlineTextBlock}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Foreground="{DynamicResource SystemErrorBrush}" Theme="{StaticResource CaptionTextBlock}" FontWeight="SemiBold" Text="{Binding Connection.MaxLatency, StringFormat={}{0:F1} ms}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="6" Margin="0,10,0,0" Padding="6" Height="60">
                                                <ItemsControl ItemsSource="{Binding Connection.LatencyHistory}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="lat-bar" Width="10" Height="{Binding ., Converter={x:Static conv:LatencyToHeightConverter.Instance}}" Background="{DynamicResource AccentPrimaryBrush}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>

                                        <!-- ═══ SENSOR ═══ The card's visual moved to Controls/SensorCardContent.axaml verbatim
                                             (RemEx-4kv0g.18.1) so the canvas and the tray flyout (.18.2) host the same markup.
                                             DataContext stays this element's own (CanvasCardViewModel) — we bind Sensor rather
                                             than setting DataContext="{Binding Sensor}" directly, because once DataContext flips
                                             to the sensor the five properties below would no longer resolve against this card VM
                                             (see SensorCardContent's own header comment). -->
                                        <ctrl:SensorCardContent IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsSensor}}"
                                            Sensor="{Binding Sensor}"
                                            IsPinnedToHome="{Binding IsPinnedToHome}"
                                            HasAlert="{Binding HasAlert}"
                                            IsAlertTripped="{Binding IsAlertTripped}"
                                            AcknowledgeAlertCommand="{Binding AcknowledgeAlertCommand}"
                                            AlertTooltip="{Binding AlertTooltip}"/>

                                        <!-- Inline rename editor: normal-sized overlay spanning the card. Commits on Enter/blur.
                                             Stayed here rather than moving into SensorCardContent (RemEx-4kv0g.18.1): CommitRename
                                             below pattern-matches the sender's DataContext against CanvasCardViewModel, which is
                                             this element's DataContext, not the sensor's — SensorCardContent's content no longer
                                             has that VM in scope.
                                             Fix round 1 (Opus review, HIGH): this TextBox used to live inside the sensor Grid,
                                             gated by the same IsSensor check the Panel below now carries. On its own, its
                                             IsVisible bound only Sensor.IsEditingTitle — but Sensor is null on the
                                             Connection/Actions/Latency cards, a null intermediate makes that binding produce no
                                             value, and IsVisible falls back to its own default (true): an empty bold TextBox
                                             sat on top of all three of those card types, eating clicks meant for their buttons.
                                             The Panel's IsVisible is the SAME binding the SensorCardContent host above uses, so
                                             a false here collapses the TextBox regardless of what its own binding resolves to. -->
                                        <Panel IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsSensor}}">
                                            <TextBox Text="{Binding Sensor.CustomTitle, Mode=TwoWay}" IsVisible="{Binding Sensor.IsEditingTitle}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="8" FontSize="12" FontWeight="Bold" MaxLength="40" AutomationProperties.Name="{local:Localize Canvas_Rename}" Loaded="OnRenameBoxLoaded" KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus"/>
                                        </Panel>
                                    </Grid>
                                </ctrl:DraggableCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ctrl:ZoomableCanvas>

                <!-- Minimap overlay -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" IsVisible="{Binding IsMinimapVisible}" CornerRadius="8" ClipToBounds="True" BoxShadow="{DynamicResource Elevation2Shadow}">
                    <ctrl:CanvasMinimap x:Name="Minimap" Width="200" Height="160" Cards="{Binding Cards}" ViewportRect="{Binding MinimapViewportRect}"/>
                </Border>

                <!-- ═══ FLOATING ACTION BAR (multi-select: Pin / Remove / Done) ═══ -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                        IsVisible="{Binding HasSelection}"
                        Background="{DynamicResource GlassBaseMediumBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="10,6" BoxShadow="{DynamicResource Elevation2Shadow}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="6,0,4,0" Theme="{StaticResource CaptionTextBlock}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectionSummary}"/>
                        <Button Classes="secondary" Command="{Binding PinSelectedCommand}" Content="{local:Localize Canvas_ActionPin}" Background="{DynamicResource CardBackgroundHoverBrush}"/>
                        <Button Classes="secondary danger" Command="{Binding RemoveSelectedCommand}" Content="{local:Localize Canvas_ActionRemove}"/>
                        <Button Classes="primary" Command="{Binding ClearSelectionCommand}" Content="{local:Localize Canvas_ActionDone}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ REPLAY HINT (always available) ═══ -->
                <!-- CornerRadius=17 is exactly half of Width/Height=34 — this is a circular button, tied
                     to its own geometry, not a copy of CornerRadiusSmall (RemEx-cgrv3). -->
                <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Width="34" Height="34"
                        Classes="secondary" Command="{Binding ReplayCoachMarkCommand}" ToolTip.Tip="{local:Localize Canvas_CoachReplayTooltip}" AutomationProperties.Name="{local:Localize Canvas_CoachReplayTooltip}"
                        CornerRadius="17" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <mi:MaterialIcon Kind="HelpCircleOutline" Width="18" Height="18" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </Button>

                <!-- ═══ COACH MARK OVERLAY (first-visit hint) — card + arrow positioned in code-behind
                     (OnCoachLayout) to aim at the real Sensors button wherever it lands. ═══ -->
                <Grid x:Name="CoachOverlay" IsVisible="{Binding CoachMarkVisible}" Background="#40000000">
                    <Canvas x:Name="CoachCanvas">
                        <!-- Arrow (stroke) + arrowhead (fill); geometry set at runtime. -->
                        <Path x:Name="CoachArrow" Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round"/>
                        <Path x:Name="CoachArrowHead" Fill="{DynamicResource AccentPrimaryBrush}"/>
                        <Border x:Name="CoachCard" Width="320"
                                Background="{DynamicResource GlassBaseMediumBrush}"
                                BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5"
                                CornerRadius="12" Padding="18,16" BoxShadow="{DynamicResource Elevation3Shadow}"
                                SizeChanged="OnCoachCardSizeChanged">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{local:Localize Canvas_CoachTitle}" Theme="{StaticResource Body2TextBlock}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{local:Localize Canvas_CoachBody}" Theme="{StaticResource CaptionTextBlock}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button HorizontalAlignment="Right" Classes="primary" Command="{Binding DismissCoachMarkCommand}" Content="{local:Localize Canvas_CoachGotIt}"/>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>

            <!-- ═══ STAGING DRAWER ═══ -->
            <Border Grid.Column="1" Background="{DynamicResource GlassBaseMediumBrush}" Width="260" IsVisible="{Binding IsStagingDrawerOpen}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="{local:Localize Canvas_ActiveSensors}" Theme="{StaticResource OverlineTextBlock}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>

                        <material:Card Padding="8" IsVisible="{Binding SensorActivationItems.Count}">
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding SensorActivationItems}" Classes="staging" Background="Transparent" BorderThickness="0" Padding="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SensorActivationItem">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                                                <CheckBox AutomationProperties.Name="{Binding SensorName}" Grid.Column="0" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SensorName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Button AutomationProperties.Name="{local:Localize A11y_MoveUp}" Grid.Column="2" Classes="secondary compact" Margin="6,0,4,0" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).MoveSensorUpCommand}" CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="ArrowUp" Width="14" Height="14"/>
                                                </Button>
                                                <Button AutomationProperties.Name="{local:Localize A11y_MoveDown}" Grid.Column="3" Classes="secondary compact" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).MoveSensorDownCommand}" CommandParameter="{Binding}">
                                                    <mi:MaterialIcon Kind="ArrowDown" Width="14" Height="14"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </material:Card>

                        <TextBlock Text="{local:Localize Canvas_NewSensors}" Theme="{StaticResource OverlineTextBlock}" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer>
                        <ListBox ItemsSource="{Binding StagedCards}" Classes="staging" Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.Styles>
                                <!--
                                  A conditional class rather than a converter: Avalonia toggles it
                                  straight from the bool, so there is no third type to keep in step
                                  with the two that already express this.

                                  MATERIAL|CARD, NOT BORDER (RemEx-lki2r). The class is set on the
                                  material:Card element below, and Material.Styles.Controls.Card
                                  derives from ContentControl/TemplatedControl - it is not a Border
                                  and never has been (checked via reflection against
                                  Material.Styles.dll: Card -> ContentControl -> TemplatedControl ->
                                  Control -> ... -> AvaloniaObject). A Selector="Border.stale" here
                                  type-matches nothing a Card ever is, so from RemEx-yqpa until this
                                  fix the opacity setter never fired in any theme - not a contrast
                                  problem on one seed, the mark was dead on all of them. The eyes
                                  pass that was supposed to catch this (this bead) is what found it.

                                -->
                                <Style Selector="material|Card.stale">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Style>

                                <!--
                                  HelpText goes on the ListBoxItem CONTAINER, not the Card above
                                  (RemEx-lki2r, review). Verified live: a hardcoded HelpText set
                                  directly on a material:Card never surfaced via UIA - on the Card or
                                  any of its descendants - while the identical value set on the
                                  containing ListBoxItem read back correctly. Material.Styles.Controls
                                  .Card simply does not route AutomationProperties.HelpText to its
                                  automation peer. UIA also reads HelpText from the FOCUSED element,
                                  which for a list is the item container, not a descendant - a second,
                                  independent reason this belongs here rather than on the Card.
                                  StaleSensorHelpTextConverter reads the localizer at bind time (see
                                  its own remarks for why that is an accepted trade here, not an
                                  oversight) - the Binding is against the item's CanvasCardViewModel,
                                  same as everything inside the DataTemplate below.
                                -->
                                <Style Selector="ListBoxItem" x:DataType="vm:CanvasCardViewModel">
                                    <Setter Property="AutomationProperties.HelpText"
                                            Value="{Binding IsStale, Converter={x:Static conv:StaleSensorHelpTextConverter.Instance}}"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CanvasCardViewModel">
                                    <!--
                                      Dimmed when the host has stopped reporting this sensor (RemEx-yqpa).
                                      The ordering already sinks these below the live ones; this is the
                                      "mark" half of mark-and-group. Opacity rather than a colour so it
                                      reads the same in all four themes and needs no per-theme value -
                                      and still legible, because a stale template is exactly as
                                      droppable as a live one and must not look disabled.

                                      HelpText carries the same fact to a screen reader (RemEx-lki2r):
                                      see the ListBoxItem style above, keyed off this same IsStale
                                      value - not the Card, whose automation peer does not surface
                                      HelpText at all (verified live; see that style's own comment).
                                    -->
                                    <material:Card Classes="interactive" Classes.stale="{Binding IsStale}"
                                            Padding="12" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding CardTitle}" Theme="{StaticResource CaptionTextBlock}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Sensor, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock Theme="{StaticResource Body2TextBlock}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{x:Static conv:SensorValueConverter.Instance}">
                                                            <Binding Path="Sensor.Value"/>
                                                            <Binding Path="Sensor.Unit"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Sensor.Unit}" Theme="{StaticResource OverlineTextBlock}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                            <Button Classes="primary compact" Content="{local:Localize Canvas_AddCard}" Command="{Binding $parent[ListBox].((vm:CanvasDashboardViewModel)DataContext).PlaceFromStagingCommand}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </material:Card>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
