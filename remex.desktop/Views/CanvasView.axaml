<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    xmlns:svc="using:Remex.Desktop.Services"
    xmlns:ctrl="using:Remex.Desktop.Controls" x:Class="Remex.Desktop.Views.CanvasView" x:DataType="vm:CanvasDashboardViewModel">

    <UserControl.Styles>
        <!-- Snapshot status line: success by default, error colour when the last attempt failed (RemEx-40x8). -->
        <Style Selector="TextBlock.snapshot-status">
            <Setter Property="Foreground" Value="{DynamicResource SystemSuccessBrush}"/>
        </Style>
        <Style Selector="TextBlock.snapshot-status.failed">
            <Setter Property="Foreground" Value="{DynamicResource SystemErrorBrush}"/>
        </Style>
        <Style Selector="ctrl|DraggableCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource AccentPrimary}" BlurRadius="16" Opacity="0.6"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ═══ Sensor alert flash ═══ -->
        <Style Selector="ctrl|DraggableCard.alert-active">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="{DynamicResource SystemError}" BlurRadius="20" Opacity="0.85"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ═══ DraggableCard chrome ═══ -->
        <Style Selector="ctrl|DraggableCard">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" BoxShadow="0 8 32 0 #40000000" Padding="0">
                        <Grid>
                            <ContentPresenter Content="{TemplateBinding Content}" Margin="{Binding CornerRadius, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static conv:CornerRadiusToMarginConverter.Instance}}"/>
                            <!-- Resize grip -->
                            <Thumb Name="PART_ResizeThumb" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Opacity="0.4" Cursor="BottomRightCorner">
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Canvas Width="12" Height="12" Margin="2">
                                            <Line StartPoint="8,12" EndPoint="12,8" Stroke="#6666AA" StrokeThickness="1.5"/>
                                            <Line StartPoint="4,12" EndPoint="12,4" Stroke="#6666AA" StrokeThickness="1.5"/>
                                            <Line StartPoint="0,12" EndPoint="12,0" Stroke="#6666AA" StrokeThickness="1.5"/>
                                        </Canvas>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <!-- ═══ Toolbar buttons ═══ -->
        <Style Selector="Button.back-btn">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.back-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>

        <!-- ═══ Staging drawer buttons ═══ -->
        <Style Selector="Button.stage-btn">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10 6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.stage-btn:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.stage-mini-btn">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6 2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.stage-mini-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>

        <!-- ═══ Action buttons inside cards ═══ -->
        <Style Selector="Button.card-action">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14 8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.card-action:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>
        <Style Selector="Button.card-action-accent">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
        </Style>
        <Style Selector="Button.card-action-accent:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button.card-action-danger">
            <Setter Property="Background" Value="{DynamicResource SystemErrorBackgroundBrush}"/>
            <!-- NOT SystemErrorBrush, which fails AA on ALL FOUR themes over this tint - 4.35 / 4.31 /
                 3.48 / 3.51 at rest and 3.95 / 3.98 / 3.19 / 3.13 on hover - and not ErrorForegroundBrush,
                 which is built for the SOLID fill and is catastrophic here at 1.18-1.67. The tint needs
                 its own token. (RemEx-1elh) -->
            <Setter Property="Foreground" Value="{DynamicResource ErrorTintForegroundBrush}"/>
        </Style>
        <Style Selector="Button.card-action-danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemErrorBackgroundHoverBrush}"/>
        </Style>

        <!-- ═══ Latency bar ═══ -->
        <Style Selector="Border.lat-bar">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="1 0"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="MinHeight" Value="2"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Height" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid Background="Transparent" RowDefinitions="Auto,*">

        <!-- ═══ Toolbar ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource GlassBaseDarkBrush}" Padding="12 8">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <Button AutomationProperties.Name="{local:Localize Canvas_Header}" Classes="back-btn" IsHitTestVisible="False" Background="Transparent">
                    <TextBlock Text="{local:Localize Canvas_Header}" FontFamily="{DynamicResource PageTitleFontFamily}" FontSize="28" FontWeight="Black" LetterSpacing="2" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{local:Localize Canvas_Header}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding LayoutStatus}" FontSize="11" Foreground="{DynamicResource SystemSuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button AutomationProperties.Name="{local:Localize Canvas_UndoTooltip}" Grid.Column="3" Classes="back-btn" Command="{Binding UndoCommand}" ToolTip.Tip="{local:Localize Canvas_UndoTooltip}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="&#8617;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Undo}" FontSize="12" IsVisible="{Binding $parent[SplitView].IsPaneOpen, FallbackValue=False}"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_RedoTooltip}" Grid.Column="4" Classes="back-btn" Command="{Binding RedoCommand}" ToolTip.Tip="{local:Localize Canvas_RedoTooltip}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="&#8618;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Redo}" FontSize="12" IsVisible="{Binding $parent[SplitView].IsPaneOpen, FallbackValue=False}"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_Save}" Grid.Column="5" Classes="back-btn" Command="{Binding SaveLayoutCommand}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="ContentSave" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Save}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_Sync}" Grid.Column="6" Classes="back-btn" Command="{Binding SyncLayoutCommand}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Sync" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Sync}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize A11y_SensorLibrary}" x:Name="SensorsButton" Grid.Column="7" Classes="back-btn" Command="{Binding ToggleStagingDrawerCommand}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Download" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock FontSize="12">
                            <TextBlock.Text>
                                <MultiBinding Converter="{x:Static local:LocalizedFormatConverter.Instance}">
                                    <Binding Path="[Canvas_Sensors]" Source="{x:Static svc:LocalizationService.Instance}"/>
                                    <Binding Path="StagedCards.Count"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_ResetView}" Grid.Column="8" Classes="back-btn" Command="{Binding ResetViewCommand}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="Sync" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_ResetView}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Canvas_ToggleMinimapTooltip}" Grid.Column="9" Classes="back-btn" Command="{Binding ToggleMinimapCommand}" ToolTip.Tip="{local:Localize Canvas_ToggleMinimapTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="&#9741;" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Map}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <!-- P8-I: Snapshot export -->
                <Button AutomationProperties.Name="{local:Localize Canvas_ExportPngTooltip}" Grid.Column="10" Classes="back-btn" Click="OnExportSnapshot" ToolTip.Tip="{local:Localize Canvas_ExportPngTooltip}" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="ContentSave" Foreground="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Canvas_Export}" FontSize="12"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="11" Orientation="Vertical" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="{local:Localize Canvas_CopySnapshotTooltip}" Classes="back-btn" Click="OnCopySnapshot" ToolTip.Tip="{local:Localize Canvas_CopySnapshotTooltip}" Padding="8,4">
                        <TextBlock Text="{local:Localize Canvas_Copy}" FontSize="12"/>
                    </Button>
                    <TextBlock Text="{Binding SnapshotStatus}" FontSize="10" Classes="snapshot-status" Classes.failed="{Binding !SnapshotSucceeded}" HorizontalAlignment="Center" IsVisible="{Binding HasSnapshotStatus}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Main content ═══ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

            <!-- ═══ CANVAS ═══ -->
            <Grid Grid.Column="0">
                <ctrl:ZoomableCanvas x:Name="MainCanvas" Background="Transparent">
                    <ItemsControl ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="4000" Height="4000" Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="vm:CanvasCardViewModel">
                                <Setter Property="Canvas.Left" Value="{Binding PositionX}"/>
                                <Setter Property="Canvas.Top" Value="{Binding PositionY}"/>
                                <Setter Property="ZIndex" Value="{Binding ZIndex}"/>
                            </Style>
                        </ItemsControl.Styles>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CanvasCardViewModel">
                                <ctrl:DraggableCard Width="{Binding Width}" Height="{Binding Height}">
                                    <ctrl:DraggableCard.ContextMenu>
                                        <ContextMenu IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsSensor}}">
                                            <MenuItem Header="{local:Localize Canvas_GraphType}">
                                                <MenuItem Header="{local:Localize Canvas_GraphSmart}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Auto"/>
                                                <MenuItem Header="{local:Localize Canvas_GraphBar}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Bar"/>
                                                <MenuItem Header="{local:Localize Canvas_GraphLine}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Line"/>
                                                <MenuItem Header="{local:Localize Canvas_GraphGauge}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Gauge"/>
                                                <MenuItem Header="{local:Localize Canvas_GraphRing}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="Ring"/>
                                                <MenuItem Header="{local:Localize Canvas_GraphLed}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="LedMeter"/>
                                                <MenuItem Header="{local:Localize Canvas_GraphGlow}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="GlowArea"/>
                                                <MenuItem Header="{local:Localize Canvas_GraphDual}" Command="{Binding Sensor.SetGraphTypeCommand}" CommandParameter="DualMetric"/>
                                            </MenuItem>
                                            <MenuItem Header="{local:Localize Canvas_SecondMetric}" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).ChooseSecondMetricCommand}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="{local:Localize Canvas_ColorPreset}">
                                                <MenuItem Header="{local:Localize Canvas_Preset_Default}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Default"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_MagentaCyan}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Magenta &amp; Cyan"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_SmokeGold}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Smoke &amp; Gold"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_EmeraldNight}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Emerald Night"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_Sunset}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Sunset"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_Arctic}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Arctic"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_NeonPurple}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Neon Purple"/>
                                                <MenuItem Header="{local:Localize Canvas_Preset_Monochrome}" Command="{Binding Sensor.ApplyThemeCommand}" CommandParameter="Monochrome"/>
                                            </MenuItem>
                                            <MenuItem Header="{local:Localize Canvas_Rename}" Command="{Binding Sensor.BeginRenameCommand}"/>
                                            <MenuItem Header="{local:Localize Canvas_ShowValueOverlay}" ToggleType="CheckBox" IsChecked="{Binding Sensor.ShowValueOverlay, Mode=TwoWay}"/>
                                            <Separator/>
                                            <MenuItem Header="{local:Localize Canvas_TogglePinToHome}" Command="{Binding TogglePinToHomeCommand}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="📌" IsVisible="{Binding IsPinnedToHome}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{local:Localize Canvas_SetAlert}" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).SetAlertCommand}" CommandParameter="{Binding}"/>

                                        </ContextMenu>
                                    </ctrl:DraggableCard.ContextMenu>

                                    <Grid>
                                        <!-- ═══ CONNECTION ═══ -->
                                        <StackPanel IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsConnection}}">
                                            <TextBlock Text="{local:Localize Canvas_Connection}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <!-- Phone presence, not the loopback link (RemEx-7zzw). -->
                                                <Ellipse Width="10" Height="10" AutomationProperties.Name="{Binding Presence.PresenceAccessibleName}" Classes="status-dot" Classes.connected="{Binding Presence.IsPhoneAttached}">
                                                </Ellipse>
                                                <TextBlock Text="{Binding Presence.PresenceText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                            <!-- Demoted, not dropped (review). I first replaced this line, reasoning that
                                                 HostRuntimeText carried the host detail — it does not: that lives on
                                                 SettingsViewModel and this card is a CanvasCardViewModel. Canvas would
                                                 have had no host-link indication at all. -->
                                            <TextBlock Text="{Binding Connection.StatusText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBox Text="{Binding Connection.HostAddress}" Margin="0,12,0,0" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="8" Padding="8 6" FontSize="12" FontFamily="Consolas, monospace" PlaceholderText="wss://host:port/ws" IsEnabled="{Binding !Connection.IsConnected}"/>
                                        </StackPanel>

                                        <!-- ═══ ACTIONS ═══ -->
                                        <StackPanel IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsActions}}" Spacing="8">
                                            <TextBlock Text="{local:Localize Canvas_Actions}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <Button Classes="card-action card-action-accent" Content="{local:Localize Dashboard_Connect}" Command="{Binding Connection.ConnectCommand}" IsVisible="{Binding !Connection.IsConnecting}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentForegroundBrush}"/>
                                            <Button Classes="card-action" Content="{local:Localize Canvas_CancelConnect}" Command="{Binding Connection.DisconnectCommand}" IsVisible="{Binding Connection.IsConnecting}" Background="{DynamicResource SystemErrorBrush}" Foreground="{DynamicResource ErrorForegroundBrush}"/>
                                            <Button Classes="card-action" Content="{local:Localize Canvas_Ping}" Command="{Binding Connection.SendPingCommand}" Background="{DynamicResource CardBackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <Button Classes="card-action" Content="{local:Localize Canvas_LockPC}" Command="{Binding Connection.LockCommand}"/>
                                            <Button Classes="card-action" Content="{local:Localize Canvas_RebootUefi}" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).RestartToUefiCommand}"/>
                                            <Button Classes="card-action" Content="{local:Localize Canvas_Disconnect}" Command="{Binding Connection.DisconnectCommand}" IsVisible="{Binding Connection.IsConnected}" Background="{DynamicResource SystemErrorBrush}" Opacity="0.8" Foreground="{DynamicResource ErrorForegroundBrush}"/>
                                        </StackPanel>

                                        <!-- ═══ LATENCY ═══ -->
                                        <StackPanel IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsLatency}}">
                                            <TextBlock Text="{local:Localize Canvas_Latency}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Connection.LatencyText}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,8,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{local:Localize Canvas_Avg}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" FontWeight="SemiBold" Text="{Binding Connection.AverageLatency, StringFormat={}{0:F1} ms}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{local:Localize Canvas_Max}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    <TextBlock Foreground="{DynamicResource SystemErrorBrush}" FontSize="13" FontWeight="SemiBold" Text="{Binding Connection.MaxLatency, StringFormat={}{0:F1} ms}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="6" Margin="0,10,0,0" Padding="6" Height="60">
                                                <ItemsControl ItemsSource="{Binding Connection.LatencyHistory}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Spacing="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Classes="lat-bar" Width="10" Height="{Binding ., Converter={x:Static conv:LatencyToHeightConverter.Instance}}" Background="{DynamicResource AccentPrimaryBrush}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>

                                        <!-- ═══ SENSOR ═══ -->
                                        <Grid IsVisible="{Binding CardType, Converter={x:Static conv:StringMatchConverter.IsSensor}}" RowDefinitions="Auto,*">
                                            <!-- Row 0: title band on top, above the sparkline (readable without a plate). -->
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Margin="8,5,8,2" VerticalAlignment="Top">
                                                <TextBlock Text="📌" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding IsPinnedToHome}"/>
                                                <TextBlock Text="{Binding Sensor.DisplayName, FallbackValue=Sensor}" FontSize="11" FontWeight="Bold" Foreground="{Binding Sensor.Theme.LabelColor, Converter={x:Static conv:HexToBrushConverter.Instance}}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <!-- Row 1: body — the sparkline fills it prominently; the value floats bottom-left. -->
                                            <Grid Grid.Row="1">
                                                <ctrl:SparklineControl History="{Binding Sensor.History}" GraphType="{Binding Sensor.ResolvedGraphType}" AccentColor="{Binding Sensor.Theme.AccentColor, Converter={x:Static conv:HexToColorConverter.Instance}}" TrackBrush="{DynamicResource TextMutedBrush}" CurrentValue="{Binding Sensor.Value}" MinSeen="{Binding Sensor.MinSeenValue}" MaxSeen="{Binding Sensor.MaxSeenValue}" SecondaryHistory="{Binding Sensor.SecondaryHistory}" SecondaryAccentColor="{Binding Sensor.SecondaryAccentHex, Converter={x:Static conv:HexToColorConverter.Instance}}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.6"/>

                                                <!-- Value plate: its OWN Viewbox (title excluded) so every card's number renders at a
                                                     consistent size; DownOnly means short values don't balloon. Layered above the
                                                     sparkline on a semi-opaque plate so it stays crisp over the prominent line. -->
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="34" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="6" IsVisible="{Binding Sensor.ShowValueOverlay}">
                                                    <Border CornerRadius="6" Padding="7,3" Background="{Binding Sensor.Theme.CardBackground, Converter={x:Static conv:HexToTranslucentBrushConverter.Instance}, ConverterParameter=0.8}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                                            <TextBlock FontSize="20" FontWeight="Black" Foreground="{Binding Sensor.Theme.ValueColor, Converter={x:Static conv:HexToBrushConverter.Instance}}">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{x:Static conv:SensorValueConverter.Instance}">
                                                                        <Binding Path="Sensor.Value"/>
                                                                        <Binding Path="Sensor.Unit"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Sensor.Unit}" FontSize="11" Foreground="{Binding Sensor.Theme.UnitColor, Converter={x:Static conv:HexToBrushConverter.Instance}}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Viewbox>

                                                <!-- Dual Metric: the SECOND sensor's value, mirrored bottom-right and tinted with the
                                                     secondary accent so it maps to the amber line (the primary value stays bottom-left). -->
                                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                                         IsVisible="{Binding Sensor.HasSecondary}">
                                                    <Border CornerRadius="6" Padding="7,3" Background="{Binding Sensor.Theme.CardBackground, Converter={x:Static conv:HexToTranslucentBrushConverter.Instance}, ConverterParameter=0.8}">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                                            <TextBlock FontSize="17" FontWeight="Black" Foreground="{Binding Sensor.SecondaryAccentHex, Converter={x:Static conv:HexToBrushConverter.Instance}}">
                                                                <TextBlock.Text>
                                                                    <MultiBinding Converter="{x:Static conv:SensorValueConverter.Instance}">
                                                                        <Binding Path="Sensor.SecondarySensor.Value"/>
                                                                        <Binding Path="Sensor.SecondarySensor.Unit"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Sensor.SecondarySensor.Unit}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Viewbox>

                                                <!-- Dual Metric legend: colour key mapping each line to its sensor. -->
                                                <Border IsVisible="{Binding Sensor.IsDualMetric}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                                        CornerRadius="5" Padding="6,4"
                                                        Background="{Binding Sensor.Theme.CardBackground, Converter={x:Static conv:HexToTranslucentBrushConverter.Instance}, ConverterParameter=0.78}">
                                                    <StackPanel Spacing="3">
                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                            <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center" Background="{Binding Sensor.Theme.AccentColor, Converter={x:Static conv:HexToBrushConverter.Instance}}"/>
                                                            <TextBlock Text="{Binding Sensor.DisplayName}" FontSize="9" MaxWidth="120" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding Sensor.HasSecondary}">
                                                            <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center" Background="{Binding Sensor.SecondaryAccentHex, Converter={x:Static conv:HexToBrushConverter.Instance}}"/>
                                                            <TextBlock Text="{Binding Sensor.SecondarySensor.DisplayName}" FontSize="9" MaxWidth="120" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- Inline rename editor: normal-sized overlay spanning the card. Commits on Enter/blur. -->
                                            <TextBox Grid.Row="0" Grid.RowSpan="2" Text="{Binding Sensor.CustomTitle, Mode=TwoWay}" IsVisible="{Binding Sensor.IsEditingTitle}" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="8" FontSize="12" FontWeight="Bold" MaxLength="40" Loaded="OnRenameBoxLoaded" KeyDown="OnRenameKeyDown" LostFocus="OnRenameLostFocus"/>
                                        </Grid>
                                    </Grid>
                                </ctrl:DraggableCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ctrl:ZoomableCanvas>

                <!-- Minimap overlay -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" IsVisible="{Binding IsMinimapVisible}" CornerRadius="8" ClipToBounds="True" BoxShadow="0 4 24 0 #50000000">
                    <ctrl:CanvasMinimap x:Name="Minimap" Width="200" Height="160" Cards="{Binding Cards}" ViewportRect="{Binding MinimapViewportRect}"/>
                </Border>

                <!-- ═══ FLOATING ACTION BAR (multi-select: Pin / Remove / Done) ═══ -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                        IsVisible="{Binding HasSelection}"
                        Background="{DynamicResource GlassBaseMediumBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="10,6" BoxShadow="0 6 28 0 #60000000">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="6,0,4,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectionSummary}"/>
                        <Button Classes="card-action" Command="{Binding PinSelectedCommand}" Content="{local:Localize Canvas_ActionPin}" Background="{DynamicResource CardBackgroundHoverBrush}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button Classes="card-action card-action-danger" Command="{Binding RemoveSelectedCommand}" Content="{local:Localize Canvas_ActionRemove}"/>
                        <Button Classes="card-action card-action-accent" Command="{Binding ClearSelectionCommand}" Content="{local:Localize Canvas_ActionDone}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentForegroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ "?" REPLAY HINT (always available) ═══ -->
                <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Width="34" Height="34"
                        Classes="back-btn" Command="{Binding ReplayCoachMarkCommand}" ToolTip.Tip="{local:Localize Canvas_CoachReplayTooltip}" AutomationProperties.Name="{local:Localize Canvas_CoachReplayTooltip}"
                        CornerRadius="17" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBlock Text="?" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                </Button>

                <!-- ═══ COACH MARK OVERLAY (first-visit hint) — card + arrow positioned in code-behind
                     (OnCoachLayout) to aim at the real Sensors button wherever it lands. ═══ -->
                <Grid x:Name="CoachOverlay" IsVisible="{Binding CoachMarkVisible}" Background="#40000000">
                    <Canvas x:Name="CoachCanvas">
                        <!-- Arrow (stroke) + arrowhead (fill); geometry set at runtime. -->
                        <Path x:Name="CoachArrow" Stroke="{DynamicResource AccentPrimaryBrush}" StrokeThickness="3" StrokeLineCap="Round" StrokeJoin="Round"/>
                        <Path x:Name="CoachArrowHead" Fill="{DynamicResource AccentPrimaryBrush}"/>
                        <Border x:Name="CoachCard" Width="320"
                                Background="{DynamicResource GlassBaseMediumBrush}"
                                BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5"
                                CornerRadius="12" Padding="18,16" BoxShadow="0 8 32 0 #70000000"
                                SizeChanged="OnCoachCardSizeChanged">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{local:Localize Canvas_CoachTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{local:Localize Canvas_CoachBody}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button HorizontalAlignment="Right" Classes="card-action card-action-accent" Command="{Binding DismissCoachMarkCommand}" Content="{local:Localize Canvas_CoachGotIt}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentForegroundBrush}"/>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Grid>

            <!-- ═══ STAGING DRAWER ═══ -->
            <Border Grid.Column="1" Background="{DynamicResource GlassBaseMediumBrush}" Width="260" IsVisible="{Binding IsStagingDrawerOpen}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                        <TextBlock Text="{local:Localize Canvas_ActiveSensors}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>

                        <Border Classes="glass-card" Padding="8" IsVisible="{Binding SensorActivationItems.Count}">
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ListBox ItemsSource="{Binding SensorActivationItems}" Background="Transparent" BorderThickness="0" Padding="0">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SensorActivationItem">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,6">
                                                <CheckBox AutomationProperties.Name="{Binding SensorName}" Grid.Column="0" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SensorName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Button AutomationProperties.Name="{local:Localize A11y_MoveUp}" Grid.Column="2" Classes="stage-mini-btn" Content="↑" Margin="6,0,4,0" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).MoveSensorUpCommand}" CommandParameter="{Binding}"/>
                                                <Button AutomationProperties.Name="{local:Localize A11y_MoveDown}" Grid.Column="3" Classes="stage-mini-btn" Content="↓" Command="{Binding $parent[UserControl].((vm:CanvasDashboardViewModel)DataContext).MoveSensorDownCommand}" CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </ScrollViewer>
                        </Border>

                        <TextBlock Text="{local:Localize Canvas_NewSensors}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2" Margin="0,4,0,0"/>
                    </StackPanel>

                    <ScrollViewer>
                        <ListBox ItemsSource="{Binding StagedCards}" Background="Transparent" BorderThickness="0" Padding="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                                <!--
                                  A conditional class rather than a converter: Avalonia toggles it
                                  straight from the bool, so there is no third type to keep in step
                                  with the two that already express this.
                                -->
                                <Style Selector="Border.stale">
                                    <Setter Property="Opacity" Value="0.55"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CanvasCardViewModel">
                                    <!--
                                      Dimmed when the host has stopped reporting this sensor (RemEx-yqpa).
                                      The ordering already sinks these below the live ones; this is the
                                      "mark" half of mark-and-group. Opacity rather than a colour so it
                                      reads the same in all four themes and needs no per-theme value -
                                      and still legible, because a stale template is exactly as
                                      droppable as a live one and must not look disabled.
                                    -->
                                    <Border Classes="glass-card interactive" Classes.stale="{Binding IsStale}"
                                            Padding="12" Margin="0,0,0,8">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding CardTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Sensor, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{x:Static conv:SensorValueConverter.Instance}">
                                                            <Binding Path="Sensor.Value"/>
                                                            <Binding Path="Sensor.Unit"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Sensor.Unit}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                            <Button Classes="stage-btn" Content="{local:Localize Canvas_AddCard}" Command="{Binding $parent[ListBox].((vm:CanvasDashboardViewModel)DataContext).PlaceFromStagingCommand}" CommandParameter="{Binding}" Background="{DynamicResource AccentPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</UserControl>
