<!--
    The pairing-PIN panel's contents, shared by ConnectionView and SettingsView.
    See PairingQrPanelView.axaml for why only the contents are shared and not the card chrome.

    DataContext is the ConnectionViewModel: inherited in ConnectionView, passed explicitly as
    DataContext="{Binding Connection}" in SettingsView.
-->
<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    x:Class="Remex.Desktop.Views.PairingPinPanelView" x:DataType="vm:ConnectionViewModel">
    <UserControl.Styles>
        <!-- Theme token, not a literal: SystemWarningBrush is defined in all four PC themes, so the
             last-15-seconds colour stays legible on each of them. -->
        <Style Selector="TextBlock.expiring">
            <Setter Property="Foreground" Value="{DynamicResource SystemWarningBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Styles>
    <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{conv:Localize Settings_PairingPinTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2" VerticalAlignment="Center"/>
            <Button AutomationProperties.Name="{conv:Localize A11y_Close}" Grid.Column="1" Content="✕" Command="{Binding ClosePairingPinCommand}" Background="Transparent" Padding="4" VerticalAlignment="Center" Cursor="Hand"/>
        </Grid>

        <!-- Monospaced and widely letter-spaced because the user is reading these six digits off
             the screen and typing them into a phone; proportional digits make 1/7 and 0/8 harder.

             SELECTABLE (RemEx-7ykyn item 1). It was a plain TextBlock, so the one thing a person
             might reasonably want to do with a PIN on a PC — copy it, into a chat with whoever is
             holding the phone — was the one thing they could not do. -->
        <Border Background="{DynamicResource CardBackgroundBrush}" Padding="20,16" CornerRadius="8" HorizontalAlignment="Center" IsVisible="{Binding !IsPairingPinExpired}">
            <!-- NO AutomationProperties.Name HERE. Setting one on a content-bearing element REPLACES its
                 text for screen readers, so naming this "Copy PIN" would have announced that and never
                 the six digits — a PIN that is screen-only, expires in three minutes and cannot be
                 re-read would have become unusable non-visually, by the change meant to make it more
                 usable (review). Every other AutomationProperties.Name in this app is on a control
                 with no text of its own. -->
            <SelectableTextBlock Text="{Binding ActivePairingPin}" FontFamily="Consolas" FontSize="42" FontWeight="Bold" LetterSpacing="8" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center"/>
        </Border>

        <!-- REPLACED, NOT GREYED OUT, and that is the decision rather than a style choice: an expired
             PIN rendered faintly is still six digits on a screen, and a user looking at their phone
             instead of the PC will type them. The visual treatment carries no information to the
             person actually doing the task, so the digits go and an action takes their place. -->
        <StackPanel Spacing="12" IsVisible="{Binding IsPairingPinExpired}">
            <TextBlock Text="{conv:Localize Settings_PairingPinExpired}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
            <Button Content="{conv:Localize Settings_PairingPinGetNew}" Command="{Binding RevealPairingPinCommand}" HorizontalAlignment="Center" Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource AccentForegroundBrush}" Padding="18,10" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
        </StackPanel>

        <TextBlock Text="{conv:Localize Settings_PairingPinHint}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !IsPairingPinExpired}"/>

        <!-- The last-15-seconds warning is a COLOUR CHANGE ON THE SAME LINE, not a new element, so
             nothing moves under the pointer while the user is mid-type. The threshold comes from
             PairingPinCountdown and was chosen from the task — read six digits, type them into a
             phone — not from a round number. -->
        <TextBlock Classes.expiring="{Binding IsPairingPinExpiringSoon}" Text="{Binding PairingPinExpiresInText}" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !IsPairingPinExpired}"/>
    </StackPanel>
</UserControl>
