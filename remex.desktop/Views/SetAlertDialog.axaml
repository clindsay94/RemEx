<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Remex.Desktop.ViewModels"
        xmlns:local="clr-namespace:Remex.Desktop.Converters"
        xmlns:conv="clr-namespace:Remex.Desktop.Converters"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        x:Class="Remex.Desktop.Views.SetAlertDialog"
        x:DataType="vm:SetAlertViewModel"
        Title="{local:Localize SetAlert_Title}"
        Width="360"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlassBaseDarkBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="24,44,24,24">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="4">
            <TextBlock Text="{local:Localize SetAlert_Header}" Theme="{StaticResource OverlineTextBlock}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
            <TextBlock Text="{Binding SensorName}" Theme="{StaticResource Headline6TextBlock}" FontWeight="Bold"
                       Foreground="{DynamicResource AccentPrimaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Threshold. NOT assists:TextFieldAssist.Label (Opus review round 2, MEDIUM): confirmed
             against Material.Avalonia 3.19.0's actual source
             (Material.Styles/Resources/Themes/NumericUpDown.axaml) that OutlineNumericUpDown's
             template-binds TextFieldAssist.Label down to an inner PART_TextBox, but that inner box
             is themed MaterialOnlyPresenterTextBox - a stripped template with no label element at
             all - while the OUTER template's own ":empty"/"focus-within" styles target
             Border#PART_LabelRootBorder, an element the OUTER template never declares either. The
             value is bound through but never painted anywhere; a caption stays here instead
             (TextInputTests.LabelExemptInputs). AutomationProperties.Name below is unaffected -
             UIA reads it directly, not through this template. -->
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,12">
            <TextBlock Text="{local:Localize SetAlert_ThresholdValue}" Theme="{StaticResource CaptionTextBlock}"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <!-- Range is wide on purpose: MB-scale sensors pass 99999 on any box with more than
                 ~100 GB of RAM (Physical Memory Total = 131072 MB), and a NumericUpDown silently
                 reverts out-of-range text on focus loss, so a tight cap read as "Set Alert ignored
                 me" (RemEx-8wpvr.9). -->
            <NumericUpDown Value="{Binding Threshold}" Increment="1"
                           Minimum="-1000000000" Maximum="1000000000"
                           FormatString="F1"
                           AutomationProperties.Name="{local:Localize SetAlert_ThresholdValue}"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
        </StackPanel>

        <!-- Direction -->
        <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}"
                      assists:ComboBoxAssist.Label="{local:Localize SetAlert_TriggerDirection}"
                      AutomationProperties.Name="{local:Localize SetAlert_TriggerDirection}"
                      Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static conv:EnumLocalizerConverter.Instance}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Severity -->
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,0,0,24">
            <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"
                      assists:ComboBoxAssist.Label="{local:Localize SetAlert_Severity}"
                      AutomationProperties.Name="{local:Localize SetAlert_Severity}"
                      Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={x:Static conv:EnumLocalizerConverter.Instance}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Buttons -->
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto,Auto">
            <Button Grid.Column="1" Content="{local:Localize Btn_Clear}" Command="{Binding ClearAlertCommand}"
                    Classes="tertiary danger"
                    MinWidth="72" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="{local:Localize Btn_Cancel}" Command="{Binding CancelCommand}"
                    Classes="tertiary" MinWidth="80" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="{local:Localize SetAlert_SetAlertBtn}" Command="{Binding ConfirmCommand}"
                    Classes="primary" MinWidth="100"/>
        </Grid>

    </Grid>
    <!-- ESCAPE DISMISSES, AND IT IS ROUTED TO THE ACTION ALREADY WRITTEN AS THIS DIALOG'S CANCEL
         (RemEx-xxifk). ENTER SETS THE ALERT (RemEx-df08), routed to ConfirmCommand - the same
         affirmative action the "SetAlert_SetAlertBtn" primary button already runs. Deliberately NOT
         ClearAlertCommand: that is the destructive option (removes the alert entirely) and stays a
         mouse-only, deliberate action - this is exactly the "backwards" failure mode to avoid. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}"/>
    </Window.KeyBindings>
</Window>