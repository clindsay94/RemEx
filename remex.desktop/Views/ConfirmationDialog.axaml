<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Remex.Desktop.Views.ConfirmationDialog"
        x:CompileBindings="False"
        Title="Confirm"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <Grid RowDefinitions="Auto,Auto,Auto" Margin="24,40,24,24">

        <!-- Dialog title -->
        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Theme="{StaticResource Headline6TextBlock}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- Descriptive message -->
        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Theme="{StaticResource Body2TextBlock}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,28"/>

        <!-- Buttons: Cancel (left) | Confirm action (right) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelBtn"
                    Classes="tertiary"
                    Click="OnCancelClicked"/>
            <!-- The destructive confirm: a PRIMARY action that happens to be destructive, which
                 in the vocabulary is the two classes together rather than a bespoke red button
                 (RemEx-z7pnx). The Button.Styles block this replaces had already stopped working
                 - its hover selector targeted an unnamed ContentPresenter as the background-
                 bearing template part, which is Fluent's shape, not Material's. -->
            <Button x:Name="ConfirmBtn"
                    Classes="primary danger"
                    Click="OnConfirmClicked"/>
        </StackPanel>

    </Grid>
</Window>
