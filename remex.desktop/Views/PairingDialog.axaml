<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
        xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Remex.Desktop.ViewModels"
        xmlns:sys="using:System"
        xmlns:services="using:Remex.Desktop.Services"
        xmlns:local="clr-namespace:Remex.Desktop.Converters"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
        x:Class="Remex.Desktop.Views.PairingDialog"
        x:DataType="vm:PairingDialogViewModel"
        Width="400"
        SizeToContent="Height"
        MaxHeight="600"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{local:Localize PairingDialogTitle}"
        Background="{DynamicResource GlassBaseDarkBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <material:Card Padding="24" Margin="12,40,12,12">
        <Grid RowDefinitions="Auto,*,Auto">

            <TextBlock Grid.Row="0"
                       Text="{local:Localize PairingDialogTitle}"
                       Theme="{StaticResource Headline6TextBlock}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center">
                <TextBlock Text="{local:Localize PairingDialogInstruction}"
                           Theme="{StaticResource Body2TextBlock}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                
                <!-- THE ERROR IS PART OF THE FIELD NOW, not a red line floating under it
                     (RemEx-5w9ws). TextFieldAssist.Hints renders inside the text field's own
                     template, so the message sits where the field's helper text goes and moves
                     with it; HasError turns the border and the helper text to the error colour at
                     the same time. That is the acceptance criterion's "visible without colour
                     alone": the field gains TEXT and a changed border, and the message is now
                     associated with the input rather than merely adjacent to it — which is the
                     difference a screen reader can hear. -->
                <TextBox Text="{Binding PinInput}"
                         PlaceholderText="000000"
                         MaxLength="6"
                         FontSize="24"
                         FontWeight="Bold"
                         LetterSpacing="8"
                         HorizontalContentAlignment="Center"
                         IsEnabled="{Binding !IsBusy}"
                         assists:TextFieldAssist.Hints="{Binding ErrorText}"
                         Classes.invalid="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                
                
                <!-- Indeterminate is honest: a pairing handshake reports no percentage, so a
                     determinate bar here would be inventing one. The accessible name is what makes
                     it mean anything to a screen reader - an indeterminate bar has no text and no
                     value to announce, so without it the dialog simply goes quiet while it works
                     (RemEx-rcgmc). Status_Connecting rather than a new string: the handshake IS the
                     connection attempt, and it already reads correctly in all nine locales. -->
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsBusy}"
                             HorizontalAlignment="Stretch"
                             AutomationProperties.Name="{local:Localize Status_Connecting}"/>
            </StackPanel>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
                <Button Content="{local:Localize Btn_Cancel}" 
                        Command="{Binding CancelCommand}"
                        Classes="secondary"/>
                <Button Content="{local:Localize Btn_Pair}" 
                        Command="{Binding SubmitCommand}"
                        Classes="primary"
                        IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
        </Grid>
    </material:Card>
    <!-- ESCAPE DISMISSES, AND IT IS ROUTED TO THE ACTION ALREADY WRITTEN AS THIS DIALOG'S CANCEL
         (RemEx-xxifk). Enter is deliberately NOT bound here: whether a default action is safe is a
         per-dialog question and stays on RemEx-df08. Escape carries none of that, because cancelling
         is never the destructive option. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
    </Window.KeyBindings>
</Window>