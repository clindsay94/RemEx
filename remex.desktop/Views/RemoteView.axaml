<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:local="clr-namespace:Remex.Desktop.Converters" x:Class="Remex.Desktop.Views.RemoteView" x:DataType="vm:RemoteViewModel">

    <UserControl.Styles>
        <Style Selector="Button.remote-btn">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusMedium}"/>
            <Setter Property="Padding" Value="12 14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="112"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.remote-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
        </Style>
        <Style Selector="Button.remote-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <Style Selector="Button.remote-btn-danger">
            <Setter Property="Background" Value="{DynamicResource SystemErrorBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemErrorBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorBrush}"/>
        </Style>
        <Style Selector="Button.remote-btn-warn">
            <Setter Property="Background" Value="{DynamicResource SystemWarningBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemWarningBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemWarningBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,24,32,32" Spacing="20">

            <!-- ═══ Header ═══ -->
            <StackPanel Spacing="4">
                <TextBlock Classes="page-title" Text="{local:Localize Remote_Header}"/>
                <TextBlock Classes="page-subtitle" Text="{local:Localize Remote_Subheader}"/>
            </StackPanel>

            <!-- ═══ Wake this PC from your phone (Wake-on-LAN info) ═══ -->
            <material:Card Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🔌" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Localize Remote_WakeTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{local:Localize Remote_WakeExplainer}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>

                    <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="10" Padding="14,12" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="{local:Localize Remote_ThisPcMac}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="1"/>
                                <SelectableTextBlock Text="{Binding HostMacAddress}" FontSize="18" FontWeight="Bold" FontFamily="Consolas, monospace" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                                <TextBlock Text="{Binding HostAdapterName}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding HostAdapterName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="remote-btn" MinHeight="0" Padding="16,10" VerticalAlignment="Center" Command="{Binding CopyMacCommand}" Content="{local:Localize Remote_CopyMac}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="{local:Localize Remote_WakeInstruction}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18"/>
                </StackPanel>
            </material:Card>

            <!-- ═══ Graceful Controls ═══ -->
            <TextBlock Text="{local:Localize Remote_Graceful}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
            <UniformGrid Columns="3" IsEnabled="{Binding Connection.IsConnected}">
                <Button AutomationProperties.Name="{local:Localize Remote_Lock}" Classes="remote-btn" Command="{Binding LockPcCommand}" Margin="0,0,4,8">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{local:Localize Remote_Lock}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="🔒" FontSize="30" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Remote_SignOut}" Classes="remote-btn" Command="{Binding SignOutPcCommand}" Margin="4,0,4,8">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{local:Localize Remote_SignOut}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="🚪" FontSize="30" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Remote_Shutdown}" Classes="remote-btn remote-btn-warn" Command="{Binding ShutdownPcCommand}" Margin="4,0,0,8">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{local:Localize Remote_Shutdown}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="⏻" FontSize="30" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Remote_Restart}" Classes="remote-btn remote-btn-warn" Command="{Binding RestartPcCommand}" Margin="0,0,4,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{local:Localize Remote_Restart}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="🔄" FontSize="30" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Remote_Sleep}" Classes="remote-btn" Command="{Binding SleepPcCommand}" Margin="4,0,4,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{local:Localize Remote_Sleep}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="🌙" FontSize="30" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Remote_Hibernate}" Classes="remote-btn" Command="{Binding HibernatePcCommand}" Margin="4,0,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{local:Localize Remote_Hibernate}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="❄️" FontSize="30" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- ═══ Forced Controls ═══ -->
            <TextBlock Text="{local:Localize Remote_Forced}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SystemErrorBrush}" LetterSpacing="2"/>
            <UniformGrid Columns="3" IsEnabled="{Binding Connection.IsConnected}">
                <Button AutomationProperties.Name="{local:Localize Remote_ForceShutdown}" Classes="remote-btn remote-btn-danger" Command="{Binding ForceShutdownPcCommand}" Margin="0,0,4,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{local:Localize Remote_ForceShutdown}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="⏻" FontSize="30" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Remote_ForceRestart}" Classes="remote-btn remote-btn-danger" Command="{Binding ForceRestartCommand}" Margin="4,0,4,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{local:Localize Remote_ForceRestart}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="🔄" FontSize="30" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button AutomationProperties.Name="{local:Localize Remote_RebootUefi}" Classes="remote-btn remote-btn-danger" Command="{Binding RestartToUefiCommand}" Margin="4,0,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{local:Localize Remote_RebootUefi}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="⚙️" FontSize="30" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Command status -->
            <TextBlock Text="{Binding WolStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" IsVisible="{Binding WolStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
