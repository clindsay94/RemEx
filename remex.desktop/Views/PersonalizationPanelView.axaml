<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:models="using:Remex.Desktop.Models"
    xmlns:local="clr-namespace:Remex.Desktop.Converters" xmlns:svc="using:Remex.Desktop.Services"
    xmlns:controls="using:Remex.Desktop.Controls"
    xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
    xmlns:mi="using:Material.Icons.Avalonia"
    x:Class="Remex.Desktop.Views.PersonalizationPanelView" x:DataType="vm:CustomizationViewModel">

    <StackPanel Spacing="20">

        <!-- ═══ Card 1: Colour (spec section 3) ═══ One seed, one path: pick where it comes from,
             shape it, pick the mapping strategy, and see it previewed — Android's own flow, brought
             to the desktop sheet. -->
        <material:Card Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{local:Localize Custom_SectionColor}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                <Grid ColumnDefinitions="*,2*">
                    <ComboBox Grid.Column="1" SelectedItem="{Binding ColorSource}" ItemsSource="{Binding AvailableColorSources}" HorizontalAlignment="Left" Width="160" AutomationProperties.Name="{local:Localize Custom_ColorSource}" assists:ComboBoxAssist.Label="{local:Localize Custom_ColorSource}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static local:PrefixedLabelConverter.Instance}" ConverterParameter="Custom_Source_">
                                            <Binding Path="CultureTag" Source="{x:Static svc:LocalizationService.Instance}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <!-- "Match my phone" (RemEx-sudp8): independent of which ColorSource is selected -
                     pressing it moves ColorSource to Custom itself - and hidden rather than
                     disabled when no phone has synced a palette over the link (RemEx-y06a0.1). -->
                <Button Classes="secondary compact" Content="{local:Localize Custom_MatchPhoneTheme}" Command="{Binding MatchPhoneThemeCommand}" IsVisible="{Binding HasPhoneTheme}" AutomationProperties.Name="{local:Localize Custom_MatchPhoneTheme}"/>

                <!-- Windows accent: the raw registry colour, as read. -->
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWindowsAccentSource}">
                    <Border x:CompileBindings="False" Width="28" Height="28" CornerRadius="6" Background="{Binding SourceAccentHex}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ToolTip.Tip="{Binding SourceAccentHex}" AutomationProperties.Name="{local:Localize Custom_CurrentWindowsAccent}"/>
                    <TextBlock Text="{Binding SourceAccentHex}" VerticalAlignment="Center" FontFamily="Consolas, monospace" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Wallpaper: the extracted candidates, best first. -->
                <StackPanel Spacing="6" IsVisible="{Binding IsWallpaperSource}">
                    <Button Classes="secondary compact" Content="{local:Localize Custom_RefreshWallpaperSeeds}" Command="{Binding RefreshWallpaperSeedsCommand}" AutomationProperties.Name="{local:Localize Custom_RefreshWallpaperSeeds}"/>
                    <ItemsControl ItemsSource="{Binding WallpaperSeedCandidates}" IsVisible="{Binding HasWallpaperSeedCandidates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="swatch compact" Background="{Binding}" AutomationProperties.Name="{Binding}" ToolTip.Tip="{Binding}" Command="{Binding $parent[UserControl].DataContext.SelectWallpaperSeedCommand}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Custom: the wheel, hex box and recent-seeds row — the person picks all three axes. -->
                <StackPanel Spacing="12" IsVisible="{Binding IsCustomSource}">
                    <controls:HctColorWheel Width="176" Height="176" HorizontalAlignment="Center"
                        Hue="{Binding SeedHue, Mode=TwoWay}"
                        Chroma="{Binding SeedChroma, Mode=TwoWay}"
                        Tone="{Binding SeedTone, Mode=TwoWay}"
                        IsDragging="{Binding IsSeedDragging, Mode=OneWayToSource}"
                        SeedCommitted="OnSeedCommitted"
                        AutomationProperties.Name="{local:Localize Custom_SeedWheel}"
                        ToolTip.Tip="{local:Localize Custom_SeedWheelTooltip}"/>

                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="{local:Localize Custom_SeedHue}" VerticalAlignment="Center" MinWidth="52"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="360" SmallChange="1" LargeChange="15" Value="{Binding SeedHue}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_SeedHue}"/>
                        <TextBlock Grid.Column="2" Text="{Binding SeedHue, StringFormat={}{0:F0}°}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>

                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding CustomAccentHex}" PlaceholderText="{Binding AccentColor}" FontFamily="Consolas, monospace" FontSize="12" MaxLength="9" AutomationProperties.Name="{local:Localize Custom_SeedHex}" Classes="outline" UseFloatingPlaceholder="True" assists:TextFieldAssist.Label="{local:Localize Custom_SeedHex}">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding ConfirmCustomAccentCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                            <!-- CornerRadius=6 stays (matches the compact-action-row exception documented
                                 in ShellView); Background/Foreground/Padding were exact duplicates of what
                                 .primary/.compact already supply and are removed (RemEx-cgrv3). -->
                            <Button Grid.Column="1" Classes="primary compact" Content="{local:Localize Btn_Apply}" Command="{Binding ConfirmCustomAccentCommand}" FontSize="12" FontWeight="SemiBold" CornerRadius="6" VerticalAlignment="Stretch"/>
                            <Border Grid.Column="2" x:CompileBindings="False" Width="28" Height="28" CornerRadius="6" Background="{Binding AccentColor}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ToolTip.Tip="{Binding AccentColor}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6" IsVisible="{Binding HasRecentSeeds}">
                        <TextBlock Text="{local:Localize Custom_RecentSeeds}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <ItemsControl ItemsSource="{Binding CustomAccentColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- WRAPPING, BECAUSE EIGHT SWATCHES DO NOT FIT ON ONE ROW HERE. A
                                         horizontal StackPanel would push the last of them out past the
                                         drawer's edge, where they are unreachable rather than merely ugly. -->
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="swatch compact" Background="{Binding}" AutomationProperties.Name="{Binding}" ToolTip.Tip="{Binding}" Command="{Binding $parent[UserControl].DataContext.SetAccentCommand}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- Vibrancy: the seed's chroma. Every source keeps this slider — it is the one axis
                     none of the three sources supply. -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{local:Localize Custom_Vibrancy}" VerticalAlignment="Center" MinWidth="52"/>
                    <Slider Grid.Column="1" Minimum="0" Maximum="120" SmallChange="1" LargeChange="10" Value="{Binding SeedChroma}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_Vibrancy}"/>
                    <TextBlock Grid.Column="2" Text="{Binding SeedChroma, StringFormat={}{0:F0}}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_ContrastTooltip}">
                    <TextBlock Text="{local:Localize Custom_ContrastLevel}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <Slider Minimum="-1" Maximum="1" SmallChange="0.1" LargeChange="0.25" Value="{Binding ThemeContrast}" Width="160" TickFrequency="0.1" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_ContrastLevel}"/>
                            <Grid ColumnDefinitions="*,*" Width="160">
                                <TextBlock Text="{local:Localize Custom_ContrastSofter}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{local:Localize Custom_ContrastSharper}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding ThemeContrast, StringFormat={}{0:F1}}" VerticalAlignment="Center" MinWidth="32" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- THE ROW PREVIEWS ITSELF, same reason as the preset gallery below (RemEx-lrxyo):
                     the ComboBox this replaced showed the SAME text for every entry regardless of
                     what a variant actually looked like on the user's own seed. Each strip is
                     DynamicColorGenerator.Generate run with that strip's OWN variant against the
                     live seed/mode/contrast, so a strip cannot show a colour a click would not
                     produce. -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{local:Localize Custom_Strategy}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding SchemeVariantStrips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SchemeVariantStripViewModel">
                                <Button Classes="tile" Margin="0" Padding="0" MinWidth="56"
                                        AutomationProperties.Name="{Binding DisplayName}"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[ItemsControl].((vm:CustomizationViewModel)DataContext).SelectSchemeVariantCommand}"
                                        CommandParameter="{Binding Variant}">
                                    <!-- Same shape as the preset tile: painted in the strip's OWN
                                         surface/outline/on-surface, so a variant whose own text is
                                         unreadable against its own surface looks unreadable here. -->
                                    <Border Background="{Binding SurfaceBrush}"
                                            BorderBrush="{Binding OutlineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="6,8">
                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="3" HorizontalAlignment="Center">
                                                <Border Width="14" Height="14" CornerRadius="7" Background="{Binding PrimaryBrush}"/>
                                                <Border Width="11" Height="11" CornerRadius="6" Background="{Binding SecondaryBrush}" VerticalAlignment="Center"/>
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding TertiaryBrush}" VerticalAlignment="Center"/>
                                                <!-- THE NEUTRAL CHIP IS WHAT SEPARATES TWO VARIANTS THAT SHARE ACCENTS
                                                     (review LOW, RemEx-lrxyo). Rainbow is TonalSpot with the neutral
                                                     palette's chroma taken to zero, so for a saturated seed the two
                                                     produce IDENTICAL primary/secondary/tertiary — measured on a dark
                                                     red seed, all three match exactly and the entire difference
                                                     is the neutrals. Three accent chips therefore render them
                                                     indistinguishable, and a picker whose choices look the same reads
                                                     as broken rather than as faithful. OnSurface is the neutral that
                                                     carries the difference AND is already bound here, so this needs
                                                     no new view-model surface. -->
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding OnSurfaceBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Theme="{StaticResource OverlineTextBlock}"
                                                       TextAlignment="Center" TextWrapping="Wrap"
                                                       Foreground="{Binding OnSurfaceBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ═══ Preview ═══ The tonal ramp itself, then a live sample card so the palette's
                     effect on real content — not just swatches — is visible at a glance. -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{local:Localize Custom_Preview}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Spacing="6">
                        <!-- One Grid per palette: a fixed label column plus the eleven-tone row. The
                             DataTemplate is shared by copy rather than by a resource key, matching how
                             the rest of this view templates ItemsControl rows - see the file header
                             note on Presets in the Saved palettes card for why the colours themselves
                             are never literals. -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="{local:Localize Custom_TonalRamp_Primary}" Theme="{StaticResource CaptionTextBlock}"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MinWidth="56"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding TonalRamp.PrimaryTones}"
                                          AutomationProperties.Name="{local:Localize Custom_TonalRamp_Primary}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TonalRampSwatch">
                                        <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0.5"
                                                ToolTip.Tip="{Binding Tone}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="{local:Localize Custom_TonalRamp_Secondary}" Theme="{StaticResource CaptionTextBlock}"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MinWidth="56"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding TonalRamp.SecondaryTones}"
                                          AutomationProperties.Name="{local:Localize Custom_TonalRamp_Secondary}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TonalRampSwatch">
                                        <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0.5"
                                                ToolTip.Tip="{Binding Tone}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="{local:Localize Custom_TonalRamp_Tertiary}" Theme="{StaticResource CaptionTextBlock}"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MinWidth="56"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding TonalRamp.TertiaryTones}"
                                          AutomationProperties.Name="{local:Localize Custom_TonalRamp_Tertiary}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TonalRampSwatch">
                                        <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0.5"
                                                ToolTip.Tip="{Binding Tone}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <TextBlock Text="{local:Localize Custom_TonalRamp_Neutral}" Theme="{StaticResource CaptionTextBlock}"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MinWidth="56"/>
                            <ItemsControl Grid.Column="1" ItemsSource="{Binding TonalRamp.NeutralTones}"
                                          AutomationProperties.Name="{local:Localize Custom_TonalRamp_Neutral}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TonalRampSwatch">
                                        <Border Width="20" Height="20" CornerRadius="3" Background="{Binding Brush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0.5"
                                                ToolTip.Tip="{Binding Tone}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>

                    <!-- The role pairs, shown as foreground text ON its own background rather than as
                         six isolated chips - an unreadable pair looks unreadable here, not merely
                         similar to its neighbour. -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="76" Height="44" CornerRadius="6" Background="{Binding TonalRamp.PrimaryBrush}">
                            <TextBlock Text="{local:Localize Custom_TonalRamp_PrimaryPair}" Theme="{StaticResource CaptionTextBlock}"
                                       Foreground="{Binding TonalRamp.OnPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="76" Height="44" CornerRadius="6" Background="{Binding TonalRamp.SurfaceBrush}">
                            <TextBlock Text="{local:Localize Custom_TonalRamp_SurfacePair}" Theme="{StaticResource CaptionTextBlock}"
                                       Foreground="{Binding TonalRamp.OnSurfaceBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Width="76" Height="44" CornerRadius="6" Background="{Binding TonalRamp.ErrorBrush}">
                            <TextBlock Text="{local:Localize Custom_TonalRamp_ErrorPair}" Theme="{StaticResource CaptionTextBlock}"
                                       Foreground="{Binding TonalRamp.OnErrorBrush}" TextAlignment="Center" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- The sample card: the same TonalRamp brushes applied to actual content (a
                         title, body text, a button) rather than isolated swatches — cards and text
                         will look exactly like this once Apply is pressed. -->
                    <Border Name="SampleCard" Background="{Binding TonalRamp.SurfaceBrush}" CornerRadius="{Binding SampleCardCornerRadius}" Opacity="{Binding AppWindowOpacity}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{local:Localize Custom_SampleCardTitle}" FontWeight="SemiBold" Foreground="{Binding TonalRamp.OnSurfaceBrush}"/>
                            <TextBlock Text="{local:Localize Custom_SampleCardBody}" FontSize="12" TextWrapping="Wrap" Foreground="{Binding TonalRamp.OnSurfaceBrush}"/>
                            <Border Background="{Binding TonalRamp.PrimaryBrush}" CornerRadius="{Binding SampleCardCornerRadius}" Padding="10,5" HorizontalAlignment="Left">
                                <TextBlock Text="{local:Localize Btn_Apply}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding TonalRamp.OnPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </material:Card>

        <!-- ═══ Card 2: Mode ═══ -->
        <material:Card Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{local:Localize Custom_SectionMode}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                <!-- Both settings below have been persisted and honoured for a while with no way to
                     reach them except by hand-editing the profile JSON (RemEx-5u0vy). -->
                <Grid ColumnDefinitions="*,2*">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{local:Localize Custom_BaseModeDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <!-- ITEM ORDER IS THE CONTRACT with CustomizationViewModel.ThemeModeToIndex:
                         0 Light, 1 Dark, 2 System. Reordering here silently remaps every saved
                         choice (RemEx-zk5bc). -->
                    <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeModeIndex}" HorizontalAlignment="Left" MinWidth="160" AutomationProperties.Name="{local:Localize Custom_BaseMode}" assists:ComboBoxAssist.Label="{local:Localize Custom_BaseMode}">
                        <ComboBoxItem Content="{local:Localize Custom_ModeLight}"/>
                        <ComboBoxItem Content="{local:Localize Custom_ModeDark}"/>
                        <ComboBoxItem Content="{local:Localize Custom_ModeSystem}"/>
                    </ComboBox>
                </Grid>
            </StackPanel>
        </material:Card>

        <!-- ═══ Card 3: Look ═══ -->
        <material:Card Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{local:Localize Custom_SectionLook}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                <Grid ColumnDefinitions="*,2*">
                    <ComboBox Grid.Column="1" SelectedItem="{Binding CanvasBackgroundType}" ItemsSource="{Binding AvailableBackgroundTypes}" HorizontalAlignment="Left" Width="160" AutomationProperties.Name="{local:Localize Custom_BackgroundMode}" assists:ComboBoxAssist.Label="{local:Localize Custom_BackgroundMode}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static local:PrefixedLabelConverter.Instance}" ConverterParameter="Custom_BgType_">
                                            <Binding Path="CultureTag" Source="{x:Static svc:LocalizationService.Instance}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <!-- Wallpaper mode's own controls (RemEx-ddynd): where the picture comes from, and how
                     blurred it is. Same PrefixedLabelConverter pattern as the mode picker above. -->
                <StackPanel Spacing="10" IsVisible="{Binding IsWallpaperBackgroundSelected}">
                    <Grid ColumnDefinitions="*,2*">
                        <ComboBox Grid.Column="1" SelectedItem="{Binding WallpaperSource}" ItemsSource="{Binding AvailableWallpaperSources}" HorizontalAlignment="Left" Width="160" AutomationProperties.Name="{local:Localize Custom_WallpaperSource}" assists:ComboBoxAssist.Label="{local:Localize Custom_WallpaperSource}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static local:PrefixedLabelConverter.Instance}" ConverterParameter="Custom_WallpaperSource_">
                                                <Binding Path="CultureTag" Source="{x:Static svc:LocalizationService.Instance}"/>
                                                <Binding/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Button Classes="secondary compact" Content="{local:Localize Custom_ChooseWallpaperImage}" Command="{Binding PickWallpaperImageCommand}" IsVisible="{Binding IsImageWallpaperSource}" AutomationProperties.Name="{local:Localize Custom_ChooseWallpaperImage}"/>
                    <Grid ColumnDefinitions="*,2*">
                        <TextBlock Text="{local:Localize Custom_WallpaperBlur}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.2" Value="{Binding WallpaperBlur}" Width="160" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_WallpaperBlur}"/>
                            <TextBlock Text="{Binding WallpaperBlur, StringFormat={}{0:P0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
                <Grid ColumnDefinitions="*,2*" IsVisible="{Binding IsWindowOpacityRelevant}">
                    <TextBlock Text="{local:Localize Custom_AppWindowOpacity}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Slider Minimum="0.1" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding AppWindowOpacity}" Width="160" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_AppWindowOpacity}"/>
                        <TextBlock Text="{Binding AppWindowOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </material:Card>

        <!-- ═══ Card 3.5: Flyout (Flyout D2 .2, RemEx-4kv0g.18.6) ═══ The tray popup's own opacity
             (independent of Card Opacity above - the cards keep the app's own opacity regardless of
             this slider), and which pinned cards / toolbar buttons / launcher apps the popup shows.
             TrayFlyoutViewModel rebuilds ToolbarItems/FlyoutSensors from the same
             CustomizationSettings fields this section writes (FlyoutOpacity/FlyoutHiddenSensorIds/
             FlyoutHiddenTileIds/FlyoutAppIds). No inline FontSize below except the section header,
             matching its six siblings (TypographyVocabularyTests) - the small end-of-slider labels
             and item labels use Theme="{StaticResource CaptionTextBlock}" instead of an inline size
             the way the older sections on this page do. -->
        <material:Card Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{local:Localize Custom_SectionFlyout}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_FlyoutOpacityTooltip}">
                    <TextBlock Text="{local:Localize Custom_FlyoutOpacity}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Slider Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding FlyoutOpacity}" Width="160" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Custom_FlyoutOpacityTooltip}" AutomationProperties.Name="{local:Localize Custom_FlyoutOpacity}"/>
                            <TextBlock Text="{Binding FlyoutOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Text="{local:Localize Custom_Clear}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="{local:Localize Custom_Frosted}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="{local:Localize Custom_FlyoutCards}" Theme="{StaticResource CaptionTextBlock}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding FlyoutCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FlyoutCardChoice">
                                <CheckBox IsChecked="{Binding IsShown}" AutomationProperties.Name="{Binding DisplayName}" ToolTip.Tip="{Binding DisplayName}">
                                    <TextBlock Text="{Binding DisplayName}" Theme="{StaticResource CaptionTextBlock}" VerticalAlignment="Center"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{local:Localize Custom_FlyoutCards_NoPins}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !FlyoutCards.Count}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{local:Localize Custom_FlyoutButtons}" Theme="{StaticResource CaptionTextBlock}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding FlyoutTiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FlyoutTileChoice">
                                <CheckBox IsChecked="{Binding IsShown}" AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding Label}">
                                    <TextBlock Text="{Binding Label}" Theme="{StaticResource CaptionTextBlock}" VerticalAlignment="Center"/>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="{local:Localize Custom_FlyoutApps}" Theme="{StaticResource CaptionTextBlock}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding FlyoutApps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:FlyoutAppChoice">
                                <CheckBox IsChecked="{Binding IsShown}" AutomationProperties.Name="{Binding DisplayName}" ToolTip.Tip="{Binding DisplayName}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Image Width="24" Height="24" Source="{Binding IconBase64, Converter={x:Static local:Base64ToImageConverter.Instance}}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                                        <TextBlock Text="{Binding DisplayName}" Theme="{StaticResource CaptionTextBlock}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{local:Localize Custom_FlyoutApps_None}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !FlyoutApps.Count}"/>
                </StackPanel>
            </StackPanel>
        </material:Card>

        <!-- ═══ Card 4: Text (RemEx-jt6w5) ═══ Readability first: per-section size and bold, the
             legibility halo, and the sensor-title backdrop. Sits ABOVE Advanced fine-tuning on
             purpose — this is the control a person reaches for when text is hard to read, not an
             override. Every value applies live (ApplyAndSave → ThemeService → TypographyService) and
             persists with the rest of Personalize; the sheet is made of these roles, so it previews
             itself. The only inline FontSize is the section header, matching its siblings — the
             ratchet in TypographyVocabularyTests only goes down. -->
        <material:Card Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{local:Localize Custom_SectionText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                <!-- ColumnDefinitions="Auto,*,Auto,Auto": label, slider (fills remaining width), value
                     label, Bold switch (no On/Off content — the sheet is too narrow for it; the
                     accessible name below carries the label a sighted user gets from the content). -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{local:Localize Custom_TextHeadersTip}">
                    <TextBlock Text="{local:Localize Custom_TextHeaders}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Column="1" Value="{Binding HeadersScale}" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextHeaders}"/>
                    <TextBlock Grid.Column="2" Text="{Binding HeadersSizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="48" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{local:Localize Custom_TextSizeLabelTip}"/>
                    <ToggleSwitch Grid.Column="3" IsChecked="{Binding HeadersBold}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextHeadersBold}"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{local:Localize Custom_TextBodyTip}">
                    <TextBlock Text="{local:Localize Custom_TextBody}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Column="1" Value="{Binding BodyScale}" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextBody}"/>
                    <TextBlock Grid.Column="2" Text="{Binding BodySizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="48" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{local:Localize Custom_TextSizeLabelTip}"/>
                    <ToggleSwitch Grid.Column="3" IsChecked="{Binding BodyBold}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextBodyBold}"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{local:Localize Custom_TextSmallTip}">
                    <TextBlock Text="{local:Localize Custom_TextSmall}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Column="1" Value="{Binding SmallScale}" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextSmall}"/>
                    <TextBlock Grid.Column="2" Text="{Binding SmallSizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="48" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{local:Localize Custom_TextSizeLabelTip}"/>
                    <ToggleSwitch Grid.Column="3" IsChecked="{Binding SmallBold}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextSmallBold}"/>
                </Grid>

                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ToolTip.Tip="{local:Localize Custom_TextSensorTip}">
                    <TextBlock Text="{local:Localize Custom_TextSensor}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider Minimum="0.8" Maximum="1.6" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True" Grid.Column="1" Value="{Binding SensorScale}" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextSensor}"/>
                    <TextBlock Grid.Column="2" Text="{Binding SensorSizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="48" Margin="12,0" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip.Tip="{local:Localize Custom_TextSizeLabelTip}"/>
                    <ToggleSwitch Grid.Column="3" IsChecked="{Binding SensorBold}" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextSensorBold}"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{local:Localize Custom_TextSensorBackdropTip}">
                    <TextBlock Text="{local:Localize Custom_TextSensorBackdrop}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding SensorTitleBackdrop}" OnContent="{local:Localize Common_On}" OffContent="{local:Localize Common_Off}" HorizontalAlignment="Right" AutomationProperties.Name="{local:Localize Custom_TextSensorBackdrop}"/>
                </Grid>

                <Separator Background="{DynamicResource CardBorderBrush}" Opacity="0.3"/>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_TextShadowTip}">
                    <TextBlock Text="{local:Localize Custom_TextShadow}" VerticalAlignment="Center"/>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding TextShadowEnabled}" OnContent="{local:Localize Common_On}" OffContent="{local:Localize Common_Off}" HorizontalAlignment="Left" AutomationProperties.Name="{local:Localize Custom_TextShadow}"/>
                </Grid>
                <Grid ColumnDefinitions="*,2*" IsEnabled="{Binding TextShadowEnabled}">
                    <TextBlock Text="{local:Localize Custom_TextShadowStrength}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" TickFrequency="10" Value="{Binding TextShadowStrength}" Width="160" TickPlacement="BottomRight" VerticalAlignment="Center" AutomationProperties.Name="{local:Localize Custom_TextShadowStrength}"/>
                        <TextBlock Text="{Binding TextShadowStrength, StringFormat={}{0:F0}}" VerticalAlignment="Center" MinWidth="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Button Classes="tertiary" Content="{local:Localize Custom_TextReset}" Command="{Binding ResetTextToDefaultsCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{local:Localize Custom_TextReset}"/>
            </StackPanel>
        </material:Card>

        <!-- ═══ Section 4: Fine-tuning ═══ Geometry and typography, folded into an expander rather
             than a card — these are overrides most people never open, not a daily-use section. -->
        <Expander Header="{local:Localize Custom_AdvancedTuning}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="20" Margin="0,12,0,0">
                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_CornerRadiusGeneralTooltip}">
                    <TextBlock Text="{local:Localize Custom_CornerRadius}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <Slider Minimum="0" Maximum="32" SmallChange="1" LargeChange="4" Value="{Binding CornerRadius}" Width="160" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Custom_BorderCornerRadiusPixelsTooltip}" AutomationProperties.Name="{local:Localize Custom_CornerRadius}"/>
                            <Grid ColumnDefinitions="*,*" Width="160">
                                <TextBlock Text="{local:Localize Custom_Square}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{local:Localize Custom_Round}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding CornerRadius, StringFormat={}{0:F0}px}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_GlassOpacityTooltip}">
                    <TextBlock Text="{local:Localize Custom_GlassOpacity}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <Slider Minimum="0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding GlassOpacity}" Width="160" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Custom_GlassFrostingOpacityPercentTooltip}" AutomationProperties.Name="{local:Localize Custom_GlassOpacity}"/>
                            <Grid ColumnDefinitions="*,*" Width="160">
                                <TextBlock Text="{local:Localize Custom_Clear}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{local:Localize Custom_Frosted}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding GlassOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_NeonGlowTooltip}">
                    <TextBlock Text="{local:Localize Custom_GlowStrength}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <Slider Minimum="0" Maximum="30" SmallChange="1" LargeChange="5" Value="{Binding GlowStrength}" Width="160" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Custom_NeonGlowThicknessPixelsTooltip}" AutomationProperties.Name="{local:Localize Custom_GlowStrength}"/>
                            <Grid ColumnDefinitions="*,*" Width="160">
                                <TextBlock Text="{local:Localize Custom_GlowNone}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{local:Localize Custom_GlowIntense}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding GlowStrength, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource CardBorderBrush}" Opacity="0.3"/>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_PageTitleFontTip}">
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedPageTitleFont}" HorizontalAlignment="Left" Width="200" MaxDropDownHeight="340" AutomationProperties.Name="{local:Localize Custom_PageTitleFont}" assists:ComboBoxAssist.Label="{local:Localize Custom_PageTitleFont}"/>
                </Grid>
                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_ContentFontTip}">
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedBodyFont}" HorizontalAlignment="Left" Width="200" MaxDropDownHeight="340" AutomationProperties.Name="{local:Localize Custom_ContentFont}" assists:ComboBoxAssist.Label="{local:Localize Custom_ContentFont}"/>
                </Grid>
                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_UiScaleTip}">
                    <TextBlock Text="{local:Localize Custom_UiScale}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                        <Slider Minimum="0.85" Maximum="1.3" SmallChange="0.05" LargeChange="0.1" Value="{Binding UiScale}" Width="168" VerticalAlignment="Center" TickFrequency="0.05" TickPlacement="BottomRight" IsSnapToTickEnabled="True" AutomationProperties.Name="{local:Localize Custom_UiScale}"/>
                        <TextBlock Text="{Binding UiScale, StringFormat={}{0:P0}}" VerticalAlignment="Center" MinWidth="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Shown only when a chosen font can't be loaded on this machine; the app falls back safely. -->
                <!-- Warning colours come from the theme, not literals: the amber pair below was
                     mixed for a dark glass background and washes out on SolarFlare, whose surface
                     is near-white. Both keys exist in all four themes (RemEx-fy0a). -->
                <Border Background="{DynamicResource SystemWarningBackgroundBrush}" BorderBrush="{DynamicResource SystemWarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" IsVisible="{Binding HasFontWarning}">
                    <TextBlock Text="{Binding FontWarning}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Expander>

        <!-- ═══ Card 5: Behaviour ═══ -->
        <material:Card Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{local:Localize Custom_SectionBehaviour}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_WelcomeSplashTooltip}">
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <ComboBox SelectedItem="{Binding SplashStyle}" ItemsSource="{Binding AvailableSplashStyles}" HorizontalAlignment="Left" Width="160" AutomationProperties.Name="{local:Localize Custom_SplashScreen}" assists:ComboBoxAssist.Label="{local:Localize Custom_SplashScreen}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <TextBlock Text="{Binding Converter={x:Static local:SplashStyleLabelConverter.Instance}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="tertiary compact" Content="{local:Localize Custom_Preview}" Command="{Binding PreviewSplashCommand}" AutomationProperties.Name="{local:Localize Custom_Preview}"/>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource CardBorderBrush}" Opacity="0.3"/>

                <!-- Reduced Motion -->
                <Grid ColumnDefinitions="*,2*">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{local:Localize Custom_ReducedMotionTitle}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{local:Localize Custom_ReducedMotionDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:Localize Custom_ReducedMotionTitle}" Grid.Column="1" IsChecked="{Binding IsReducedMotion}" OnContent="{local:Localize Common_On}" OffContent="{local:Localize Common_Off}" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
        </material:Card>

        <!-- ═══ Card 6: Saved palettes ═══ -->
        <material:Card Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{local:Localize Custom_SectionSavedPalettes}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                <!-- THE GALLERY PREVIEWS ITSELF (RemEx-2gjwn). This was five hand-authored tiles whose
                     swatch colours were literals - #050505 and #00F3FF for CyberNOC, and so on - copied
                     from resource dictionaries that no longer exist. Every colour below now comes out of
                     DynamicColorGenerator run on the preset's own seed and variant, which is the same call
                     clicking the tile makes, so a tile cannot show a colour the app will not paint.

                     THREE COLUMNS, NOT FIVE, AND THAT IS A MEASUREMENT. This panel is hosted in the
                     Personalize drawer at roughly 300px. Five columns was already tight for four presets
                     and a Dynamic tile; the catalog ships eight, and at five columns each tile is ~52px -
                     narrower than the word "Daybreak" at any legible size. Three gives ~92px and three
                     rows, which the drawer scrolls. -->
                <TextBlock Text="{local:Localize Custom_BuiltInPresets}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource TextMutedBrush}"/>
                <ItemsControl ItemsSource="{Binding ThemePresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SeedPresetTileViewModel">
                            <Button Classes="tile" Margin="4" Padding="0"
                                    AutomationProperties.Name="{Binding DisplayName}"
                                    Classes.selected="{Binding IsSelected}"
                                    Command="{Binding $parent[ItemsControl].((vm:CustomizationViewModel)DataContext).SelectThemeCommand}"
                                    CommandParameter="{Binding Id}">
                                <!-- The card is painted in the preset's OWN surface/outline, and the label in
                                     its OWN on-surface, so the tile doubles as the contrast check: a preset
                                     whose text is unreadable against its surface looks unreadable here. -->
                                <Border Background="{Binding SurfaceBrush}"
                                        BorderBrush="{Binding OutlineBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{Binding PreviewCornerRadius}"
                                        Padding="6,8">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                            <Border Width="14" Height="14" CornerRadius="7" Background="{Binding PrimaryBrush}"/>
                                            <Border Width="11" Height="11" CornerRadius="6" Background="{Binding SecondaryBrush}" VerticalAlignment="Center"/>
                                            <Border Width="8" Height="8" CornerRadius="4" Background="{Binding TertiaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="Bold"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{Binding OnSurfaceBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The person's own palettes (RemEx-ddynd, spec section 7): whole recipes, painted like the
                     presets above from their OWN seed and strategy. Presets have no delete; these do. -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{local:Localize Custom_UserPalettes}" Theme="{StaticResource CaptionTextBlock}" Foreground="{DynamicResource TextMutedBrush}"/>
                    <ItemsControl ItemsSource="{Binding SavedPalettes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SavedPaletteTileViewModel">
                                <Border Margin="4" Background="{Binding SurfaceBrush}" BorderBrush="{Binding OutlineBrush}" BorderThickness="1" CornerRadius="8" Padding="6,8">
                                    <StackPanel Spacing="6">
                                        <Button Classes="tile" Padding="0" Background="Transparent"
                                                AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding $parent[ItemsControl].((vm:CustomizationViewModel)DataContext).ApplySavedPaletteCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                <Border Width="14" Height="14" CornerRadius="7" Background="{Binding PrimaryBrush}"/>
                                                <Border Width="11" Height="11" CornerRadius="6" Background="{Binding SecondaryBrush}" VerticalAlignment="Center"/>
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding TertiaryBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBox Text="{Binding Name, Mode=TwoWay}" FontWeight="Bold" TextAlignment="Center"
                                                 Foreground="{Binding OnSurfaceBrush}"
                                                 AutomationProperties.Name="{local:Localize Custom_PaletteNamePlaceholder}"
                                                 Classes="outline" UseFloatingPlaceholder="True"
                                                 assists:TextFieldAssist.Label="{local:Localize Custom_PaletteNamePlaceholder}"/>
                                        <Button Classes="tertiary danger icon-button compact" HorizontalAlignment="Center"
                                                ToolTip.Tip="{local:Localize Custom_DeletePalette}" AutomationProperties.Name="{local:Localize Custom_DeletePalette}"
                                                Command="{Binding $parent[ItemsControl].((vm:CustomizationViewModel)DataContext).DeleteSavedPaletteCommand}"
                                                CommandParameter="{Binding}">
                                            <mi:MaterialIcon Kind="Close" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding NewPaletteName, Mode=TwoWay}" PlaceholderText="{local:Localize Custom_PaletteNamePlaceholder}" AutomationProperties.Name="{local:Localize Custom_PaletteNamePlaceholder}" Classes="outline" UseFloatingPlaceholder="True" assists:TextFieldAssist.Label="{local:Localize Custom_PaletteNamePlaceholder}"/>
                        <Button Grid.Column="1" Classes="secondary compact" Content="{local:Localize Custom_SavePalette}" Command="{Binding SaveCurrentPaletteCommand}" AutomationProperties.Name="{local:Localize Custom_SavePalette}"/>
                    </Grid>
                </StackPanel>

                <!-- Share palette (RemEx-a7uzb): copy the live palette as a compilable Avalonia
                     ResourceDictionary, or export/import its recipe as JSON so a palette can travel
                     to a future session or hand off to the phone. WrapPanel because the card is
                     ~300px wide and three buttons do not fit one row. Copy as AXAML is a shipped
                     RemEx-a7uzb feature the spec does not retire; Import and Export are the spec's. -->
                <WrapPanel ItemSpacing="8" LineSpacing="8">
                    <Button Classes="secondary compact" Content="{local:Localize Custom_CopyPaletteAxaml}" Command="{Binding CopyPaletteAsAxamlCommand}" AutomationProperties.Name="{local:Localize Custom_CopyPaletteAxaml}"/>
                    <Button Classes="secondary compact" Content="{local:Localize Custom_ExportPaletteJson}" Command="{Binding ExportPaletteJsonCommand}" AutomationProperties.Name="{local:Localize Custom_ExportPaletteJson}"/>
                    <Button Classes="secondary compact" Content="{local:Localize Custom_ImportPaletteJson}" Command="{Binding ImportPaletteJsonCommand}" AutomationProperties.Name="{local:Localize Custom_ImportPaletteJson}"/>
                </WrapPanel>
            </StackPanel>
        </material:Card>

        <!-- Foreground=TextMutedBrush is deliberate: a de-emphasized reset link, quieter than the
             .tertiary default TextSecondaryBrush (RemEx-cgrv3). -->
        <Button Classes="tertiary" Content="{local:Localize Custom_Reset}" Command="{Binding ResetToDefaultCommand}" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>

    </StackPanel>
</UserControl>
