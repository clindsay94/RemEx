<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    xmlns:personalize="using:Remex.Desktop.Views.Personalize"
    x:Class="Remex.Desktop.Views.PersonalizationPanelView" x:DataType="vm:CustomizationViewModel">

    <UserControl.Styles>
        <!-- Tab header text sits at the LEFT of its tab, not centred (RemEx-vkkcq fix round 1,
             Connor's ask). Two setters because Material centres the header twice: MaterialTabItem
             sets HorizontalContentAlignment=Center on the TabItem AND, in a template style,
             HorizontalAlignment=Center on PART_ContentPresenter itself - so the presenter shrinks
             to its text and floats in the middle of the 90px MinWidth slot, and the content
             alignment alone moves nothing. The /template/ form is an alignment setter, not a
             template override (FocusVisibleStyleGuardTests.NoViewReplacesTheTabItemTemplate...),
             and it matches only the TabItem's own presenter, not the RippleEffect's inner one,
             whose TemplatedParent is the ripple. App.axaml's Padding="16,0" inset still applies,
             so the text starts 16px in from the tab's left edge. MinWidth is untouched. -->
        <Style Selector="TabItem">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style Selector="TabItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Styles>

    <!-- Personalize as five tabs (RemEx-4kv0g.4.3, spec §1/§2): the strip stays pinned at the top of
         the sheet and never scrolls - each tab owns its own ScrollViewer, so the height bound that
         used to sit on ShellView's ScrollViewer now sits on this whole control (see ShellView.axaml
         and docs/REGRESSION-GUARDS.md).

         Root is a Grid RowDefinitions="*,Auto", not a StackPanel: a vertical StackPanel measures
         every child with infinite available height regardless of what height the StackPanel itself
         was given - the exact bug ShellView's old ScrollViewer.MaxHeight comment documents, one level
         up. The star row hands the MaxHeight ShellView binds onto this control straight to the
         TabControl, so its selected tab's own ScrollViewer scrolls instead of the whole sheet running
         off the window; the Auto row below it sizes to the Reset footer's own height and takes
         nothing from the star row's budget. SelectedTabIndex is remembered for the run
         (CustomizationViewModel), not persisted. -->
    <Grid RowDefinitions="*,Auto">
        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" VerticalAlignment="Stretch">
            <TabItem Header="{local:Localize Custom_Tab_Colour}">
                <personalize:PersonalizeColourTab/>
            </TabItem>
            <TabItem Header="{local:Localize Custom_Tab_Palettes}">
                <personalize:PersonalizePalettesTab/>
            </TabItem>
            <TabItem Header="{local:Localize Custom_Tab_Surfaces}">
                <personalize:PersonalizeSurfacesTab/>
            </TabItem>
            <TabItem Header="{local:Localize Custom_Tab_Text}">
                <personalize:PersonalizeTextTab/>
            </TabItem>
            <TabItem Header="{local:Localize Custom_Tab_Layout}">
                <personalize:PersonalizeLayoutTab/>
            </TabItem>
        </TabControl>

        <!-- Foreground=TextMutedBrush is deliberate: a de-emphasized reset link, quieter than the
             .tertiary default TextSecondaryBrush (RemEx-cgrv3). Global reset for the whole sheet, not
             just one tab's content - moved here from the Palettes tab (RemEx-4kv0g.4.3 fix round 1) so
             it is reachable from every tab instead of undiscoverable from the other four. -->
        <Button Grid.Row="1" Classes="tertiary" Content="{local:Localize Custom_Reset}" Command="{Binding ResetToDefaultCommand}"
                HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
