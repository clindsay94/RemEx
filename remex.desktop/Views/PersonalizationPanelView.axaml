<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:models="using:Remex.Desktop.Models"
    xmlns:local="clr-namespace:Remex.Desktop.Converters" xmlns:svc="using:Remex.Desktop.Services"
    x:Class="Remex.Desktop.Views.PersonalizationPanelView" x:DataType="vm:CustomizationViewModel">

    <UserControl.Styles>
        <Style Selector="Button.accent-picker">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.accent-picker:pointerover">
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="20">

        <!-- ═══ Section 1: Presets ═══ -->
        <TextBlock Text="{local:Localize Custom_BasePresets}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
        <UniformGrid Columns="5">
            <!-- Dynamic -->
            <Button AutomationProperties.Name="{local:Localize Custom_PresetDynamic}" Classes="theme-tile" Margin="4" Padding="12" Command="{Binding SelectThemeCommand}" CommandParameter="Dynamic" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=Dynamic}">
                <StackPanel Spacing="8">
                    <Border Height="36" CornerRadius="18" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#6C4CFF" />
                                <GradientStop Offset="0.5" Color="#00F3FF" />
                                <GradientStop Offset="1" Color="#FF00FF" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <TextBlock Text="{local:Localize Custom_PresetDynamic}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>
            <!-- Base Dark Glass -->
            <Button AutomationProperties.Name="{local:Localize Custom_PresetStandardGlass}" Classes="theme-tile" Margin="4" Padding="12" Command="{Binding SelectThemeCommand}" CommandParameter="BaseDarkGlass" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=BaseDarkGlass}">
                <StackPanel Spacing="8">
                    <Border Height="36" Background="#1AFFFFFF" CornerRadius="8" BorderBrush="#2AFFFFFF" BorderThickness="1"/>
                    <TextBlock Text="{local:Localize Custom_PresetStandardGlass}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>
            <!-- Cyber-NOC -->
            <Button AutomationProperties.Name="{local:Localize Custom_PresetCyberNOC}" Classes="theme-tile" Margin="4" Padding="12" Command="{Binding SelectThemeCommand}" CommandParameter="CyberNOC" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=CyberNOC}">
                <StackPanel Spacing="8">
                    <Border Height="36" Background="#050505" CornerRadius="2" BorderBrush="#00F3FF" BorderThickness="1"/>
                    <TextBlock Text="{local:Localize Custom_PresetCyberNOC}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>
            <!-- Solar-Flare -->
            <Button AutomationProperties.Name="{local:Localize Custom_PresetSolarFlare}" Classes="theme-tile" Margin="4" Padding="12" Command="{Binding SelectThemeCommand}" CommandParameter="SolarFlare" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=SolarFlare}">
                <StackPanel Spacing="8">
                    <Border Height="36" Background="#CCFFFFFF" CornerRadius="12" BorderBrush="#FFB800" BorderThickness="1"/>
                    <TextBlock Text="{local:Localize Custom_PresetSolarFlare}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>
            <!-- Monolith -->
            <Button AutomationProperties.Name="{local:Localize Custom_PresetMonolith}" Classes="theme-tile" Margin="4" Padding="12" Command="{Binding SelectThemeCommand}" CommandParameter="Monolith" Classes.selected="{Binding SelectedThemePreset, Converter={x:Static local:StringMatchConverter.EqualsParameter}, ConverterParameter=Monolith}">
                <StackPanel Spacing="8">
                    <Border Height="36" Background="#2C2C2E" CornerRadius="4" BorderBrush="#444" BorderThickness="3"/>
                    <TextBlock Text="{local:Localize Custom_PresetMonolith}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- ═══ Section 2: Advanced Overrides ═══ -->
        <Border Classes="glass-card" Padding="20">
            <StackPanel Spacing="20">
                <TextBlock Text="{local:Localize Custom_AdvancedTuning}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_CornerRadiusGeneralTooltip}">
                    <TextBlock Text="{local:Localize Custom_CornerRadius}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <Slider Minimum="0" Maximum="32" Value="{Binding CornerRadius}" Width="160" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Custom_BorderCornerRadiusPixelsTooltip}"/>
                            <Grid ColumnDefinitions="*,*" Width="160">
                                <TextBlock Text="{local:Localize Custom_Square}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{local:Localize Custom_Round}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding CornerRadius, StringFormat={}{0:F0}px}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_GlassOpacityTooltip}">
                    <TextBlock Text="{local:Localize Custom_GlassOpacity}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <Slider Minimum="0.01" Maximum="1.0" Value="{Binding GlassOpacity}" Width="160" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Custom_GlassFrostingOpacityPercentTooltip}"/>
                            <Grid ColumnDefinitions="*,*" Width="160">
                                <TextBlock Text="{local:Localize Custom_Clear}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{local:Localize Custom_Frosted}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding GlassOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_NeonGlowTooltip}">
                    <TextBlock Text="{local:Localize Custom_GlowStrength}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <Slider Minimum="0" Maximum="30" Value="{Binding GlowStrength}" Width="160" VerticalAlignment="Center" ToolTip.Tip="{local:Localize Custom_NeonGlowThicknessPixelsTooltip}"/>
                            <Grid ColumnDefinitions="*,*" Width="160">
                                <TextBlock Text="{local:Localize Custom_GlowNone}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{local:Localize Custom_GlowIntense}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="{Binding GlowStrength, StringFormat={}{0:F0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource CardBorderBrush}" Opacity="0.3"/>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_SelectColorPaletteTooltip}">
                    <TextBlock Text="{local:Localize Custom_AccentColor}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent-picker" Background="#6C4CFF" Command="{Binding SetAccentCommand}" CommandParameter="#6C4CFF" ToolTip.Tip="{local:Localize Custom_SelectNeonVioletTooltip}" AutomationProperties.Name="{local:Localize Custom_SelectNeonVioletTooltip}"/>
                        <Button Classes="accent-picker" Background="#00F3FF" Command="{Binding SetAccentCommand}" CommandParameter="#00F3FF" ToolTip.Tip="{local:Localize Custom_SelectCyberCyanTooltip}" AutomationProperties.Name="{local:Localize Custom_SelectCyberCyanTooltip}"/>
                        <Button Classes="accent-picker" Background="#FF00FF" Command="{Binding SetAccentCommand}" CommandParameter="#FF00FF" ToolTip.Tip="{local:Localize Custom_SelectHotPinkTooltip}" AutomationProperties.Name="{local:Localize Custom_SelectHotPinkTooltip}"/>
                        <Button Classes="accent-picker" Background="#FFB800" Command="{Binding SetAccentCommand}" CommandParameter="#FFB800" ToolTip.Tip="{local:Localize Custom_SelectSolarGoldTooltip}" AutomationProperties.Name="{local:Localize Custom_SelectSolarGoldTooltip}"/>
                        <Button Classes="accent-picker" Background="#22C55E" Command="{Binding SetAccentCommand}" CommandParameter="#22C55E" ToolTip.Tip="{local:Localize Custom_SelectEmeraldGreenTooltip}" AutomationProperties.Name="{local:Localize Custom_SelectEmeraldGreenTooltip}"/>
                        <Button Classes="accent-picker" Background="#F43F5E" Command="{Binding SetAccentCommand}" CommandParameter="#F43F5E" ToolTip.Tip="{local:Localize Custom_SelectCrimsonRoseTooltip}" AutomationProperties.Name="{local:Localize Custom_SelectCrimsonRoseTooltip}"/>

                        <ItemsControl ItemsSource="{Binding CustomAccentColors}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Classes="accent-picker" Background="{Binding}" AutomationProperties.Name="{Binding}" Command="{Binding $parent[UserControl].DataContext.SetAccentCommand}" CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Width="24" Height="24" CornerRadius="12" Padding="0" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource TextMutedBrush}" FontSize="14" Content="+" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding OpenCustomAccentPickerCommand}" ToolTip.Tip="{local:Localize Custom_AddCustomColorTooltip}">
                            <Button.Flyout>
                                <Flyout IsOpen="{Binding IsCustomAccentPickerOpen}" Placement="Bottom">
                                    <StackPanel Spacing="8" Width="180" Margin="4">
                                        <TextBlock Text="{local:Localize Custom_CustomAccentColorTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBox Text="{Binding CustomAccentHex}" Watermark="#RRGGBB" FontFamily="Consolas, monospace" FontSize="12" MaxLength="9" Background="{DynamicResource GlassBaseDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource CardBorderBrush}" CornerRadius="6" Padding="8,5"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                            <Button Content="{local:Localize Btn_Cancel}" Command="{Binding CloseCustomAccentPickerCommand}" Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" Padding="8,4" FontSize="12" CornerRadius="6"/>
                                            <Button Content="{local:Localize Btn_Apply}" Command="{Binding ConfirmCustomAccentCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="8,4" FontSize="12" FontWeight="SemiBold" CornerRadius="6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ Section 3: Atmosphere ═══ -->
        <Border Classes="glass-card" Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{local:Localize Custom_Atmosphere}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                <Grid ColumnDefinitions="*,2*">
                    <TextBlock Text="{local:Localize Custom_BackgroundMode}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding CanvasBackgroundType}" ItemsSource="{Binding AvailableBackgroundTypes}" HorizontalAlignment="Left" Width="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static local:PrefixedLabelConverter.Instance}" ConverterParameter="Custom_BgType_">
                                            <Binding Path="CultureTag" Source="{x:Static svc:LocalizationService.Instance}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,2*" IsVisible="{Binding IsGlassModeSelected}">
                    <TextBlock Text="{local:Localize Custom_AppWindowOpacity}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Slider Minimum="0.1" Maximum="1.0" Value="{Binding AppWindowOpacity}" Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AppWindowOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,2*">
                    <TextBlock Text="{local:Localize Custom_SchemeVariant}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding SchemeVariant}" ItemsSource="{Binding AvailableSchemeVariants}" HorizontalAlignment="Left" Width="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{x:Static local:PrefixedLabelConverter.Instance}" ConverterParameter="Custom_Scheme_">
                                            <Binding Path="CultureTag" Source="{x:Static svc:LocalizationService.Instance}"/>
                                            <Binding/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_WelcomeSplashTooltip}">
                    <TextBlock Text="{local:Localize Custom_SplashScreen}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" SelectedItem="{Binding SplashStyle}" ItemsSource="{Binding AvailableSplashStyles}" HorizontalAlignment="Left" Width="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock Text="{Binding Converter={x:Static local:SplashStyleLabelConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Separator Background="{DynamicResource CardBorderBrush}" Opacity="0.3"/>

                <!-- Hardware Sync -->
                <Grid ColumnDefinitions="*,2*">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{local:Localize Custom_HardwareSyncTitle}" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="{local:Localize Custom_HardwareSyncDesc}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch AutomationProperties.Name="{local:Localize Custom_HardwareSyncTitle}" Grid.Column="1" IsChecked="{Binding SyncWithHardware}" OnContent="{local:Localize Common_On}" OffContent="{local:Localize Common_Off}" HorizontalAlignment="Left"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ Section 4: Typography ═══ -->
        <Border Classes="glass-card" Padding="20">
            <StackPanel Spacing="16">
                <TextBlock Text="{local:Localize Custom_Typography}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_PageTitleFontTip}">
                    <TextBlock Text="{local:Localize Custom_PageTitleFont}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedPageTitleFont}" HorizontalAlignment="Left" Width="200" MaxDropDownHeight="340"/>
                </Grid>
                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_ContentFontTip}">
                    <TextBlock Text="{local:Localize Custom_ContentFont}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding SelectedBodyFont}" HorizontalAlignment="Left" Width="200" MaxDropDownHeight="340"/>
                </Grid>
                <Grid ColumnDefinitions="*,2*" ToolTip.Tip="{local:Localize Custom_UiScaleTip}">
                    <TextBlock Text="{local:Localize Custom_UiScale}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                        <Slider Minimum="0.85" Maximum="1.3" Value="{Binding UiScale}" Width="168" VerticalAlignment="Center" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                        <TextBlock Text="{Binding UiScale, StringFormat={}{0:P0}}" VerticalAlignment="Center" MinWidth="42" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- Shown only when a chosen font can't be loaded on this machine; the app falls back safely. -->
                <Border Background="#22F59E0B" BorderBrush="#55F59E0B" BorderThickness="1" CornerRadius="8" Padding="12,8" IsVisible="{Binding HasFontWarning}">
                    <TextBlock Text="{Binding FontWarning}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Border>

        <Button Content="{local:Localize Custom_Reset}" Command="{Binding ResetToDefaultCommand}" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>

    </StackPanel>
</UserControl>
