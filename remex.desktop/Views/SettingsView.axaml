<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Remex.Desktop.ViewModels"
    xmlns:conv="using:Remex.Desktop.Converters"
    xmlns:local="clr-namespace:Remex.Desktop.Converters"
    xmlns:views="using:Remex.Desktop.Views"
    xmlns:coreModels="using:Remex.Core.Models" x:Class="Remex.Desktop.Views.SettingsView" x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.settings-back">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.settings-back:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>
        <Style Selector="Button.settings-back:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- Modern TextBox styling -->
        <Style Selector="TextBox.modern">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.modern:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource GlassBaseMediumBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="Transparent" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="page-content" Margin="40" Spacing="32">

            <!-- ═══ Header ═══ -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="settings-back" Content="{local:Localize Settings_Back}" Command="{Binding NavigateBackCommand}" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Classes="page-title" Text="{local:Localize Settings_Header}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SavedStatus}" FontSize="13" Foreground="{DynamicResource SystemSuccessBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <Button Content="{local:Localize Settings_SaveChanges}" Command="{Binding SaveCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="20,10" CornerRadius="10" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- ═══ RESPONSIVE TWO-COLUMN CONTENT ═══ -->
            <WrapPanel x:Name="SettingsCards" Margin="0,10,0,0" HorizontalAlignment="Stretch">

                <!-- LEFT COLUMN -->
                <StackPanel Width="{Binding #SettingsCards.Bounds.Width, Converter={x:Static local:ResponsiveColumnWidthConverter.Instance}}" Spacing="24" Margin="0,0,24,16">

                    <!-- ═══ Connection Section ═══ -->
                    <Border Classes="glass-card" Padding="24">
                        <StackPanel Spacing="20">
                            <TextBlock Text="{local:Localize Settings_Connection}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                            <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Ellipse AutomationProperties.Name="{Binding Connection.ConnectionStatusAccessibleName}" Width="12" Height="12" VerticalAlignment="Center" Classes="status-dot" Classes.connected="{Binding Connection.IsConnected}">
                                        </Ellipse>
                                        <TextBlock Text="{Binding Connection.StatusText}" FontSize="16" FontWeight="Black" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HostRuntimeText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" IsVisible="{Binding Connection.IsConnected}"/>
                                    <TextBlock Text="{Binding HostCapabilityText}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" IsVisible="{Binding Connection.IsConnected}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Spacing="8" ToolTip.Tip="{local:Localize Settings_ConfigureHostAddressTooltip}">
                                <TextBlock Text="{local:Localize Settings_HostAddress}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Text="{Binding HostAddress}" Watermark="wss://host:port/ws" FontFamily="Consolas" Classes="modern" ToolTip.Tip="{local:Localize Settings_InputConnectionUrlTooltip}"/>
                                    <Button Grid.Column="1" Content="{local:Localize Btn_Discover}" Command="{Binding DiscoverHostCommand}" IsEnabled="{Binding !IsDiscovering}" Background="{DynamicResource CardBackgroundBrush}" Padding="14,10" CornerRadius="8" Margin="8,0,0,0" Cursor="Hand" ToolTip.Tip="{local:Localize Settings_DiscoverHostsTooltip}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="{local:Localize Settings_SaveReconnect}" Command="{Binding SaveAndReconnectCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="18,10" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{local:Localize Tooltip_SaveReconnect}"/>
                                <Button Content="{local:Localize Btn_Disconnect}" Command="{Binding Connection.DisconnectCommand}" IsVisible="{Binding Connection.IsConnected}" Background="Transparent" Foreground="{DynamicResource SystemErrorBrush}" BorderBrush="{DynamicResource SystemErrorBrush}" BorderThickness="1" Padding="18,10" CornerRadius="8" Cursor="Hand" ToolTip.Tip="{local:Localize Settings_DisconnectTooltip}"/>
                                <Button Content="{local:Localize Home_QrCodeButton}"
                                        Command="{Binding Connection.GenerateQrCodeCommand}"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Padding="18,10" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand"
                                        ToolTip.Tip="{local:Localize Home_QrCodeTooltip}"/>
                                <Button Content="{local:Localize Settings_ShowPairingPin}"
                                        Command="{Binding Connection.RevealPairingPinCommand}"
                                        IsVisible="{Binding !Connection.IsConnected}"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Padding="18,10" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand"
                                        ToolTip.Tip="{local:Localize Settings_ShowPairingPinTooltip}"/>
                            </StackPanel>

                            <!-- QR Code Display Panel — contents shared with ConnectionView
                                 (RemEx-xmgw). The card chrome here is deliberately NOT the
                                 glass-card style ConnectionView uses; see PairingQrPanelView. -->
                            <Border IsVisible="{Binding Connection.ShowQrCode}"
                                    Background="{DynamicResource GlassBaseDarkBrush}"
                                    CornerRadius="12" Padding="20"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <views:PairingQrPanelView DataContext="{Binding Connection}"/>
                            </Border>

                            <!-- Pairing PIN Display Panel — contents shared with ConnectionView -->
                            <Border IsVisible="{Binding Connection.ShowPairingPin}"
                                    Background="{DynamicResource GlassBaseDarkBrush}"
                                    CornerRadius="12" Padding="20"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <views:PairingPinPanelView DataContext="{Binding Connection}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ═══ General Section ═══ -->
                    <Border Classes="glass-card" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{local:Localize Settings_General}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                            <!-- Close behavior: minimize to tray vs. exit on window close -->
                            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{local:Localize Settings_CloseToTrayTooltip}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{local:Localize Settings_CloseToTray}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{local:Localize Settings_CloseToTrayDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch AutomationProperties.Name="{local:Localize Settings_CloseToTray}" Grid.Column="1" IsChecked="{Binding IsCloseToTrayEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Automatic update check: query GitHub for a newer release on startup -->
                            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{local:Localize Settings_CheckForUpdatesTooltip}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{local:Localize Settings_CheckForUpdates}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{local:Localize Settings_CheckForUpdatesDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch AutomationProperties.Name="{local:Localize Settings_CheckForUpdates}" Grid.Column="1" IsChecked="{Binding IsCheckForUpdatesEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Launch at Login behavior: run minimized on sign-in.
                                 The "could not check" warning sits ABOVE the switch and inside the same gated
                                 StackPanel, matching the keep-session-unlocked block below. Review caught it
                                 placed after the switch while all nine translations say "the switch below",
                                 and gated only by coincidence - the flag happened never to be set when the
                                 feature is unsupported, which is a fact in a different file. (RemEx-h5lr) -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsLaunchAtLoginSupported}">
                                <TextBlock Text="{local:Localize Settings_LaunchAtLoginStateUnknown}"
                                           IsVisible="{Binding IsLaunchAtLoginStateUnknown}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SystemWarningBrush}"/>
                                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{local:Localize Settings_LaunchAtLoginTooltip}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{local:Localize Settings_LaunchAtLogin}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{local:Localize Settings_LaunchAtLoginDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch AutomationProperties.Name="{local:Localize Settings_LaunchAtLogin}" Grid.Column="1" IsChecked="{Binding IsLaunchAtLoginEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>
                            </StackPanel>

                            <!-- Keep session unlocked while a paired client is connected (opt-in unattended access) (RemEx-l6o) -->
                            <StackPanel Spacing="4" IsVisible="{Binding IsKeepSessionUnlockedSupported}">
                                <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{local:Localize Settings_KeepSessionUnlockedTooltip}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{local:Localize Settings_KeepSessionUnlocked}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{local:Localize Settings_KeepSessionUnlockedDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ToggleSwitch AutomationProperties.Name="{local:Localize Settings_KeepSessionUnlocked}" Grid.Column="1" IsChecked="{Binding IsKeepSessionUnlockedEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="{local:Localize Settings_KeepSessionUnlockedWarning}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemWarningBrush}" TextWrapping="Wrap" IsVisible="{Binding IsKeepSessionUnlockedEnabled}"/>
                            </StackPanel>

                            <!-- Fully exit the application (ends the process) -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{local:Localize Settings_ExitApp}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{local:Localize Settings_ExitAppDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{local:Localize Settings_ExitAppButton}" Command="{Binding ExitApplicationCommand}" Background="Transparent" Foreground="{DynamicResource SystemErrorBrush}" BorderBrush="{DynamicResource SystemErrorBrush}" BorderThickness="1" Padding="18,10" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- RIGHT COLUMN -->
                <StackPanel Width="{Binding #SettingsCards.Bounds.Width, Converter={x:Static local:ResponsiveColumnWidthConverter.Instance}}" Spacing="24" Margin="0,0,0,16">

                    <!-- ═══ Layout Section ═══ -->
                    <Border Classes="glass-card" Padding="24">
                        <StackPanel Spacing="20">
                            <TextBlock Text="{local:Localize Settings_Layout}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                            <Grid ColumnDefinitions="*,Auto" ToolTip.Tip="{local:Localize Settings_EnableAlignmentGuidesTooltip}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{local:Localize Settings_SnapToGrid}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{local:Localize Settings_SnapToGridDesc}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <ToggleSwitch AutomationProperties.Name="{local:Localize Settings_SnapToGrid}" Grid.Column="1" IsChecked="{Binding IsSnapToGridEnabled}" OnContent="" OffContent="" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Spacing="8" IsEnabled="{Binding IsSnapToGridEnabled}" ToolTip.Tip="{local:Localize Settings_GridPlacementIncrementTooltip}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{local:Localize Settings_GridSize}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="Black" Foreground="{DynamicResource AccentPrimaryBrush}" Text="{Binding GridSize, StringFormat={}{0} px}"/>
                                </Grid>
                                <Slider Minimum="10" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding GridSize}" Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Pinned Sensors Section ═══ -->
                    <Border Classes="glass-card" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{local:Localize Settings_PinnedSensors}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                            <TextBlock Text="{local:Localize Settings_PinnedSensorsDesc}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8"/>

                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding AvailableSensors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SensorPinItem">
                                            <CheckBox AutomationProperties.Name="{Binding SensorName}" IsChecked="{Binding IsPinned}" Margin="0,4">
                                                <TextBlock Text="{Binding SensorName}" FontSize="13" VerticalAlignment="Center"/>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- ═══ Backup &amp; Restore Section ═══ -->
                    <Border Classes="glass-card" Padding="24">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{local:Localize Settings_BackupSection}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                            <TextBlock Text="{local:Localize Settings_BackupDescription}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Opacity="0.85"/>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="{local:Localize Settings_ExportButton}" Command="{Binding ExportSettingsCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="16,10" CornerRadius="8" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                                <Button Content="{local:Localize Settings_ImportButton}" Command="{Binding ImportSettingsCommand}" Background="{DynamicResource CardBackgroundBrush}" Padding="16,10" CornerRadius="8" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </WrapPanel>

            <!-- ═══ FULL WIDTH SECTIONS ═══ -->
            <StackPanel Spacing="24">
                <!-- ═══ Shared Folders Section ═══ -->
                <Border Classes="glass-card" Padding="24" IsVisible="{Binding SupportsSharedFolderConfiguration}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="{local:Localize Settings_FileTransferSection}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_FileTransferDesc}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <Button Content="{local:Localize Settings_FileTransferAddFolder}" Command="{Binding AddSharedFolderCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" Padding="16,10" CornerRadius="8" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                                <Button Content="{local:Localize Settings_FileTransferRestoreDefaults}" Command="{Binding RestoreDefaultSharedFoldersCommand}" Background="{DynamicResource CardBackgroundBrush}" Padding="16,10" CornerRadius="8" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                            </StackPanel>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding SharedRoots}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileTransferSharedRootItem">
                                    <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding AbsolutePath}" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="24,0">
                                                <TextBlock Text="{local:Localize Settings_FileTransferWritable}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <ToggleSwitch AutomationProperties.Name="{local:Localize Settings_FileTransferWritable}" IsChecked="{Binding IsWritable}" OnContent="" OffContent=""/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="{local:Localize Settings_FileTransferRemove}" Command="{Binding RemoveCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource SystemErrorBrush}" BorderBrush="{DynamicResource SystemErrorBrush}" BorderThickness="1" Padding="12,8" CornerRadius="8" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ File-Sharing Trust Section ═══ -->
                <Border Classes="glass-card" Padding="24" IsVisible="{Binding SupportsTrustManagement}">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{local:Localize Settings_TrustSection}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="{local:Localize Settings_TrustRefresh}" Command="{Binding RefreshTrustedDevicesCommand}" Background="{DynamicResource CardBackgroundBrush}" Padding="14,8" CornerRadius="8" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                        </Grid>

                        <TextBlock Text="{local:Localize Settings_TrustDesc}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>

                        <TextBlock Text="{local:Localize Settings_TrustEmpty}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}" IsVisible="{Binding !HasTrustedDevices}"/>

                        <ItemsControl ItemsSource="{Binding TrustedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FileTrustDeviceItem">
                                    <Border Background="{DynamicResource GlassBaseDarkBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding ShortId}" FontSize="14" FontWeight="Bold" FontFamily="Consolas,monospace" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Content="{local:Localize Settings_TrustRevoke}" Command="{Binding RevokeCommand}" Background="{DynamicResource CardBackgroundBrush}" Foreground="{DynamicResource SystemErrorBrush}" BorderBrush="{DynamicResource SystemErrorBrush}" BorderThickness="1" Padding="12,8" CornerRadius="8" Cursor="Hand"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{local:Localize Settings_TrustFullBrowse}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <ToggleSwitch AutomationProperties.Name="{local:Localize Settings_TrustFullBrowse}" Grid.Column="1" IsChecked="{Binding FullBrowseGranted}" OnContent="" OffContent=""/>
                                            </Grid>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{local:Localize Settings_TrustAutoAccept}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                <ToggleSwitch AutomationProperties.Name="{local:Localize Settings_TrustAutoAccept}" Grid.Column="1" IsChecked="{Binding AutoAcceptIncoming}" OnContent="" OffContent=""/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ═══ Help Section ═══ -->
                <Border Classes="glass-card" Padding="24">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{local:Localize Settings_Help}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" LetterSpacing="2"/>
                            <TextBlock Text="{local:Localize Settings_HelpPrompt}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{local:Localize Settings_ReplayTutorial}" Command="{Binding ReplayTutorialCommand}" Background="{DynamicResource CardBackgroundBrush}" Padding="18,10" CornerRadius="8" FontSize="13" FontWeight="Bold" Cursor="Hand" ToolTip.Tip="{local:Localize Settings_ReplayTutorialTooltip}"/>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
