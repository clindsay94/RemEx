<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Remex.Desktop.Converters"
        xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
        x:Class="Remex.Desktop.Views.SecondMetricDialog"
        Title="{local:Localize SecondMetric_Title}"
        Width="380" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GlassBaseDarkBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,44,24,24">

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16" Spacing="4">
            <TextBlock Text="{local:Localize SecondMetric_Header}" Theme="{StaticResource OverlineTextBlock}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMutedBrush}" LetterSpacing="2"/>
            <TextBlock x:Name="CardTitleText" Theme="{StaticResource Headline6TextBlock}" FontWeight="Bold"
                       Foreground="{DynamicResource AccentPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Search -->
        <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="{local:Localize SecondMetric_Search}" Margin="0,0,0,12" Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- Candidate list -->
        <material:Card Grid.Row="2" Padding="4">
            <ListBox x:Name="SensorList" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Theme="{StaticResource Body2TextBlock}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis" Padding="4,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </material:Card>

        <!-- Buttons -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,16,0,0">
            <Button Grid.Column="1" Content="{local:Localize Btn_Clear}" Click="OnClear"
                    Classes="tertiary danger" MinWidth="72" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="{local:Localize Btn_Cancel}" Click="OnCancel"
                    Classes="tertiary" MinWidth="80" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="{local:Localize SecondMetric_SetBtn}" Click="OnSet"
                    Classes="primary" MinWidth="90"/>
        </Grid>

    </Grid>
</Window>
