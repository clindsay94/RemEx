<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Remex.Desktop.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
             xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:assists="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             x:Class="Remex.Desktop.App" RequestedThemeVariant="Dark">
    <!-- Forced to Dark: most themes are dark glass. ThemeService switches to Light for SolarFlare. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Remex.Desktop/Themes/BaseDarkGlass.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Typography -->
            <FontFamily x:Key="JetBrainsMono">avares://Remex.Desktop/Assets#JetBrains Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
            <FontFamily x:Key="Bungee_Shade">avares://Remex.Desktop/Assets/Fonts/BungeeShade-Regular.ttf#Bungee Shade</FontFamily>
            <FontFamily x:Key="Nabla">avares://Remex.Desktop/Assets/Fonts/Nabla-Regular.ttf#Nabla</FontFamily>
            <FontFamily x:Key="Sixtyfour">avares://Remex.Desktop/Assets/Fonts/Sixtyfour-Regular.ttf#Sixtyfour</FontFamily>
            <FontFamily x:Key="VictorMono">avares://Remex.Desktop/Assets/Fonts/victor_mono_bold.ttf#Victor Mono</FontFamily>
            <FontFamily x:Key="Orbitron">avares://Remex.Desktop/Assets/Fonts#Orbitron</FontFamily>
            <!-- Themeable header font — overridden live by the personalization font picker; default = Orbitron. -->
            <FontFamily x:Key="PageTitleFontFamily">avares://Remex.Desktop/Assets/Fonts#Orbitron</FontFamily>
            <!-- Themeable content/body font — overridden live by the picker; default = Inter (the app default font). -->
            <FontFamily x:Key="BodyFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
            <!-- Overall UI scale (the personalization "UI size" slider). Overridden live by ThemeService. -->
            <x:Double x:Key="UiScale">1</x:Double>

            <!-- ═══ Material typography keys, overridden BY KEY on purpose (RemEx-prkot §3 of
                 docs/AUDIT-fluent-removal.md). MaterialTheme sets FontFamily/FontSize on Window AND
                 on PopupRoot/OverlayPopupHost through these two DynamicResources; overriding the
                 keys reaches both surfaces in one move, where a Window-level pin would fix the ten
                 dialogs and leave every tooltip, flyout and context menu on Roboto — the silent
                 half the audit calls a trap. ThemeService mirrors the font picker into
                 MaterialDesignFonts alongside BodyFontFamily, so the live-themable body font keeps
                 covering popups too. Types must match what Material's themes expect: a FontFamily
                 element and an x:Double, not strings. -->
            <FontFamily x:Key="MaterialDesignFonts">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
            <x:Double x:Key="MaterialDesignFontSize">14</x:Double>

            <!-- ═══ THE CARD SURFACE (RemEx-qbzl1). Material.Styles' Card, re-themed rather than
                 used as shipped, and declared as an OWN key of Application.Resources on purpose.
                 It CANNOT be a ResourceInclude: ThemeService.ApplyBaseThemeInternal clears every
                 merged dictionary except its own override dictionary before inserting the new
                 theme file, so a merged Card theme would survive until the first theme switch and
                 then vanish — cards would silently fall back to Material's opaque paper on a
                 translucent shell. Own keys are untouched by that loop.

                 Two things are re-themed, and both are the reason a stock Card will not do:

                 PAINT. Material's Card is opaque MaterialCardBackgroundBrush. RemEx surfaces are
                 translucent glass over a mica/acrylic window backdrop (RemEx-c437b); an opaque
                 card would erase the backdrop wherever a card sits, which is most of the app.
                 Background/BorderBrush/BorderThickness/CornerRadius therefore come from the
                 Card* palette keys, which is also what keeps the corner-radius sliders in
                 CustomizationViewModel working — they write CardCornerRadius, and this theme
                 reads it as a DynamicResource, so the vibrate-feedback preview still animates.

                 SHADOW. Material drives Card elevation through ShadowAssist.ShadowDepth, whose
                 change handler assigns Border.BoxShadow as a LOCAL value — local values outrank
                 style setters in Avalonia, so a themed, glow-slider-scaled shadow could never be
                 pushed past it. This template drops ShadowAssist entirely and binds the ramp key
                 directly; the App.axaml styles below then step the level on hover.

                 Padding defaults to 0, not Material's 8: every call site already sets its own
                 padding, and 8 would silently inset all ~50 of them.

                 Structure is otherwise Material's own Card template (Material.Avalonia 3.19.0)
                 so InsideClipping keeps working — call sites that clipped content with
                 ClipToBounds on the old Border set InsideClipping here instead, because the Card
                 itself must stay unclipped or it would clip its own shadow. -->
            <ControlTheme x:Key="{x:Type material:Card}" TargetType="material:Card">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
                <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="ClipToBounds" Value="False"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Transitions">
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                        <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter>
                <Setter Property="Template">
                    <ControlTemplate>
                        <Panel Name="PART_RootPanel">
                            <Border Name="PART_BackgroundBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    BoxShadow="{DynamicResource Elevation1Shadow}">
                                <Border.Transitions>
                                    <Transitions>
                                        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.6">
                                            <BoxShadowsTransition.Easing>
                                                <SpringEasing Mass="1" Stiffness="120" Damping="12"/>
                                            </BoxShadowsTransition.Easing>
                                        </BoxShadowsTransition>
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <Border Name="PART_InnerBorder"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    ClipToBounds="{TemplateBinding InsideClipping}">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Padding="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Border>
                        </Panel>
                    </ControlTemplate>
                </Setter>
            </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- MATERIAL OWNS EVERY CONTROL TEMPLATE NOW (RemEx-prkot, Connor's call 2026-08-26:
             "wire MaterialTheme in", reversing the 2026-08-20 palette-only decision). Fluent is
             GONE, not merely shadowed — docs/AUDIT-fluent-removal.md verified per control that
             nothing this app uses loses its template, and that there is no Simple-theme safety
             net underneath, which is why the audit had to be per-control rather than optimistic.

             BaseTheme="Inherit" follows Application.RequestedThemeVariant, which ThemeService
             already flips for light/dark — including the live OS-follow of System mode
             (RemEx-zk5bc) — so Material's base tracks the same switch everything else does.
             The initial Primary/Secondary are placeholders: ThemeService pushes the real seed
             palette into MaterialTheme.CurrentTheme on every ApplyCustomization, which is what
             keeps this from being a two-palette app (RemEx surfaces seeded, Material controls
             stuck on a brand colour). -->
        <themes:MaterialTheme BaseTheme="Inherit" PrimaryColor="Purple" SecondaryColor="Lime" />
        <!-- Icon glyphs for mi:MaterialIcon — a separate package from Material.Avalonia's control
             themes, loaded on its own before those went in and unchanged by them. -->
        <mi:MaterialIconStyles />
        <!-- Global Control Styles -->

        <!-- Base Text Styling -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- ═══ The four inherited Window properties, settled deliberately (RemEx-n0pb8 via the
             audit's §3). Material's Window theme would supply MaterialPaperBrush/MaterialBodyBrush;
             three windows pin nothing and every window leaves Foreground to inheritance, so without
             these the app would mix Material's palette under RemEx-brushed content — the
             foreground-from-one-palette-over-background-from-another shape that fails on light
             themes. App styles (frame Style) outrank ControlTheme setters (frame StyleTheme), so
             these win everywhere a window does not pin its own. FontFamily/FontSize ride the
             MaterialDesignFonts keys above instead — the key override is what reaches popups. -->
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <!-- Material sets the PAPER brush as the FOREGROUND on both of these — correct against its
             own dark tooltip surface, near-white-on-near-white against ours on a light palette
             (the audit's §3 tail). Both take the app's glass treatment instead, same trio as the
             NotificationCard style below. -->
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
        </Style>

        <!-- ═══ CARD STATE (RemEx-qbzl1). Border.glass-card is retired; material:Card is the
             app's one raised-surface primitive and its resting paint lives in the ControlTheme
             above. What is left here is STATE.

             The bead's real ask was that an interactive card RAISE A LEVEL on hover rather than
             only shift colour, so the three-step ramp is spent as: every card rests at level 1,
             hovering any card takes it to 2, and hovering an .interactive card — one that is
             itself a click target — takes it to 3 with a bigger lift. Colour still moves too;
             it is no longer the only signal, which is what the acceptance criterion was about.

             Card has no BoxShadow property of its own (BoxShadow belongs to Border), so the
             shadow cannot ride a TemplateBinding the way Background does. The /template/
             selectors below reach PART_BackgroundBorder directly. This works only because the
             ControlTheme dropped ShadowAssist: ShadowAssist writes BoxShadow as a local value,
             and a local value would outrank every one of these setters. -->
        <Style Selector="material|Card:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="translateY(-4px) scale(1.01)"/>
        </Style>
        <Style Selector="material|Card:pointerover /template/ Border#PART_BackgroundBorder">
            <Setter Property="BoxShadow" Value="{DynamicResource Elevation2Shadow}"/>
        </Style>

        <Style Selector="material|Card.interactive:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="translateY(-6px) scale(1.02)"/>
        </Style>
        <Style Selector="material|Card.interactive:pointerover /template/ Border#PART_BackgroundBorder">
            <Setter Property="BoxShadow" Value="{DynamicResource Elevation3Shadow}"/>
        </Style>

        <!-- Surface variant (RemEx-zm6gp): for cards that HOST a list rather than act as a
             clickable unit. The hover lift is designed for finite cards; on a container as tall as
             its unvirtualized content, scale(1.01) about the centre displaces the top edge by 1% of
             half its height - on Task Manager that is ~80px of list sliding up over the search
             field. Surfaces keep the hover background and the elevation step, and give up the
             transform.
             ORDER IS LOAD-BEARING: Avalonia has no specificity — the last matching style wins —
             so this block must sit BELOW both transform-setting hover styles above, or a
             Card (or a future "surface interactive") re-acquires the lift and the slide
             returns. TaskManagerListSurfaceTests asserts this ordering from the source. -->
        <Style Selector="material|Card.surface:pointerover">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>

        <!-- ═══ CARD-SHAPED BUTTON (RemEx-qbzl1). HomeView's eight quick actions and three link
             tiles are cards that happen to be click targets. They carried
             Classes="glass-card interactive" against a selector that only ever matched Border, so
             they matched NOTHING and have been rendering as ordinary buttons — dead classes the
             sweep for leftover .glass-card selectors is what surfaced. They cannot become Cards
             (a Card is not focusable and raises no Command), so the surface comes to them as a
             button class instead, painted from the same Card* keys so the two idioms cannot
             drift apart. RemEx-z7pnx folds .card into the Material button vocabulary. -->
        <Style Selector="Button.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.card.interactive:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="translateY(-6px) scale(1.02)"/>
        </Style>
        <Style Selector="Button.card.interactive:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════════════════
             THE BUTTON VOCABULARY (RemEx-z7pnx). Documented in docs/BUTTON-VOCABULARY.md.

             Before this, 37 button classes across 16 files each answered "what should a button
             look like?" from scratch: nine different corner radii, six ways to spell "this is
             the destructive one", and two identical colour swatches declared in two files. The
             names described SCREENS (rd-btn, log-btn, about-back), so nothing about a name told
             you what it meant, and a new button had no rule to follow.

             These classes describe ROLE. Pick one emphasis, add a tint if the action carries a
             consequence, add a shape or size modifier if the layout needs one. That is the whole
             system, and it is what the Phase 4 view beads apply instead of a preference.

             They sit ON TOP of Material's Button template rather than replacing it: the ripple,
             the hover overlay (PART_HoverEffect), the focus overlay and the disabled treatment
             all come from MaterialButtonBase, and what RemEx supplies is the palette and the
             geometry. ShadowAssist IS used here, unlike on Card — a button's shadow is a plain
             drop shadow with no accent glow riding on it, so Material's fixed ramp is exactly
             right and the local-value problem that ruled it out for cards never arises.
             ═══════════════════════════════════════════════════════════════════════════════ -->

        <!-- EMPHASIS 1/3 — PRIMARY. The one thing this surface exists to do. Accent fill, and
             the only emphasis that carries elevation, so at most one per surface. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>

        <!-- EMPHASIS 2/3 — SECONDARY. An action of equal standing to the primary, or the normal
             emphasis on a surface that has no single primary action. Card surface plus the card
             border, so a row of them reads as a row of controls rather than a row of shouts. -->
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
        </Style>

        <!-- EMPHASIS 3/3 — TERTIARY. Inline, toolbar and dismiss actions: present, not competing.
             No fill and no border until hovered, which is what lets a toolbar of them sit over a
             card without drawing a grid of boxes. -->
        <Style Selector="Button.tertiary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tertiary:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <!-- Pressed feedback is one rule for all three emphases. It was previously spelled
             scale(0.96), scale(0.97) and scale(0.98) in different files, which is not a design
             decision, it is three people not knowing about each other. -->
        <Style Selector="Button.primary:pressed, Button.secondary:pressed, Button.tertiary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>

        <!-- ─── TINT MODIFIERS. Combine with any emphasis. A tint says the action has a
             CONSEQUENCE — it never changes how loud the button is, only what it means. Applied
             after the emphasis blocks above so it wins on the properties it sets; Avalonia has
             no specificity, so this ordering is the mechanism. -->
        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource SystemErrorBackgroundBrush}"/>
            <!-- ErrorTintForegroundBrush, not SystemErrorBrush. The tint is a different surface
                 from the fill and inverts the answer: red-on-15%-red measures 1.24:1, white
                 measures 15.96:1 at rest and clears AA against every backdrop (RemEx-1elh, and
                 the token comment in Themes/Shared/FallbackPalette.axaml). Three of the five
                 danger buttons this replaces used the red; card-action-danger already used the
                 white. One rule ends the disagreement on the measured side. -->
            <Setter Property="Foreground" Value="{DynamicResource ErrorTintForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorBrush}"/>
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource SystemErrorBackgroundHoverBrush}"/>
        </Style>
        <Style Selector="Button.success">
            <Setter Property="Background" Value="{DynamicResource SystemSuccessBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemSuccessBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemSuccessBrush}"/>
        </Style>
        <Style Selector="Button.warning">
            <Setter Property="Background" Value="{DynamicResource SystemWarningBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemWarningBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemWarningBrush}"/>
        </Style>
        <!-- PRIMARY is already a solid fill, so a tinted primary fills SOLID rather than
             washing. This is the destructive-confirm shape: one loud button whose colour is the
             warning. ErrorForegroundBrush is the dark token, correct over solid red, and the
             opposite of the one the wash above needs. -->
        <Style Selector="Button.primary.danger">
            <Setter Property="Background" Value="{DynamicResource SystemErrorBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemErrorBrush}"/>
        </Style>
        <Style Selector="Button.primary.success">
            <Setter Property="Background" Value="{DynamicResource SystemSuccessBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemSuccessBrush}"/>
        </Style>
        <Style Selector="Button.primary.warning">
            <Setter Property="Background" Value="{DynamicResource SystemWarningBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SystemWarningBrush}"/>
        </Style>

        <!-- A tertiary button has no fill to tint, so a tinted one keeps its transparency and
             only recolours its label. Without this, .tertiary.danger would paint a filled box and
             stop being tertiary. -->
        <Style Selector="Button.tertiary.danger, Button.tertiary.success, Button.tertiary.warning">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.tertiary.danger">
            <Setter Property="Foreground" Value="{DynamicResource SystemErrorBrush}"/>
        </Style>

        <!-- ─── SIZE AND SHAPE MODIFIERS. Orthogonal to emphasis and tint. -->
        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.pill">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="20,12"/>
        </Style>
        <Style Selector="Button.pill.compact">
            <Setter Property="Padding" Value="12,6"/>
        </Style>

        <!-- ─── ICON BUTTON. A square hit target with a glyph and no label. Tertiary paint, so
             .icon-button is written alongside .tertiary rather than instead of it — the size is
             the only thing this class owns. -->
        <Style Selector="Button.icon-button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-button.compact">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- ─── TILE. A large, stretch-content click target: theme presets, the tray's device
             tiles, Remote's command grid. Distinct from .card, which lifts off the page on hover;
             a tile sits flat in a grid of its peers and only brightens. Height is deliberately
             NOT set here — a tile's height belongs to the grid it lives in, and pinning it in the
             class is what previously forced three near-identical copies of this style. -->
        <Style Selector="Button.tile">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.tile:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.tile:disabled">
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
        <!-- The selected state of a tile group (theme presets, and any future single-choice grid). -->
        <Style Selector="Button.tile.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- ─── SWATCH. A round colour chip whose FILL is the value it represents, so the class
             sets everything except Background. One class now: this was declared twice, as
             Button.accent-swatch here and Button.accent-picker in PersonalizationPanelView, at 28px
             and 24px, and the hover-border bug (RemEx-fy0a) had to be fixed in both — once each,
             months apart. -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="assists:ShadowAssist.ShadowDepth" Value="Depth0"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.swatch.compact">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <!-- BorderBrush is a TOKEN, not White (RemEx-fy0a). A white hover border is invisible on
             SolarFlare, whose surface is near-white, so on that theme the swatch had no hover
             feedback at all - the control looked inert rather than styled. TextPrimaryBrush is the
             one key guaranteed to contrast with its own theme's background. -->
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="RenderTransform" Value="scale(1.15)"/>
        </Style>

        <!-- Typography classes -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="{DynamicResource PageTitleFontFamily}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontFamily" Value="{DynamicResource PageTitleFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="LetterSpacing" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- Non-feature page content column: fills available width, caps + centers on wide displays. -->
        <Style Selector="StackPanel.page-content">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MaxWidth" Value="1200"/>
        </Style>
        <!-- Card / section header. FontFamily is themed live via the font picker (Phase 2). -->
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>


        <!-- ═══ KEYBOARD-FOCUS VISIBLE RING ═══

             EVERY INTERACTIVE CONTROL TYPE, NOT JUST BUTTON. This used to style Button alone, so a
             keyboard user tabbing through a form got a clear accent ring on the buttons and then
             Fluent's default on everything else - which on CyberNOC and Monolith is near-invisible
             against their dark surfaces. The effect was worse than no ring at all: focus appeared to
             VANISH when it left a button and reappear when it returned, so the tab order looked
             broken rather than under-styled. (RemEx-2p19, continuing RemEx-dygk.)

             AccentPrimaryBrush is per-theme by construction, so each theme rings in its own accent
             rather than in a literal that one of the four cannot show - the failure just fixed for
             the accent swatches in RemEx-wcvr.

             `:focus-visible` rather than `:focus` throughout, deliberately: it fires for keyboard
             traversal and not for a mouse click, so clicking a control does not leave a ring behind
             it. That is the distinction the pseudo-class exists for, and losing it would make the
             UI look permanently focused after any click.

             Split by whether the control templates a ContentPresenter or draws its own border:
             ContentPresenter for the content controls, the control itself where there is no inner
             presenter to reach. -->
        <Style Selector="Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ToggleButton:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="RepeatButton:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- These draw their own border, so the ring goes on the control rather than on an inner
             presenter. TextBox is the one a user is most likely to be typing into blind without it.

             LISTBOXITEM IS HERE, NOT WITH THE BUTTONS, BECAUSE IT DOES NOT DEPEND ON THE TEMPLATE'S
             SHAPE (RemEx-kgs7g). It used to target `/template/ ContentPresenter` like the three
             above it. That works under Fluent — Avalonia 12.1.1's ListBoxItem template is a single
             ContentPresenter#PART_ContentPresenter which template-binds BorderBrush, BorderThickness
             and CornerRadius, so both forms render — but it only works for as long as the template
             root happens to be a ContentPresenter, and it silently renders nothing when it is not.

             That is not hypothetical: HomeView's pinned-sensor list supplies its own ListBoxItem
             template. Its root WAS a bare ContentPresenter, so the old selector matched it and drew
             the ring at the item's bounds — 20px clear of the card on two sides, because the card's
             own margin sat inside the item. The ring was there; it was around the wrong rectangle.

             Set on the CONTROL, the ring renders through whatever border the template binds, and the
             obligation moves to the template: a view supplying its own has to bind BorderBrush and
             BorderThickness or the ring reaches nothing. HomeView's now does, and
             FocusVisibleStyleGuardTests holds both halves.

             A note on provenance: the theme swap docs/AUDIT-fluent-removal.md analysed HAPPENED
             (RemEx-prkot, 2026-08-26) — MaterialTheme owns the templates now, and the audit is a
             description of what ships, not a contingency. This control-level shape is exactly why
             the ring survived the swap: Material's ListBoxItem has no ContentPresenter to reach at
             all, but its PART_RootBorder template-binds both border properties, and Material nulls
             FocusAdorner on nine controls so there is nothing underneath these styles. -->
        <Style Selector="ListBoxItem:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="TextBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ComboBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="CheckBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="RadioButton:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ToggleSwitch:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Slider:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

            <!-- ═══ CONNECTION STATUS INDICATOR (RemEx-udds) ═══
             Colour resolves through theme tokens so all four themes apply, and the .connected
             class flips with the binding. The base style is the disconnected state; .connected
             overrides it. Replaces literal colours previously held in a BoolToColorConverter
             ConverterParameter, which DynamicResource could not reach. -->
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource SystemErrorBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Fill" Duration="0:0:0.4"/>
            </Transitions>
        </Setter>
        </Style>
        <Style Selector="Ellipse.status-dot.connected">
            <Setter Property="Fill" Value="{DynamicResource SystemSuccessBrush}"/>
        </Style>
        <Style Selector="Ellipse.status-ring">
            <Setter Property="Stroke" Value="{DynamicResource SystemErrorBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Stroke" Duration="0:0:0.4"/>
            </Transitions>
        </Setter>
        </Style>
        <Style Selector="Ellipse.status-ring.connected">
            <Setter Property="Stroke" Value="{DynamicResource SystemSuccessBrush}"/>
        </Style>

        <!-- ═══ In-app toast (RemEx-5wc2) ═══
             The control theme (Material now, Fluent before it — the audit verified Material
             templates NotificationCard too) dresses toasts from its own palette, which follows
             the light/dark variant but knows nothing about the seed the user picked - so a toast
             would be the one surface in the app that ignores it. A Style setter outranks a
             ControlTheme setter, so these win; the values are theme resources rather than
             literals for the usual reason. -->
        <Style Selector="NotificationCard">
            <Setter Property="Background" Value="{DynamicResource GlassBaseDarkBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <!-- The menu is built in App.BuildTrayMenu, not declared here. Its items are not
                 static: the status header changes with phone presence and Remote desktop enables
                 and disables. A declared menu can only be updated by index, which is how the old
                 UpdateTrayMenuHeaders came to address items[0], [1], [2] and [4] by number. -->
            <TrayIcon Icon="avares://Remex.Desktop/Assets/icon.png" ToolTipText="{local:Localize Tray_TooltipDefault}" IsVisible="True" Clicked="OnTrayIconClicked" />
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
