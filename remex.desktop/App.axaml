<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Remex.Desktop.Converters"
             x:Class="Remex.Desktop.App" RequestedThemeVariant="Dark">
    <!-- Forced to Dark: most themes are dark glass. ThemeService switches to Light for SolarFlare. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Remex.Desktop/Themes/BaseDarkGlass.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══ SVG Icon Paths (Material Design, Apache 2.0) ═══ -->
            <!-- Navigation -->
            <StreamGeometry x:Key="IconHome">M10,20V14H14V20H19V12H22L12,3L2,12H5V20H10Z</StreamGeometry>
            <StreamGeometry x:Key="IconSensors">M3.5,18.5L9.5,12.5L13.5,16.5L22,6.22L20.59,4.81L13.5,13.5L9.5,9.5L2,17L3.5,18.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconRemote">M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z</StreamGeometry>
            <StreamGeometry x:Key="IconLauncher">M16,20H20V16H16M16,14H20V10H16M10,8H14V4H10M16,8H20V4H16M10,14H14V10H10M4,14H8V10H4M4,20H8V16H4M10,20H14V16H10M4,8H8V4H4V8Z</StreamGeometry>
            <StreamGeometry x:Key="IconTasks">M7,5H21V7H7V5M7,13V11H21V13H7M4,4.5A1.5,1.5 0 0,1 5.5,6A1.5,1.5 0 0,1 4,7.5A1.5,1.5 0 0,1 2.5,6A1.5,1.5 0 0,1 4,4.5M4,10.5A1.5,1.5 0 0,1 5.5,12A1.5,1.5 0 0,1 4,13.5A1.5,1.5 0 0,1 2.5,12A1.5,1.5 0 0,1 4,10.5M7,19V17H21V19H7M4,16.5A1.5,1.5 0 0,1 5.5,18A1.5,1.5 0 0,1 4,19.5A1.5,1.5 0 0,1 2.5,18A1.5,1.5 0 0,1 4,16.5Z</StreamGeometry>
            <StreamGeometry x:Key="IconDesktop">M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V9H13V11H21V13M15,9V7H21V5H15V3H13V9H15Z</StreamGeometry>
            <StreamGeometry x:Key="IconGear">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11.03L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.47,5.34 14.86,5.08L14.47,2.44C14.43,2.19 14.22,2 13.97,2H9.97C9.72,2 9.51,2.19 9.47,2.44L9.08,5.08C8.47,5.34 7.9,5.66 7.38,6.05L4.89,5.05C4.67,4.96 4.4,5.05 4.28,5.27L2.28,8.73C2.16,8.95 2.21,9.22 2.4,9.37L4.51,11.03C4.47,11.34 4.45,11.67 4.45,12C4.45,12.33 4.47,12.65 4.51,12.97L2.4,14.63C2.21,14.78 2.16,15.05 2.28,15.27L4.28,18.73C4.4,18.95 4.67,19.04 4.89,18.95L7.38,17.95C7.9,18.34 8.47,18.66 9.08,18.92L9.47,21.56C9.51,21.81 9.72,22 9.97,22H13.97C14.22,22 14.43,21.81 14.47,21.56L14.86,18.92C15.47,18.66 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</StreamGeometry>
            <StreamGeometry x:Key="IconAbout">M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z</StreamGeometry>
            <StreamGeometry x:Key="IconLogs">M14,2H6C4.89,2 4,2.89 4,4V20C4,21.1 4.89,22 6,22H18C19.1,22 20,21.1 20,20V8L14,2M12,18H6V16H12V18M16,14H6V12H16V14M16,10H6V8H16V10M13,9V3.5L18.5,9H13Z</StreamGeometry>
            <!-- Nav revamp glyphs (Commands / Processes / Connection / FAQ / Personalize) -->
            <StreamGeometry x:Key="IconCommands">M15,2H9A3,3 0 0,0 6,5V22H18V5A3,3 0 0,0 15,2M12,4A1,1 0 0,1 13,5A1,1 0 0,1 12,6A1,1 0 0,1 11,5A1,1 0 0,1 12,4M9,8H11V10H9V8M13,8H15V10H13V8M9,12H11V14H9V12M13,12H15V14H13V12M9,16H11V18H9V16M13,16H15V18H13V16Z</StreamGeometry>
            <StreamGeometry x:Key="IconProcesses">M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2M15,15H17V9H15M11,15H13V6H11M7,15H9V11H7V15Z</StreamGeometry>
            <StreamGeometry x:Key="IconConnection">M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83C7.22,12.88 7.22,9.71 9.17,7.76L12.71,4.22C14.66,2.27 17.83,2.27 19.78,4.22C21.73,6.17 21.73,9.34 19.78,11.29L18.29,12.78C18.3,11.96 18.17,11.14 17.89,10.36L18.36,9.88C19.53,8.72 19.53,6.83 18.36,5.66C17.19,4.5 15.3,4.5 14.13,5.66L10.59,9.2C9.42,10.37 9.42,12.26 10.59,13.41M13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17C16.78,11.12 16.78,14.29 14.83,16.24L11.29,19.78C9.34,21.73 6.17,21.73 4.22,19.78C2.27,17.83 2.27,14.66 4.22,12.71L5.71,11.22C5.7,12.04 5.83,12.86 6.11,13.65L5.64,14.12C4.47,15.28 4.47,17.17 5.64,18.34C6.81,19.5 8.7,19.5 9.87,18.34L13.41,14.8C14.58,13.63 14.58,11.74 13.41,10.59C13,10.2 13,9.56 13.41,9.17Z</StreamGeometry>
            <StreamGeometry x:Key="IconFaq">M15.07,11.25L14.17,12.17C13.45,12.89 13,13.5 13,15H11V14.5C11,13.39 11.45,12.39 12.17,11.67L13.41,10.41C13.78,10.05 14,9.55 14,9C14,7.89 13.1,7 12,7A2,2 0 0,0 10,9H8A4,4 0 0,1 12,5A4,4 0 0,1 16,9C16,9.88 15.64,10.67 15.07,11.25M13,19H11V17H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12C22,6.47 17.5,2 12,2Z</StreamGeometry>
            <StreamGeometry x:Key="IconPersonalize">M17.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,9A1.5,1.5 0 0,1 19,10.5A1.5,1.5 0 0,1 17.5,12M14.5,8A1.5,1.5 0 0,1 13,6.5A1.5,1.5 0 0,1 14.5,5A1.5,1.5 0 0,1 16,6.5A1.5,1.5 0 0,1 14.5,8M9.5,8A1.5,1.5 0 0,1 8,6.5A1.5,1.5 0 0,1 9.5,5A1.5,1.5 0 0,1 11,6.5A1.5,1.5 0 0,1 9.5,8M6.5,12A1.5,1.5 0 0,1 5,10.5A1.5,1.5 0 0,1 6.5,9A1.5,1.5 0 0,1 8,10.5A1.5,1.5 0 0,1 6.5,12M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A1.5,1.5 0 0,0 13.5,19.5C13.5,19.11 13.35,18.76 13.11,18.5C12.88,18.23 12.73,17.88 12.73,17.5A1.5,1.5 0 0,1 14.23,16H16A5,5 0 0,0 21,11C21,6.58 16.97,3 12,3Z</StreamGeometry>
            <!-- Toolbar actions -->
            <StreamGeometry x:Key="IconSave">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</StreamGeometry>
            <StreamGeometry x:Key="IconSync">M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12H4A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z</StreamGeometry>
            <StreamGeometry x:Key="IconImport">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
            <!-- Version info -->
            <StreamGeometry x:Key="IconLaptop">M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z</StreamGeometry>
            <StreamGeometry x:Key="IconDesktopPC">M21,16H3V4H21M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z</StreamGeometry>
            <!-- Sensor widget -->
            <StreamGeometry x:Key="IconFlash">M7,2V13H10V22L17,10H13L17,2H7Z</StreamGeometry>
            <!-- Warning -->
            <StreamGeometry x:Key="IconWarning">M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16</StreamGeometry>
            <!-- File Transfer -->
            <StreamGeometry x:Key="IconFiles">M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z</StreamGeometry>

            <!-- Typography -->
            <FontFamily x:Key="JetBrainsMono">avares://Remex.Desktop/Assets#JetBrains Mono, Consolas, DejaVu Sans Mono, monospace</FontFamily>
            <FontFamily x:Key="Bungee_Shade">avares://Remex.Desktop/Assets/Fonts/BungeeShade-Regular.ttf#Bungee Shade</FontFamily>
            <FontFamily x:Key="Nabla">avares://Remex.Desktop/Assets/Fonts/Nabla-Regular.ttf#Nabla</FontFamily>
            <FontFamily x:Key="Sixtyfour">avares://Remex.Desktop/Assets/Fonts/Sixtyfour-Regular.ttf#Sixtyfour</FontFamily>
            <FontFamily x:Key="VictorMono">avares://Remex.Desktop/Assets/Fonts/victor_mono_bold.ttf#Victor Mono</FontFamily>
            <FontFamily x:Key="Orbitron">avares://Remex.Desktop/Assets/Fonts#Orbitron</FontFamily>
            <!-- Themeable header font — overridden live by the personalization font picker; default = Orbitron. -->
            <FontFamily x:Key="PageTitleFontFamily">avares://Remex.Desktop/Assets/Fonts#Orbitron</FontFamily>
            <!-- Themeable content/body font — overridden live by the picker; default = Inter (the app default font). -->
            <FontFamily x:Key="BodyFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
            <!-- Overall UI scale (the personalization "UI size" slider). Overridden live by ThemeService. -->
            <x:Double x:Key="UiScale">1</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- Global Control Styles -->

        <!-- Base Text Styling -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style Selector="Border.glass-card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.6">
                        <BoxShadowsTransition.Easing>
                            <SpringEasing Mass="1" Stiffness="120" Damping="12" />
                        </BoxShadowsTransition.Easing>
                    </BoxShadowsTransition>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.glass-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardHoverShadow}"/>
            <Setter Property="RenderTransform" Value="translateY(-4px) scale(1.01)"/>
        </Style>

        <!-- Glass Card Interactive Effect -->
        <Style Selector="Border.glass-card.interactive:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="translateY(-6px) scale(1.02)"/>
            <Setter Property="BoxShadow" Value="{DynamicResource CardHoverShadow}"/>
        </Style>

        <!-- Theme Preset Tile Button -->
        <Style Selector="Button.theme-tile">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="{DynamicResource CardBorderThickness}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.theme-tile:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.theme-tile:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)"/>
        </Style>
        <Style Selector="Button.theme-tile.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Glass Navigation Button -->
        <Style Selector="Button.glass-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.2"/>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.glass-button:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.glass-button:pressed">
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>

        <!-- Accent Color Swatch -->
        <Style Selector="Button.accent-swatch">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <!-- BorderBrush is a TOKEN, not White, and this is the same bug that was already fixed for
             Button.accent-picker in PersonalizationPanelView (RemEx-fy0a). A white hover border is
             invisible on SolarFlare, whose surface is near-white, so on that theme the swatch had no
             hover feedback at all - the control looked inert rather than styled. TextPrimaryBrush is
             the one key guaranteed to contrast with its own theme's background. -->
        <Style Selector="Button.accent-swatch:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="RenderTransform" Value="scale(1.15)"/>
        </Style>

        <!-- Typography classes -->
        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Black"/>
        </Style>
        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontFamily" Value="{DynamicResource PageTitleFontFamily}"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="LetterSpacing" Value="2"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.page-subtitle">
            <Setter Property="FontFamily" Value="{DynamicResource PageTitleFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="LetterSpacing" Value="4"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        </Style>

        <!-- Non-feature page content column: fills available width, caps + centers on wide displays. -->
        <Style Selector="StackPanel.page-content">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MaxWidth" Value="1200"/>
        </Style>
        <!-- Card / section header. FontFamily is themed live via the font picker (Phase 2). -->
        <Style Selector="TextBlock.card-title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>


        <!-- ═══ KEYBOARD-FOCUS VISIBLE RING ═══

             EVERY INTERACTIVE CONTROL TYPE, NOT JUST BUTTON. This used to style Button alone, so a
             keyboard user tabbing through a form got a clear accent ring on the buttons and then
             Fluent's default on everything else - which on CyberNOC and Monolith is near-invisible
             against their dark surfaces. The effect was worse than no ring at all: focus appeared to
             VANISH when it left a button and reappear when it returned, so the tab order looked
             broken rather than under-styled. (RemEx-2p19, continuing RemEx-dygk.)

             AccentPrimaryBrush is per-theme by construction, so each theme rings in its own accent
             rather than in a literal that one of the four cannot show - the failure just fixed for
             the accent swatches in RemEx-wcvr.

             `:focus-visible` rather than `:focus` throughout, deliberately: it fires for keyboard
             traversal and not for a mouse click, so clicking a control does not leave a ring behind
             it. That is the distinction the pseudo-class exists for, and losing it would make the
             UI look permanently focused after any click.

             Split by whether the control templates a ContentPresenter or draws its own border:
             ContentPresenter for the content controls, the control itself where there is no inner
             presenter to reach. -->
        <Style Selector="Button:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ToggleButton:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="RepeatButton:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- These draw their own border, so the ring goes on the control rather than on an inner
             presenter. TextBox is the one a user is most likely to be typing into blind without it. -->
        <Style Selector="TextBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ComboBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="CheckBox:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="RadioButton:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="ToggleSwitch:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Slider:focus-visible">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

            <!-- ═══ CONNECTION STATUS INDICATOR (RemEx-udds) ═══
             Colour resolves through theme tokens so all four themes apply, and the .connected
             class flips with the binding. The base style is the disconnected state; .connected
             overrides it. Replaces literal colours previously held in a BoolToColorConverter
             ConverterParameter, which DynamicResource could not reach. -->
        <Style Selector="Ellipse.status-dot">
            <Setter Property="Fill" Value="{DynamicResource SystemErrorBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Fill" Duration="0:0:0.4"/>
            </Transitions>
        </Setter>
        </Style>
        <Style Selector="Ellipse.status-dot.connected">
            <Setter Property="Fill" Value="{DynamicResource SystemSuccessBrush}"/>
        </Style>
        <Style Selector="Ellipse.status-ring">
            <Setter Property="Stroke" Value="{DynamicResource SystemErrorBrush}"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Stroke" Duration="0:0:0.4"/>
            </Transitions>
        </Setter>
        </Style>
        <Style Selector="Ellipse.status-ring.connected">
            <Setter Property="Stroke" Value="{DynamicResource SystemSuccessBrush}"/>
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://Remex.Desktop/Assets/icon.png" ToolTipText="{local:Localize Tray_TooltipDefault}" IsVisible="True" Clicked="OnTrayIconClicked">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{local:Localize Tray_ShowMainWindow}" Click="OnShowMainWindow" />
                        <NativeMenuItem Header="{local:Localize Tray_LiveGlance}" Click="OnToggleLiveGlance" />
                        <NativeMenuItem Header="{local:Localize Tray_SwitchLightMode}" Click="OnToggleTheme" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="{local:Localize Tray_Exit}" Click="OnExitApp" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
