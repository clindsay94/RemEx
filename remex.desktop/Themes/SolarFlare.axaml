<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══ SOLAR FLARE THEME ═══

         A preset is its GEOMETRY plus a seed. The colours come from Shared/FallbackPalette.axaml
         until ThemeService.ApplyCustomization lands, and from the M3 generator after that; this
         preset's seed (#FFB800) lives in CustomizationViewModel.SelectTheme. (RemEx-07jij)

         THIS IS THE LIGHT PRESET, and that is now a SETTING rather than a property of the name.
         SelectTheme writes UseLightPalette = true for it explicitly. The fallback palette merged
         below is dark, so this preset is the one that would show a dark flash if the generated
         palette ever arrived after the first frame - the price of one fallback instead of four.

         IT DOES NOT FLASH, BUT NOT BECAUSE ANYTHING IS SYNCHRONOUS. ApplyCustomization posts its
         whole body to the dispatcher (ThemeService.ApplyCustomization), and MainWindow.Show happens
         from InitializeAppAsync, queued after it. What actually orders them is priority: the post is
         DispatcherPriority.Default, which runs ahead of Render, so it lands before the first frame.
         Lower that priority, or move Show ahead of it, and this preset flashes dark.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Remex.Desktop/Themes/Shared/FallbackPalette.axaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Soft, generous corners and a barely-there shadow: the daylight look. -->
    <CornerRadius x:Key="CardCornerRadius">24</CornerRadius>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <BoxShadows x:Key="CardShadow">0 4 16 0 #1A000000</BoxShadows>
    <BoxShadows x:Key="CardHoverShadow">0 8 32 0 #30000000, 0 0 12 2 #40FFB800</BoxShadows>
</ResourceDictionary>
