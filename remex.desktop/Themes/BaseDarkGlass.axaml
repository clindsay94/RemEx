<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══ DARK GLASS DESIGN SYSTEM ═══

         A preset is its GEOMETRY plus a seed. The colours come from Shared/FallbackPalette.axaml
         until ThemeService.ApplyCustomization lands, and from the M3 generator after that; the seed
         itself lives in CustomizationViewModel.SelectTheme, not here. (RemEx-07jij)
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Remex.Desktop/Themes/Shared/FallbackPalette.axaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Expressive Shape: Asymmetrical corners for cards -->
    <CornerRadius x:Key="CardCornerRadius">28, 8, 28, 8</CornerRadius>
    <Thickness x:Key="CardBorderThickness">1</Thickness>
    <BoxShadows x:Key="CardShadow">0 10 40 0 #50000000</BoxShadows>
    <BoxShadows x:Key="CardHoverShadow">0 20 60 0 #70000000, 0 0 20 3 #306C4CFF</BoxShadows>
</ResourceDictionary>
