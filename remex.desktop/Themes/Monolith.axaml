<ResourceDictionary xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ═══ MONOLITH THEME ═══

         A preset is its GEOMETRY plus a seed. The colours come from Shared/FallbackPalette.axaml
         until ThemeService.ApplyCustomization lands, and from the M3 generator after that; this
         preset's seed (#0A84FF) lives in CustomizationViewModel.SelectTheme. (RemEx-07jij)
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Remex.Desktop/Themes/Shared/FallbackPalette.axaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- The heavy 3px border is the whole identity of this preset - it is the only one that is not
         glass, and the only one whose cards are drawn rather than floated. -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <Thickness x:Key="CardBorderThickness">3</Thickness>
    <BoxShadows x:Key="CardShadow">0 8 32 0 #40000000</BoxShadows>
    <BoxShadows x:Key="CardHoverShadow">0 12 48 0 #60000000, 0 0 15 2 #400A84FF</BoxShadows>
</ResourceDictionary>
