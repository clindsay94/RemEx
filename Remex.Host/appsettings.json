{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RemexHost": {
    "Network": {
      "Port": 5005,
      "BindAddress": "0.0.0.0",
      "MaxConnections": 10,
      "ConnectionTimeoutSeconds": 300
    },
    "Telemetry": {
      "CollectionIntervalMs": 1000,
      "EnableHWiNFO": true,
      "EnableFallback": true
    },
    "Security": {
      "LocalhostOnly": false,
      "PairingTimeoutSeconds": 120
    }
  }
}
