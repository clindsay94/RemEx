{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Remex": {
    "AccessKey": ""
  },
  "RemexHost": {
    "Network": {
      "Port": 5005,
      "BindAddress": "0.0.0.0",
      "MaxConnections": 10,
      "ConnectionTimeoutSeconds": 300
    },
    "Telemetry": {
      "CollectionIntervalMs": 1000,
      "EnableHWiNFO": true,
      "EnableFallback": true
    },
    "Security": {
      "RequireAccessKey": true,
      "AccessKey": "",
      "LocalhostOnly": false
    }
  }
}
