<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Remex.Host-250abb58-e6f9-4331-93e2-4801f7e26382</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Remex.Host.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Remex.Core\Remex.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.3" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" NoWarn="NU1510" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.3" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.5" />
    <PackageReference Include="System.Management" Version="10.0.3" />
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.5" NoWarn="NU1510" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="2.88.8" />
  </ItemGroup>

  <!--
    Copy libremex_linux_bridge.so into the runtimes/linux-x64/native/ folder so
    [DllImport("remex_linux_bridge")] in LinuxPipeWireFrameSource resolves at runtime.
    .NET 10 no longer probes the assembly directory, so the runtimes-folder
    convention (same one SkiaSharp.NativeAssets.Linux uses) is required.
    The .so itself is produced by Remex.Host.Native.Linux/CMakeLists.txt — see
    the warning message for the rebuild command.
  -->
  <Target Name="CopyNativeLinuxBridge"
          AfterTargets="Build"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <_NativeBridgeSource>$(MSBuildThisFileDirectory)..\Remex.Host.Native.Linux\build\libremex_linux_bridge.so</_NativeBridgeSource>
      <_NativeBridgeDest>$(OutputPath)runtimes\linux-x64\native\</_NativeBridgeDest>
    </PropertyGroup>
    <Warning Condition="!Exists('$(_NativeBridgeSource)')"
             Text="libremex_linux_bridge.so not found at $(_NativeBridgeSource). PipeWire screen capture will be unavailable until you build the native bridge: cmake -S Remex.Host.Native.Linux -B Remex.Host.Native.Linux/build &amp;&amp; cmake --build Remex.Host.Native.Linux/build" />
    <Copy Condition="Exists('$(_NativeBridgeSource)')"
          SourceFiles="$(_NativeBridgeSource)"
          DestinationFolder="$(_NativeBridgeDest)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeLinuxBridgeToPublish"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <PropertyGroup>
      <_NativeBridgeSource>$(MSBuildThisFileDirectory)..\Remex.Host.Native.Linux\build\libremex_linux_bridge.so</_NativeBridgeSource>
    </PropertyGroup>
    <Warning Condition="!Exists('$(_NativeBridgeSource)')"
             Text="libremex_linux_bridge.so not found at $(_NativeBridgeSource). PipeWire screen capture will be unavailable until you build the native bridge: cmake -S Remex.Host.Native.Linux -B Remex.Host.Native.Linux/build &amp;&amp; cmake --build Remex.Host.Native.Linux/build" />
    <Copy Condition="Exists('$(_NativeBridgeSource)')"
          SourceFiles="$(_NativeBridgeSource)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
