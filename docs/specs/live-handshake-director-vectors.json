    { "name": "tap to skip before lock",
      "peers": 3, "hasTarget": true, "readyAt": 0.72, "linkedAt": 1.02, "failedAt": null, "skipAt": 0.50, "exitFromMark": false,
      "expectHandoff": 0.50, "expectOrigin": "mark", "expectPulses": [0.32] },
    { "name": "tap to skip after lock",
      "peers": 3, "hasTarget": true, "readyAt": 0.72, "linkedAt": 1.02, "failedAt": null, "skipAt": 1.10, "exitFromMark": false,
