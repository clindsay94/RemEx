{
  "_comment": "Shared test vectors for LiveHandshakeDirector (RemEx-8g6n0). Both the Kotlin and the C# director must produce exactly these hand-off decisions. Times are seconds since the splash started; a null field means the event never happened. exitFromMark=true is the PC rule (it always opens from the mark). Tolerance 0.001 s.",
  "constants": {
    "floor": 0.9,
    "grace": 1.2,
    "cap": 2.6,
    "lockHold": 0.5,
    "exit": 0.72,
    "fadeExit": 0.28,
    "firstPulse": 0.32,
    "pulsePeriod": 1.0
  },
  "cases": [
    { "name": "three PCs, desktop locks on",
      "peers": 3, "hasTarget": true, "readyAt": 0.72, "linkedAt": 1.02, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 1.52, "expectOrigin": "target", "expectPulses": [0.32, 1.32] },
    { "name": "one PC",
      "peers": 1, "hasTarget": true, "readyAt": 0.60, "linkedAt": 0.84, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 1.34, "expectOrigin": "target", "expectPulses": [0.32, 1.32] },
    { "name": "slow Wi-Fi, links inside the grace window",
      "peers": 2, "hasTarget": true, "readyAt": 0.70, "linkedAt": 1.74, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 2.24, "expectOrigin": "target", "expectPulses": [0.32, 1.32] },
    { "name": "links after the grace window: opens from the mark, ignores the late link",
      "peers": 2, "hasTarget": true, "readyAt": 0.70, "linkedAt": 2.30, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 1.90, "expectOrigin": "mark", "expectPulses": [0.32, 1.32] },
    { "name": "target asleep",
      "peers": 2, "hasTarget": true, "readyAt": 0.70, "linkedAt": null, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 1.90, "expectOrigin": "mark", "expectPulses": [0.32, 1.32] },
    { "name": "connect fails fast",
      "peers": 1, "hasTarget": true, "readyAt": 0.60, "linkedAt": null, "failedAt": 1.10, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 1.10, "expectOrigin": "mark", "expectPulses": [0.32] },
    { "name": "first run, nothing paired",
      "peers": 0, "hasTarget": false, "readyAt": 0.55, "linkedAt": null, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 0.90, "expectOrigin": "mark", "expectPulses": [0.32] },
    { "name": "paired PCs but no target",
      "peers": 2, "hasTarget": false, "readyAt": 0.50, "linkedAt": null, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 0.90, "expectOrigin": "mark", "expectPulses": [0.32] },
    { "name": "PC, phone already linked",
      "peers": 3, "hasTarget": true, "readyAt": 0.55, "linkedAt": 0.86, "failedAt": null, "skipAt": null, "exitFromMark": true,
      "expectHandoff": 1.36, "expectOrigin": "mark", "expectPulses": [0.32, 1.32] },
    { "name": "already linked at launch (warm connection)",
      "peers": 1, "hasTarget": true, "readyAt": 0.20, "linkedAt": 0.0, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 0.90, "expectOrigin": "target", "expectPulses": [0.32] },
    { "name": "never ready: the cap wins",
      "peers": 1, "hasTarget": true, "readyAt": null, "linkedAt": null, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 2.60, "expectOrigin": "mark", "expectPulses": [0.32, 1.32, 2.32] },
    { "name": "linked but never ready: the cap wins, from the target",
