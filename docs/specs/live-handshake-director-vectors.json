      "readyAt": 0.72, "linkedAt": 1.02, "failedAt": null, "skipAt": null, "exitFromMark": false,
      "expectHandoff": 1.82, "expectOrigin": "target", "expectLockShown": 1.12, "expectAnswersShown": [0.62, 0.80], "expectPulses": [0.32, 1.32] },
