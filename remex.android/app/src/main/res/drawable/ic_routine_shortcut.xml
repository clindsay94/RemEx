<?xml version="1.0" encoding="utf-8"?>
<!-- Pinned and dynamic routine shortcuts (routines spec A12): the launcher icon's own background, so a
     routine sits on the home screen as one of RemEx's own. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_routine_shortcut_foreground"/>
    <monochrome android:drawable="@drawable/ic_routine_shortcut_foreground"/>
</adaptive-icon>
