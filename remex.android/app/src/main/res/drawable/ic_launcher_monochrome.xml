    <!--
      Themed-icon (Android 13+ monochrome) layer: the system paints this with a SINGLE tint
      derived from the wallpaper/theme, using ONLY this drawable's alpha channel - RGB values
      here are never shown. Before this fix every path (including the hexagon casing) used an
      OPAQUE fill, so the alpha mask was solid across the whole badge: the tint painted one flat
      hexagon block with no visible mark, and the "hole" cut into the P-bowl was faked with an
      opaque patch colored to match the (ignored, in this mode) background, so it did not read
      as a hole either. Fixed the same way ic_launcher_foreground_vector.xml already does it:
      transparent fill + stroke for the casing outline, and a real evenOdd cutout for the P-bowl
      hole, so only the mark's true silhouette is opaque (RemEx-alwfa.1a).
    -->
    <group android:scaleX="0.8" android:scaleY="0.8" android:pivotX="54" android:pivotY="54">
        <path android:pathData="M33,26 L75,26 A13,13 0 0 1 88,39 L88,69 A13,13 0 0 1 75,82 L33,82 A13,13 0 0 1 20,69 L20,39 A13,13 0 0 1 33,26 Z"
            android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeAlpha="0.55" android:strokeWidth="1.4"/>
        <path android:pathData="M27.3,36 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z" android:fillColor="#FF000000"/>
        <path android:pathData="M34.3,36 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z" android:fillColor="#FF000000"/>
        <path android:pathData="M41.3,36 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0 Z" android:fillColor="#FF000000"/>
        <path android:pathData="M30,50 L39,61 L30,72" android:strokeColor="#FF000000" android:strokeWidth="4.8" android:strokeLineCap="round" android:strokeLineJoin="round"/>
        <path android:pathData="M45,47 h7 v25 h-7 Z" android:fillColor="#FF000000"/>
        <path android:fillType="evenOdd" android:pathData="M52,47 H60 A8,8 0 0 1 60,63 H52 Z M53.5,53 H58.8 A2.8,2.8 0 0 1 58.8,58.6 H53.5 Z" android:fillColor="#FF000000"/>
