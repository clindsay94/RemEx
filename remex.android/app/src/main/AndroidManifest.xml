<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- File transfers use a User-Initiated Data Transfer job (not a dataSync FGS) per Play policy;
         RUN_USER_INITIATED_JOBS replaces FOREGROUND_SERVICE_DATA_SYNC (RemEx-gvbq). -->
    <uses-permission android:name="android.permission.RUN_USER_INITIATED_JOBS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.USE_LOOPBACK_INTERFACE" />

    <!--
        RemEx has no ads and no ad-attribution, so it opts out of the advertising ID entirely.
        Firebase Analytics (bundled with Crashlytics) otherwise auto-merges these two permissions
        and collects the ad ID by default. Removing them here — plus disabling collection via the
        google_analytics_adid_collection_enabled meta-data in <application> below — makes the Play
        Console "this app does NOT use an advertising ID" declaration truthful and permanent.
        Analytics and Crashlytics continue to work without it.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />

    <!--
        android:allowBackup="true" is intentional. Security properties are preserved because:
          - data_extraction_rules.xml excludes the SPKI pin store (pinned_hosts) and
            DataStore preferences from cloud/D2D backups.
          - The EncryptedSharedPreferences master key (stored in Android Keystore) is
            non-exportable by design and cannot be transferred between devices.
        If you add new sensitive storage in the future, you MUST also add an exclusion rule
        to both data_extraction_rules.xml (API 31+) and backup_rules.xml (pre-API 31) to
        prevent that data from being included in backups.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemEx"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">

        <!-- Opt out of Firebase Analytics advertising-ID collection (see the AD_ID removal above). -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />

        <service
            android:name=".tile.RemexLockTileService"
            android:exported="true"
            android:label="@string/tile_lock_label"
            android:icon="@drawable/ic_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tile.RemexShutdownTileService"
            android:exported="true"
            android:label="@string/tile_shutdown_label"
            android:icon="@drawable/ic_shutdown"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tile.RemexRestartTileService"
            android:exported="true"
            android:label="@string/tile_restart_label"
            android:icon="@drawable/ic_restart"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tile.RemexRestartUefiTileService"
            android:exported="true"
            android:label="@string/tile_restart_uefi_label"
            android:icon="@drawable/ic_restart_uefi"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tile.RemexWakeOnLanTileService"
            android:exported="true"
            android:label="@string/tile_wol_label"
            android:icon="@drawable/ic_wol"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tile.RemexSleepTileService"
            android:exported="true"
            android:label="@string/tile_sleep_label"
            android:icon="@drawable/ic_sleep"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tile.RemexHibernateTileService"
            android:exported="true"
            android:label="@string/tile_hibernate_label"
            android:icon="@drawable/ic_hibernate"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <service
            android:name=".tile.RemexMonitorOffTileService"
            android:exported="true"
            android:label="@string/tile_monitor_off_label"
            android:icon="@drawable/ic_monitor_off"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

        <!-- Service for backwards compatibility of per-app languages -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget: Remote Control -->
        <receiver
            android:name=".widget.RemoteControlWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_remote_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_control_widget_info" />
        </receiver>

        <activity
            android:name=".widget.RemoteControlConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.RemEx" />

        <!-- Widget: Hardware Info -->
        <receiver
            android:name=".widget.HardwareInfoWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_hardware_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hardware_info_widget_info" />
        </receiver>

        <activity
            android:name=".widget.HardwareInfoConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.RemEx" />

        <!-- Widget: App Launcher -->
        <receiver
            android:name=".widget.AppLauncherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_launcher_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/app_launcher_widget_info" />
        </receiver>

        <activity
            android:name=".widget.AppLauncherConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.RemEx" />

        <!-- Foreground service for keeping connection alive -->
        <service
            android:name=".service.RemexConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- User-Initiated Data Transfer job keeps file transfers alive while the queue drains
             (RemEx-gvbq). Replaces the former dataSync foreground service; see
             docs/superpowers/specs/2026-07-13-uidt-migration-design.md. -->
        <service
            android:name=".service.FileTransferJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Share target: "Send to PC" from any app's share sheet (2.1, WP8). -->
        <activity
            android:name=".share.ShareToPcActivity"
            android:exported="true"
            android:label="@string/share_to_pc_title"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.RemEx">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Resolves file-sharing consent prompts from their notification actions (2.1, WP9). -->
        <receiver
            android:name=".service.FileConsentActionReceiver"
            android:exported="false" />

        <!-- FileProvider for open-after-download + share staging (2.1, WP8). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
